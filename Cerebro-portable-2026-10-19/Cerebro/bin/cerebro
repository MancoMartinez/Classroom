#!/usr/bin/env python3
"""Consola del motor local compartido con Codex y Claude."""
import os,sys
from pathlib import Path
root=Path(__file__).resolve().parent.parent
python=root/'.venv-cerebro/bin/python'
if python.exists() and Path(sys.prefix).resolve() != (root/'.venv-cerebro').resolve():
    os.execv(str(python),[str(python),__file__,*sys.argv[1:]])
from cerebro_motor import main
if __name__=='__main__':main()
