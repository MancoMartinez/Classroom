ss: '%d \" + \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_RelativeTime_SS}:{seconds}}',\r\n                m: \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_RelativeTime_Minute_m}:{a minute}}\",\r\n                mm: \"%d \" + \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_RelativeTime_Minutes_mm}:{minutes}}\",\r\n                h: \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_RelativeTime_H}:{an hour}}\",\r\n                hh: \"%d \" + \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_RelativeTime_HH}:{hours}}\",\r\n                d: \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_RelativeTime_D}:{a day}}\",\r\n                dd: \"%d \" + \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_RelativeTime_DD}:{days}}\",\r\n                M: \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_RelativeTime_Month_M}:{a month}}\",\r\n                MM: \"%d \" + \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_RelativeTime_Months_MM}:{months}}\",\r\n                y: \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_RelativeTime_Y}:{a year}}\",\r\n                yy: \"%d \" + \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_RelativeTime_YY}:{years}}\"\r\n            },\r\n\r\n            weekdays: [\r\n                \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_Weekdays_Sunday}:{Sunday}}\",\r\n                \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_Weekdays_Monday}:{Monday}}\",\r\n                \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_Weekdays_Tuesday}:{Tuesday}}\",\r\n                \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_Weekdays_Wednesday}:{Wednesday}}\",\r\n                \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{DateTime_Weekdays_Thursday}:{Thursday}}\",\r\n                \"RESOURCE{{Sysrepublic.Fou