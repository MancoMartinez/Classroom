rsion of UI Calendar widget initialization\r\n     */\r\n    initialiseDatePicker: function ($control, onChangeCallback, config) {\r\n        // use jquery ui datepicker.\r\n        var $calendarControl = $control.find(\".js-date-picker-container\");\r\n        if ($calendarControl.length === 0) {\r\n            return;\r\n        }\r\n        config.buttonImageOnly = false;\r\n        var oldOnSelect = config.onSelect;\r\n        config.onSelect = function (dateText, inst) {\r\n            oldOnSelect(dateText, inst);\r\n            $control.trigger('datepickeronchange');\r\n        };\r\n        config.beforeShow = function (input, inst) {\r\n            $calendarControl.datepicker(\"setDate\", datePicker.currentDate($control, true));\r\n        };\r\n        if (config.DatePicker.IsVisible && config.DatePicker.ShowCalendar) {\r\n            $calendarControl.datepicker(config);\r\n            // the control is inlined so it needs to stop bubbling clicks\r\n            // events to prevent closing containing dropdown/overlay\r\n            $calendarControl.on('click', function (event) {\r\n                event.stopPropagation();\r\n            });\r\n            // this makes jQuery widget to show the same month names as we are using (long form)\r\n            var monthNames = $calendarControl.datepicker('option', 'monthNames');\r\n            $calendarControl.datepicker('option', 'monthNamesShort', monthNames);\r\n        }\r\n    }\r\n};\r\n\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/lib/es6-promise.auto.min.js\n * ======================================== */\n\n!function(t,e){\"object\"==typeof exports&&\"undefined\"!=typeof module?module.exports=e():\"function\"==typeof define&&define.amd?define(e):t.ES6Promise=e()}(this,function(){\"use strict\";function t(t){var e=typeof t;return null!==t&&(\"object\"===e||\"function\"===e)}function e(t){return\"function\"==typeof t}function n(t){I=t}function r(t){J=t