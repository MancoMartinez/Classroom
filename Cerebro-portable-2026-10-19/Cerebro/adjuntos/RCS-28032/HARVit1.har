nt-size:1.4em;text-align:center;margin-bottom:.1em;background-color:#000;background-color:rgba(0,0,0,0.5)}.video-js .vjs-subtitles{color:#fff}.video-js .vjs-captions{color:#fc6}.vjs-tt-cue{display:block}.video-js.vjs-fullscreen .vjs-text-track{font-size:3em}.vjs-default-skin .vjs-hidden{display:none}.vjs-lock-showing{display:block!important;opacity:1;visibility:visible}.vjs-no-js{padding:20px;color:#ccc;background-color:#333;text-align:center;width:300px;height:150px;margin:0 auto;font:18px Arial,sans-serif}.vjs-no-js a,.vjs-no-js a:visited{color:#F4A460}.videoWrapper{position:relative;padding-bottom:41%;padding-top:0;height:0;z-index:2}video{position:absolute!important;top:0;left:0;width:100%!important;height:100%!important;z-index:0}video.video-js{z-index:1000}.video-js .vjs-controls{z-index:1002}.video-js .vjs-big-play-button{z-index:1002}.videoWrapper .video-js{position:absolute;top:0;left:0;width:100%!important;height:100%!important;z-index:1;background:#000}.videoWrapper object,.videoWrapper embed{position:absolute;top:0;left:0;width:100%;height:100%!important;z-index:1}.vjs-spinner{display:none!important}.video-js img.vjs-poster{height:100%!important;width:100%!important;z-index:1;max-width:100%}\n\n/* ========================================\n * Source: Components/src/styles/Cpf/Content/Styles/new/n_zugo.css\n * ======================================== */\n\n/*\r\n    Zugo tables & grid views, Apps panel\r\n*/\r\n\r\n#search-toolbox-top {\r\n    width: 40%;\r\n    float: right;\r\n}\r\n\r\n.search-results-outer .header {\r\n    margin: 0;\r\n    height: 4rem;\r\n}\r\n\r\n.search-results-outer,\r\n.results-container:not(table),\r\n#results-container,\r\n.scroll-search-container,\r\ndiv[sng-zugo-delayed-request],\r\ndiv[sng-zugo-triggered-request] {\r\n    height: 100%;\r\n}\r\n\r\n#page > .results-container,\r\n#page > #results,\r\n#page > #results-container,\r\n#page > div[sng-zugo] {\r\n    height: 100%;\r\n    min-height: 0;\r\n}\r\n\r\n#page > .search-results-outer {\r\n    padding: 0 1rem .5rem;\r\n}\r\n\r\n.results-container {\r\n    margin-bottom: 0;\r\n}\r\n\r\n.search-bar .input-group {\r\n    float: right;\r\n    width: calc(100% - 10rem);\r\n}\r\n\r\n.results-count-message:empty ~ .search-bar .input-group {\r\n    width: 100%;\r\n}\r\n\r\n.search-bar .input-group .input-group-addon {\r\n    background: transparent;\r\n    color: var(--text-disabled);\r\n    border-color: var(--text-disabled);\r\n    cursor: pointer;\r\n}\r\n\r\n.search-filter {\r\n    flex-wrap: nowrap;\r\n}\r\n\r\n    .search-filter .form-control {\r\n        flex-shrink: 1;\r\n    }\r\n\r\n    .search-filter .input-group-addon {\r\n        flex-shrink: 0;\r\n        line-height: 2rem;\r\n    }\r\n\r\n    .search-filter .input-group .btn {\r\n        margin: 0;\r\n    }\r\n\r\n.search-filter-container .factboard-zugo {\r\n    display: none;\r\n}\r\n\r\n.factboard-select .search-filter-container .factboard-zugo {\r\n    display: inline-block;\r\n}\r\n\r\n.search-filter-container .factboard-zugo {\r\n    line-height: 0;\r\n}\r\n\r\n.search-filter-container button {\r\n    margin-left: 0.75rem;\r\n}\r\n\r\n#cancel-search-button {\r\n    z-index: 4;\r\n    color: var(--muted);\r\n}\r\n\r\n.results-count-message {\r\n    width: 10rem;\r\n    text-align: right;\r\n    line-height: 2.4rem;\r\n    font-size: 0.875rem;\r\n    padding-right: 0.75rem;\r\n    color: var(--muted);\r\n    float: left;\r\n}\r\n\r\n.search-results {\r\n    height: 100%;\r\n    overflow-y: auto;\r\n    position: relative;\r\n    width: 100%;\r\n}\r\n\r\n.zugo-item {\r\n    position: relative;\r\n}\r\n\r\n.panel-item {\r\n    float: left;\r\n}\r\n\r\n.apps-panel {\r\n    padding-top: 1rem;\r\n    background: var(--section-background);\r\n    display: grid;\r\n    flex-grow: 0;\r\n    max-height: 100%;\r\n    flex: 1 1 auto;\r\n}\r\n\r\n.lightbox .apps-panel {\r\n    background: var(--modal-background);\r\n}\r\n\r\n.panel.results-panel.apps-panel {\r\n\tdisplay: flex;\r\n\tflex: 0 1 auto;\r\n\tflex-wrap: wrap;\r\n}\r\n\r\n.panel.results-panel.apps-panel > * {\r\n    justify-content: left;\r\n    align-items: flex-start;\r\n    padding: 10px;\r\n}\r\n\r\n.panel.results-panel.apps-panel.section {\r\n    margin-bottom: 0;\r\n}\r\n\r\n.flex-container > .panel.results-panel.apps-panel {\r\n    height: auto;\r\n}\r\n\r\n.apps-panel > div {\r\n\theight: 13rem;\r\n\tdisplay: flex;\r\n\talign-content: center;\r\n\tjustify-content: center;\r\n\tmin-width: 0;\r\n}\r\n\r\n.apps-panel-item {\r\n    overflow: hidden;\r\n    position: relative;\r\n}\r\n\r\n    .apps-panel-item:hover {\r\n        overflow: visible;\r\n    }\r\n\r\n.apps-panel-box {\r\n    position: absolute;\r\n    padding: 0.75rem;\r\n    text-align: center;\r\n    text-decoration: none;\r\n    width: 13rem;\r\n    border-radius: 2rem;\r\n    cursor: pointer;\r\n    position: relative;\r\n    word-break: normal;\r\n    display: block;\r\n    background: 0;\r\n    box-shadow: none;\r\n    transition: background 0.2s ease, box-shadow 0.2s ease;\r\n    z-index: 1;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n}\r\n\r\n    .apps-panel-box.box {\r\n        border: 0;\r\n        background: 0;\r\n    }\r\n\r\n    .apps-panel-box.disabled {\r\n        cursor: default;\r\n    }\r\n\r\na.apps-panel-box {\r\n    text-decoration: none;\r\n}\r\n\r\n.apps-panel-box:hover {\r\n    background: var(--app-panel-hover);\r\n    box-shadow: 0 4px 12px rgba(10, 20, 50, 0.15);\r\n    z-index: 5;\r\n}\r\n\r\n.apps-panel-box:after {\r\n    border-radius: 2rem;\r\n}\r\n\r\n.apps-panel-box.disabled:hover {\r\n    background: 0;\r\n    box-shadow: none;\r\n}\r\n\r\n.apps-panel-box.disabled .app-name {\r\n    color: #7d92ad;\r\n}\r\n\r\n.apps-panel-box.disabled .app-description {\r\n    display: none;\r\n}\r\n\r\na.apps-panel-box:focus {\r\n    box-shadow: none;\r\n}\r\n\r\n    a.apps-panel-box:focus:after {\r\n        width: 100%;\r\n        height: 11rem;\r\n        border-radius: 2rem;\r\n        position: absolute;\r\n        top: 0;\r\n        left: 0;\r\n        border: solid 0.125rem rgba(var(--primary-rgb), 0.2);\r\n        transition: border 0.2s ease;\r\n        content: \"\";\r\n    }\r\n\r\n    a.apps-panel-box:focus:hover:after {\r\n        height: 100%;\r\n    }\r\n\r\n.app-icon {\r\n    padding: 0.875rem 0.75rem 0.75rem;\r\n    position: relative;\r\n    height: 6.5rem;\r\n    width: 8rem;\r\n    background: var(--app-icon);\r\n    color: var(--secure-primary-text);\r\n    border-radius: 2rem;\r\n    margin: 0 1.25rem 0.5rem;\r\n    box-shadow: 2px 4px 10px rgba(29,62,111,0.1);\r\n}\r\n\r\n    .app-icon.app-icon-platform {\r\n        background: var(--app-icon-platform);\r\n        color: white;\r\n    }\r\n\r\n        .app-icon.app-icon-platform.disabled {\r\n            background: 0;\r\n            border: 1px solid var(--section-border);\r\n        }\r\n\r\n.app-icon-platform .disabled {\r\n    cursor: not-allowed;\r\n}\r\n\r\n.app-icon .fa,\r\n.app-icon .fo {\r\n    font-size: 3.875rem;\r\n}\r\n\r\n.app-icon .sub-icon {\r\n    font-size: 1.5rem;\r\n    position: absolute;\r\n    bottom: 1rem;\r\n    right: 1.25rem;\r\n    background: var(--secure-primary-text);\r\n    padding: 0.25rem 0.125rem;\r\n    border-radius: 0.75rem;\r\n    color: var(--app-icon-sub-icon);\r\n    box-sizing: content-box;\r\n    width: 1.28571429em;\r\n}\r\n\r\n.app-icon.app-folder-icon {\r\n    width: 10rem;\r\n    margin-top: 0.25rem;\r\n    height: 6.25rem;\r\n    padding-top: 0.75rem;\r\n}\r\n\r\n    .app-icon.app-folder-icon,\r\n    .app-icon.app-folder-icon::after {\r\n        border-radius: 0 1rem 1rem 1rem;\r\n        background: rgba(var(--primary-rgb), 0.5);\r\n        box-shadow: none;\r\n        color: var(--secure-primary-text);\r\n    }\r\n\r\n        .app-icon.app-folder-icon::after {\r\n            content: \"\";\r\n            display: block;\r\n            width: 5rem;\r\n            height: 0.75rem;\r\n            position: absolute;\r\n            top: -0.75rem;\r\n            left: 0;\r\n            border-radius: 0.675rem 0.675rem 0 0;\r\n            border-bottom: 0;\r\n        }\r\n\r\n.apps-panel-box .button-icon {\r\n    padding: 0;\r\n    height: 4rem;\r\n    font-size: 3.75rem;\r\n    line-height: 3.75rem;\r\n    display: inline-block;\r\n    width: 5.5rem;\r\n    position: relative;\r\n    text-align: center;\r\n    border-radius: 0.5rem;\r\n    margin: 0.5rem;\r\n    font-weight: 300;\r\n}\r\n\r\n.app-folder .button-icon:after {\r\n    content: \"\";\r\n    display: block;\r\n    position: absolute;\r\n    width: 2rem;\r\n    height: 0.5rem;\r\n    top: -0.25rem;\r\n    left: 0.25rem;\r\n}\r\n\r\n.button-icon .sub-icon {\r\n    bottom: 0;\r\n    right: 0;\r\n}\r\n\r\n.app-name,\r\n.app-description {\r\n\tline-height: 1.125rem;\r\n\tfont-size: 0.8125rem;\r\n\tdisplay: block;\r\n\tmax-width: 150px;\r\n}\r\n.panel.results-panel.apps-panel .panel-item.zugo-item.no-checkbox.apps-panel-item .app-name,\r\n.panel.results-panel.apps-panel .panel-item.zugo-item.no-checkbox.apps-panel-item .app-description {\r\n\tmax-width: 150px;\r\n}\r\n\r\n.app-name {\r\n\tpadding: 0.25rem;\r\n\tfont-size: 1.25rem;\r\n\tletter-spacing: -0.03rem;\r\n\tcolor: var(--default-text);\r\n}\r\n\r\n.app-description {\r\n    color: var(--muted);\r\n    opacity: 0;\r\n    transition: opacity 0.2s ease;\r\n}\r\n\r\n.app-icon:not(.app-folder-icon) {\r\n    margin: 0 1.5rem 0.5rem;\r\n}\r\n\r\n.apps-panel-box:hover .app-description {\r\n    opacity: 1;\r\n}\r\n\r\n.panel .no-results {\r\n    display: inline-block;\r\n    padding: 2rem;\r\n}\r\n\r\n.compass.compass-apps {\r\n    height: 2rem;\r\n    font-size: 1.125rem;\r\n}\r\n/* #13455 */\r\n.panel-item.zugo-item + .no-results {\r\n    display: none;\r\n}\r\n\r\n.search-results-wrapper .loading-bar-container {\r\n    text-align: center;\r\n    padding: 10px;\r\n}\r\n\r\n.fa.sort-icon-asc,\r\n.fa.sort-icon-desc {\r\n    line-height: 1rem;\r\n    float: right;\r\n    padding: 0.25rem 0.5rem;\r\n}\r\n\r\n.fa.sort-icon-asc {\r\n    display: none;\r\n}\r\n\r\n.fa.sort-icon-desc {\r\n    display: none;\r\n}\r\n\r\n.sort.asc .fa.sort-icon-asc {\r\n    display: inline-block;\r\n}\r\n\r\n.sort.desc .fa.sort-icon-desc {\r\n    display: inline-block;\r\n}\r\n\r\n.dyno-control-wrapper .search-results-wrapper {\r\n    height: 300px;\r\n}\r\n\r\n.dyno-control-wrapper .search-loader {\r\n    position: absolute;\r\n    left: 0;\r\n    right: 0;\r\n    width: auto;\r\n}\r\n\r\n.search-results-wrapper {\r\n    min-height: 3rem;\r\n    top: 4.5rem;\r\n}\r\n\r\n.results-page-tabular-js {\r\n    height: 100%;\r\n    overflow-y: auto;\r\n}\r\n\r\n.page-content .search-results-wrapper,\r\n.dyno-view .search-results-wrapper {\r\n    position: relative;\r\n    top: 0;\r\n    min-height: 22rem;\r\n}\r\n\r\n.dyno-view-body .search-results-wrapper {\r\n    min-height: 8rem;\r\n}\r\n\r\n.fixed-table-header,\r\n.sng-fixed-table-header {\r\n    position: relative;\r\n    top: 0;\r\n    left: 0;\r\n    z-index: 3;\r\n    width: 100%;\r\n    overflow-x: hidden;\r\n    table-layout: fixed;\r\n}\r\n\r\n    .fixed-table-header thead {\r\n        position: fixed;\r\n    }\r\n\r\n.sng-fixed-table-header,\r\n.table.sng-fixed-table-header {\r\n    display: none;\r\n}\r\n\r\n#search-loader {\r\n    position: fixed;\r\n    bottom: 0;\r\n    width: 100%;\r\n    padding: 1.5rem;\r\n    background: var(--toolbar-background);\r\n    min-height: 5.5rem;\r\n}\r\n\r\n    #search-loader .section-controls {\r\n        padding: 0;\r\n    }\r\n\r\n    #search-loader .buttons {\r\n        position: absolute;\r\n        top: 1.5rem;\r\n        right: 1.5rem;\r\n    }\r\n\r\n/* stack */\r\n\r\n.stack-select-all-wrapper,\r\n.stack-item {\r\n    padding: 0.5rem 1rem;\r\n    cursor: pointer;\r\n}\r\n\r\n.stack-item {\r\n}\r\n\r\n    .stack-item.to-remove,\r\n    .stack-item.to-add {\r\n        border-left-width: 0.1875rem;\r\n        border-left-style: solid;\r\n        padding-left: 0.3125rem;\r\n    }\r\n\r\n    .stack-item.to-remove {\r\n        border-left-color: var(--danger-secure);\r\n        color: var(--text-disabled);\r\n    }\r\n\r\n    .stack-item.to-add {\r\n        border-left-color: var(--success);\r\n    }\r\n\r\n    .stack-item:not(.no-results):hover {\r\n        background-color: rgba(var(--primary-rgb), 0.2);\r\n    }\r\n\r\n.stack-item-title,\r\n.stack-item-content {\r\n    white-space: normal;\r\n    word-break: break-all;\r\n    word-break: break-word;\r\n    word-wrap: break-word;\r\n}\r\n\r\n.stack-item-title {\r\n    color: var(--secure-primary-text);\r\n}\r\n\r\n.stack-item-content {\r\n    font-size: 0.875rem;\r\n    color: var(--muted);\r\n}\r\n\r\n.stack-item .select-wrapper select {\r\n    padding: 0.125rem;\r\n    height: 2rem;\r\n}\r\n\r\n.stack-item .select-wrapper,\r\n.stack-item .form-control {\r\n    height: 2rem;\r\n}\r\n\r\n.stack-select-all-wrapper {\r\n    margin-bottom: 0;\r\n}\r\n\r\n.stack-select-all {\r\n    margin-right: 0.75rem;\r\n}\r\n\r\n.stack-item-checkbox {\r\n    float: left;\r\n    padding-right: 0.5rem;\r\n}\r\n\r\n.stack-item .disabled {\r\n    color: var(--muted);\r\n}\r\n\r\n/*.stack-item .item-selection-column {\r\n    padding: 1.25rem .75rem .5rem 0;\r\n    float: left;\r\n    height: 35px;\r\n}*/\r\n\r\n/*.stack-row-select {\r\n    position: relative;\r\n    top: -0.625rem;\r\n}*/\r\n\r\n/*.stack-item .content {\r\n    display: block;\r\n}*/\r\n\r\n.stackview-content {\r\n    font-size: 0.875rem;\r\n    color: var(--muted);\r\n}\r\n\r\n.stackview-title {\r\n    display: block;\r\n}\r\n\r\n.stackview-additional {\r\n    float: right;\r\n    font-size: 0.875rem;\r\n    color: var(--muted);\r\n}\r\n\r\n.stackview-title .stackview-child {\r\n    margin-left: 0.5rem;\r\n}\r\n\r\n.stack-item.zugo-item:after {\r\n    clear: both;\r\n    content: \"\";\r\n    display: block;\r\n}\r\n\r\n.stackview-icon {\r\n    padding: 0 5px 0 0;\r\n}\r\n\r\n.item-selection-column label {\r\n    margin: 0;\r\n    line-height: 1rem;\r\n}\r\n/* Apps */\r\n\r\n.loading-indication {\r\n    padding: 3.75rem 0 0;\r\n    text-align: center;\r\n    width: 100%;\r\n    color: var(--text-disabled);\r\n}\r\n\r\n    .loading-indication img {\r\n        width: 2.6875rem;\r\n        height: 0.6875rem;\r\n        display: inline-block;\r\n    }\r\n\r\n/* APPS MENU */\r\n#apps {\r\n    display: none;\r\n    padding: 0.75rem;\r\n}\r\n\r\n#apps-search-container .panel {\r\n    padding: calc(1% + 1rem) 5%;\r\n}\r\n\r\n#apps-search-container .search-container {\r\n    height: 100%;\r\n}\r\n\r\n/* Preview Mode */\r\n\r\n#preview-outer {\r\n    position: fixed;\r\n    left: 0;\r\n    right: 0;\r\n    bottom: 0;\r\n    display: none;\r\n    background-color: var(--modal-background);\r\n    border-top: 1px solid var(--border-light);\r\n    overflow: hidden;\r\n    height: 50%;\r\n}\r\n\r\n    #preview-outer .title {\r\n        padding: 0.5rem;\r\n        text-transform: uppercase;\r\n        font-size: 0.875rem;\r\n        border-bottom: 1px solid var(--border-light);\r\n        height: 2.5rem;\r\n    }\r\n\r\n        #preview-outer .title span {\r\n            color: var(--default-text);\r\n        }\r\n\r\n            #preview-outer .title span:not(.fa) {\r\n                font-weight: bold;\r\n            }\r\n\r\n        #preview-outer .title .close {\r\n            position: absolute;\r\n            cursor: pointer;\r\n            font-size: 1rem;\r\n            top: 0.5rem;\r\n            right: 0.5rem;\r\n            text-shadow: none;\r\n            color: var(--default-text);\r\n            opacity: 1;\r\n        }\r\n\r\n    #preview-outer #preview-spinner {\r\n        padding: 0.5rem;\r\n        font-size: 0.875rem;\r\n        color: var(--muted);\r\n        text-align: center;\r\n    }\r\n\r\n    #preview-outer iframe {\r\n        display: none;\r\n        width: 100%;\r\n        height: 100%;\r\n        border: 0;\r\n        padding-bottom: 2.5rem;\r\n    }\r\n\r\n.search-results.split-view {\r\n    overflow-y: scroll;\r\n    margin-right: 0;\r\n}\r\n\r\n.no-results {\r\n    padding: 0.5rem 1rem;\r\n    font-size: 0.875rem;\r\n}\r\n\r\n/* Custom Case Number */\r\n\r\n.ccn-label {\r\n    padding: 0.25rem 0.5rem;\r\n    border: 1px solid var(--modal-border);\r\n    background: var(--section-border);\r\n    font-size: 0.875rem;\r\n    font-weight: bold;\r\n    border-radius: 0.25rem;\r\n    -moz-border-radius: 0.25rem;\r\n    -webkit-border-radius: 0.25rem;\r\n    margin: 0 0.5rem;\r\n}\r\n\r\n    .ccn-label:hover,\r\n    .ccn-label.selected {\r\n        border-color: rgba(var(--primary-rgb), 0.25);\r\n    }\r\n\r\n    .ccn-label.selected {\r\n        background: var(--section-background);\r\n    }\r\n\r\n    .ccn-label.empty {\r\n        padding: 0.25rem 2rem;\r\n        border-style: dashed;\r\n    }\r\n\r\n.ccn-add {\r\n    color: var(--muted);\r\n}\r\n\r\n    .ccn-add:hover {\r\n        cursor: pointer;\r\n        color: var(--secure-primary-text);\r\n    }\r\n\r\n.ccn-type {\r\n    display: block;\r\n    padding: 0.5rem 0.25rem;\r\n    float: left;\r\n}\r\n\r\n    .ccn-type .ccn-label {\r\n        margin: 0;\r\n    }\r\n\r\n.ccn-pad {\r\n    padding-bottom: 1rem;\r\n}\r\n\r\n#addNewRow {\r\n    color: var(--secure-primary-text);\r\n    cursor: pointer;\r\n}\r\n\r\n.myTdInput {\r\n    color: var(--default-text);\r\n}\r\n\r\n/* Zugo Angular styles */\r\n\r\n\t.zugo-header:not(#data-grid-header) {\r\n\t\twidth: 100%;\r\n\t\tposition: relative;\r\n\t\tz-index: 1;\r\n\t\tdisplay: -ms-flexbox;\r\n\t\tdisplay: flex;\r\n\t\t-ms-flex-wrap: nowrap;\r\n\t\tflex-wrap: nowrap;\r\n\t}\r\n\r\n.zugo-hide-title {\r\n    visibility: hidden;\r\n}\r\n\r\n.zugo-result-count-message {\r\n    font-size: 0.875rem;\r\n    color: var(--muted);\r\n    text-align: right;\r\n    white-space: nowrap;\r\n    overflow: hidden;\r\n    text-overflow: ellipsis;\r\n}\r\n\r\n.filter-by-search .fa-remove,\r\n.cancel-search {\r\n    padding: 0.5rem;\r\n    margin-left: -1.5rem;\r\n    color: var(--muted);\r\n    cursor: pointer;\r\n}\r\n\r\n    .filter-by-search .fa-remove:hover,\r\n    .cancel-search:hover {\r\n        color: var(--secure-primary-text);\r\n    }\r\n\r\ntable.table.table-fixed-header {\r\n    margin-bottom: 0;\r\n}\r\n/* track */\r\n\r\n#track-lite-close {\r\n    position: absolute;\r\n    top: 0.625rem;\r\n    right: 0.625rem;\r\n}\r\n\r\n.track-loader {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    right: 0;\r\n    bottom: 0;\r\n    background: var(--modal-background);\r\n    text-align: center;\r\n    height: 100%;\r\n    padding: 0;\r\n}\r\n\r\n#track-lite .table th,\r\n#track-lite .table td {\r\n    padding: 0.5rem;\r\n}\r\n\r\n#track-lite .table {\r\n    margin-bottom: 0;\r\n    border: 0;\r\n}\r\n\r\n#track-lite tr:last-child,\r\n#track-lite tr:last-child td {\r\n    border-bottom: 0;\r\n}\r\n\r\n#track-lite h3 {\r\n    padding: 0.5rem;\r\n}\r\n\r\n.track-close {\r\n    position: absolute;\r\n    top: 0.625rem;\r\n    right: 0.625rem;\r\n    cursor: pointer;\r\n    padding: .125rem .375rem;\r\n    border-radius: 1rem;\r\n    background: rgba(var(--primary-rgb), 0.25);\r\n    transition: background 0.2s ease;\r\n    color: var(--secure-primary-text);\r\n    cursor: pointer;\r\n}\r\n\r\n    .track-close:hover {\r\n        background: rgba(var(--primary-rgb), 0.35);\r\n    }\r\n\r\n.track-icon {\r\n    font-size: 1.125rem;\r\n    color: var(--secure-primary-text);\r\n}\r\n\r\n.pop-track-button,\r\n.track-icon {\r\n    font: normal normal normal 14px/1 FontAwesome;\r\n}\r\n\r\n.pop-track-wrapper {\r\n    position: absolute;\r\n    z-index: 3;\r\n    top: 10%;\r\n    left: 10%;\r\n    width: 80%;\r\n    height: 60%;\r\n    border: 1px solid #777;\r\n    background: var(--modal-background);\r\n}\r\n\r\n.pop-track-container {\r\n    position: relative;\r\n    width: 100%;\r\n    height: 100%;\r\n}\r\n\r\n.pop-track-header {\r\n    position: absolute;\r\n    left: 0;\r\n    right: 0;\r\n    top: 0;\r\n    height: 35px;\r\n}\r\n\r\n    .pop-track-header h3 {\r\n        padding: 0.5rem;\r\n    }\r\n\r\n.pop-track-content {\r\n    position: absolute;\r\n    left: 0;\r\n    right: 0;\r\n    top: 36px;\r\n    bottom: 0;\r\n}\r\n\r\n    .pop-track-content iframe,\r\n    .zugo-pop-track-content iframe {\r\n        height: 100%;\r\n        width: 100%;\r\n        border-top: 1px solid #777;\r\n        border-bottom: 0;\r\n        border-left: 0;\r\n        border-right: 0;\r\n        background: #ffffff;\r\n    }\r\n\r\n.sng-pop-track-column {\r\n    text-align: center;\r\n}\r\n\r\n.pop-track-button {\r\n    padding: 0.37rem 0.5rem;\r\n    width: 1.28571429em;\r\n    text-align: center;\r\n    border-radius: 0.25rem;\r\n    display: inline-block;\r\n    box-sizing: content-box;\r\n    color: var(--secure-primary-text);\r\n    cursor: pointer;\r\n}\r\n\r\n    .pop-track-button:hover {\r\n        background: rgba(var(--accent-rgb) / 0.15);\r\n    }\r\n\r\n.zugo-tracks-wrapper {\r\n    position: fixed;\r\n    width: 300px;\r\n    background: var(--modal-background);\r\n    z-index: 60;\r\n    border-radius: 1rem;\r\n    box-shadow: var(--shadow-medium);\r\n    padding-bottom: 0.2rem;\r\n}\r\n\r\n    .zugo-tracks-wrapper h3 {\r\n        padding: 0.5rem;\r\n        color: var(--secure-primary-text);\r\n        border-bottom: 0;\r\n        margin-bottom: 0;\r\n    }\r\n\r\n.zugo-track-row {\r\n    cursor: pointer;\r\n    background: 0;\r\n}\r\n\r\n.sng-pop-track-column {\r\n    width: 50px;\r\n}\r\n\r\n.zugo-pop-tracks-wrapper {\r\n    position: absolute;\r\n    bottom: 0;\r\n    left: 0;\r\n    right: 0;\r\n    height: 50%;\r\n    background: var(--modal-background);\r\n}\r\n\r\n    .zugo-pop-tracks-wrapper:after {\r\n        display: block;\r\n        clear: both;\r\n        content: \"\";\r\n    }\r\n\r\n.zugo-results-split-top {\r\n    height: 40%;\r\n}\r\n\r\n.zugo-pop-track-wrapper {\r\n    position: relative;\r\n    height: 100%;\r\n    border: 1px solid var(--modal-border);\r\n    float: left;\r\n}\r\n\r\n.zugo-pop-track-content {\r\n    position: absolute;\r\n    left: 0;\r\n    right: 0;\r\n    top: 36px;\r\n    bottom: 0;\r\n    overflow-y: hidden;\r\n}\r\n\r\n.zugo-pop-track-container {\r\n    position: relative;\r\n    height: 100%;\r\n}\r\n\r\n.zugo-track-icon {\r\n    color: var(--muted);\r\n    margin-right: 0.5rem;\r\n}\r\n\r\n.sng-results-container table.grid.table {\r\n    margin-bottom: 0;\r\n}\r\n\r\n.simple-grid-input {\r\n    position: relative;\r\n    padding-right: 8.5rem;\r\n}\r\n\r\n    .simple-grid-input .form-control {\r\n        max-width: none;\r\n    }\r\n\r\n    .simple-grid-input button {\r\n        position: absolute;\r\n        top: 0;\r\n        right: 0;\r\n        width: 8rem;\r\n    }\r\n\r\n.filteredselect-full-page .filtered-select {\r\n    height: 100%;\r\n}\r\n\r\n.filteredselect-full-page {\r\n    height: calc(100vh - 10rem);\r\n}\r\n\r\n    .filteredselect-full-page .section {\r\n        height: 100%;\r\n    }\r\n\r\n    .filteredselect-full-page .section-content {\r\n        height: calc(100% - 3rem);\r\n    }\r\n\r\n    .filteredselect-full-page .search-results-wrapper {\r\n        min-height: 0;\r\n    }\r\n\r\n    .filteredselect-full-page .search-results {\r\n        position: relative;\r\n    }\r\n\r\n    .filteredselect-full-page .sngfilter-existing {\r\n        max-height: none;\r\n        margin: 0;\r\n        margin-top: -1px;\r\n        height: calc(100% - 4rem);\r\n    }\r\n\r\n    .filteredselect-full-page .sngfilter {\r\n        margin-bottom: 0.75rem;\r\n    }\r\n\r\n    .filteredselect-full-page .search-results-outer {\r\n        height: 100%;\r\n    }\r\n/*\r\n.filteredselect-full-page {\r\n    height: calc(100vh - 5rem);\r\n}\r\n\r\n#user-groups-grid,\r\n#user-location-groups-grid {\r\n    height: 100%;\r\n}\r\n\r\n.filteredselect-full-page .section {\r\n    height: 100%;\r\n}\r\n\r\n.filteredselect-full-page .section-content {\r\n    height: calc(100% - 2rem);\r\n}\r\n\r\n.filteredselect-full-page .sngfilter-existing {\r\n    height: 100%;\r\n}\r\n    */\r\n\r\n/* new search container styles */\r\n\r\n.search-container {\r\n    position: relative;\r\n    height: 100%;\r\n}\r\n\r\n    .search-container.has-search-header {\r\n        height: calc(100% - 4.5rem);\r\n        background: var(--section-background);\r\n        border-radius: 1rem;\r\n        box-shadow: 0 0.25rem 0.5rem rgba(10, 15, 40, 0.12);\r\n        padding: .5rem;\r\n    }\r\n\r\n.zugobodywithtotals {\r\n    /*padding-bottom: 41.5px;*/\r\n}\r\n\r\n@media (max-width: 576px) {\r\n    .zugobodywithtotals {\r\n        padding-bottom: 0;\r\n    }\r\n}\r\n\r\n@media (min-width: 800px) {\r\n\t.zugo-total-mobile.custom-d-md-none {\r\n\t\tdisplay: none !important;\r\n\t}\r\n\t.custom-d-md-block {\r\n\t\tdisplay: block !important;\r\n\t}\r\n}\r\n\r\n#zugoTotalRowTbl.table{\r\n\theight: 3rem;\r\n\tmargin-right: 30px;\r\n}\r\n\r\n/* change to small size */\r\n@media (max-width: 800px) {\r\n\r\n\t.panel.results-panel.apps-panel > *{\r\n\t\tpadding: 0px;\r\n\t}\r\n}\r\n\r\n/* Reduce all app icons to fit in cols*/\r\n@media (max-width: 432px) {\r\n\r\n\t.apps-panel-box {\r\n\t\twidth: 10rem;\r\n\t}\r\n}\r\n\r\n@media (max-width: 591px) {\r\n\r\n\tdiv#allAppsPanel {\r\n\t\tjustify-content: center;\r\n\t\tjustify-content: space-evenly;\r\n\t}\r\n/*\t\tdiv#allAppsPanel::after {\r\n\t\t\tcontent: \"\";\r\n\t\t\tflex: auto;\r\n\t\t}*/\r\n}\r\n\r\n.zugo-total-container {\r\n\tposition: relative;\r\n\tdisplay: block;\r\n\theight: 3rem;\r\n\tflex-shrink: 0;\r\n\tpadding: 0 0.5rem;\r\n\t/*overflow: hidden;*/\r\n\tmargin: 2px 0px;\r\n\tbackground: var(--section-background);\r\n}\r\n\r\n#zugoTotalRowTbl tr th:hover{\r\n\tbackground-color:none;\r\n}\r\n\r\n.zugo-total {\r\n\toverflow: hidden;\r\n}\r\n\r\n    .zugo-total thead{\r\n        background: 0;\r\n    }\r\n\r\n    .zugo-total-mobile {\r\n        padding: 8px;\r\n        padding-bottom: 3.5rem;\r\n    }\r\n\r\n.zugo-total-mobile-span {\r\n    color: var(--table-footer-color);\r\n    width: 9rem;\r\n    font-size: 14px;\r\n}\r\n\r\n.hiddenTotal {\r\n    color: var(--muted);\r\n}\r\n\r\n.data-grid-container {\r\n    height: 100%;\r\n    display: flex;\r\n    flex-direction: column;\r\n}\r\n\r\n.search-container,\r\ndiv[sng-zugo],\r\n.zugo-container,\r\n.zugo-body {\r\n    height: 100%;\r\n\tflex: 1 1 auto;\r\n}\r\n\r\n.zugo-container {\r\n    display: flex;\r\n    flex-direction: column;\r\n    padding: .5rem 1.5rem 1rem;\r\n}\r\n\r\n.zugo-body-container {\r\n\tpadding: .5rem;\r\n\tflex: 1 1 auto;\r\n\t/*z-index: -1;*/\r\n}\r\n\r\n.zugo-container-size {\r\n    min-height: 0;\r\n}\r\n\r\n.zugo-header ~ .zugo-body {\r\n    flex-grow: 1;\r\n    overflow-y: auto;\r\n    position: relative;\r\n    overflow-x: hidden;\r\n}\r\n\r\n/*\r\n    Stacking required for fixed header feature in zugo grids:\r\n    - body\r\n        |- container within body for tables\r\n           | - table with fixed header\r\n    Some apps are overriding these stacking\r\n    via cascade e.g. files app, so this has increased specificity\r\n*/\r\ndiv[sng-zugo] .zugo-body {\r\n    position: relative;\r\n}\r\n\r\ndiv[sng-zugo] .fixed-table-container {\r\n    height: 100%;\r\n    position: static;\r\n}\r\n\r\ndiv[sng-zugo] .sng-fixed-table-header {\r\n    position: absolute;\r\n    z-index: 1;\r\n}\r\n\r\ndiv.zugo-body.zugobodywithtotals.zugobodywithdata .fixed-table-container.sng-results-container {\r\n\tdisplay: flex;\r\n\tflex-flow: wrap;\r\n\talign-content: flex-start;\r\n}\r\n\r\n\tdiv.zugo-body.zugobodywithtotals.zugobodywithdata .fixed-table-container.sng-results-container table.grid.table.scrollbar-check {\r\n\t\tflex: 1 1 100%;\r\n\t}\r\n\r\n.fixed-table-container table {\r\n\tmargin: 0;\r\n}\r\n\r\n.fixed-table-head,\r\n.fixed-table-body,\r\n.fixed-table-head thead,\r\n.fixed-table-body tbody {\r\n\twidth: 100%;\r\n}\r\n\r\n.fixed-table-head {\r\n    height: 2.5rem;\r\n}\r\n\r\n    .fixed-table-head thead th {\r\n        position: relative;\r\n    }\r\n\r\n.fixed-table-body {\r\n    height: calc(100% - 2.5rem);\r\n    overflow-y: auto;\r\n}\r\n\r\n.search-container > .fixed-table-head {\r\n    position: absolute;\r\n    top: 0;\r\n    width: auto;\r\n}\r\n\r\n.search-container > .fixed-table-head-no-controls {\r\n    position: absolute;\r\n    top: 0;\r\n    width: auto;\r\n}\r\n\r\n.sng-results-container {\r\n    height: 100%;\r\n    overflow-y: auto;\r\n}\r\n\r\n.zugo-header h1 {\r\n    white-space: nowrap;\r\n    overflow: hidden;\r\n    text-overflow: ellipsis;\r\n}\r\n\r\n.zugo-title {\r\n    flex-basis: 50%;\r\n}\r\n\r\n.zugo-title,\r\n.zugo-header .search-filter-container {\r\n    flex: 1 1 auto;\r\n    padding: .5rem .75rem;\r\n}\r\n\r\n.zugo-container .zugo-title,\r\n.zugo-container .zugo-header .search-filter-container {\r\n    padding: 0 0 0.5rem;\r\n}\r\n\r\n.zugo-header .search-filter-container {\r\n    align-items: center;\r\n    justify-content: right;\r\n    display: flex;\r\n    max-width: 40rem;\r\n}\r\n\r\n\t.zugo-header .search-filter-container .search-filter input[type=search] {\r\n\t\ttext-indent: 8px;\r\n\t}\r\n\r\n.zugo-title h1 {\r\n    margin: 0;\r\n    padding: 0 0 0.25rem;\r\n    font-size: 1.25rem;\r\n    color: var(--secure-primary-text);\r\n}\r\n\r\n.zugo-description {\r\n    color: var(--muted);\r\n}\r\n\r\n.zugo-body th .sort-icon,\r\n.dyno-table-body th .sort-icon {\r\n    margin-left: 0.5rem;\r\n    line-height: 1.5rem;\r\n    color: var(--secure-primary-text);\r\n    opacity: 0;\r\n    font-size: 0.875rem;\r\n    font-weight: bold;\r\n}\r\n\r\n\r\n.zugo-body th:hover .sort-icon,\r\n.dyno-table-body th:hover .sort-icon,\r\n.zugo-body th.sort-column .sort-icon,\r\n.dyno-table-body th.sort-column .sort-icon {\r\n    opacity: 0.6;\r\n}\r\n\r\n.page-header-searchbox .zugo-container > .zugo-header {\r\n    position: fixed;\r\n    top: 4rem;\r\n    width: 50%;\r\n    right: 0;\r\n    background: 0;\r\n    box-shadow: none;\r\n    z-index: 50;\r\n}\r\n\r\n    .page-header-searchbox .zugo-container > .zugo-header .zugo-title {\r\n        display: none;\r\n    }\r\n\r\n\r\n\r\n/**\r\n    sng-zugo-tracks component\r\n    Lists smart tracks links as actual links with <a> tags\r\n*/\r\nsng-zugo-tracks {\r\n    display: block;\r\n}\r\n\r\nsng-zugo-tracks a {\r\n    display: flex;\r\n    align-items: center;\r\n    border-radius: 1rem;\r\n    padding: .375rem .75rem;\r\n    transition: background 0.2s ease;\r\n    color: var(--secure-primary-text);\r\n    text-decoration: none;\r\n}\r\n\r\nsng-zugo-tracks a:focus .zugo-track-name,\r\nsng-zugo-tracks a:hover .zugo-track-name {\r\n    text-decoration: underline;\r\n}\r\n\r\nsng-zugo-tracks a:focus,\r\nsng-zugo-tracks a:hover {\r\n    box-shadow: none;\r\n    outline: none;\r\n    text-decoration: none;\r\n    cursor: pointer;\r\n}\r\n\r\n.zugo-track-row button,\r\n.zugo-track-row a {\r\n    display: flex;\r\n    align-items: center;\r\n    border-radius: 1rem;\r\n    padding: .375rem .75rem;\r\n    transition: background 0.2s ease;\r\n    color: var(--secure-primary-text);\r\n    text-decoration: none;\r\n}\r\n\r\n.zugo-track-row a:focus .zugo-track-name,\r\n.zugo-track-row a:hover .zugo-track-name {\r\n    text-decoration: underline;\r\n}\r\n\r\n.zugo-track-row button:focus,\r\n.zugo-track-row button:hover {\r\n    box-shadow: none;\r\n    outline: none;\r\n    text-decoration: none;\r\n    cursor: pointer;\r\n}\r\n\r\nsng-zugo-tracks button {\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\tborder-radius: 1rem;\r\n\tpadding: .375rem .75rem;\r\n\ttransition: background 0.2s ease;\r\n\tcolor: $(Navy);\r\n}\r\n\r\nsng-zugo-tracks button:focus,\r\nsng-zugo-tracks button:hover {\r\n\tbox-shadow: none;\r\n\toutline: none;\r\n\ttext-decoration: none;\r\n\tcursor: pointer;\r\n}\r\n\r\n.zugo-track-row button {\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\tborder-radius: 1rem;\r\n\tpadding: .375rem .75rem;\r\n\ttransition: background 0.2s ease;\r\n\tcolor: $(Navy);\r\n}\r\n\r\n.zugo-track-row button:focus,\r\n.zugo-track-row button:hover {\r\n\tbox-shadow: none;\r\n\toutline: none;\r\n\ttext-decoration: none;\r\n\tcursor: pointer;\r\n}\r\n\r\n.zugo-row-factboard-selected {\r\n    background-color: rgba(var(--primary-rgb), 0.125);\r\n}\r\n\r\n    .zugo-row-factboard-selected > td {\r\n        background-color: rgba(var(--primary-rgb), 0.125) !important;\r\n    }\r\n\r\n.zugo-search-description {\r\n    display: inline-block;\r\n    color: var(--muted);\r\n    vertical-align: middle;\r\n    font-size: small;\r\n    margin-left: 0.5rem;\r\n    font-weight: bold;\r\n}\r\n\r\n.zugo-title-wrapper {\r\n    padding-bottom: 0.25rem;\r\n    display: flex;\r\n    align-items: center;\r\n}\r\n\r\n.variable-help-text {\r\n    color: var(--success);\r\n}\r\n\r\n.total-box {\r\n\tborder-bottom: none !important;\r\n\ttext-align: right;\r\n\tpadding-right: 0.75rem !important;\r\n}\r\n\r\n.zugo-total th:last-child {\r\n\tleft: -0.5rem;\r\n}\n\n/* ========================================\n * Source: Components/src/styles/Cpf/Content/Styles/new/print-media.css\n * ======================================== */\n\n/*\r\n\tGeneric print styles across the application\r\n*/\r\n@media print {\r\n\tbody {\r\n\t\t-webkit-hyphens: auto;\r\n\t\t-moz-hyphens: auto;\r\n\t\t-ms-hyphens: auto;\r\n\t\thyphens: auto;\r\n\t\t/* Ensure the colors are rendered as they appear on the screen */\r\n\t\t-webkit-print-color-adjust: exact !important;\r\n\t\tprint-color-adjust: exact !important;\r\n\t}\r\n\r\n\tbody,\r\n\t#scroll-content,\r\n\t.app-container {\r\n\t\toverflow: visible !important;\r\n\t\theight: auto !important;\r\n\t}\r\n\r\n\tbody, #scroll-content, #page, #main-toolbar {\r\n\t\tbackground: #ebf1f7;\r\n\t}\r\n\r\n\t.flex-container,\r\n\t#page,\r\n\t.flex-body,\r\n\t.app-container {\r\n\t\toverflow: visible;\r\n\t\theight: auto;\r\n\t\twidth: auto !important;\r\n\t}\r\n\r\n\t.app-menu-top {\r\n\t\tbox-shadow: none;\r\n\t}\r\n\r\n\t#riddon-button-wrapper {\r\n\t\tflex-wra