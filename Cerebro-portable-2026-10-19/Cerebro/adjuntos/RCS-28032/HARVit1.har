\n\t\t.sng-expression-picker .single-option.medium {\r\n\t\t\tpadding: 2.25rem 0.725rem;\r\n\t\t}\r\n\r\n\t.sng-expression-picker .select-wrapper:last-child,\r\n\t.sng-expression-picker .select-wrapper:last-child select {\r\n\t\t-webkit-border-top-left-radius: 0;\r\n\t\t-webkit-border-bottom-left-radius: 0;\r\n\t\t-moz-border-radius-topleft: 0;\r\n\t\t-moz-border-radius-bottomleft: 0;\r\n\t\tborder-top-left-radius: 0;\r\n\t\tborder-bottom-left-radius: 0;\r\n\t}\r\n\r\n\t.sng-expression-picker.with-options input,\r\n\t.sng-expression-picker.with-options textarea.medium,\r\n\t.sng-expression-picker .select-wrapper:last-child {\r\n\t}\r\n\r\n\t.sng-expression-picker .select-wrapper:last-child {\r\n\t\twidth: 100% !important;\r\n\t\tborder-left: 1px solid var(--section-border);\r\n\t}\r\n\r\n\t.sng-expression-picker input.compact {\r\n\t\twidth: 100%;\r\n\t}\r\n\r\n\t/*.sng-expression-picker.with-options textarea,*/\r\n\r\n\t.sng-expression-picker button {\r\n\t\tpadding: .375rem 0.84rem;\r\n\t\tmin-width: initial;\r\n\t}\r\n\r\n\t.sng-expression-picker.expression-picker-expanded {\r\n\t\tmargin-top: 18px;\r\n\t}\r\n\r\n.expression-builder-term {\r\n\tpadding: 0.25rem .5rem;\r\n\tdisplay: inline-block;\r\n\tborder: 1px solid var(--section-border);\r\n\tmargin: 0;\r\n}\r\n\r\n\t.expression-builder-term + .expression-builder-term {\r\n\t\tborder-left: 0;\r\n\t}\r\n\r\n.expression-builder-wrapper {\r\n\tborder: 1px solid var(--modal-border);\r\n\tborder-radius: .25rem;\r\n\tmin-height: 2.25rem;\r\n\tpadding: .25rem;\r\n\tfont-size: 1rem;\r\n\toverflow: auto;\r\n}\r\n\r\n.warning {\r\n\tcolor: var(--warning-secure);\r\n}\r\n\r\n/* Alert classes */\r\n\r\n.alert-warning,\r\n.alert-danger,\r\n.alert-success {\r\n\tcolor: inherit;\r\n\tbackground: 0;\r\n\tpadding: .5rem .5rem .5rem 3.5rem;\r\n\tposition: relative;\r\n}\r\n\r\n.alert-warning {\r\n\tborder: 1px solid var(--warning-secure);\r\n}\r\n\r\n.alert-success {\r\n\tborder: 1px solid var(--success);\r\n}\r\n\r\n.alert-danger {\r\n\tborder: 1px solid var(--danger-secure);\r\n}\r\n\r\n\t.alert-warning:before,\r\n\t.alert-danger:before,\r\n\t.alert-success:before {\r\n\t\tfont-family: 'Font Awesome 6 Pro';\r\n\t\tposition: absolute;\r\n\t\tleft: 1rem;\r\n\t\ttop: .5rem;\r\n\t\tfont-size: 1.5rem;\r\n\t}\r\n\r\n.alert-warning:before {\r\n\tcontent: '\\f06a';\r\n\tcolor: var(--warning-secure);\r\n}\r\n\r\n.alert-success:before {\r\n\tcontent: '\\f00c';\r\n\tcolor: var(--success);\r\n}\r\n\r\n.alert-danger:before {\r\n\tcontent: '\\f071';\r\n\tcolor: var(--danger-secure);\r\n}\r\n\r\n.no-trim {\r\n\twhite-space: pre;\r\n}\r\n\r\n\r\n\r\n.inline-block {\r\n\tdisplay: inline-block !important;\r\n}\r\n\r\n.image-popper-wrapper {\r\n\tposition: fixed;\r\n\tz-index: 1004;\r\n\tbackground: var(--background);\r\n\tborder: 1px solid var(--section-border);\r\n\tbox-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);\r\n}\r\n\r\n\t.image-popper-wrapper:hover {\r\n\t\tcursor: move;\r\n\t}\r\n\r\n\t.image-popper-wrapper.popper-popin {\r\n\t\tanimation: 200ms zoomIn ease;\r\n\t}\r\n\r\n\t.image-popper-wrapper.popper-popout {\r\n\t\tanimation: 200ms zoomOut ease;\r\n\t}\r\n\r\n.image-popper-close {\r\n\tfloat: right;\r\n\tpadding: 0.25rem;\r\n}\r\n\r\n\t.image-popper-close:hover {\r\n\t\tcursor: pointer;\r\n\t}\r\n\r\n.image-popper-content {\r\n\tborder-top: 1px solid var(--section-border);\r\n}\r\n\r\n\r\n\r\n/* Extended Properties */\r\n\r\n.category-title {\r\n\twhite-space: nowrap;\r\n\tmargin-bottom: .5rem;\r\n\tpadding-bottom: 0;\r\n}\r\n\r\n.category-rows {\r\n}\r\n\r\n.category-content {\r\n\tpadding: 0 0 .75rem;\r\n}\r\n\r\n\t.category-content + .category-content {\r\n\t\tborder-top: 1px solid var(--border-light);\r\n\t\tpadding-top: .75rem;\r\n\t}\r\n\r\n.margin-sides-10pct {\r\n\tmargin-left: 10%;\r\n\tmargin-right: 10%;\r\n}\r\n\r\n.margin-sides-5pct {\r\n\tmargin-left: 5%;\r\n\tmargin-right: 5%;\r\n}\r\n\r\n/* Tags\r\n*/\r\n.tag {\r\n\tbackground: rgba(var(--muted-rgb), 0.1);\r\n\tdisplay: inline-block;\r\n\tpadding: 0.125rem 0.25rem;\r\n\tfont-weight: bold;\r\n\tborder-radius: 0.25rem;\r\n\tfont-size: 0.75rem;\r\n\tline-height: 0.875rem;\r\n\tcolor: var(--muted);\r\n\tborder-radius: 1rem;\r\n}\r\n\r\n\t.tag + .tag {\r\n\t\tmargin-left: .25rem;\r\n\t}\r\n\r\n\t.tag.clickable {\r\n\t\tcursor: pointer;\r\n\t}\r\n\r\n\t.tag.clickable,\r\n\t.tag.tag-accent {\r\n\t\tbackground: rgba(var(--primary-rgb), 0.1);\r\n\t\tcolor: var(--secure-primary-text);\r\n\t}\r\n\r\n\t.tag.tag-warning {\r\n\t\tbackground: rgba(var(--warning-rgb), 0.1);\r\n\t\tcolor: var(--warning-text);\r\n\t}\r\n\r\n\t.tag.tag-success {\r\n\t\tbackground: rgba(var(--success-rgb), 0.1);\r\n\t\tcolor: var(--success-secure);\r\n\t}\r\n\r\n\t.tag.tag-danger {\r\n\t\tbackground: rgba(var(--danger-rgb), 0.1);\r\n\t\tcolor: var(--danger-text);\r\n\t}\r\n\r\n\r\n/* Section and box code */\r\n\r\n.dyno-control.nav-item {\r\n\tbackground: none;\r\n}\r\n\r\n.section:not(:last-child) {\r\n\tmargin-bottom: 1rem;\r\n}\r\n\r\n.clickable {\r\n\tcursor: pointer;\r\n\tposition: relative;\r\n}\r\n\r\n.box.clickable {\r\n\tcolor: var(--secure-primary-text);\r\n}\r\n\r\n\t.box.clickable:after,\r\n\t.info-tile .clickable:after {\r\n\t\t-ms-transition: opacity 0.2s ease;\r\n\t\t-moz-transition: opacity 0.2s ease;\r\n\t\t-webkit-transition: opacity 0.2s ease;\r\n\t\ttransition: opacity 0.2s ease;\r\n\t\tdisplay: block;\r\n\t\tcontent: '';\r\n\t\tposition: absolute;\r\n\t\tleft: 0;\r\n\t\ttop: 0;\r\n\t\twidth: 100%;\r\n\t\theight: 100%;\r\n\t\tbackground: rgba(var(--primary-rgb), 0.2);\r\n\t\topacity: 0;\r\n\t\tz-index: 0;\r\n\t\tborder-radius: 1rem;\r\n\t\tpointer-events: none;\r\n\t}\r\n\r\n\t.box.clickable:hover,\r\n\t.box.clickable:focus,\r\n\t.box.clickable:active {\r\n\t\ttext-decoration: none;\r\n\t}\r\n\r\n\t\t.box.clickable:hover:after,\r\n\t\t.info-tile .clickable:hover:after {\r\n\t\t\topacity: 1;\r\n\t\t}\r\n\r\n\t.box.clickable:active,\r\n\t.info-tile .clickable:active {\r\n\t\tbox-shadow: 0 0 0 2px rgba(var(--primary-rgb), 0.5);\r\n\t}\r\n\r\n\t.box.clickable:focus,\r\n\t.info-tile .clickable:focus {\r\n\t\toutline: 0;\r\n\t\tbox-shadow: 0 0 0 2px rgba(var(--primary-rgb), .5);\r\n\t\tz-index: 1;\r\n\t}\r\n\r\n\t.box.clickable.selected {\r\n\t\tcursor: default;\r\n\t}\r\n\r\n.section .section {\r\n\tbox-shadow: none;\r\n}\r\n\r\n.stepwise-container {\r\n\tpadding: 1rem;\r\n}\r\n/* Section */\r\n.section-scroll {\r\n\toverflow-y: auto;\r\n}\r\n\r\n.section-title {\r\n\tborder-radius: 1rem 1rem 0 0;\r\n\tpadding: 1rem;\r\n\tfont-size: 1.25rem;\r\n\tfont-weight: bold;\r\n}\r\n\r\n.toggle-section-title {\r\n\ttext-transform: initial;\r\n\tfont-weight: bold;\r\n}\r\n\r\n.toggle-section.disabled .toggle-section-title {\r\n\tcolor: var(--text-disabled);\r\n}\r\n\r\n.toggle-section-title .title-text {\r\n\tmax-width: calc(100% - 10rem);\r\n\tdisplay: inline-block;\r\n}\r\n\r\n\r\n.section-order-number {\r\n\tposition: relative;\r\n\tfloat: left;\r\n\tpadding-right: .5rem;\r\n\tmargin-right: .75rem;\r\n\tcolor: var(--muted);\r\n\tfont-size: 1rem;\r\n\tfont-weight: bold;\r\n\ttext-align: center;\r\n\twidth: 2rem;\r\n}\r\n\r\n.title-wrapper .toggle {\r\n\tposition: relative;\r\n}\r\n\r\n\t.section-order-number:after,\r\n\t.title-wrapper .toggle:after {\r\n\t\tdisplay: block;\r\n\t\tcontent: '';\r\n\t\theight: calc(100% - .5rem);\r\n\t\tposition: absolute;\r\n\t\tright: 0;\r\n\t\ttop: .25rem;\r\n\t\tborder-right: 1px dotted var(--section-border);\r\n\t\topacity: .5;\r\n\t}\r\n\r\n.title-wrapper .toggle {\r\n\tfloat: left;\r\n\tmargin: 0 1rem 0 0;\r\n\tposition: relative;\r\n\tpadding-right: 1rem;\r\n}\r\n\r\n.section-help {\r\n\tpadding: .5rem;\r\n\tfont-size: .875rem;\r\n\ttext-transform: none;\r\n\tfont-weight: normal;\r\n\tbox-shadow: none;\r\n\tborder: 1px solid var(--section-border);\r\n\tpadding: .5rem;\r\n\tborder-radius: .5rem;\r\n}\r\n\r\n.section-content {\r\n\tpadding: 1rem;\r\n}\r\n\r\n.section-title + .section-content,\r\n.subsection-title + .section-content {\r\n\tpadding-top: 0;\r\n}\r\n\r\n.fact-board-background {\r\n\tbackground: var(--section-background) !important;\r\n}\r\n\r\n/* Wizard */\r\n\r\n.wizard {\r\n\tpadding: 1rem;\r\n\tmargin-bottom: 1rem;\r\n}\r\n\r\n.wizard-header {\r\n\tdisplay: flex;\r\n\twidth: 100%;\r\n}\r\n\r\n\t.wizard-header > div:nth-child(2) {\r\n\t\twhite-space: nowrap;\r\n\t\ttext-align: center;\r\n\t\tflex-grow: 1;\r\n\t\tpadding: .25rem 0;\r\n\t}\r\n\r\n\t\t.wizard-header > div:nth-child(2) > div {\r\n\t\t\tdisplay: inline-block;\r\n\t\t}\r\n\r\n.wizard .progress {\r\n\twidth: 100%;\r\n\theight: .25rem;\r\n\tmargin: .5rem 0 1rem;\r\n}\r\n\r\n\r\n.wizard-progress {\r\n\tdisplay: none;\r\n}\r\n\r\n\r\n.wizard-steps {\r\n\tmargin-bottom: 1.5rem;\r\n\tdisplay: table;\r\n\twidth: 100%;\r\n\tborder-bottom: 3px dotted var(--section-border);\r\n\theight: .6125rem;\r\n}\r\n\r\n\t.wizard-steps > div {\r\n\t\tposition: relative;\r\n\t\tcursor: pointer;\r\n\t}\r\n\r\n\t\t.wizard-steps > div:before,\r\n\t\t.wizard-steps > div:after {\r\n\t\t\tdisplay: block;\r\n\t\t\tcontent: '';\r\n\t\t}\r\n\r\n\t\t.wizard-steps > div:before {\r\n\t\t\twidth: 100%;\r\n\t\t\theight: .25rem;\r\n\t\t\tmargin-top: .375rem;\r\n\t\t}\r\n\r\n\t\t.wizard-steps > div:after {\r\n\t\t\tposition: absolute;\r\n\t\t\ttop: 0;\r\n\t\t\tleft: 50%;\r\n\t\t\twidth: 1rem;\r\n\t\t\theight: 1rem;\r\n\t\t\tbackground: var(--background);\r\n\t\t\tborder: 0;\r\n\t\t\toutline: none;\r\n\t\t\tborder-radius: .5rem;\r\n\t\t\tz-index: 1;\r\n\t\t}\r\n\r\n\t\t.wizard-steps > div.completed:after {\r\n\t\t\tbackground: var(--primary-base);\r\n\t\t}\r\n\r\n\t\t.wizard-steps > div.errors:after {\r\n\t\t\tbackground: var(--warning-secure) !important;\r\n\t\t\tcolor: var(--text-contrast);\r\n\t\t\tbox-shadow: 0 2px 8px rgba(var(--warning-rgb), 0.25);\r\n\t\t\tfont-family: 'Font Awesome 6 Pro';\r\n\t\t\tcontent: '\\21';\r\n\t\t\tline-height: 1rem;\r\n\t\t\ttext-indent: -1px;\r\n\t\t\tfont-size: .625rem;\r\n\t\t\ttext-align: center;\r\n\t\t}\r\n\r\n\t.wizard-steps > .uncomplete ~ .uncomplete {\r\n\t\tcursor: default;\r\n\t}\r\n\r\n\t.wizard-steps .uncomplete ~ div:after {\r\n\t\tbackground: var(--background);\r\n\t}\r\n\r\n\t.wizard-steps > div.selected:after {\r\n\t\tbox-shadow: 0 0 0 .25rem rgba(var(--primary-rgb),0.5);\r\n\t}\r\n\r\n\t.wizard-steps > div.completed.selected:after {\r\n\t\tbackground: var(--primary-base);\r\n\t}\r\n\r\n.wizard-steps {\r\n\tdisplay: flex;\r\n\twidth: 100%;\r\n}\r\n\r\n\t.wizard-steps > div {\r\n\t\tflex-grow: 1;\r\n\t}\r\n\r\n\t\t.wizard-steps > div:first-child,\r\n\t\t.wizard-steps > div:last-child {\r\n\t\t\tflex-grow: 0.5;\r\n\t\t}\r\n\r\n\t\t\t.wizard-steps > div:first-child:after {\r\n\t\t\t\tleft: 0;\r\n\t\t\t\tmargin: 0;\r\n\t\t\t}\r\n\r\n\t\t\t.wizard-steps > div:last-child:after {\r\n\t\t\t\tleft: auto;\r\n\t\t\t\tright: 0;\r\n\t\t\t\tmargin: 0;\r\n\t\t\t}\r\n\r\n\t\t.wizard-steps > div:only-child {\r\n\t\t\tflex-grow: 1;\r\n\t\t}\r\n\r\n\t\t\t.wizard-steps > div:only-child:after {\r\n\t\t\t\tleft: calc(50% - 0.5rem);\r\n\t\t\t\tright: auto;\r\n\t\t\t}\r\n\r\n\r\n\r\n\r\n/* Collapsible panels */\r\n\r\n.dashboards-list {\r\n\tdisplay: flex;\r\n\tflex-wrap: wrap;\r\n\tpadding: .5rem;\r\n}\r\n\r\n.dashboards-category {\r\n\tpadding: .5rem;\r\n}\r\n\r\n.dashboards-panel {\r\n\twidth: 100%;\r\n\tpadding: 1rem;\r\n\tborder-radius: 0 0 .25rem .25rem;\r\n\tflex-wrap: wrap;\r\n}\r\n\r\n.dashboards-title {\r\n\tcolor: var(--default-text);\r\n\tpadding: .5rem;\r\n\tmargin-bottom: 0;\r\n\tborder-bottom: 2px dotted var(--border-strong);\r\n\tfont-weight: bold;\r\n\tborder-radius: .25rem .25rem 0 0;\r\n}\r\n\r\n\r\n/* Dashboard homepage buttons */\r\n\r\n.dashboard-button {\r\n\tpadding: 2rem;\r\n\tdisplay: inline-block;\r\n\ttext-align: center;\r\n\twidth: 14rem;\r\n\tborder-radius: 1.75rem\r\n}\r\n\r\n\t.dashboard-button .title {\r\n\t\twhite-space: nowrap;\r\n\t\toverflow: hidden;\r\n\t\ttext-overflow: ellipsis;\r\n\t\tcolor: var(--muted);\r\n\t}\r\n\r\n/* Context overlay */\r\n\r\n.context-item,\r\nbody.factboard-select .factboard-addable {\r\n\tposition: relative;\r\n\tbox-shadow: 0 0 0 2px var(--primary-base);\r\n\tborder-radius: .25rem;\r\n\tborder-bottom-right-radius: 0;\r\n}\r\n\r\n\t.context-item.context-item-success,\r\n\tbody.factboard-select .factboard-item-selected,\r\n\tbody.factboard-select .factboard-item-added {\r\n\t\tbox-shadow: 0 0 0 2px var(--success);\r\n\t}\r\n\r\n\t.context-item.context-item-warning {\r\n\t\tbox-shadow: 0 0 0 2px var(--warning-secure);\r\n\t}\r\n\r\n\t.context-item.context-item-danger {\r\n\t\tbox-shadow: 0 0 0 2px var(--danger-secure);\r\n\t}\r\n\r\n\t.context-item.context-item-secondary {\r\n\t\tbox-shadow: 0 0 0 2px var(--secure-primary-text);\r\n\t}\r\n\r\n\t.context-item.context-item-muted {\r\n\t\tbox-shadow: 0 0 0 2px var(--muted);\r\n\t}\r\n\r\n.context-item-btn {\r\n\tposition: absolute;\r\n\tright: -2px;\r\n\ttop: 100%;\r\n\tmargin-top: 1px;\r\n\tbackground: rgba(var(--primary-rgb), 0.25);\r\n\twidth: 1.25rem;\r\n\theight: 1.25rem;\r\n\tz-index: 1;\r\n\tborder-radius: 0 0 .25rem .25rem;\r\n\tcolor: var(--secure-primary-text) !important;\r\n}\r\n\r\n\t.context-item-btn .fa,\r\n\t.factboard-addable .context-item-btn .fa {\r\n\t\tpadding: 0;\r\n\t\tmargin: 0;\r\n\t\tcolor: var(--secure-primary-text) !important;\r\n\t}\r\n\r\n\r\n.factboard-item-selected > .context-item-btn,\r\n.context-item-success .context-item-btn {\r\n\tbackground: var(--success);\r\n}\r\n\r\n.context-item-warning .context-item-btn {\r\n\tbackground: var(--warning-secure);\r\n}\r\n\r\n.context-item-danger .context-item-btn {\r\n\tbackground: var(--danger-secure);\r\n}\r\n\r\n.context-item-secondary .context-item-btn {\r\n\tbackground: var(--secure-primary-text);\r\n\tcolor: var(--text-contrast-secondary);\r\n}\r\n\r\n.context-item-muted .context-item-btn {\r\n\tbackground: var(--muted);\r\n}\r\n\r\n/* Fact board specific */\r\n\r\n/* Fix for issue with html2canvas which prints both characters of a ligature over each other */\r\n.factboard-rendering {\r\n\tfont-feature-settings: \"liga\" 0;\r\n\t-ms-font-feature-settings: \"liga\" 0;\r\n\tletter-spacing: 0;\r\n}\r\n\r\nhtml.factboard-rendering {\r\n\toverflow: visible;\r\n\tmin-height: 100vh;\r\n\theight: auto;\r\n}\r\n\r\n\thtml.factboard-rendering body {\r\n\t\theight: 100%;\r\n\t\tmin-height: 100vh;\r\n\t\tposition: relative;\r\n\t\toverflow: visible;\r\n\t}\r\n\r\nbody:not(.factboard-select) .factboard-addable .context-item-btn {\r\n\tdisplay: none;\r\n}\r\n\r\n/**\r\n    when capturing page do not crop the height\r\n*/\r\n.factboard-rendering body,\r\nbody.factboard-creator-active {\r\n\theight: 100%;\r\n\tmin-height: 100vh;\r\n\tposition: relative;\r\n\toverflow: visible;\r\n}\r\n\r\n\t/**\r\n    when captureing page make sure that visible alerts are not captured\r\n*/\r\n\t.factboard-rendering body .alert-vis,\r\n\t.factboard-rendering body #alert,\r\n\tbody.factboard-creator-active .alert-vis,\r\n\tbody.factboard-creator-active #alert {\r\n\t\tdisplay: none !important;\r\n\t}\r\n/**\r\n    when capturing page do not crop the height\r\n*/\r\n.factboard-creator-active .scroll-content {\r\n\tmin-height: 100%;\r\n\toverflow: visible;\r\n}\r\n\r\n/*\r\n   These below two rules are set by the object that actually\r\n   captures the item from the page within factboard service\r\n   a.k.a. content creator\r\n   If we are capturing nested -addable- items, allow creator\r\n   to not capture internal addable-artefacts\r\n*/\r\n.factboard-creator-active .factboard-addable {\r\n\tbox-shadow: none !important;\r\n}\r\n\r\n/**\r\n    hides scrollable headers during factboard screenshot creation\r\n*/\r\n.factboard-creator-active .zugo-container table.fixed-table-header {\r\n\tdisplay: none !important;\r\n}\r\n/**\r\n    Hides load more item in zugo grid during factboard screenshot creation\r\n*/\r\n.factboard-creator-active .zugo-container .load-indicator-mini {\r\n\tdisplay: none !important;\r\n}\r\n\r\n.factboard-creator-active .factboard-addable .context-item-btn {\r\n\tdisplay: none !important;\r\n}\r\n\r\n.factboard-addable > .context-item-btn span:before {\r\n\tcontent: '\\f067';\r\n}\r\n\r\n.factboard-item-selected > .context-item-btn span:before {\r\n\tcontent: '\\f068';\r\n}\r\n\r\n/* Fti watch */\r\n\r\n.watch-item {\r\n\tbox-shadow: 0 0 0 .125rem rgba(var(--warning-rgb), 0.5);\r\n\tmargin: 0 .125rem .375rem;\r\n\tborder-radius: .25rem;\r\n\tpadding: 0 1.5rem 0 .125rem;\r\n\tposition: relative;\r\n}\r\n\r\n\t.watch-item:last-child {\r\n\t\tmargin-bottom: 0;\r\n\t}\r\n\r\nspan.watch-item {\r\n\tdisplay: inline-block;\r\n}\r\n\r\n.watch-btn {\r\n\tdisplay: block;\r\n\tposition: absolute;\r\n\ttop: .24rem;\r\n\tright: .125rem;\r\n\tpadding: 0 .125rem;\r\n\tborder-radius: .25rem;\r\n\tcolor: var(--warning-secure);\r\n\tz-index: 0;\r\n\tline-height: 1rem;\r\n}\r\n\r\n\t.watch-btn:hover {\r\n\t\tbackground: rgba(var(--warning-rgb), 0.2);\r\n\t}\r\n\r\n/* Reports app */\r\n\r\n.report-age {\r\n\tpadding: .375rem 1rem 0;\r\n\tfont-size: .875rem;\r\n}\r\n\r\n.static-header {\r\n\tbackground: var(--section-border);\r\n\tborder: 2px solid var(--table-row);\r\n\tpadding: .5rem;\r\n\tborder-radius: .25rem;\r\n}\r\n\r\n\t.static-header h1, .static-header h2 {\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\r\n\r\n.confirm-menu {\r\n\twhite-space: pre;\r\n\tpadding: .5rem;\r\n\tfont-size: 1rem;\r\n}\r\n\r\n\t.confirm-menu .btn {\r\n\t\tmargin-left: 1rem;\r\n\t}\r\n\r\n\r\n/*  Sticky navigation bar */\r\n\r\n.sticky-bar {\r\n\tposition: relative;\r\n}\r\n\r\n\t.sticky-bar.sticky-bar-fixed {\r\n\t\tposition: fixed;\r\n\t\tz-index: 3;\r\n\t}\r\n\r\n.pdf-export-button {\r\n\tmin-width: 150px;\r\n}\r\n\r\n/* Video */\r\n.embed-responsive-item.video-js:not(-webkit-full-screen) {\r\n\tz-index: 1;\r\n}\r\n\r\n.cctv-no-video {\r\n\tflex: 1;\r\n\tbackground: var(--muted);\r\n\tcolor: white;\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n\tjustify-content: center;\r\n\twidth: 100%;\r\n\talign-items: center;\r\n\tgap: 1rem;\r\n}\r\n\r\n/* impersonating-notification */\r\n#impersonating-notification {\r\n\ttext-align: left;\r\n\tpadding: 1px;\r\n\tdisplay: flex;\r\n\tjustify-content: center;\r\n\talign-items: center;\r\n\theight: 2.5rem;\r\n\tbackground: rgba(var(--primary-rgb), 0.2);\r\n\tbox-shadow: inset -4px 0 10px 1px rgba(10,50,70,0.13);\r\n}\r\n\r\n\t#impersonating-notification .fs-selected button.fa.fa-remove {\r\n\t\tdisplay: none;\r\n\t}\r\n\r\n.completed-container {\r\n\tdisplay: -ms-flexbox;\r\n\tdisplay: flex;\r\n\theight: 0.5rem;\r\n\toverflow: hidden;\r\n\tfont-size: .75rem;\r\n\tbackground-color: #e9ecef;\r\n\tborder-radius: 0.25rem;\r\n\tmax-width: 18rem;\r\n\tmargin: 0.5rem;\r\n}\r\n\r\n.completed-progress-bar {\r\n\tdisplay: -ms-flexbox;\r\n\tdisplay: flex;\r\n\t-ms-flex-direction: column;\r\n\tflex-direction: column;\r\n\t-ms-flex-pack: center;\r\n\tjustify-content: center;\r\n\tcolor: #fff;\r\n\ttext-align: center;\r\n\twhite-space: nowrap;\r\n\tbackground-color: rgb(44, 160, 0);\r\n\ttransition: width .6s ease;\r\n}\r\n\r\n/* Error viewer */\r\n#error-viewer {\r\n\tmargin: 20px;\r\n}\r\n\r\n\t#error-viewer .row {\r\n\t\tmargin-bottom: 15pt;\r\n\t}\r\n\r\n#ie-not-supported-login {\r\n\tdisplay: none;\r\n\tbackground-color: #ededbc;\r\n\tborder: 1px solid #d9d348;\r\n\tpadding: 10px;\r\n\t-webkit-box-shadow: 7px 7px 14px 3px rgba(199,199,199,0.93);\r\n\tbox-shadow: 7px 7px 14px 3px rgba(199,199,199,0.93);\r\n}\r\n\r\n\t#ie-not-supported-login p {\r\n\t\tpadding: 10px;\r\n\t}\r\n\r\n#ie-not-supported {\r\n\tdisplay: none;\r\n\tbackground-color: #ededbc;\r\n\tborder: 1px solid #d9d348;\r\n\tpadding: 10px;\r\n\twidth: 90%;\r\n\tposition: fixed;\r\n\tbottom: 10px;\r\n\tfont-size: 0.8rem;\r\n\t-webkit-box-shadow: 7px 7px 14px 3px rgba(199,199,199,0.93);\r\n\tbox-shadow: 7px 7px 14px 3px rgba(199,199,199,0.93);\r\n}\r\n\r\n#ie-dismiss {\r\n\tfloat: right;\r\n}\r\n\r\n#ie-not-supported p {\r\n\tpadding: 5px;\r\n}\r\n\r\napp-hierarchy {\r\n\tdisplay: block;\r\n}\r\n\r\n/* Cpf Tour */\r\n.tour-overlay {\r\n\tz-index: 990;\r\n}\r\n\r\n.tour-preview-container {\r\n\tz-index: 99999;\r\n\tpadding: 1rem;\r\n\tmargin: -1rem;\r\n\tbackground: white;\r\n\tborder-radius: 2rem;\r\n\toutline: 4px solid rgba(255, 255, 255, 0.2);\r\n}\r\n\r\n.tour-desc-box {\r\n\tposition: fixed;\r\n\tz-index: 999999;\r\n\ttop: 2rem;\r\n\twidth: 30rem;\r\n\tpadding: 1rem;\r\n}\r\n\r\n#tour-close {\r\n\tmin-width: auto;\r\n}\r\n\r\n.tour-desc-buttons {\r\n\tpadding-top: 1rem;\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n}\r\n\r\n\t.tour-desc-buttons > * {\r\n\t\tflex: 1;\r\n\t\ttext-align: center;\r\n\t}\r\n\r\n\r\n\r\n\r\n.fade-in {\r\n\tanimation: fade-in .75s;\r\n}\r\n\r\n.factboard-rendering .fade-in {\r\n\tanimation: none;\r\n}\r\n\r\n.fade-out {\r\n\tanimation: fade-out .75s;\r\n}\r\n\r\n.skeleton-overlay {\r\n\tposition: absolute;\r\n\tinset: 0;\r\n\tz-index: 50;\r\n\tpointer-events: auto;\r\n}\r\n\r\n.skeleton {\r\n\tposition: relative;\r\n\toverflow: hidden;\r\n\tborder-radius: .4rem;\r\n\tbackground: var(--skeleton-background);\r\n}\r\n\r\n\t.skeleton::before {\r\n\t\tcontent: '';\r\n\t\tdisplay: block;\r\n\t\tposition: absolute;\r\n\t\tleft: -150px;\r\n\t\ttop: 0;\r\n\t\theight: 100%;\r\n\t\twidth: 150px;\r\n\t\tbackground: linear-gradient(90deg,  var(--skeleton-background) 0%, var(--skeleton-background-highlight) 50%,  var(--skeleton-background) 100%);\r\n\t\tanimation: load 1s cubic-bezier(0.4, 0.0, 0.2, 1) infinite;\r\n\t}\r\n\r\n\r\n/* --- keyframes --- */\r\n@keyframes load {\r\n\tfrom {\r\n\t\tleft: -150px;\r\n\t}\r\n\r\n\tto {\r\n\t\tleft: 100%;\r\n\t}\r\n}\r\n\r\n@keyframes fade-in {\r\n\t0% {\r\n\t\topacity: 0;\r\n\t}\r\n\r\n\t100% {\r\n\t\topacity: 1;\r\n\t}\r\n}\r\n\r\n@keyframes fade-out {\r\n\t0% {\r\n\t\topacity: 0;\r\n\t}\r\n\r\n\t100% {\r\n\t\topacity: 1;\r\n\t}\r\n}\r\n\r\n@keyframes zoomIn {\r\n\tfrom {\r\n\t\topacity: 0;\r\n\t\ttransform: scale3d(.3, .3, .3);\r\n\t}\r\n\r\n\t50% {\r\n\t\topacity: 1;\r\n\t}\r\n}\r\n\r\n@keyframes zoomOut {\r\n\tfrom {\r\n\t\topacity: 1;\r\n\t}\r\n\r\n\t50% {\r\n\t\topacity: 0;\r\n\t\ttransform: scale3d(.3, .3, .3);\r\n\t}\r\n\r\n\tto {\r\n\t\topacity: 0;\r\n\t}\r\n}\r\n\r\n\r\n/* *** Breakpoints *** */\r\n@media (min-width: 1400px) {\r\n\t.col-xxl-3 {\r\n\t\tflex: 0 0 auto;\r\n\t\twidth: 25%;\r\n\t}\r\n\t.col-xxl-4 {\r\n\t\tflex: 0 0 auto;\r\n\t\twidth: 33.33333333%;\r\n\t}\r\n}\r\n\r\n@media screen and (max-width: 1023px) {\r\n\t#alert,\r\n\t#forgot-password-alert,\r\n\t#refresh-results-box,\r\n\t.refresh-results-box {\r\n\t\tright: 0;\r\n\t}\r\n\r\n\t\t#alert.alert-vis,\r\n\t\t#refresh-results-box.alert-vis,\r\n\t\t.refresh-results-box.alert-vis {\r\n\t\t\tbottom: 3rem;\r\n\t\t}\r\n\r\n\r\n\t.alert-body {\r\n\t\tflex-wrap: wrap;\r\n\t\tmax-width: 95vw;\r\n\t}\r\n\r\n\r\n\t.asymetric-65 {\r\n\t\tflex-basis: 65%;\r\n\t}\r\n\r\n\t.asymetric-30 {\r\n\t\tflex-basis: 30%;\r\n\t}\r\n\r\n\r\n\tbody .col:only-child,\r\n\tbody [class^='col-']:only-child,\r\n\tbody [class*=' col-']:only-child,\r\n\tbody.landscape .col,\r\n\tbody.landscape [class^='col-'],\r\n\tbody.landscape [class*=' col-'] {\r\n\t\t-ms-flex-preferred-size: initial;\r\n\t\tflex-basis: auto;\r\n\t\tmax-width: none;\r\n\t}\r\n}\r\n\r\n.avoid-menu-activating {\r\n\tposition:fixed !important;\r\n\topacity: 0 !important;\r\n\toverflow: hidden !important;\r\n}\r\n\r\n@media only screen and (max-width: 991px) {\r\n\r\n\t/*Added for composer new search conditions specific to override the calc above*/\r\n\tdiv.compose-condition-item div.composer-accordion-popup.active.composer-accordion-popup-wide.avoid-menu-absolute {\r\n\t\tmax-width: 32rem;\r\n\t\tmin-width: 32rem;\r\n\t}\r\n\r\n\t.dd-menu, .sngfilter-menu, .composer-accordion-popup {\r\n\t\tmax-width: 32rem;\r\n\t}\r\n}\r\n\r\n@media only screen and (min-width: 800px) and (max-width: 991px) {\r\n\tdiv.icon-nav-btn-container .dropdown.open .dd-menu {\r\n\t\tleft: auto !important\r\n\t}\r\n}\r\n\r\n@media screen and (max-width: 799px) {\r\n\r\n\thtml, body {\r\n\t\tfont-size: 14px;\r\n\t}\r\n\r\n\t.app-container > .flex-body {\r\n\t\tpadding-bottom: 3.25rem;\r\n\t}\r\n\r\n\r\n\tbody .col:only-child,\r\n\tbody [class^='col-']:only-child,\r\n\tbody [class*=' col-']:only-child,\r\n\tbody.landscape .col,\r\n\tbody.landscape [class^='col-'],\r\n\tbody.landscape [class*=' col-'] {\r\n\t\t-ms-flex-preferred-size: initial;\r\n\t\tflex-basis: auto;\r\n\t\tmax-width: none;\r\n\t}\r\n}\r\n\r\n@media only screen and (max-width: 767px) {\r\n\r\n\t.composer-accordion-popup {\r\n\t\tmin-width: calc(100vw - 8rem);\r\n\t\tmax-width: calc(100vw - 8rem);\r\n\t}\r\n\r\n\t.form-stretch {\r\n\t\twidth: 100%\r\n\t}\r\n    .form-stretch .form-control {\r\n\t\twidth: 100%;\r\n    }\r\n\t.dd-menu, .sngfilter-menu, .composer-accordion-popup {\r\n\t\tmax-width: 26rem;\r\n\t}\r\n\r\n\t.avoid-menu {\r\n\t\tmax-width: 90vw;\r\n\t}\r\n\t/*Added for composer new search conditions specific*/\r\n\tdiv.compose-condition-item div.composer-accordion-popup.active.composer-accordion-popup-wide.avoid-menu-absolute .sngfilter-menu.avoid-menu.avoid-menu-fixed.pop-top.visible {\r\n\t\tmax-width: 24rem;\r\n\t}\r\n}\r\n\r\n@media screen and (max-width: 442px) {\r\n\t.location-hierarchy-flex {\r\n\t\tdisplay: block !important;\r\n\t}\r\n\r\n\t.location-hierarchy-level-m {\r\n\t\tmargin-left: 0px;\r\n\t\tmargin-top: 1rem;\r\n\t}\r\n}\r\n\r\n@media print {\r\n\t.no-print, .no-print * {\r\n\t\tdisplay: none !important;\r\n\t}\r\n}\r\n\r\n.app-container {\r\n\ttransition: margin-left 300ms ease;\r\n\tmargin-left: 0;\r\n}\r\n\r\nbody.secure-docked .flex-body {\r\n\tmargin-left: 400px;\r\n}\r\n\r\n/* Shift content when composer chat is docked - padding is set dynamically via JS */\r\nbody.secure-composer-docked {\r\n\ttransition: padding-left 0.2s ease;\r\n}\r\n\r\n\n\n/* ========================================\n * Source: Components/src/styles/Cpf/Content/Styles/new/n_navigation.css\n * ======================================== */\n\n/*\r\n    Header, secondary navigation and sidebars\r\n*/\r\n/* RESERVED Z-INDEX VALUES */\r\n.app-container {\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n\theight: 100vh;\r\n\twidth: 100%;\r\n\tposition: relative;\r\n\toverflow: hidden;\r\n}\r\n\r\n\r\n.app-menu {\r\n\tmin-height: 6rem;\r\n\tflex-shrink: 0;\r\n\tposition: relative;\r\n}\r\n\r\n.app-menu-bottom,\r\n.app-menu-top {\r\n\twidth: 100%;\r\n}\r\n\r\n\r\n.app-menu-top {\r\n\tmin-height: 3.25rem;\r\n\tdisplay: flex;\r\n\tbackground: var(--toolbar-background);\r\n\talign-items: start;\r\n\tbox-shadow: 0 2px 12px rgba(10,15,40,0.15);\r\n\tz-index: 60;\r\n\tposition: relative;\r\n}\r\n\r\n.app-menu-bottom {\r\n\tmin-height: 2.5rem;\r\n\tdisplay: flex;\r\n\tpadding: .5rem .5rem !important;\r\n}\r\n\r\n.teleport-bar {\r\n\tdisplay: none !important;\r\n\topacity: 0;\r\n\theight: 0;\r\n\toverflow: hidden;\r\n}\r\n\r\n.page-title-container {\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n}\r\n\r\n\r\n.page-title,\r\n.mobile-btn-large {\r\n\tfloat: left;\r\n\tposition: relative;\r\n}\r\n\r\n.mobile-btn-large {\r\n\tfont-size: 1.5rem;\r\n\tcolor: var(--secure-primary-text);\r\n\tpadding: 0 1rem;\r\n\tdisplay: none;\r\n\tposition: relative;\r\n\twidth: 1.28571429em;\r\n\tbox-sizing: content-box;\r\n\ttext-align: center;\r\n\tline-height: 3.25rem;\r\n\tmargin-right: 0;\r\n}\r\n\r\na.mobile-btn-large {\r\n\ttext-decoration: none;\r\n}\r\n\r\n\t.mobile-btn-large:disabled, .mobile-btn-large[disabled] {\r\n\t\tcolor: var(--text-disabled);\r\n\t}.page-title {\r\n\tfloat: left;\r\n\tpadding: 0 1rem;\r\n\tfont-size: 1.5rem;\r\n\tfont-weight: bold;\r\n\tline-height: 1.675rem;\r\n\tmax-width: 28rem;\r\n\twhite-space: nowrap;\r\n\toverflow: hidden;\r\n\ttext-overflow: ellipsis;\r\n\tflex-shrink: 0;\r\n\tmargin-top: -0.125rem;\r\n}\r\n\r\n\t.page-title:empty {\r\n\t\tdisplay: none;\r\n\t}\r\n\r\n\t\t.page-title:empty + .navbar-nav {\r\n\t\t\tpadding-left: .5rem;\r\n\t\t}\r\n\r\n\t.page-title.sm {\r\n\t\tfont-size: 1.125rem;\r\n\t\tpadding: .25rem 1.5rem;\r\n\t}\r\n\r\n.beta-icon {\r\n\tbackground-color: #ccc;\r\n\tborder-radius: 4px;\r\n\tcolor: #000;\r\n\tfont-size: 10px;\r\n\tmargin-left: 1px;\r\n\tpadding: 2px 5px;\r\n}\r\n\r\n.app-logo {\r\n\tmax-width: 12rem;\r\n\theight: 3.25rem;\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\toverflow: hidden;\r\n\tmargin: 0;\r\n\tfloat: left;\r\n\tpadding: 0 .5rem;\r\n\tflex-shrink: 0;\r\n}\r\n\r\n/* Dark logos hidden when no native dark logo; light logos hidden when one is active.\r\n   lores/hires responsive rules continue to apply naturally to whichever set is shown.\r\n   Rules are intentionally broad (no .app-logo scope) so they also apply within .receipt-logo. */\r\nhtml:not(.has-dark-logo) .logo-dark {\r\n\tdisplay: none;\r\n}\r\n\r\nhtml.has-dark-logo .logo-light {\r\n\tdisplay: none;\r\n}\r\n\r\n/* CSS filter fallback for clients without a native dark logo */\r\nhtml.dark-theme:not(.has-dark-logo) a.app-logo {\r\n\tfilter: invert(1) hue-rotate(180deg) brightness(160%) grayscale(80%);\r\n\tmix-blend-mode: screen;\r\n\ttransform: translateZ(0);\r\n\twill-change: filter;\r\n}\r\n\r\n/* Responsive Logo Styles */\r\n\r\n.logo-lores {\r\n\tdisplay: block;\r\n}\r\n\r\n.logo-hires {\r\n\tdisplay: none;\r\n}\r\n\r\n\r\n\r\n\r\n.nav {\r\n\t-ms-flex-negative: 0;\r\n\tflex-shrink: 0;\r\n}\r\n\r\n.dropdown-item,\r\n.dropdown-section {\r\n\tborder: 0;\r\n\tbackground: 0;\r\n\tpadding: 0 1rem 0.25rem;\r\n\tline-height: 2rem;\r\n\tfont-size: .875rem;\r\n\tposition: relative;\r\n\t-moz-appearance: none;\r\n\t-webkit-appearance: none;\r\n\ttransition: background 0.2s ease, color 0.2s ease;\r\n\tborder-radius: 0.25rem;\r\n}\r\n\r\n.dropdown-section {\r\n\tdisplay: block;\r\n\tborder-radius: 0;\r\n\tborder-top: 1px solid var(--section-border);\r\n\tpadding: .25rem 1rem;\r\n}\r\n\r\n.dropdown-item {\r\n\tcolor: var(--secure-primary-text);\r\n\tcursor: pointer;\r\n}\r\n\r\n\t.dropdown-item + .nav-link,\r\n\t.nav-link + .nav-link {\r\n\t\tmargin-left: 0.25rem;\r\n\t}\r\n\r\n\t.dropdown-item .fa,\r\n\t.nav-link .fa,\r\n\t.dropdown-item .fo,\r\n\t.nav-link .fo {\r\n\t\tmargin-right: 0.25rem;\r\n\t\twidth: 1.28571429em;\r\n\t\ttext-align: center;\r\n\t}\r\n\r\n\t.nav-link:hover {\r\n\t\tbackground: rgba(var(--primary-rgb), 0.45);\r\n\t}.nav-link:active,\r\n.navbar-nav .nav-link:active {\r\n\tbackground: rgba(var(--primary-rgb), 0.3);\r\n}\r\n\r\n.dropdown-item:hover, .dropdown-item:active {\r\n\tbackground: 0;\r\n}\r\n\r\n.nav-link {\r\n\ttext-align: left;\r\n}\r\n\r\n.nav-item > .nav-link {\r\n\twidth: 100%;\r\n}\r\n\r\n.nav-link .fo {\r\n\tposition: relative;\r\n\ttop: 1px;\r\n}\r\n\r\n\r\n.dropdown-item {\r\n\tpadding: 0;\r\n}\r\n\r\n\t.dropdown-item > div,\r\n\t.dropdown-item > a,\r\n\t.dropdown-item > span,\r\n\t.dropdown-item > button {\r\n\t\tcolor: var(--muted);\r\n\t\tdisplay: block;\r\n\t\tpadding: .25rem .75rem;\r\n\t\ttext-decoration: none;\r\n\t\theight: auto;\r\n\t\twidth: 100%;\r\n\t\ttext-align: left;\r\n\t\ttransition: background 0.2s ease;\r\n\t}\r\n\r\n\t.dropdown-item > button,\r\n\t.dropdown-item > a {\r\n\t\t-moz-appearance: none;\r\n\t\tappearance: none;\r\n\t\t-webkit-appearance: none;\r\n\t\tbackground: transparent;\r\n\t\tborder: 0;\r\n\t\tcolor: var(--secure-primary-text);\r\n\t\tfont-weight: normal;\r\n\t}\r\n\r\n\t\t.dropdown-item > button:hover,\r\n\t\t.dropdown-item > a:hover,\r\n\t\t#more-toolbar-button:hover,\r\n\t\t#edit-portal-button:hover {\r\n\t\t\tbackground: rgba(var(--primary-rgb), 0.25);\r\n\t\t}\r\n\r\n\t.dropdown-item .fa {\r\n\t\tcolor: var(--secure-primary-text);\r\n\t\tmargin-right: .75rem;\r\n\t\tmargin-left: .125rem;\r\n\t\ttext-align: center;\r\n\t}\r\n\r\n\t.dropdown-item > .nav-link {\r\n\t\tmin-width: 100%;\r\n\t\tbackground: 0;\r\n\t\tborder-radius: 0;\r\n\t\ttext-align: left;\r\n\t\tpadding: .25rem .75rem;\r\n\t\tline-height: 2rem;\r\n\t\tfont-weight: normal;\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t\t.dropdown-item > .nav-link:disabled {\r\n\t\t\tbox-shadow: none;\r\n\t\t}\r\n\r\n\r\n\r\n.dropdown-header {\r\n\tposition: relative;\r\n\tpadding: .5rem .75rem;\r\n\tborder-radius: .25rem .25rem 0 0;\r\n\tfont-size: 1rem;\r\n\tcolor: var(--secure-primary-text);\r\n\tfont-weight: bold;\r\n}\r\n\r\n\t.dropdown-header + .dropdown-divider {\r\n\t\tmargin-top: 0;\r\n\t}\r\n\r\n.dropdown-content {\r\n\tpadding: 1rem;\r\n}\r\n\r\n.dropdown-header + .dropdown-content {\r\n\tpadding-top: 0;\r\n}\r\n\r\n.dropdown-divider {\r\n\tborder-top: 2px dotted var(--section-border);\r\n\tmargin: .375rem 1rem;\r\n}\r\n\r\n.dropdown-content {\r\n\tpadding: 1rem;\r\n}\r\n\r\n.dropdown-header + .dropdown-content {\r\n\tpadding-top: .5rem;\r\n}\r\n\r\n\r\n.nav-item {\r\n\tdisplay: flex;\r\n\tposition: relative;\r\n}\r\n\r\n\r\n\r\n.toolbar .nav-item {\r\n\tfloat: left;\r\n\tflex-shrink: 0;\r\n\tmargin: 0;\r\n}\r\n\r\n.app-menu-right {\r\n\tmargin-left: auto;\r\n\tmax-width: 50%;\r\n\tpadding-right: .5rem;\r\n\tflex-shrink: 0;\r\n\tmin-width: max-content;\r\n}\r\n\r\n\t/* the buttons within app menu nav should not wrap into multilines */\r\n\t.app-menu-right .nav-link {\r\n\t\twhite-space: nowrap;\r\n\t}\r\n\r\n/* Nav tabs */\r\n.portal-tabs-container {\r\n\tborder-bottom: 1px solid var(--section-border);\r\n}\r\n\r\n.portal-tab-more-container {\r\n\tpadding-left: 0;\r\n}\r\n\r\n.portal-tab-edit-container {\r\n\tpadding-left: 0;\r\n\tmargin-left: auto;\r\n}\r\n\r\n.portal-tab-more .dropdown-menu {\r\n\tbackground: var(--modal-background);\r\n\tbox-shadow: var(--shadow-medium);\r\n}\r\n\r\n.nav-tabs {\r\n\tborder: 0;\r\n}\r\n\r\n.nav-tabs, .nav.nav-tabs {\r\n\tpadding: 0;\r\n}\r\n\r\n\t.nav-tabs.alt {\r\n\t\tbackground: var(--table-row);\r\n\t}\r\n\r\n\t.nav-tabs .nav-link, .nav-tabs .nav-item .nav-link, #more-toolbar-button, #edit-portal-button {\r\n\t\theight: 2.5rem;\r\n\t\ttext-align: center;\r\n\t\tfont-size: 1rem;\r\n\t\tbackground: transparent;\r\n\t\tcolor: var(--secure-primary-text);\r\n\t\tpadding: 0 1rem;\r\n\t\tcursor: pointer;\r\n\t\tline-height: 2.5rem;\r\n\t\toverflow: hidden;\r\n\t\twhite-space: nowrap;\r\n\t\ttext-overflow: ellipsis;\r\n\t\tborder: 0 solid transparent;\r\n\t\tborder-width: 0 0 0.175rem 0;\r\n\t\tbox-shadow: none !important;\r\n\t\tfont-weight: 500;\r\n\t\tborder-radius: 1rem;\r\n\t}\r\n\r\n\t\t.nav-tabs .nav-item .nav-link:hover {\r\n\t\t\tborder-radius: 1rem;\r\n\t\t}\r\n\r\n\t\t.nav-tabs .nav-item .nav-link:focus {\r\n\t\t\tborder-radius: 1rem;\r\n\t\t}\r\n\r\n\t\t.nav-tabs .nav-item .nav-link:hover,\r\n\t\t.nav-tabs .nav-item .nav-link:focus {\r\n\t\t\tcolor: var(--secure-primary-text);\r\n\t\t\tbackground: transparent;\r\n\t\t\toutline: 0;\r\n\t\t}\r\n\r\n\t\t.nav-tabs .nav-item .nav-link:hover {\r\n\t\t\tbackground: rgba(var(--primary-rgb), .25);\r\n\t\t}\r\n\r\n\t\t.nav-tabs .nav-item .nav-link:focus {\r\n\t\t\tbox-shadow: 0 0 0 2px rgba(var(--primary-rgb), .25);\r\n\t\t}\r\n\r\n\t\t\t.nav-tabs .nav-link.active:disabled {\r\n\t\t\t\tborder-color: transparent;\r\n\t\t\t}\r\n\r\n\t.nav-tabs .nav-item, .nav-tabs .nav-item + .nav-item {\r\n\t\tmargin: 0!important;\r\n\t}\r\n\r\n\t.nav-tabs li.nav-item:has(> a.nav-link.active), .nav-tabs li.nav-item:has(> button.nav-link.active) {\r\n\t\tborder-bottom: solid 3px var(--primary-base);\r\n\t}\r\n\r\n.right.nav .nav-tabs {\r\n\tbackground: 0;\r\n\tborder: 0;\r\n\tborder-bottom: 1px solid rgba(10,15,40,0.06);\r\n}\r\n\r\n\t.right.nav .nav-tabs .nav-item {\r\n\t\tmargin-right: 0;\r\n\t}\r\n\r\n\r\n\t.right.nav .nav-tabs .nav-link, #periodTypeSelectorComp.nav-tabs .nav-link {\r\n\t\tborder-radius: 1rem;\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n.tab-ribbon {\r\n\tbackground: 0;\r\n}\r\n\r\n.files-tab-ribbon {\r\n\tdisplay: flex;\r\n\tpadding: .5rem .75rem;\r\n\tgap: 0.25rem;\r\n}\r\n\r\n\r\n/* Compass */\r\n\r\n.compass {\r\n\tfloat: left;\r\n\tpadding: 0 1rem;\r\n\tmargin: 0;\r\n\theight: auto;\r\n\tflex: 1;\r\n\talign-items: center;\r\n\tdisplay: flex;\r\n\tflex-wrap: wrap;\r\n\tfont-size: 0.875rem;\r\n}\r\n\r\n\t.compass li {\r\n\t\tdisplay: inline-flex;\r\n\t\tflex-grow: 0;\r\n\t\tmax-width: 16rem;\r\n\t\toverflow-x: hidden;\r\n\t\ttext-overflow: ellipsis;\r\n\t\twhite-space: nowrap;\r\n\t\talign-items: center;\r\n\t}\r\n\r\n\t\t.compass li:first-child {\r\n\t\t\tcolor: var(--muted);\r\n\t\t}\r\n\r\n\t\t.compass li:first-child:before {\r\n\t\t\tcontent: none;\r\n\t\t}\r\n\r\n\t\t.compass li:before {\r\n\t\t\tfont-family: 'Font Awesome 6 Pro';\r\n\t\t\tcontent: '\\f105';\r\n\t\t\tcolor: var(--muted);\r\n\t\t\tmargin: 0 0.5rem;\r\n\t\t\tfont-size: .875rem;\r\n\t\t\tfont-weight: 300;\r\n\t\t\tdisplay: block;\r\n\t\t}\r\n\r\n\t\t.compass li:only-child {\r\n\t\t\ttext-overflow: ellipsis;\r\n\t\t}\r\n\r\n.compass-root:before {\r\n\tdisplay: none !important;\r\n}\r\n\r\n.compass .compass-close,\r\n.compass-close:before {\r\n\tdisplay: none;\r\n}\r\n\r\n.compass li[ng-click] {\r\n\tcolor: var(--secure-primary-text);\r\n\tcursor: pointer;\r\n}\r\n\r\n.compass li.breadcrumb-last-item {\r\n\tcolor: var(--default-text);\r\n\tcursor: default;\r\n}\r\n\r\n.compass a {\r\n\tcolor: var(--muted);\r\n\tfont-weight: normal;\r\n}\r\n\r\n.compass-close {\r\n\tmargin-left: auto;\r\n\tpadding: .125rem .5rem;\r\n\tcolor: var(--muted);\r\n}\r\n\r\n.sort-spinner {\r\n\tcolor: var(--muted);\r\n\t-webkit-animation: fa-spin 2s infinite linear;\r\n\tanimation: fa-spin 2s infinite linear;\r\n\tfont-family: 'Font Awesome 6 Pro';\r\n\tfont-weight: 300;\r\n}\r\n\r\n.app-menu-spinner {\r\n\tposition: absolute;\r\n\ttop: 100%;\r\n\tmargin-top: -1px;\r\n\tleft: 0;\r\n\twidth: 100vw;\r\n}\r\n\r\n\r\n\r\n.cpf-spinner {\r\n\twidth: 100%;\r\n\theight: 3px;\r\n\tbackground: var(--primary-base);\r\n\toverflow: hidden;\r\n\topacity: 0;\r\n\ttransition: opacity 0.3s ease;\r\n\tpointer-events: none;\r\n}\r\n\r\n\t.cpf-spinner:before {\r\n\t\theight: 100%;\r\n\t\twidth: 0;\r\n\t\tposition: absolute;\r\n\t\tleft: 50%;\r\n\t\ttop: 0;\r\n\t\tcontent: '';\r\n\t\tdisplay: block;\r\n\t\tbackground: #fff;\r\n\t\twidth: 14rem;\r\n\t\tanimation: spinner-bar 1s ease-in-out infinite;\r\n\t}\r\n\r\n\t.cpf-spinner.cpf-spinner-shown {\r\n\t\topacity: 0.6;\r\n\t}\r\n\r\n.sort-spinner:before {\r\n\tcontent: \"\\f1ce\" !important;\r\n}\r\n\r\n\r\n\r\n.toolbar, .toolbar-section {\r\n\tpadding-left: .5rem;\r\n\tdisplay: flex;\r\n\tflex-wrap: wrap;\r\n}\r\n\r\nsng-toolbar {\r\n\tdisplay: flex;\r\n\tflex-wrap: wrap;\r\n\tflex: 1 1 auto;\r\n}\r\n\r\n.toolbar-toggle {\r\n\tmargin: 0 .5rem .5rem;\r\n}\r\n\r\n.sub-toolbar-toggle {\r\n\tdisplay: none;\r\n}\r\n\r\n.navbar-nav .toolbar-noitems-message {\r\n\tpadding: .5rem;\r\n\tcolor: var(--muted-light);\r\n\tdisplay: none;\r\n\tmin-width: 12rem;\r\n\ttext-align: center;\r\n}\r\n\r\n.icon-nav {\r\n\tpadding: 0;\r\n\theight: 3rem;\r\n\tdisplay: flex;\r\n\tmargin-left: auto;\r\n\talign-items: center;\r\n\tpadding-right: .5rem;\r\n}\r\n\r\n.icon-nav-btn-container {\r\n\tdisplay: flex;\r\n\tposition: relative;\r\n\tmargin: 0;\r\n\tpadding: 0 0.25rem;\r\n\talign-items: center;\r\n}\r\n\r\n\t.icon-nav-btn-container:after, .icon-nav-btn-container:before {\r\n\t\tdisplay: block;\r\n\t\tcontent: '';\r\n\t\tposition: absolute;\r\n\t\ttop: .5rem;\r\n\t\tbottom: .5rem;\r\n\t\tborder-left: 1px solid var(--border-light);\r\n\t}\r\n\r\n\t.icon-nav-btn-container:before {\r\n\t\tleft: 0;\r\n\t}\r\n\r\n\t.icon-nav-btn-container:after {\r\n\t\tright: 0;\r\n\t}\r\n\r\n\t.icon-nav-btn-container + .icon-nav-btn-container:before {\r\n\t\tdisplay: none;\r\n\t}\r\n\r\n\t.icon-nav-btn-container .icon-nav-btn {\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.icon-nav-btn-container:last-child:after {\r\n\t\tdisplay: none;\r\n\t}\r\n\r\n.icon-nav-btn {\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\tjustify-content: center;\r\n\tpadding: 0.5rem 0.75rem 0.475rem;\r\n\tborder-radius: 1.5rem;\r\n\tcursor: pointer;\r\n\ttransition: background 0.2s ease;\r\n\tposition: relative;\r\n\tcolor: var(--secure-primary-text);\r\n\theight: 2.75rem;\r\n\tmargin: 0;\r\n}\r\n\r\n\t.icon-nav-btn .charm-title {\r\n\t\tposition: absolute;\r\n\t\ttop: 100%;\r\n\t\tfont-weight: 400;\r\n\t\tfont-size: 0.875rem;\r\n\t\tpadding: .125rem .5rem;\r\n\t\tborder-radius: .5rem;\r\n\t\tbackground: var(--secure-primary-text);\r\n\t\tborder: 1px solid white;\r\n\t\tcolor: var(--text-contrast);\r\n\t\twhite-space: pre;\r\n\t\tmargin-top: 1rem;\r\n\t\tpointer-events: none;\r\n\t\topacity: 0;\r\n\t\ttransition: opacity 0.2s ease;\r\n\t}\r\n\r\n\t\t.icon-nav-btn .charm-title.right {\r\n\t\t\tright: 0;\r\n\t\t}\r\n\r\n.dropdown.open .charm-title {\r\n\topacity: 0 !important;\r\n}\r\n\r\n.icon-nav-btn:hover {\r\n\tbackground: rgba(var(--primary-rgb), 0.25);\r\n}\r\n\r\n\t.icon-nav-btn:hover .charm-title {\r\n\t\topacity: 1;\r\n\t}\r\n\r\n.icon-nav-btn, .icon-nav-btn:hover, .icon-nav-btn:focus {\r\n\ttext-decoration: none;\r\n}\r\n\r\n.icon-nav-icon {\r\n\tfont-size: 1.75rem;\r\n\tcolor: var(--secure-primary-text);\r\n\tfloat: left;\r\n}\r\n\r\n\t.icon-nav-icon + .fa-stack-1x {\r\n\t\ttop: -2px;\r\n\t}\r\n\r\n.icon-nav-btn .mobile-app-name {\r\n\tcolor: var(--secure-primary-text);\r\n\tdisplay: inline-block;\r\n\tfont-size: 1rem;\r\n\tpadding: 0 0 0 .5rem;\r\n}\r\n\r\n.icon-nav-btn > .caret {\r\n\tpadding: .375rem 0 0 .25rem;\r\n\tmargin-left: -0.45rem;\r\n\tposition: absolute;\r\n\tbottom: -0.325rem;\r\n\tleft: 50%;\r\n\topacity: 0.3;\r\n\tfont-size: 0.6rem;\r\n\tfont-weight: 600;\r\n}\r\n\r\n.icon-nav .dropdown {\r\n\tmin-width: 0;\r\n\tfloat: left;\r\n}\r\n\r\n\t.icon-nav .dropdown.open .dd-toggle {\r\n\t\tbackground: rgba(var(--primary-rgb), 0.25);\r\n\t}\r\n\r\n\t.icon-nav .dropdown.open .caret {\r\n\t\tcolor: var(--secure-primary-text);\r\n\t\tfont-weight: normal\r\n\t}\r\n\r\n\t.icon-nav .dropdown button:after {\r\n\t\tcolor: var(--secure-primary-text);\r\n\t\tpadding-left: .125rem;\r\n\t}\r\n\r\n.icon-item-count {\r\n\tbackground: var(--muted);\r\n\tcolor: var(--text-contrast);\r\n\tborder-radius: .5rem;\r\n\tpadding: 0 .25rem;\r\n\tfont-size: .75rem;\r\n\tline-height: .875rem;\r\n\tfont-weight: bold;\r\n\tdisplay: inline-block;\r\n\tmargin-left: .25rem;\r\n\tposition: relative;\r\n\tm