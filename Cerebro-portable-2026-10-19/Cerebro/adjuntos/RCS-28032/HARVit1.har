                resizedCanvas.height = desiredHeight;\r\n\r\n                    // create context\r\n                    var resizedCtx = resizedCanvas.getContext(\"2d\");\r\n\r\n                    // grab the canvas and resize it back to original size\r\n                    resizedCtx.drawImage(canvas, 0, 0, desiredWidth, desiredHeight);\r\n\r\n                    // replace the canvas with resized one and return\r\n                    canvas = resizedCanvas;\r\n                    return canvas;\r\n                });\r\n            } else {\r\n                return originalHtml2Canvas(element, conf);\r\n            }\r\n        }\r\n    }\r\n})();\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/moment-overrides.js\n * ======================================== */\n\n﻿// @ts-check\r\n/**\r\n * This file contains overrides to Moment JS localization support\r\n * \r\n * @description The main purpose of these overrides is to provide support for our own\r\n * resource localization support and localization strings extraction\r\n * We should not override other settings leaving them as default\r\n * \r\n * Note that we should always provide the CULTURE to the module in order\r\n * to make it work as we expect\r\n * \r\n * @module MomentOverrides\r\n * @requires moment.js\r\n */\r\n(function (moment, CULTURE, undefined) {\r\n\r\n    if (moment) {\r\n\r\n        // setup custom locale support\r\n        // inheriting default (en-us) configuration\r\n        moment.defineLocale(\"en-SYS\", {\r\n            parentLocale: \"en\",\r\n        });\r\n\r\n        // set default local (we do this later in per-component basis too)\r\n        if (typeof CULTURE === 'string') {\r\n            moment.locale(CULTURE);\r\n        }\r\n\r\n        // custom moment configuration\r\n\r\n        // add proper moment' configuration keys here\r\n        // customization assumes that locale already has been set\r\n        // to support our