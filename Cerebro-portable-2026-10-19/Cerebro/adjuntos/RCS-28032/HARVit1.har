le.top = '0';\r\n\t\t\toverlay.style.left = '0';\r\n\t\t\toverlay.style.width = '100%';\r\n\t\t\toverlay.style.height = '100%';\r\n\t\t\tel.appendChild(overlay);\r\n\t\t}\r\n\t},\r\n\r\n\t/**\r\n\t * Hide a loading skeleton overlay given a selector.\r\n\t * @param {*} selector The selector (optional - hides all if not provided).\r\n\t */\r\n\thideSkeleton: function (selector) {\r\n\t\tif (!selector) {\r\n\t\t\tdocument.querySelectorAll('.skeleton-overlay[data-skeleton]').forEach(o => o.remove());\r\n\t\t\tdocument.querySelectorAll('[data-skeleton-orig-position]').forEach(el => {\r\n\t\t\t\tif (el.dataset.skeletonOrigPosition === 'static') el.style.position = '';\r\n\t\t\t\tdelete el.dataset.skeletonOrigPosition;\r\n\t\t\t});\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tif (typeof selector !== 'string') {\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tconst elements = document.querySelectorAll(selector);\r\n\t\tif (!elements || elements.length === 0) {\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tfor (let i = 0; i < elements.length; i++) {\r\n\t\t\tlet el = elements[i];\r\n\r\n\t\t\tconst overlay = el.querySelector && el.querySelector('.skeleton-overlay[data-skeleton]');\r\n\t\t\tif (overlay) {\r\n\t\t\t\toverlay.remove();\r\n\t\t\t}\r\n\r\n\t\t\tif (el.dataset.skeletonOrigPosition === 'static') {\r\n\t\t\t\tel.style.position = '';\r\n\t\t\t}\r\n\r\n\t\t\tdelete el.dataset.skeletonOrigPosition;\r\n\t\t}\r\n\t},\r\n\tloader: function (config) {\r\n\t\t// config:\r\n\t\t// selector: the target dom element selectors to cover,\r\n\t\t// state: whether to enable or disable the loader\r\n\r\n\t\tif (\r\n\t\t\t!config.hasOwnProperty(\"selector\") ||\r\n\t\t\t!config.hasOwnProperty(\"state\")\r\n\t\t) {\r\n\t\t\tcpf.alert(\r\n\t\t\t\t\"RESOURCE{{cpf.ui.js}:{BadLoadAnim}:{Loading animation improperly configured. Please contact support.}}\",\r\n\t\t\t\t\"e\"\r\n\t\t\t);\r\n\t\t}\r\n\r\n\t\tvar $target = $(config.selector);\r\n\t\tif ($target.length === 0) {\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tvar $loader = $target.children(\".load-indicator, .load-indicator-mini\");\r\n\r\n\t\tif ($loader.length === 0) {\r\n\t\t\tif (config.state === \"off\") {\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\t$loader = $(\r\n\t\t\t\t'<div style=\"display: none\" class=\"load-indicator' +\r\n\t\t\t\t\t(config.mini ? \"-mini\" : \" full\") +\r\n\t\t\t\t\t(config.classOverride ? \" \" + config.classOverride : \"\") +\r\n\t\t\t\t\t'\"><div></div>' + (config.message ? ('<span class=\"load-text\">' + config.message + '</span>') : '') + '</div>'\r\n\t\t\t);\r\n\r\n\t\t\t// set loader bg to match target bg\r\n\t\t\tvar bg = \"transparent\";\r\n\t\t\tvar $current = $target;\r\n\t\t\t// find a background color of any parent\r\n\t\t\twhile (\r\n\t\t\t\t[\"rgba(0,0,0,0)\", \"rgba(0, 0, 0, 0)\", \"transparent\"].indexOf(\r\n\t\t\t\t\tbg\r\n\t\t\t\t) > -1 &&\r\n\t\t\t\t$current.length &&\r\n\t\t\t\t!$current.is(\"html\")\r\n\t\t\t) {\r\n\t\t\t\tbg = $current.css(\"backgroundColor\");\r\n\t\t\t\t$current = $current.parent();\r\n\t\t\t}\r\n\r\n\t\t\t/*\r\n\t\t\t// TODO: Improve loader and support themeing based on bg color\r\n\t\t\tif (bg.indexOf('rgb(') > -1) {\r\n\t\t\t\t// calculate if the background is dark enough to warrant a different appearance for the loader\r\n\t\t\t\tvar c = bg.replace(\"rgb(\", \"\").replace(\")\", \"\");\r\n\t\t\t\tc = c.split(\",\");\r\n\t\t\t\tvar lum = 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]; // RGB calculation into luminosity\r\n\t\t\t\tif (lum < 50) {\r\n\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t*/\r\n\r\n\t\t\t$loader.css(\"backgroundColor\", bg);\r\n\t\t\t$target.append($loader);\r\n\t\t}\r\n\r\n\t\tswitch (config.state) {\r\n\t\t\tcase \"on\":\r\n\t\t\t\tif (\r\n\t\t\t\t\t$target.css(\"position\") === null ||\r\n\t\t\t\t\t$target.css(\"position\") === \"static\"\r\n\t\t\t\t) {\r\n\t\t\t\t\t$target.css({ position: \"relative\" });\r\n\t\t\t\t}\r\n\t\t\t\tif ($loader.hasClass(\"load-error\")) {\r\n\t\t\t\t\t$loader.removeClass(\"load-error\");\r\n\t\t\t\t}\r\n\r\n\t\t\t\t$loader.stop(true).show();\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"off\":\r\n\t\t\t\t$loader.delay(350).fadeOut(\"fast\", function () {\r\n\t\t\t\t\tif (config.callback) {\r\n\t\t\t\t\t\tconfig.callback();\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"error\":\r\n\t\t\t\t$loader.stop(true).show();\r\n\t\t\t\t$loader.addClass(\"load-error\");\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t},\r\n\tisLoading: function (element) {\r\n\t\tvar $el = $(element);\r\n\t\treturn $el.length && $el.find(\"> .load-indicator\").length;\r\n\t},\r\n\tprogress: {\r\n\t\tloader: function (target, setting, value, callback) {\r\n\t\t\tvar $target = $(target);\r\n\t\t\tvar $loader = $target.find(\".progress-indicator\");\r\n\t\t\tvar $progress = $loader.find(\"progress\");\r\n\r\n\t\t\t// If no target to append the loader to is found, end running\r\n\t\t\tif ($target.length === 0) {\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\r\n\t\t\tif (!$loader.length) {\r\n\t\t\t\t// if no loader and set to 'on' or 'update' create the loader. if 'off' or 'error' terminate\r\n\t\t\t\tif (setting === \"on\" || setting === \"update\") {\r\n\t\t\t\t\tif (\r\n\t\t\t\t\t\t$target.css(\"position\") === null ||\r\n\t\t\t\t\t\t$target.css(\"position\") === \"static\"\r\n\t\t\t\t\t) {\r\n\t\t\t\t\t\t$target.css({ position: \"relative\" });\r\n\t\t\t\t\t}\r\n\t\t\t\t\t$target.css(\"min-height\", \"7rem\");\r\n\t\t\t\t\t$loader = $(\r\n\t\t\t\t\t\t'<div class=\"progress-indicator sng-animate\"><progress class=\"progress\" value=\"0\" max=\"100\"></progress><div class=\"load-indicator\"><div></div></div></div>'\r\n\t\t\t\t\t);\r\n\t\t\t\t\t$progress = $loader.find(\"progress\");\r\n\r\n\t\t\t\t\t// set loader bg to match target bg\r\n\t\t\t\t\tvar bg = \"transparent\";\r\n\t\t\t\t\tvar $current = $target;\r\n\t\t\t\t\t// find a background color of any parent\r\n\t\t\t\t\twhile (\r\n\t\t\t\t\t\t[\r\n\t\t\t\t\t\t\t\"rgba(0,0,0,0)\",\r\n\t\t\t\t\t\t\t\"rgba(0, 0, 0, 0)\",\r\n\t\t\t\t\t\t\t\"transparent\",\r\n\t\t\t\t\t\t].indexOf(bg) > -1 &&\r\n\t\t\t\t\t\t$current.length\r\n\t\t\t\t\t) {\r\n\t\t\t\t\t\tbg = $current.css(\"backgroundColor\");\r\n\t\t\t\t\t\t$current = $current.parent();\r\n\t\t\t\t\t}\r\n\t\t\t\t\t$loader.css(\"backgroundColor\", bg);\r\n\r\n\t\t\t\t\t$target.append($loader);\r\n\t\t\t\t\t$loader.show();\r\n\t\t\t\t} else {\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\tswitch (setting) {\r\n\t\t\t\tcase \"off\":\r\n\t\t\t\t\t$progress.val(100);\r\n\t\t\t\t\t$loader.delay(400).fadeOut(\"fast\", function () {\r\n\t\t\t\t\t\t$(this).remove();\r\n\t\t\t\t\t\tif (callback) {\r\n\t\t\t\t\t\t\tcallback();\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"update\":\r\n\t\t\t\t\tif (\r\n\t\t\t\t\t\ttypeof value !== \"undefined\" &&\r\n\t\t\t\t\t\t!cpf.utils.isNaN(Number(value))\r\n\t\t\t\t\t) {\r\n\t\t\t\t\t\t$progress.val(value);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"error\":\r\n\t\t\t\t\t$loader.addClass(\"load-error\");\r\n\t\t\t\t\t$progress.val(0);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tdefault: // this includes 'on',\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t},\r\n\t},\r\n\t/*\r\n\tcompass: {\r\n\t\titems: [],\r\n\t\tadd: function(item) {\r\n\t\t\tcpf.compass.items.push(item);\r\n\t\t},\r\n\t\tremove: function(number) {\r\n\t\t\tcpf.compass.items.pop(number);\r\n\t\t},\r\n\t\tinit: function () {\r\n\t\t\tcpf.compass.items = [\r\n\t\t\t\t{\r\n\t\t\t\t\tdisplayName: \"Secure\",\r\n\t\t\t\t\turl: APPLICATIONPATH\r\n\t\t\t\t}\r\n\t\t\t];\r\n\t\t\tcpf.compass.update();\r\n\t\t},\r\n\t\tupdate: function () {\r\n\t\t\t$(\"#compass, #mobile-compass\").html(\"\");\r\n\t\t\tfor (var i = 0, ii = items.length; i < ii; i++) {\r\n\t\t\t\tvar $item = $(\"<li><a href=\\\"#\\\">\" + items[i].displayName + \"</a></li>\");\r\n\t\t\t\tif (items[i].url) {\r\n\t\t\t\t\t$item.find(\"a\").attr(\"href\", url);\r\n\t\t\t\t} else if (items[i].function) {\r\n\t\t\t\t\tvar func = items[i].function;\r\n\t\t\t\t\t$item.find(\"a\").on(\"click\", function() {\r\n\t\t\t\t