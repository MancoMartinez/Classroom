          "content": {
            "size": 93125,
            "mimeType": "text/html",
            "text": "\r\n\r\n<!DOCTYPE html>\r\n\r\n<!--USER CONTROLS -->\r\n\r\n\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head><link rel=\"stylesheet\" type=\"text/css\" href=\"/vitaminshoppe/nettrack/DXR.axd?r=1_66,0_2776,0_2771,1_207,0_2690,1_208,0_2685,0_2665,0_2669-nTjkx&p=8967471e\" />\r\n        <link rel=\"stylesheet\" href=\"/vitaminshoppe/nettrack/css/LPMSStyles.css?id=6.26.8\"  type=\"text/css\"/>\r\n        <script src=\"../include/scripts/StoreLookUpTypeAhead.js?id=6.26.8\" type=\"text/javascript\"></script>\r\n        <script id=\"dxis_wfjdmin\" type=\"text/javascript\" src=\"/vitaminshoppe/nettrack/include/JQuery/jquery-3.7.1.min.js\"></script>\r\n        <script type=\"text/javascript\" src=\"/vitaminshoppe/nettrack/include/scripts/Bootstrap-5.3.8.Bundle.min.js\"></script>\r\n        <link href=\"/vitaminshoppe/nettrack/css/Bootstrap-5.3.8.min.css\" rel=\"stylesheet\" />\r\n <link rel=\"stylesheet\" href=\"/vitaminshoppe/nettrack/css/new.css?id=6.26.8\" type=\"text/css\"/>\r\n        <link href=\"/vitaminshoppe/nettrack/css/font-awesome.min.css\" rel=\"stylesheet\" />\r\n        <meta name=\"viewport\" content=\"width=device-width, user-scalable=no, maximum-scale=1.0, minimum-scale=1.0\" />\r\n        <script type=\"text/javascript\" src=\"../include/scripts/LPSCommon.js?id=6.26.8\"></script>\r\n   \r\n    <script  type=\"text/javascript\">\r\n        function showSelectCaseClassPrint() {\r\n            window.document.forms[0].fld_storeident$STOREID.value = 123;\r\n            $('#trow_StoreLookup').hide();\r\n            $('#trow_title_SelectAuditClass').show();\r\n            $('#trow_cardView').show();\r\n            return;\r\n        }\r\n\r\n        function onStartNewIncident() {\r\n            if (window.document.forms[0].fld_storeident$STOREID.value != '') {\r\n                if ($('#hidecaseclass').val() == 0) {\r\n                    $('#trow_title_SelectAuditClass').show();\r\n                    $('#trow_cardView').show();\r\n                    setnextbutton();\r\n                    return;\r\n                }\r\n                if ($('#hideauditgroup').val() == 0) {\r\n                    //showSelectCaseGroup();\r\n                    hideSelectAuditType();\r\n                    setnextbutton();\r\n                    return;\r\n                }\r\n                if ($('#hideauditgroup').val() != 0 && $('#hidecaseclass').val() != 0) {\r\n                    //hideSelectCaseGroup();\r\n                    hideSelectCaseClass();\r\n                    showAuditType();\r\n                }\r\n            }\r\n            else {\r\n                hideSelectCaseClass();\r\n                //hideSelectCaseGroup();\r\n                hideSelectAuditType();\r\n            }\r\n        }\r\n\r\n        function showSelectCaseClass() {\r\n            if (window.document.forms[0].fld_storeident$STOREID.value != '' && window.document.forms[0].hidecaseclass.value != 1) {\r\n                $('#trow_title_SelectAuditClass').show();\r\n                $('#trow_cardView').show();\r\n            }\r\n            else {\r\n                cardView.UnselectCards();\r\n                $('#trow_title_SelectAuditClass').hide();\r\n                $('#trow_cardView').hide();\r\n                if (window.document.forms[0].hidecaseclass.value != 1) {\r\n                    hideSelectAuditType();\r\n                }\r\n                else {\r\n                    showAuditType();\r\n                }\r\n            }\r\n            if ($('#hideauditgroup').val() != 1) {\r\n                //showSelectCaseGroup();\r\n                $('#trow_title_SelectAuditType').hide();\r\n                $('#trow_AuditMaster_AuditMasterDescription').hide();\r\n                //$('#trow_MasterCase_CaseTier').hide();\r\n                //$('#trow_MasterCase_CaseTier_Multi').hide();\r\n                //$('#divLabel_sys_CaseTypeDescription').hide();\r\n                //document.getElementById(\"lbl01_AuditMaster_AuditMasterDescription\").textContent = '';\r\n            }\r\n            setnextbutton();\r\n        }\r\n\r\n        function hideSelectAuditType() {\r\n            //cardView.UnselectCards();\r\n            $('#trow_title_SelectAuditType').hide();\r\n            $('#trow_AuditMaster_AuditMasterDescription').hide();\r\n            //$('#trow_MasterCase_CaseTier').hide();\r\n            //$('#trow_MasterCase_CaseTier_Multi').hide();\r\n            //$('#divLabel_sys_CaseTypeDescription').hide();\r\n            //document.getElementById(\"lbl01_AuditMaster_AuditMasterDescription\").textContent = '';\r\n            //fld_AuditMaster_AuditMasterDescription.SetSelectedIndex(-1);\r\n            //fld_MasterCase_CaseTier.SetSelectedIndex(-1);\r\n            setnextbutton();\r\n\r\n        }\r\n\r\n        function hideSelectCaseClass() {\r\n            cardView.UnselectCards();\r\n            $('#trow_title_SelectAuditClass').hide();\r\n            $('#trow_cardView').hide();\r\n            fld_AuditMaster_AuditMasterDescription.SetSelectedIndex(-1);\r\n            setnextbutton();\r\n        }\r\n\r\n        function GetCardClick(s, e) {\r\n            var key = '';\r\n            var loc = '';\r\n            key = cardView.GetCardKey(e.visibleIndex);\r\n            $('#tmpauditclassid').val(key);\r\n            window.scrollTo(0, 500);\r\n\r\n            //if ($('#hideauditgroup').val() == 0) {\r\n               // showSelectCaseGroup();\r\n               // hideSelectAuditType();\r\n                //cardViewGroup.PerformCallback(key);\r\n            //}\r\n           // else {\r\n                showAuditType();\r\n                fld_AuditMaster_AuditMasterDescription.PerformCallback(key);\r\n                fld_AuditMaster_AuditMasterDescription.Focus();\r\n           // }\r\n        }\r\n\r\n        function setnextbutton() {\r\n            if (window.document.forms[0].fld_storeident$STOREID.value != '' && fld_AuditMaster_AuditMasterDescription.GetText() != '') {\r\n                btn_Save.SetEnabled(true);\r\n            }\r\n            else {\r\n                btn_Save.SetEnabled(false);\r\n            }\r\n            if (fld_AuditMaster_AuditMasterDescription.GetText() != '') {\r\n                btn_Print.SetEnabled(true);\r\n            }\r\n            else {\r\n                btn_Print.SetEnabled(false);\r\n            }\r\n        }\r\n\r\n        function showAuditType() {\r\n            if (window.document.forms[0].fld_storeident$STOREID.value != '') {\r\n                $('#trow_title_SelectAuditType').show();\r\n                $('#trow_AuditMaster_AuditMasterDescription').show();\r\n                //document.getElementById(\"lbl01_sys_CaseTypeDescription\").textContent = '';\r\n                //$('#divLabel_sys_CaseTypeDescription').show();\r\n            }\r\n            else {\r\n                cardView.UnselectCards();\r\n                $('#trow_title_SelectAuditType').hide();\r\n                $('#trow_AuditMaster_AuditMasterDescription').hide();\r\n                //$('#trow_MasterCase_CaseTier').hide();\r\n                //$('#trow_MasterCase_CaseTier_Multi').hide();\r\n                //$('#divLabel_sys_CaseTypeDescription').hide();\r\n                //document.getElementById(\"lbl01_sys_CaseTypeDescription\").textContent = '';\r\n                fld_AuditMaster_AuditMasterDescription.SetSelectedIndex(-1);\r\n            }\r\n            setnextbutton();\r\n        }\r\n\r\n    </script>\r\n    <title>\r\n\tNew Audit\r\n</title></head>\r\n<body onload=\"showSelectCaseClass(); hideSelectAuditType();\">\r\n    <script id=\"dxis_1528934105\" src=\"/vitaminshoppe/nettrack/DXR.axd?r=1_9,1_10,1_253,1_21,1_62,1_11,1_12,1_13,1_47,1_6,1_46,1_15,1_22,1_31,1_181,1_182,1_19,1_20,1_188,1_184,1_191,1_39,1_180,1_30,1_7,1_17,1_211,1_224,1_225,1_226,1_209,1_249,1_248,1_25,1_58,1_186-nTjkx\" type=\"text/javascript\"></script><table class=\"dxlpLoadingPanel_Moderno dxlpControl_Moderno\" cellspacing=\"0\" cellpadding=\"0\" id=\"sys_DisplaySaveMessage\" style=\"font-weight:bold;height:75px;width:200px;border-collapse:collapse;position:absolute;left:0px;top:0px;z-index:30000;display:none;\">\r\n\t<tr>\r\n\t\t<td class=\"dx\" style=\"padding-right:0px;\"><img class=\"dxlp-loadingImage dxlp-imgPosLeft\" src=\"/vitaminshoppe/nettrack/DXR.axd?r=1_87-nTjkx\" alt=\"\" align=\"middle\" /></td><td class=\"dx\" style=\"font-weight:bold;width:100%;padding-left:0px;\"><span id=\"sys_DisplaySaveMessage_TL\">Could not Find entry in Screen Label table (sys_DisplaySaveMessage)</span></td>\r\n\t</tr>\r\n</table><div id=\"sys_DisplaySaveMessage_LD\" class=\"dxlpLoadingDiv_Moderno dxlpControl_Moderno dx-ft\" style=\"left:0px;top:0px;z-index:29999;display:none;position:absolute;\">\r\n\r\n</div><script id=\"dxss_753097522\" type=\"text/javascript\">\n<!--\nASPx.FillDocumentElementDXThemeCssClassName(\"Moderno\");\r\nASPx.createControl(ASPxClientLoadingPanel,'sys_DisplaySaveMessage','lps',{'containerElementID':'LPSRoundPanel'});\n\n//-->\n</script>\r\n\r\n    <form method=\"post\" action=\"./NewAudit.aspx\" onsubmit=\"javascript:return WebForm_OnSubmit();\" id=\"Login\" postbackurl=\"&lt;%=RePost%>\" autocomplete=\"off\" onkeypress=\"var keyCode = (event.which) ? event.which : event.keyCode; if(keyCode == &#39;13&#39;){return false;}\">\r\n<div class=\"aspNetHidden\">\r\n<input type=\"hidden\" name=\"__EVENTTARGET\" id=\"__EVENTTARGET\" value=\"\" />\r\n<input type=\"hidden\" name=\"__EVENTARGUMENT\" id=\"__EVENTARGUMENT\" value=\"\" />\r\n<input type=\"hidden\" name=\"__VIEWSTATE\" id=\"__VIEWSTATE\" value=\"\" />\r\n</div>\r\n\r\n<script type=\"text/javascript\">\r\n//<![CDATA[\r\nvar theForm = document.forms['Login'];\r\nif (!theForm) {\r\n    theForm = document.Login;\r\n}\r\nfunction __doPostBack(eventTarget, eventArgument) {\r\n    if (!theForm.onsubmit || (theForm.onsubmit() != false)) {\r\n        theForm.__EVENTTARGET.value = eventTarget;\r\n        theForm.__EVENTARGUMENT.value = eventArgument;\r\n        theForm.submit();\r\n    }\r\n}\r\n//]]>\r\n</script>\r\n\r\n\r\n<script src=\"/vitaminshoppe/nettrack/WebResource.axd?d=KB1EyreUPY0OtYcP_lv8WMIDSzNThe52Mdr3nOzgnkffrH6C7jdr1fx7RaPb6eDh9j1Nh9B2MWw8jywprKI8TeY8iqc1&amp;t=638901526312636832\" type=\"text/javascript\"></script>\r\n\r\n\r\n<script src=\"/vitaminshoppe/nettrack/WebResource.axd?d=YsYn_ztMWJ9pqvWCDSGTY8jQ63l6quwzAGk7e7mieOmC2KI_MOLQrvr4I6FNRvC388i1_qh1a2zOMecuCKrZ_MORZvHMrBxFK5wWZnFM5aNM1xx90&amp;t=638901526312636832\" type=\"text/javascript\"></script>\r\n<script type=\"text/javascript\">\r\n//<![CDATA[\r\nfunction WebForm_OnSubmit() {\r\nif (typeof(ValidatorOnSubmit) == \"function\" && ValidatorOnSubmit() == false) return false;\r\nreturn true;\r\n}\r\n//]]>\r\n</script>\r\n\r\n<div class=\"aspNetHidden\">\r\n\r\n\t<input type=\"hidden\" name=\"__VIEWSTATEGENERATOR\" id=\"__VIEWSTATEGENERATOR\" value=\"21D0E819\" />\r\n\t<input type=\"hidden\" name=\"__VIEWSTATEENCRYPTED\" id=\"__VIEWSTATEENCRYPTED\" value=\"\" />\r\n\t<input type=\"hidden\" name=\"__EVENTVALIDATION\" id=\"__EVENTVALIDATION\" value=\"\" />\r\n</div>\r\n    <script id=\"dxss_263068316\" type=\"text/javascript\">\n<!--\nASPx.createControl(ASPxClientCallback,'cbBusinessRules','',{'callBack':function(arg) { WebForm_DoCallback('cbBusinessRules',arg,ASPx.Callback,'cbBusinessRules',ASPx.CallbackError,true); }},{'BeginCallback':clientBusineeRules_BeginCallback,'CallbackComplete':clientBusineeRules_CallbackComplete});\n\n//-->\n</script>\r\n        <div class=\"dxpnlControl_Moderno dxpnl-edge t\" id=\"HeaderControl_topPanel\" style=\"padding-left:0px;padding-right:0px;padding-top:0px;padding-bottom:0px;border-bottom-color:#1D3E6F;border-bottom-style:Solid;border-bottom-width:0px;\">\r\n\t\r\n\t        <nav class=\"navbar navbar-light navbar-main\" style=\"padding: 0 !important;\">\r\n                <div id=\"HeaderControl_topPanel_divHeader\" class=\"nav-container\">\r\n\t                <div class=\"nav\">\r\n\t\t\t\t\t\t