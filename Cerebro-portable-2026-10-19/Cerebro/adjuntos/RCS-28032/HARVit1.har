            "mimeType": "application/x-javascript",
            "text": "function OnStoreLookupRowClick(s, e) {\r\n    var valueField = window.hfStoreLookup.Get('ValueField');\r\n    var str = s.GetText();\r\n    var eid = str.split(';');\r\n    if (eid.length > 1) {\r\n        s.SetText(eid[0].trim() + ' - ' + eid[1] + ', ' + eid[3] + ', ' + eid[4] + ', ' + eid[5]);  //1,3,4,5\r\n        // Check if the element exists\r\n        var hiddenField = document.getElementById('fld_store_storeident_fld_storeno');\r\n        var hiddenField2 = document.getElementById('fld_store_storeident_fld_storeident');\r\n        if (hiddenField !== null) {\r\n            // Set the value only if the element exists\r\n            hiddenField.value = eid[0].trim();\r\n        }\r\n        if (hiddenField2 !== null) {\r\n            // Set the value only if the element exists\r\n            hiddenField2.value = eid[2].trim();\r\n        }\r\n    }\r\n    else {\r\n       // s.SetText('');\r\n    }\r\n\r\n    if (s.GetText().trim() != '' && eid.length > 1) {\r\n        eSpin.Show();\r\n        STORESetSelectedValue(s, eid[2].trim());\r\n    }\r\n}\r\n\r\nfunction SetStoreIDOnPageLoad(s, e) {\r\n    var valueField = window.hfStoreLookup.Get('ValueField');\r\n    var str = s.GetText();\r\n    var eid = str.split(';');\r\n    if (eid.length > 1) {\r\n        s.SetText(eid[0].trim());\r\n    }\r\n    else {\r\n        // s.SetText('');\r\n    }\r\n}\r\n\r\nfunction OnStoreLookupEndCallback(s, e) {\r\n    eSpin.Hide();\r\n}\r\n\r\nfunction STORESetSelectedValue(s, valueFieldValue) {\r\n    var employeeLookupCallbackPanel = eval('StoreLookupCallbackPanel' + s.name);\r\n    if (valueFieldValue.trim() != '') {\r\n        employeeLookupCallbackPanel.PerformCallback(valueFieldValue);\r\n    }\r\n}\r\n\r\nfunction SetStoreInfo(ucontrol, returnValue) {\r\n    eval(ucontrol + '_popup.Hide();')\r\n    eval(ucontrol).SetText(returnValue[1] + ' - ' + returnValue[2] + ', ' + returnValue[6] + ', ' + returnValue[7] + ', ' + returnValue[8]);   //2, 6, 7, 8, 9\r\n    // Check if the element exists\r\n    var hiddenField = document.getElementById('fld_store_storeident_fld_storeno');\r\n    var hiddenField2 = document.getElementById('fld_store_storeident_fld_storeident');\r\n    if (hiddenField !== null) {\r\n        // Set the value only if the element exists\r\n        hiddenField.value = nullcheckzero(returnValue[1]);\r\n    }\r\n    if (hiddenField2 !== null) {\r\n        // Set the value only if the element exists\r\n        hiddenField2.value = nullcheckzero(returnValue[0]);\r\n    }\r\n    eSpin.Show();\r\n    StoreLookupCallbackPanelSTOREID.PerformCallback(returnValue[0]);\r\n    showSelectCaseClass();\r\n}\r\n\r\nfunction ShowStoreFind(popup) {\r\n    eval(popup + '_popup.Show()');\r\n}\r\nfunction nullcheck(fld) {\r\n    var ret = fld;\r\n    if (fld === null) {\r\n        ret = '';\r\n    }\r\n    return ret;\r\n}\r\nfunction nullcheckzero(fld) {\r\n    var ret = fld;\r\n    if (fld === null) {\r\n        ret = '0';\r\n    }\r\n    return ret;\r\n}\r\n\r\nfunction ClearStorelookup(StoreID) {\r\n    STOREID.SetValue(null);\r\n    var comboBox = document.getElementById(StoreID+'_I');\r\n    if (comboBox) { comboBox.value = ''; }\r\n    var hiddenField = document.getElementById('fld_store_storeident_fld_storeno');\r\n    var hiddenField2 = document.getElementById('fld_store_storeident_fld_storeident');\r\n    if (hiddenField !== null) {\r\n        // Set the value only if the element exists\r\n        hiddenField.value = 0;\r\n    }\r\n    if (hiddenField2 !== null) {\r\n        // Set the value only if the element exists\r\n        hiddenField2.value = 0;\r\n    }\r\n}"
          },
