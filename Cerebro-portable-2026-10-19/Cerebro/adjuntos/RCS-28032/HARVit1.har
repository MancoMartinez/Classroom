\t\tdisplay: flex;\r\n\t\tflex-wrap: wrap;\r\n\t\tflex-shrink: 1;\r\n\t\talign-items: center;\r\n\t\tgap: 0.25rem;\r\n\t}\r\n\r\n\t\t.navbar-nav > div .nav-link {\r\n\t\t\tmargin-right: initial;\r\n\t\t}\r\n\r\n\r\n\t.navbar-nav .nav-link:hover,\r\n\t.navbar-nav .nav-item.open > .nav-link {\r\n\t\tbackground: rgba(var(--primary-rgb), 0.3);\r\n\t}\r\n\r\n\r\n\r\n\t/* danger nav link button */\r\n\t.navbar-nav .nav-link.nav-danger .fa {\r\n\t\tcolor: var(--danger-secure);\r\n\t}\r\n\r\n\t.navbar-nav .nav-link.nav-danger:not(.disabled):not(:disabled):hover {\r\n\t\tbackground: var(--danger-secure);\r\n\t}\r\n\r\n\t.navbar-nav .dropdown-menu {\r\n\t\tbackground: var(--modal-background);\r\n\t\tborder: 0;\r\n\t\tborder-top-left-radius: 0;\r\n\t\tborder-top-right-radius: 0;\r\n\t\tmargin-top: 0;\r\n\t\tpadding: 0;\r\n\t\tbox-shadow: 0 2px 5px #444;\r\n\t\tbox-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);\r\n\t\tborder-top: 1px solid var(--modal-hover);\r\n\t}\r\n\r\n.nav-link.disabled:hover ~ .dropdown-menu,\r\n.nav-link:disabled:hover ~ .dropdown-menu {\r\n\tdisplay: none;\r\n}\r\n\r\n.open .dropdown-menu {\r\n\tdisplay: block;\r\n}\r\n\r\n.ribbon-group {\r\n\tdisplay: flex;\r\n}\r\n\r\n\t/* ribbon groups */\r\n\t.ribbon-group > ul {\r\n\t\tpadding: 0 .25rem;\r\n\t\tmargin: 0 .75rem;\r\n\t\tdisplay: flex;\r\n\t\tflex-direction: row;\r\n\t\tlist-style: none;\r\n\t\tposition: relative;\r\n\t\tgap: 0.25rem;\r\n\t}\r\n\r\n\t\t.ribbon-group > ul:before,\r\n\t\t.ribbon-group > ul:after {\r\n\t\t\theight: .75rem;\r\n\t\t\twidth: .125rem;\r\n\t\t\tcontent: '';\r\n\t\t\tdisplay: block;\r\n\t\t\tposition: absolute;\r\n\t\t\ttop: 50%;\r\n\t\t\tz-index: 1;\r\n\t\t\tbackground: rgba(10,10,50, 0.07);\r\n\t\t\tborder-radius: .25rem;\r\n\t\t\ttransform: translateY(-50%);\r\n\t\t}\r\n\r\n\t\t.ribbon-group > ul:before {\r\n\t\t\tleft: -0.325rem;\r\n\t\t}\r\n\r\n\t\t.ribbon-group > ul:after {\r\n\t\t\tright: -0.325rem;\r\n\t\t}\r\n\r\n\t.ribbon-group:first-child ul:before,\r\n\t.ribbon-group:last-child ul:after {\r\n\t\tdisplay: none;\r\n\t}\r\n\r\n\r\n\t.ribbon-group + .ribbon-group > ul {\r\n\t\tpadding-left: 0;\r\n\t\tmargin-left: 0;\r\n\t}\r\n\r\n\t\t.ribbon-group + .ribbon-group > ul:before {\r\n\t\t\tdisplay: none;\r\n\t\t\tpadding-left: 0;\r\n\t\t}\r\n\r\n.dropdown-menu .nav-item {\r\n\tdisplay: block;\r\n\tfloat: none;\r\n\tbackground: var(--modal-background);\r\n\ttext-align: left;\r\n\twidth: auto;\r\n\tmargin: 0;\r\n}\r\n\r\n\t.dropdown-menu .nav-item .nav-link {\r\n\t\tpadding-right: 1.5rem;\r\n\t\twhite-space: nowrap;\r\n\t\twidth: auto;\r\n\t\tmax-width: none;\r\n\t}\r\n\r\n.navbar-nav .dropdown-menu .nav-item .nav-link .fa,\r\n.navbar-nav .dropdown-menu .nav-item .nav-link .fo {\r\n\tcolor: var(--secure-primary-text);\r\n}\r\n\r\n.navbar-nav .dropdown-menu .nav-item .nav-link:hover .fa,\r\n.navbar-nav .dropdown-menu .nav-item .nav-link:hover .fo {\r\n\tcolor: var(--text-contrast);\r\n}\r\n\r\n\r\n.dropdown-toggle::after {\r\n\tborder-width: .25rem;\r\n}\r\n\r\n.disabled .fa,\r\n.disabled .fo,\r\n.nav-link.disabled,\r\n.navbar-nav .disabled .fa,\r\n.dropdown-item :disabled,\r\n.dropdown-item a.disabled,\r\n.dropdown-item a.disabled:hover,\r\n.dropdown-item :disabled .fa,\r\n.nav-link:disabled,\r\n.nav-link:disabled .fa {\r\n\tcolor: var(--text-disabled) !important;\r\n\tbackground: 0 !important;\r\n\tcursor: not-allowed !important;\r\n\tbox-shadow: none !important;\r\n}\r\n\r\n/* sub toolbar */\r\n\r\n/* TODO:ML: Investigate .header-control */\r\n.header-control {\r\n\tbackground: rgba(var(--primary-rgb),0.25);\r\n}\r\n\r\n\t.header-control:hover {\r\n\t\tbackground: rgba(var(--primary-rgb),0.35);\r\n\t}\r\n\r\n\t.header-control:active {\r\n\t\tbackground: rgba(var(--primary-rgb),0.25);\r\n\t}\r\n\r\n\t.header-control:disabled {\r\n\t\tcolor: var(--muted);\r\n\t\tbackground: rgba(255,255,255,0.1);\r\n\t\topacity: .5;\r\n\t\tcursor: not-allowed;\r\n\t}\r\n\r\n\r\n.header-control-btn {\r\n\tpadding: 0 1rem;\r\n}\r\n\r\n\r\n/* */\r\n\r\n.dropdown-item .label {\r\n\tpadding-top: .125rem;\r\n\tposition: relative;\r\n\ttop: .125rem;\r\n}\r\n\r\n\r\n/* ------------*/\r\n\r\n.panel-has-sidebar {\r\n\twidth: calc(100% - 21rem);\r\n\tfloat: right;\r\n\tposition: relative;\r\n\tz-index: 1;\r\n}\r\n\r\n.lightbox .panel-has-sidebar {\r\n\theight: 100%;\r\n}\r\n\r\n.sidebar {\r\n\theight: 100%;\r\n\tposition: relative;\r\n\twidth: 20rem;\r\n\tfont-size: .875rem;\r\n\tpadding: 0 0.75rem;\r\n\toverflow-y: auto;\r\n\tflex-shrink: 0;\r\n}\r\n\r\n\t.sidebar > h3 {\r\n\t\tmargin-left: 1rem;\r\n\t\tmargin-right: 1rem;\r\n\t\tmargin-top: 0.5rem;\r\n\t}\r\n\r\n.lightbox .sidebar {\r\n\tborder-right-color: var(--modal-inner);\r\n}\r\n\r\n#secondary-nav ul:not(#mobile-compass), #secondary-nav ul:not(#mobile-compass) li,\r\n.sidebar ul {\r\n\tlist-style: none;\r\n\tmargin: 0;\r\n\tpadding: 0;\r\n}\r\n\r\n\t#secondary-nav ul:not(#mobile-compass) ul,\r\n\t.sidebar ul ul {\r\n\t\tpadding-left: 1rem;\r\n\t}\r\n\r\n\t#secondary-nav ul:not(#mobile-compass) li a,\r\n\t.sidebar li a {\r\n\t\tpadding: .5rem .5rem .5rem 1rem;\r\n\t}\r\n\r\n\t#secondary-nav ul:not(#mobile-compass) li a,\r\n\t.sidebar li a,\r\n\t.sidebar-item,\r\n\t.node > .node-text {\r\n\t\tcolor: var(--secure-primary-text);\r\n\t\tdisplay: block;\r\n\t\twidth: 100%;\r\n\t\tcursor: pointer;\r\n\t\tborder-radius: 1.5rem;\r\n\t}\r\n\r\n\t\t#secondary-nav ul:not(#mobile-compass) li a:hover,\r\n\t\t.sidebar li a:hover,\r\n\t\t.sidebar-item:hover,\r\n\t\t.node > .node-text:hover {\r\n\t\t\tbackground: rgba(var(--primary-rgb), 0.25);\r\n\t\t}\r\n\r\n\t\t#secondary-nav ul:not(#mobile-compass) li a.selected,\r\n\t\t#secondary-nav ul:not(#mobile-compass) li a.nested-selected,\r\n\t\t.sidebar li a.selected,\r\n\t\t.sidebar-item.selected,\r\n\t\t.node-text.selected-node,\r\n\t\t.node.selected > .node-text,\r\n\t\t.sidebar li a.active,\r\n\t\t.sidebar-item.active {\r\n\t\t\tcolor: var(--secure-primary-text);\r\n\t\t\tbackground: rgba(var(--primary-rgb), 0.5);\r\n\t\t}\r\n\r\n\t\t\t#secondary-nav ul:not(#mobile-compass) li a.selected:hover,\r\n\t\t\t.sidebar li a.selected:hover,\r\n\t\t\t.sidebar-item.selected:hover,\r\n\t\t\t.sidebar li a.active:hover,\r\n\t\t\t.sidebar-item.active:hover,\r\n\t\t\t.node:hover {\r\n\t\t\t\tcursor: default;\r\n\t\t\t}\r\n\r\n\t\t.sidebar li a.disabled,\r\n\t\t.sidebar-item.disabled,\r\n\t\t.sidebar-item:disabled {\r\n\t\t\tcolor: var(--text-disabled) !important;\r\n\t\t\tbackground: 0 !important;\r\n\t\t\tcursor: not-allowed;\r\n\t\t}\r\n\r\n.close-nav {\r\n\tfloat: right;\r\n\tmargin: .25rem;\r\n}\r\n\r\n.mobile-nav-header .close-nav {\r\n\tdisplay: none;\r\n}\r\n\r\n.mobile-nav-header h2 {\r\n\tpadding: .75rem;\r\n\tborder-bottom: 1px solid var(--border-light);\r\n}\r\n\r\n.node-text:hover {\r\n\tcursor: pointer;\r\n}\r\n\r\n.node-container, .sidebar ul {\r\n\tfont-size: .875rem;\r\n\tlist-style: none;\r\n\tmargin: 0;\r\n\tpadding: 0;\r\n}\r\n\r\n\t.node-container .node-container {\r\n\t\tpadding-left: 1rem;\r\n\t}\r\n\r\n.node {\r\n\tposition: relative;\r\n}\r\n\r\n.node-text {\r\n\theight: 2rem;\r\n\tline-height: 2rem;\r\n}\r\n\r\n.node-text, .sidebar-item {\r\n\tcolor: var(--muted);\r\n\tdisplay: block;\r\n\tline-height: 1.125rem;\r\n\tpadding: .5rem .75rem;\r\n\toverflow: hidden;\r\n\twhite-space: nowrap;\r\n\t-moz-text-overflow: ellipsis;\r\n\ttext-overflow: ellipsis;\r\n\ttext-align: left;\r\n}\r\n\r\n.sidebar-item {\r\n\tpadding-left: 2.25rem;\r\n}\r\n\r\n\t.node-text:hover, .node-text:focus, .sidebar-item:hover, .sidebar-item:focus {\r\n\t\tbackground: rgba(var(--primary-rgb), 0.25);\r\n\t\tcolor: var(--secure-primary-text);\r\n\t}\r\n\r\n.node-text.selected {\r\n\tborder-left: 2px solid var(--primary-base);\r\n\tmargin-left: -2px;\r\n\tcolor: var(--secure-primary-text);\r\n\tbackground-color: var(--table-row-hover);\r\n}\r\n\r\n.node-icon {\r\n\tcolor: var(--secure-primary-text);\r\n\tmargin-right: .5rem;\r\n\tfont-weight: bold;\r\n}\r\n\r\n.selected > .node-text .node-icon {\r\n\tcolor: var(--secure-primary-text);\r\n}\r\n\r\n.node-collapse {\r\n\tpadding-right: 1rem;\r\n\twidth: 1.25rem;\r\n}\r\n\r\n\t.node-collapse.hide-toggle:before {\r\n\t\tcontent: '' !important;\r\n\t}\r\n\r\n.node-label-wrapper {\r\n\tpadding-left: 2.25rem;\r\n}\r\n\r\nspan.add-link .fa {\r\n\tmargin-right: .5rem;\r\n}\r\n\r\nspan.add-link-no-color {\r\n\tpadding: 0.5rem 0;\r\n\tdisplay: block;\r\n}\r\n\r\nspan.add-link {\r\n\tpadding: 0.5rem 0;\r\n\tdisplay: block;\r\n\tcolor: var(--secure-primary-text);\r\n}\r\n\r\n.search-expandable, #navigation-bar {\r\n\tdisplay: none;\r\n}\r\n\r\n.navbar-nav a:hover, #secondary-nav li a:hover, #secondary-nav li a:focus {\r\n\ttext-decoration: none;\r\n}\r\n\r\n/* Properties Panels */\r\n\r\n\r\n.prop-panel-section {\r\n\tpadding: .75rem;\r\n}\r\n\r\n\r\n\t.prop-panel-section .form-control,\r\n\t.prop-panel-section .select-wrapper {\r\n\t\twidth: 100%;\r\n\t\tmax-width: none;\r\n\t}\r\n\r\n.prop-panel-control label {\r\n\tdisplay: inline-block;\r\n}\r\n\r\n.prop-panel-section .input-group [ng-include] .fa-question-circle,\r\n.prop-panel-section .input-group [ng-include] .help-link {\r\n\tdisplay: none;\r\n}\r\n\r\n\r\n/* Breadcrumbs */\r\n\r\n.breadcrumb {\r\n\tbackground: 0;\r\n\tmargin: 0;\r\n\tdisplay: block;\r\n}\r\n\r\n#compass {\r\n\tpadding: .75rem 0 0;\r\n\tfloat: left;\r\n}\r\n\r\n#mobile-compass {\r\n\tpadding: 0 .75rem .75rem;\r\n\tfont-size: 1rem;\r\n}\r\n\r\n.breadcrumb li {\r\n\tcolor: var(--muted);\r\n}\r\n\r\n.breadcrumb-item + .breadcrumb-item:before {\r\n\tcontent: '\\f105';\r\n\tfont-family: 'Font Awesome 6 Pro', 'icoMoon';\r\n\tcolor: var(--text-disabled);\r\n\tline-height: 1rem;\r\n\tfont-weight: 300;\r\n}\r\n\r\n.breadcrumb a {\r\n\tcolor: var(--secure-primary-text);\r\n}\r\n\r\n.breadcrumb-last-item-text {\r\n\tdisplay: none;\r\n}\r\n\r\n/* Mobile */\r\n.tasks-button {\r\n\tposition: relative;\r\n\ttop: .5rem;\r\n}\r\n\r\n\t.tasks-button.mobile-open {\r\n\t\tbackground: rgba(var(--primary-rgb), 0.25);\r\n\t\tcolor: var(--secure-primary-text);\r\n\t}\r\n\r\n.tasks-popout .nav-link,\r\n.tasks-popout .dropdown-item a {\r\n\tfont-size: .9375rem;\r\n}\r\n\r\n.tasks-popout .nav-link {\r\n\tpadding: .5rem .5rem .5rem 2rem;\r\n\twhite-space: nowrap;\r\n\tposition: relative;\r\n\twidth: 100%;\r\n}\r\n\r\n.tasks-popout .nav-item:not(:last-child) .nav-link {\r\n\tborder-bottom: 1px solid var(--border-light);\r\n}\r\n\r\n.tasks-popout .fa {\r\n\tposition: absolute;\r\n\tleft: .25rem;\r\n\ttop: .75rem;\r\n}\r\n\r\n.tasks-popout {\r\n\tpadding: 0 .5rem;\r\n}\r\n\r\n\t.tasks-popout .dropdown-item {\r\n\t\tposition: relative;\r\n\t}\r\n\r\n\t\t.tasks-popout .dropdown-item a {\r\n\t\t\tpadding: .5rem 1rem .5rem 2rem;\r\n\t\t}\r\n\r\n\t.tasks-popout .dropdown-menu {\r\n\t\tposition: absolute;\r\n\t\ttop: 0;\r\n\t\tleft: 105%;\r\n\t\tpadding: 0 .5rem;\r\n\t\toverflow-y: auto;\r\n\t\toverflow-x: hidden;\r\n\t\twhite-space: nowrap;\r\n\t\tmax-height: 16rem;\r\n\t\t-webkit-overflow-scrolling: touch;\r\n\t}\r\n\r\n\t.tasks-popout .nav-item {\r\n\t\tposition: relative;\r\n\t}\r\n\r\n/* Hidden chrome */\r\n\r\n.chrome-hidden .app-menu {\r\n\tdisplay: none;\r\n}\r\n\r\n.header {\r\n\twidth: 100%;\r\n}\r\n\r\n\r\n\r\n/* Searches menu in Nav */\r\n\r\n.search-item {\r\n\tpadding: .5rem;\r\n}\r\n\r\n\t.search-item + .search-item {\r\n\t\tborder-top: 1px solid var(--border-light);\r\n\t}\r\n\r\n.search-item-details {\r\n\tflex: 1 1 auto;\r\n}\r\n\r\n\t.search-item-details div {\r\n\t\tdisplay: inline-block;\r\n\t}\r\n\r\n.search-item-details, .search-item-buttons, .search-item-icons {\r\n\tpadding: 0 .25rem;\r\n}\r\n\r\n.search-item-buttons,\r\n.search-item-icons {\r\n\tflex: 0 0 auto;\r\n\talign-items: center;\r\n\tdisplay: flex;\r\n\talign-self: flex-start;\r\n}\r\n\r\n.search-item-icons {\r\n\tpadding-top: 0.25rem;\r\n}\r\n\r\n\r\n\r\n/** Impersonation */\r\n\r\n\r\n#imp-switch-usermenu {\r\n\tbackground: 0;\r\n\tpadding: 0;\r\n\tmargin: 0;\r\n}\r\n\r\n\t#imp-switch-usermenu .title {\r\n\t\tfont-weight: 500;\r\n\t\tcolor: var(--secure-primary-text);\r\n\t\tfont-size: 1.125rem;\r\n\t}\r\n\r\n\t#imp-switch-usermenu .form-control-icon {\r\n\t\tdisplay: none;\r\n\t}\r\n\r\n\t#imp-switch-usermenu .fs-selected {\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n#user-domain-select {\r\n\tpadding-left: 3.5rem;\r\n}\r\n\r\n/* Responsive Styles */\r\n\r\n/* --- keyframes --- */\r\n@keyframes sidebar-wiggle {\r\n\t0% {\r\n\t\ttransform: translateX(-19rem);\r\n\t}\r\n\r\n\t25% {\r\n\t\ttransform: translateX(-18.25rem);\r\n\t}\r\n\r\n\t50% {\r\n\t\ttransform: translateX(-19rem);\r\n\t}\r\n\r\n\t75% {\r\n\t\ttransform: translateX(-18.25rem);\r\n\t}\r\n\r\n\t100% {\r\n\t\ttransform: translateX(-19rem);\r\n\t}\r\n}\r\n\r\n@keyframes spinner-bar {\r\n\t0% {\r\n\t\tleft: -14rem;\r\n\t\topacity: 0;\r\n\t}\r\n\r\n\t10% {\r\n\t\topacity: 1;\r\n\t}\r\n\r\n\t90% {\r\n\t\tleft: calc(100% + 14rem);\r\n\t\topacity: 1;\r\n\t}\r\n\r\n\t100% {\r\n\t\topacity: 0;\r\n\t}\r\n}\r\n\r\n/* *** Breakpoints *** */\r\n/*@media screen and (max-width: 1023px) {*/\r\n@media screen and (max-width: 991px) {\r\n\r\n\t#main-nav {\r\n\t\tposition: absolute;\r\n\t\ttop: 3.75rem;\r\n\t\tleft: calc(40%);\r\n\t\tleft: -webkit-calc(40%);\r\n\t\tleft: -moz-calc(40%);\r\n\t\ttransform: translateX(-50%);\r\n\t\tbackground: var(--modal-background);\r\n\t\tborder-radius: 1rem;\r\n\t\tmax-width: 90vw;\r\n\t\twidth: auto;\r\n\t\tbox-shadow: 2px 4px 12px rgba(10,10,30,0.2);\r\n\t\tvisibility: hidden;\r\n\t\topacity: 0;\r\n\t\ttransition: opacity 0.2s ease;\r\n\t\tmax-height: 90vh;\r\n\t\tflex-direction: column;\r\n\t}\r\n\r\n\t\t#main-nav.toolbar-visible {\r\n\t\t\tvisibility: visible;\r\n\t\t\tflex-direction: column;\r\n\t\t\topacity: 1;\r\n\t\t}\r\n\r\n\t\t#main-nav > div {\r\n\t\t\tflex-direction: column;\r\n\t\t\twidth: 100%;\r\n\t\t}\r\n\r\n\t\t#main-nav > #react-toolbar-root {\r\n\t\t\twidth: fit-content;\r\n\t\t\tmax-width: 100%;\r\n\t\t\talign-self: center;\r\n\t\t}\r\n\r\n\t.navbar-nav .nav-item {\r\n\t\tflex: 1;\r\n\t\twidth: 100%;\r\n\t\tmargin: 0.25rem 0;\r\n\t}\r\n\r\n\t.toolbar-toggle {\r\n\t\tmargin: 5px;\r\n\t\talign-self: center;\r\n\t}\r\n\r\n\t.toolbar-noitems .toolbar-noitems-message {\r\n\t\tdisplay: block;\r\n\t}\r\n\r\n\t.app-menu-bottom {\r\n\t\tpadding: .25rem .5rem !important;\r\n\t}\r\n\r\n\t.app-menu-right {\r\n\t\tmax-width: max-content;\r\n\t}\r\n\r\n\t.page-title {\r\n\t\tfont-size: 1.25rem;\r\n\t\tline-height: 1.25rem;\r\n\t\tpadding-bottom: .25rem;\r\n\t}\r\n\r\n\t.charm-shortcuts {\r\n\t\tdisplay: none !important;\r\n\t}\r\n\r\n\r\n\t.sidebar {\r\n\t\tposition: fixed;\r\n\t\ttop: 3.25rem;\r\n\t\tleft: 0;\r\n\t\tbottom: 0;\r\n\t\tbackground: var(--table-row);\r\n\t\tz-index: 50;\r\n\t\theight: auto;\r\n\t\tpadding: 1rem !important;\r\n\t\tbox-shadow: 0 2px 12px rgba(10,10,30,0.24);\r\n\t\tleft: 0;\r\n\t\ttransform: translateX(-19rem);\r\n\t\twidth: 20rem;\r\n\t\ttransition: transform 0.3s ease-in-out, background 0.2s ease, box-shadow 0.2s ease;\r\n\t\tbox-shadow: 0 2px 12px rgba(10,10,30,0.24);\r\n\t\tanimation: sidebar-wiggle 0.75s 0.3s ease;\r\n\t\toverflow: hidden;\r\n\t}\r\n\r\n\t\t.sidebar.sidebar-open {\r\n\t\t\ttransform: translateX(0);\r\n\t\t\tbackground: white;\r\n\t\t\tbox-shadow: 0 2px 18px rgba(10,10,30,0.28);\r\n\t\t\tanimation: none;\r\n\t\t\toverflow-y: auto;\r\n\t\t}\r\n\r\n\t.panel-has-sidebar {\r\n\t\twidth: calc(100% - 2rem);\r\n\t\tleft: 1.5rem;\r\n\t}\r\n\r\n\t.sidebar {\r\n\t\tmax-width: 20rem;\r\n\t}\r\n\r\n\t\t.sidebar:after {\r\n\t\t\tdisplay: block;\r\n\t\t\tposition: absolute;\r\n\t\t\tcontent: '\\f0da';\r\n\t\t\ttop: 50%;\r\n\t\t\ttransform: translateY(-50%);\r\n\t\t\tright: .25rem;\r\n\t\t\tfont-size: 0.875rem;\r\n\t\t\tcolor: var(--muted);\r\n\t\t\tfont-family: 'Font Awesome 6 Pro';\r\n\t\t\tfont-weight: bold;\r\n\t\t\topacity: 1;\r\n\t\t\ttransition: opacity 0.2s ease;\r\n\t\t}\r\n\r\n\t\t.sidebar.sidebar-open:after {\r\n\t\t\topacity: 0;\r\n\t\t}\r\n}\r\n\r\n@media screen and (max-width: 991px) {\r\n\t.mobile-nav-header .close-nav {\r\n\t\tdisplay: block;\r\n\t}\r\n\r\n\t.app-logo {\r\n\t\tpadding: 0 .5rem;\r\n\t}\r\n}\r\n\r\n@media screen and (max-width: 799px) {\r\n\r\n\t#main-nav {\r\n\t\tleft: 80%;\r\n\t}\r\n\r\n\t.icon-nav-icon + .fa-stack-1x {\r\n\t\ttop: 0px;\r\n\t}\r\n\r\n\t.toolbar-toggle {\r\n\t\tmargin: 0.625rem 1rem 0.5rem auto;\r\n\t}\r\n\r\n\t#allappsToolbarButton, .icon-nav {\r\n\t\tposition: fixed;\r\n\t\tbottom: 0;\r\n\t\tleft: 0;\r\n\t}\r\n\r\n\t#allappsToolbarButton {\r\n\t\tz-index: 1;\r\n\t\tborder-radius: 0 1rem 0 0;\r\n\t}\r\n\r\n\t.all-apps-toggle-curve {\r\n\t\tbottom: 0;\r\n\t\ttop: auto;\r\n\t\ttransform: rotate(270deg);\r\n\t}\r\n\r\n\t#main-toolbar {\r\n\t\tflex-direction: column;\r\n\t}\r\n\r\n\t.app-menu-right {\r\n\t\tmax-width: max-content;\r\n\t}\r\n\r\n\t.table-count {\r\n\t\tdisplay: none;\r\n\t}\r\n\r\n\t.compass {\r\n\t\tfont-size: .75rem;\r\n\t}\r\n\r\n\t\t.compass li:before {\r\n\t\t\tfont-size: 0.675rem;\r\n\t\t\tpadding: 0;\r\n\t\t\tmargin: 0 0.25rem;\r\n\t\t}\r\n\r\n\t.icon-nav {\r\n\t\twidth: 100%;\r\n\t\tpadding: .5rem 1rem;\r\n\t\tpadding-left: 1rem;\r\n\t\tdisplay: flex;\r\n\t\talign-items: center;\r\n\t\tjustify-content: center;\r\n\t\tpadding-left: 4.5rem;\r\n\t\tbackground: white;\r\n\t\theight: 3.25rem;\r\n\t\tbox-shadow: -2px 0 12px rgba(10,10,20,0.2);\r\n\t\tjustify-content: space-around;\r\n\t}\r\n\r\n\t.icon-nav-icon {\r\n\t\tfont-size: 2rem;\r\n\t}\r\n\r\n\t.icon-nav-btn > .caret {\r\n\t\tbottom: auto;\r\n\t\ttop: -0.75rem;\r\n\t}\r\n\r\n\t\t.icon-nav-btn > .caret:before {\r\n\t\t\tcontent: '\\f0d8';\r\n\t\t}\r\n\r\n\t.icon-nav .dropdown .dd-menu {\r\n\t\tposition: fixed;\r\n\t\tleft: 0 !important;\r\n\t\tright: 0 !important;\r\n\t\tbottom: 3.25rem;\r\n\t}\r\n\r\n\t.sidebar {\r\n\t\tbottom: 3.25rem;\r\n\t}\r\n}\r\n\r\n@media (max-width: 576px) {\r\n\r\n\t#main-nav {\r\n\t\tleft: 70%;\r\n\t}\r\n}\r\n\r\n\r\n@media screen and (max-width: 480px) {\r\n\r\n\t.app-menu-right {\r\n\t\tmin-width: unset;\r\n\t\tmax-width: unset;\r\n\t}\r\n\r\n\t\t.app-menu-right div div.d-flex {\r\n\t\t\tflex-flow: row;\r\n\t\t\tflex-wrap: wrap;\r\n\t\t}\r\n\r\n\t\t\t.app-menu-right div div.d-flex div.d-flex.align-items-center {\r\n\t\t\t\tflex: 1 1 auto;\r\n\t\t\t}\r\n\r\n\t\t\t.app-menu-right div div.d-flex:first-child {\r\n\t\t\t\tmargin-bottom: 5px;\r\n\t\t\t}\r\n\r\n\t\t\t.app-menu-right div div.d-flex:nth-child(2) {\r\n\t\t\t\tflex-flow: row-reverse;\r\n\t\t\t\tjustify-content: left;\r\n\t\t\t}\r\n}\r\n\r\n@media (-webkit-min-device-pixel-ratio: 1.25), (min-resolution: 120dpi) {\r\n\r\n\t.logo-lores {\r\n\t\tdisplay: none;\r\n\t}\r\n\r\n\t.logo-hires {\r\n\t\tdisplay: block;\r\n\t}\r\n}\r\n\n\n/* ========================================\n * Source: Components/src/styles/Cpf/Content/Styles/new/n_notifications.css\n * ======================================== */\n\n/* Notifications Styles */\r\n#notifications-wrapper {\r\n    position: relative;\r\n    height: 100%;\r\n    display: flex;\r\n}\r\n\r\n.preview-wrapper\r\n#detail-view-wrapper {\r\n    height: 100%;\r\n}\r\n\r\n#nodes {\r\n    width: 100%;\r\n}\r\n\r\n.preview-wrapper {\r\n    width: 32rem;\r\n    display: -webkit-box;\r\n    display: -ms-flexbox;\r\n    display: flex;\r\n    -webkit-box-orient: vertical;\r\n    -webkit-box-direction: normal;\r\n    -ms-flex-direction: column;\r\n    flex-direction: column;\r\n}\r\n\r\n#preview-list {\r\n    height: 100%;\r\n    overflow: auto;\r\n    padding: 0 0.5rem;\r\n}\r\n\r\n#detail-view-wrapper {\r\n    flex: 1;\r\n    height: 100%;\r\n    overflow-y: auto;\r\n}\r\n\r\n.preview-item {\r\n    padding: .5rem;\r\n}\r\n\r\n    .preview-item p {\r\n        padding-bottom: 10px;\r\n    }\r\n\r\n    .preview-item.t-row {\r\n        border-top: 0;\r\n    }\r\n\r\n.preview-item-checkbox {\r\n    float: left;\r\n    height: 1.25rem;\r\n}\r\n\r\n.preview-item:hover {\r\n    cursor: pointer;\r\n    background: var(--notification-hover);\r\n}\r\n\r\n.preview-item .preview-unread-indicator {\r\n    display: none;\r\n    font-size: 0.5625rem;\r\n    position: relative;\r\n    bottom: 0.125rem;\r\n    margin-right: 0.25rem;\r\n}\r\n\r\n.preview-item-info {\r\n    padding: .5rem;\r\n    padding-left: 1rem;\r\n    position: relative;\r\n}\r\n\r\n\r\n.preview-options {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    padding: .6125rem .5rem 0;\r\n}\r\n\r\n.preview-item.preview-item-selected .preview-options {\r\n    border-color: rgba(var(--primary-rgb), 0.25);\r\n}\r\n\r\n.preview-date-created {\r\n    float: right;\r\n    color: var(--muted);\r\n}\r\n\r\n.preview-item.has-read-false {\r\n    font-weight: bold;\r\n}\r\n\r\n.preview-top .fa {\r\n    margin-right: .5rem;\r\n    color: sandybrown;\r\n}\r\n\r\n#notification-icon {\r\n    margin-right: .5rem;\r\n    color: sandybrown;\r\n}\r\n\r\n.selected-preview-item {\r\n    background: rgba(var(--primary-rgb), 0.2);\r\n}\r\n\r\n.preview-item-info:before {\r\n    width: 3px;\r\n    height: auto;\r\n    content: '';\r\n    display: block;\r\n    background: rgb(91, 200, 217);\r\n    position: absolute;\r\n    top: 0.5rem;\r\n    left: -0.25rem;\r\n    bottom: 0.5rem;\r\n    border-radius: 1rem;\r\n    opacity: 0;\r\n    transition: opacity 0.2s ease;\r\n}\r\n\r\n\r\n.selected-preview-item .preview-item-info:before {\r\n    opacity: 1;\r\n}\r\n\r\n.preview-wrapper .sort-seperator {\r\n    padding: 0.75rem 0.5rem;\r\n    text-transform: uppercase;\r\n    font-size: 0.75rem;\r\n    text-align: center;\r\n    font-weight: bold;\r\n    color: var(--muted);\r\n}\r\n\r\n#sort-filter {\r\n    padding: 0 0.5rem 0.5rem;\r\n}\r\n\r\n#notification-preview #filter-by-search {\r\n    border: 1px solid var(--section-border);\r\n}\r\n\r\n#hide-details-view {\r\n    position: absolute;\r\n    top: 0.5rem;\r\n    left: 0.5rem;\r\n}\r\n\r\n.subjects-wrapper {\r\n    clear: both;\r\n    background: var(--section-background);\r\n    border: 1px solid var(--section-border);\r\n    padding: .5rem 0;\r\n    border-radius: .125rem;\r\n}\r\n\r\n.subject-value {\r\n    hyphens: auto;\r\n    overflow-wrap: break-word;\r\n    word-break: break-word;\r\n    word-wrap: break-word;\r\n}\r\n\r\n\r\n.attachments-wrapper a {\r\n    border: 1px solid var(--section-border);\r\n    padding: .25rem .5rem;\r\n    display: inline-block;\r\n}\r\n\r\n    .attachments-wrapper a:hover {\r\n        text-decoration: none;\r\n        border-color: rgba(var(--primary-rgb), 0.25);\r\n    }\r\n\r\n    .attachments-wrapper a > div {\r\n        display: inline-block;\r\n    }\r\n\r\n#load-more-preview-items, #loading-more-preview-items {\r\n    text-align: center;\r\n    font-size: .875rem;\r\n    padding: 1rem;\r\n}\r\n\r\n#notification-banner {\r\n    padding: 0.385rem 0.875rem;\r\n    color: var(--text-contrast);\r\n    margin-top: 1rem;\r\n}\r\n\r\n    #notification-banner.escalated {\r\n        background: var(--danger-secure);\r\n    }\r\n\r\n    #notification-banner.delegated {\r\n        background: var(--warning-secure);\r\n    }\r\n\r\n#detail-view .header {\r\n    background: 0;\r\n    padding: 0;\r\n    box-shadow: none;\r\n    position: static;\r\n}\r\n\r\n#detail-view {\r\n    padding: 2rem;\r\n}\r\n\r\n.sub-heading span {\r\n    font-size: inherit;\r\n    padding-right: .5rem;\r\n}\r\n\r\n.attachments-wrapper {\r\n    margin-bottom: .5rem;\r\n    padding: .5rem;\r\n}\r\n\r\n.notification-attachment {\r\n    margin: .2rem;\r\n    border-radius: .5rem;\r\n    padding: 0.5rem;\r\n    border: 1px solid #d0dde8;\r\n    display: inline-block;\r\n    width: 15rem;\r\n    float: left;\r\n}\r\n\r\n.attachment-type {\r\n    text-transform: uppercase;\r\n    font-weight: bold;\r\n    font-size: 85%;\r\n}\r\n\r\n.notification-attachment span.fa, .notification-attachment span.attachment-type {\r\n    color: var(--muted);\r\n}\r\n\r\n.notification-attachment span.attachment-name {\r\n    color: var(--secure-primary-text);\r\n}\r\n\r\n.notification-body {\r\n    background-color: white;\r\n    padding: 1rem;\r\n}\r\n\r\n.notification-dyno-view .dyno-view-body {\r\n    overflow: visible;\r\n    background: 0;\r\n    padding: 1rem 0 0;\r\n}\r\n\r\n@media screen and (max-width: 1339px) {\r\n    .preview-wrapper {\r\n        width: 26rem;\r\n    }\r\n\r\n    #detail-view-wrapper {\r\n        width: calc(100% - 26rem);\r\n    }\r\n}\r\n\r\n.notification-title {\r\n    border: 0;\r\n    color: var(--secure-primary-text);\r\n    font-size: 1.75rem;\r\n}\r\n\r\n/* Restore list indentation inside notification bodies. The global reset\r\n   (ul, ol { padding: 0 }) zeroes bullet indentation, which pushes markers\r\n   outside the shaded card. Scope the restore to the body wrapper only. */\r\n.notification-text-body ul,\r\n.notification-text-body ol {\r\n    padding-left: 1.5rem;\r\n    margin: 0.25rem 0;\r\n}\r\n\r\n.notification-text-body li {\r\n    margin-bottom: 0.25rem;\r\n}\r\n\r\n.notification-text-body ul {\r\n    list-style: disc outside;\r\n}\r\n\r\n.notification-text-body ol {\r\n    list-style: decimal outside;\r\n}\r\n\n\n/* ========================================\n * Source: Components/src/styles/Cpf/Content/Styles/new/platform-help.css\n * ======================================== */\n\n﻿/* platform help related style */\r\n/*\r\n    ===================================\r\n    components\r\n    ===================================\r\n*/\r\n/* inline help directive */\r\n\r\nsng-local-help-item,\r\n[sng-local-help-item] {\r\n    display: inline-block;\r\n    white-space: nowrap;\r\n}\r\n\r\nsng-local-help-item a,\r\nsng-local-help-item button,\r\n[sng-local-help-item] a,\r\n[sng-local-help-item] button {\r\n    display: inline-block;\r\n    position: relative;\r\n    z-index: 1;\r\n    top: auto;\r\n    float: none;\r\n    vertical-align: middle;\r\n    text-align: center;\r\n    border-radius: 50%;\r\n    line-height: 1;\r\n    border: none;\r\n}\r\n\r\nsng-local-help-item a:focus,\r\nsng-local-help-item button:focus,\r\n[sng-local-help-item] a:focus,\r\n[sng-local-help-item] button:focus {\r\n    border: none;\r\n    box-shadow: none;\r\n}\r\n\r\nsng-local-help-item .help-icon,\r\nsng-local-help-item .help-icon,\r\n[sng-local-help-item] .help-icon,\r\n[sng-local-help-item] .help-icon {\r\n    z-index: 1;\r\n    top: auto;\r\n    float: none;\r\n    margin-left: auto;\r\n    font-size: 1.25rem;\r\n}\r\n\r\nsng-local-help-item .help-icon:before,\r\nsng-local-help-item .help-icon:before,\r\n[sng-local-help-item] .help-icon:before,\r\n[sng-local-help-item] .help-icon:before {\r\n    content: '\\f29c';\r\n    color: var(--accent);\r\n}\r\n\n\n/* ========================================\n * Source: Components/src/styles/Cpf/Content/Styles/new/n_scrollbars.css\n * ======================================== */\n\n﻿\n\n/* ========================================\n * Source: Components/src/styles/Cpf/Content/Styles/new/n_sng-fullscreen.css\n * ======================================== */\n\n/* custom rules for sngFullscreen controls */\r\n.lightbox-title .sng-fullscreen-btn:hover {\r\n\tcolor: var(--secure-primary-text);\r\n\tbackground: rgba(var(--primary-rgb), 0.35);\r\n}\r\n\r\n.lightbox-title .sng-fullscreen-btn {\r\n\tposition: absolute;\r\n\ttop: .875rem;\r\n\tright: calc(1.25rem + 2 * .875rem);\r\n\tfont-size: 1.25rem;\r\n\tcursor: pointer;\r\n\tz-index: 101;\r\n\tcolor: var(--text-contrast);\r\n\tborder-radius: 1rem;\r\n}\r\n\r\n.lightbox-title .sng-fullscreen-btn:focus {\r\n    outline: 0;\r\n    -webkit-box-shadow: 0 0 0 3px rgba(var(--primary-rgb), .5);\r\n    box-shadow: 0 0 0 3px rgba(var(--primary-rgb), .5);\r\n    color: var(--accent);\r\n}\r\n\r\n.lightbox-title .sng-fullscreen-btn.lightbox-close {\r\n\tcolor: var(--secure-primary-text);\r\n}\r\n\n\n/* ========================================\n * Source: Components/src/styles/Cpf/Content/Styles/new/n_utilities.css\n * ======================================== */\n\n\r\n/* Load indicator classes */\r\n\r\n.load-indicator {\r\n    padding: 5%;\r\n    -webkit-backface-visibility: hidden;\r\n    backface-visibility: hidden;\r\n    min-height: 5rem;\r\n}\r\n\r\n    .load-indicator.full {\r\n        position: absolute;\r\n        top: 0;\r\n        left: 0;\r\n        right: 0;\r\n        bottom: 0;\r\n        background: var(--section-background);\r\n        height: auto;\r\n        z-index: 10;\r\n    }\r\n\r\n    .load-indicator.data-grid {\r\n        position: absolute;\r\n        top: 0;\r\n        left: 0;\r\n        right: 0;\r\n        bottom: 0;\r\n        background: var(--section-background);\r\n        height: auto;\r\n        z-index: 5;\r\n        padding: 0%;\r\n        width: 100%;\r\n    }\r\n\r\n.load-indicator:not(.load-error) > div,\r\n.load-indicator:not(.load-error) > div:before,\r\n.load-indicator:not(.load-error) > div:after {\r\n    -webkit-backface-visibility: hidden;\r\n    backface-visibility: hidden;\r\n    -webkit-animation: load-ind 1.5s infinite ease-in-out;\r\n    animation: load-ind 1.5s infinite ease-in-out;\r\n    background: var(--default-text);\r\n    height: 2rem;\r\n    width: 0.5rem;\r\n    border-radius: 0.25rem;\r\n}\r\n\r\n.load-indicator > div {\r\n    -webkit-backface-visibility: hidden;\r\n    backface-visibility: hidden;\r\n    position: absolute;\r\n    left: 50%;\r\n    top: 40%;\r\n    margin-top: -1rem;\r\n    opacity: 0.25;\r\n}\r\n\r\n.load-indicator-light:not(.load-error) > div,\r\n.load-indicator-light:not(.load-error) > div:before,\r\n.load-indicator-light:not(.load-error) > div:after {\r\n    -webkit-backface-visibility: hidden;\r\n    backface-visibility: hidden;\r\n    -webkit-animation: load-ind-light 1.5s infinite ease-in-out;\r\n    animation: load-ind-light 1.5s infinite ease-in-out;\r\n    background: var(--text-contrast);\r\n}\r\n\r\n.load-indicator-mini {\r\n    min-height: 1.5rem;\r\n    padding: 0.5rem;\r\n    position: relative;\r\n    text-align: center;\r\n}\r\n\r\n.load-indicator-mini > div {\r\n    margin-top: -0.125rem;\r\n    display: inline-block;\r\n    position: relative;\r\n}\r\n\r\n.load-indicator-mini > div,\r\n.load-indicator-mini > div:before,\r\n.load-indicator-mini > div:after {\r\n    -webkit-animation: load-ind-m 1s infinite ease-in-out;\r\n    animation: load-ind-m 1s infinite ease-in-out;\r\n    background: var(--text-disabled);\r\n    height: 0.5rem;\r\n    width: 0.5rem;\r\n    border-radius: 0.5rem;\r\n}\r\n\r\n.load-indicator:not(.load-error) > div,\r\n.load-indicator-mini > div {\r\n    -webkit-animation-delay: -0.2s;\r\n    animation-delay: -0.2s;\r\n    margin-left: -0.25rem;\r\n}\r\n\r\n.load-indicator.load-error > div {\r\n    width: 5rem;\r\n    text-align: center;\r\n    font-size: 3rem;\r\n    margin-left: -2.5rem;\r\n    margin-top: -3rem;\r\n    color: var(--text-disabled);\r\n}\r\n\r\n.load-indicator.load-error > div:before {\r\n    content: \"\\f071\";\r\n    font-family: \"FontAwesome\";\r\n    display: inline-block;\r\n}\r\n\r\n.load-indicator:not(.load-error) > div:before,\r\n.load-indicator:not(.load-error) > div:after,\r\n.load-indicator-mini > div:after,\r\n.load-indicator-mini > div:before {\r\n    content: \"\";\r\n    position: absolute;\r\n    top: 0;\r\n}\r\n\r\n.load-indicator:not(.load-error) > div:before,\r\n.load-indicator-mini > div:before {\r\n    animation-delay: -0.4s;\r\n    left: -1.25rem;\r\n    -webkit-animation-delay: -0.4s;\r\n}\r\n\r\n.load-indicator-mini > div:after,\r\n.load-indicator > div:after {\r\n    left: 1.25rem;\r\n}\r\n\r\n#page > .load-indicator > div {\r\n    top: 15rem;\r\n}\r\n\r\n.load-indicator .load-text {\r\n    display: block;\r\n    font-size: 1.5rem;\r\n    color: var(--text-disabled);\r\n    text-align: center;\r\n    margin-top: 2rem;\r\n}\r\n\r\n.progress-indicator {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    bottom: 0;\r\n    right: 0;\r\n    background: var(--table-row);\r\n    padding: 2rem;\r\n    z-index: 6;\r\n    -webkit-transition: opacity 0.4s 0.2s ease;\r\n    transition: opacity 0.4s 0.2s ease;\r\n    opacity: 1;\r\n}\r\n\r\n.progress-indicator.ng-hide-remove {\r\n    opacity: 1;\r\n    display: block !important;\r\n}\r\n\r\n.progress-indicator.ng-hide {\r\n    opacity: 0;\r\n}\r\n\r\n@-webkit-keyframes load-ind {\r\n    0%,\r\n    90%,\r\n    100% {\r\n        -webkit-box-shadow: 0 0 var(--default-text);\r\n        box-shadow: 0 0 var(--default-text);\r\n        height: 1.5rem;\r\n    }\r\n\r\n    45% {\r\n        -webkit-box-shadow: 0 -0.75rem var(--default-text);\r\n        box-shadow: 0 -0.75rem var(--default-text);\r\n        height: 2rem;\r\n    }\r\n}\r\n\r\n@keyframes load-ind {\r\n    0%,\r\n    90%,\r\n    100% {\r\n        -webkit-box-shadow: 0 0 var(--default-text);\r\n        box-shadow: 0 0 var(--default-text);\r\n        height: 1.5rem;\r\n    }\r\n\r\n    45% {\r\n        -webkit-box-shadow: 0 -0.75rem var(--default-text);\r\n        box-shadow: 0 -0.75rem var(--default-text);\r\n        height: 2rem;\r\n    }\r\n}\r\n\r\n@-webkit-keyframes load-ind-light {\r\n    0%,\r\n    90%,\r\n    100% {\r\n        -webkit-box-shadow: 0 0 var(--text-contrast);\r\n        box-shadow: 0 0 var(--text-contrast);\r\n        height: 1.5rem;\r\n    }\r\n\r\n    45% {\r\n        -webkit-box-shadow: 0 -0.75rem var(--text-contrast);\r\n        box-shadow: 0 -0.75rem var(--text-contrast);\r\n        height: 2rem;\r\n    }\r\n}\r\n\r\n@keyframes load-ind-light {\r\n    0%,\r\n    90%,\r\n    100% {\r\n        -webkit-box-shadow: 0 0 var(--text-contrast);\r\n        box-shadow: 0 0 var(--text-contrast);\r\n        height: 1.5rem;\r\n    }\r\n\r\n    45% {\r\n        -webkit-box-shadow: 0 -0.75rem var(--text-contrast);\r\n        box-shadow: 0 -0.75rem var(--text-contrast);\r\n        height: 2rem;\r\n    }\r\n}\r\n\r\n@-webkit-keyframes load-ind-m {\r\n    0%,\r\n    100%,\r\n    90% {\r\n        background: rgba(var(--secure-primary-text-rgb), 0.08);\r\n    }\r\n\r\n    45% {\r\n        background: rgba(var(--secure-primary-text-rgb), 0.25);\r\n    }\r\n}\r\n\r\n@keyframes load-ind-m {\r\n    0%,\r\n    100%,\r\n    90% {\r\n        background: rgba(var(--secure-primary-text-rgb), 0.08);\r\n    }\r\n\r\n    45% {\r\n        background: rgba(var(--secure-primary-text-rgb), 0.25);\r\n    }\r\n}\r\n\r\n/* Search progress indicator */\r\n\r\n@-webkit-keyframes search {\r\n    0% {\r\n        top: 0rem;\r\n        left: 0.125rem;\r\n    }\r\n\r\n    20% {\r\n        top: 0rem;\r\n        left: 2.5rem;\r\n    }\r\n\r\n    33% {\r\n        top: 0rem;\r\n        left: 2.5rem;\r\n    }\r\n\r\n    53% {\r\n        top: 1.75rem;\r\n        left: 1.25rem;\r\n    }\r\n\r\n    66% {\r\n        top: 1.75rem;\r\n        left: 1.25rem;\r\n    }\r\n\r\n    87%,\r\n    100% {\r\n        top: 0;\r\n        left: 0.125rem;\r\n    }\r\n}\r\n\r\n@keyframes search {\r\n    0% {\r\n        top: 0rem;\r\n        left: 0.125rem;\r\n    }\r\n\r\n    20% {\r\n        top: 0rem;\r\n        left: 2.5rem;\r\n    }\r\n\r\n    33% {\r\n        top: 0rem;\r\n        left: 2.5rem;\r\n    }\r\n\r\n    53% {\r\n        top: 1.75rem;\r\n        left: 1.25rem;\r\n    }\r\n\r\n    66% {\r\n        top: 1.75rem;\r\n        left: 1.25rem;\r\n    }\r\n\r\n    87%,\r\n    100% {\r\n        top: 0;\r\n        left: 0.125rem;\r\n    }\r\n}\r\n\r\n.search-anim {\r\n    position: relative;\r\n    display: block;\r\n    width: 5rem;\r\n    margin: 0 auto;\r\n}\r\n\r\n.search-anim:before,\r\n.search-anim:after {\r\n    font-family: \"FontAwesome\";\r\n    color: var(--border-strong);\r\n    display: block;\r\n    content: \"\";\r\n}\r\n\r\n.search-anim:before {\r\n    font-size: 4rem;\r\n    line-height: 5.75rem;\r\n    opacity: 0.3;\r\n    content: \"\\f1c0\";\r\n}\r\n\r\n.search-anim:after {\r\n    position: absolute;\r\n    top: 0.5rem;\r\n    left: 1rem;\r\n    -webkit-animation: search 4s infinite;\r\n    animation: search 4s infinite;\r\n    content: \"\\f002\";\r\n    font-size: 3rem;\r\n}\r\n\r\n/* Alert boxes */\r\n\r\n.alert-box {\r\n    padding: 1rem;\r\n    background: rgba(var(--primary-rgb), 0.2);\r\n    color: var(--secure-primary-text);\r\n    border-radius: 1rem;\r\n    margin-bottom: 1rem;\r\n    display: flex;\r\n    flex-direction: row;\r\n    align-items: center\r\n}\r\n\r\n.alert-box:last-child {\r\n    margin-bottom: 0;\r\n}\r\n\r\n.alert-box .alert-icon {\r\n    font-size: 1.5rem;\r\n    margin-right: 1rem;\r\n    -webkit-box-flex: 0;\r\n    -ms-flex-positive: 0;\r\n    flex-grow: 0;\r\n    -ms-flex-negative: 0;\r\n    flex-shrink: 0;\r\n    line-height: 1.5rem;\r\n}\r\n\r\n.alert-box .alert-icon:before {\r\n    content: \"\\f05a\";\r\n    font-family: \"FontAwesome\";\r\n}\r\n\r\n.alert-box.accent {\r\n    background: rgba(var(--primary-rgb), 0.2);\r\n    color: var(--secure-primary-text);\r\n}\r\n\r\n.alert-box.info .alert-icon:before {\r\n    content: \"\\f05a\";\r\n}\r\n\r\n.alert-box.warning {\r\n    background: var(--warning-alert-box);\r\n    color: var(--warning-text);\r\n}\r\n\r\n.alert-box.warning .alert-icon:before {\r\n    content: \"\\f06a\";\r\n}\r\n\r\n.alert-box.success {\r\n    background: var(--success-alert-box);\r\n    color: var(--success-text);\r\n}\r\n\r\n.alert-box.success .alert-icon:before {\r\n    content: \"\\f058\";\r\n}\r\n\r\n.alert-box.danger {\r\n    background: var(--danger-alert-box);\r\n    border-color: rgba(var(--danger-rgb), 0.2);\r\n    color: var(--danger-text);\r\n}\r\n\r\n.alert-box.danger .alert-icon:before {\r\n    content: \"\\f071\";\r\n}\r\n\r\n    .alert-box.info {\r\n        background: var(--info-alert-box);\r\n        color: var(--info-alert-text);\r\n    }\r\n\r\n    .alert-box.info a {\r\n        color: var(--info-alert-text);\r\n    }\r\n\r\n.alert-box.info .alert-icon:before {\r\n    content: \"\\f05a\";\r\n}\r\n\r\n.alert-box-sm {\r\n    padding: 0.5rem;\r\n}\r\n\r\n.alert-box-sm .alert-icon {\r\n    font-size: 1rem;\r\n    line-height: 1rem;\r\n}\r\n\r\n.alert-box code {\r\n    background: rgba(0, 0, 0, 0.05);\r\n}\r\n\r\n/* Flexbox stuff */\r\n.flex-grow {\r\n    -webkit-box-flex: 1;\r\n    -ms-flex-positive: 1;\r\n    flex-grow: 1;\r\n}\r\n\r\n.flex-nogrow {\r\n    -webkit-box-flex: 0;\r\n    -ms-flex-positive: 0;\r\n    flex-grow: 0;\r\n}\r\n\r\n.flex-shrink {\r\n    -ms-flex-negative: 1;\r\n    flex-shrink: 1;\r\n}\r\n\r\n.flex-noshrink {\r\n    -ms-flex-negative: 0;\r\n    flex-shrink: 0;\r\n}\r\n/* separators */\r\n\r\n.separator-left:before,\r\n.separator-right:after {\r\n    display: block;\r\n    position: absolute;\r\n    top: 0.5rem;\r\n    bottom: 0.5rem;\r\n    content: \"\";\r\n}\r\n\r\n.separator-left:before {\r\n    left: 0;\r\n    border-left: 1px dotted var(--border-strong);\r\n}\r\n\r\n.separator-right:after {\r\n    right: 0;\r\n    border-right: 1px dotted var(--border-strong);\r\n}\r\n\r\n/* vertical and horizontal rules. vr is best used within a flexbox model\r\n*/\r\n\r\n.vr {\r\n    padding: 0.5rem 0.25rem;\r\n}\r\n\r\n.vr:after {\r\n    display: block;\r\n    content: \"\";\r\n    height: 100%;\r\n    border-left: 1px dotted var(--border-strong);\r\n}\r\n\r\nfieldset.hr-text {\r\n    border-top: 2px dotted var(--border-strong);\r\n    padding-left: 0;\r\n}\r\n\r\nfieldset.hr-text legend {\r\n    font-size: 0.875rem;\r\n    margin: 0;\r\n    width: auto;\r\n    text-align: left;\r\n    color: var(--muted);\r\n    padding: 0 0.5rem;\r\n    font-weight: 700;\r\n}\r\n\r\n/* Transitions */\r\n\r\n.height-transition-start {\r\n    -webkit-transition: max-height 1s ease;\r\n    transition: max-height 1s ease;\r\n    overflow: hidden;\r\n}\r\n\r\n/* Alignment */\r\n\r\n.align {\r\n    display: -webkit-box;\r\n    display: -ms-flexbox;\r\n    display: flex;\r\n}\r\n\r\n.align.align-left {\r\n    -webkit-box-pack: start;\r\n    -ms-flex-pack: start;\r\n    justify-content: flex-start;\r\n}\r\n\r\n.align.align-center {\r\n    -webkit-box-pack: center;\r\n    -ms-flex-pack: center;\r\n    justify-content: center;\r\n}\r\n\r\n.align.align-right {\r\n    -webkit-box-pack: end;\r\n    -ms-flex-pack: end;\r\n    justify-content: flex-end;\r\n}\r\n\r\n.align > div {\r\n    max-width: 100%;\r\n    -webkit-box-flex: 0;\r\n    -ms-flex: 0 1 auto;\r\n    flex: 0 1 auto;\r\n}\r\n\r\n/* font awesome */\r\n.fa-xl {\r\n    font-size: 1.5em;\r\n}\r\n\n\n/* ========================================\n * Source: Components/src/styles/Cpf/Content/Styles/new/n_utility-classes.css\n * ======================================== */\n\n/*\r\n    Padding and Margin Classes\r\n    Format ({p/m}-{a/x/y/t/r/b/l}-{05/1/2/3})\r\n    Where p or m is padding or margin\r\n    a - all, x/y - x or y axis only, t/r/b/l - top right bottom left only\r\n*/\r\n.pt-05, .p-05, .py-05 {\r\n    padding-top: .5rem !important;\r\n}\r\n\r\n.pb-05, .p-05, .py-05 {\r\n    padding-bottom: .5rem !important;\r\n}\r\n\r\n.pl-05, .p-05, .px-05 {\r\n    padding-left: .5rem !important;\r\n}\r\n\r\n.pr-05, .p-05, .px-05 {\r\n    padding-right: .5rem !important;\r\n}\r\n\r\n.mt-05, .ma-05, .m-y-05 {\r\n    margin-top: .5rem !important;\r\n}\r\n\r\n.mb-05, .ma-05, .m-y-05 {\r\n    margin-bottom: .5rem !important;\r\n}\r\n\r\n.ml-05, .ma-05, .m-x-05 {\r\n    margin-left: .5rem !important;\r\n}\r\n\r\n.mr-05, .ma-05, .m-x-05 {\r\n    margin-right: .5rem !important;\r\n}\r\n\r\n/* Font size utility classes */\r\n.f-s-0 {\r\n    font-size: .875rem !important;\r\n}\r\n\r\n.f-s-1 {\r\n    font-size: 1rem !important;\r\n}\r\n\r\n.f-s-2 {\r\n    font-size: 1.5rem !important;\r\n}\r\n\r\n.f-s-3 {\r\n    font-size: 2rem !important;\r\n}\r\n\r\n.b-r {\r\n    -webkit-border-radius: .25rem;\r\n    -moz-border-radius: .25rem;\r\n    border-radius: .25rem;\r\n}\r\n\r\n.full-height {\r\n    height: 100%;\r\n}\r\n\r\n.h-100 {\r\n    height: 100%;\r\n}\r\n\r\n.w-100 {\r\n    width: 100%;\r\n}\r\n\r\n.inline {\r\n    display: inline;\r\n}\r\n\r\n.inline-block {\r\n    display: inline-block;\r\n}\r\n\r\n.label-light {\r\n    background: var(--section-border);\r\n    color: var(--muted);\r\n}\r\n\r\n    .label-light.label-hover:hover {\r\n        background: rgba(var(--primary-rgb), 0.25);\r\n        cursor: pointer;\r\n        color: var(--secure-primary-text);\r\n    }\r\n\r\n.text-primary {\r\n    color: var(--default-text) !important;\r\n}\r\n\r\n.text-muted {\r\n    color: var(--muted) !important;\r\n}\r\n\r\n.text-danger {\r\n    color: var(--danger-secure) !important;\r\n}\r\n\r\n.text-success {\r\n    color: var(--success-secure) !important;\r\n}\r\n\r\n.text-warning {\r\n    color: var(--warning-secure) !important;\r\n}\r\n\r\n.text-contrast {\r\n    color: var(--text-contrast) !important;\r\n}\r\n\r\n/* Backgrounds */\r\n\r\n.bg-success {\r\n    background-color: var(--success-secure) !important;\r\n}\r\n\r\n.bg-warning {\r\n    background-color: var(--warning-secure) !important;\r\n}\r\n\r\n.bg-danger {\r\n    background-color: var(--danger-secure) !important;\r\n}\r\n\r\n.bg-accent {\r\n    background-color: var(--primary-base) !important;\r\n}\r\n\r\n.bg-secondary {\r\n    background-color: var(--secure-primary-text) !important;\r\n}\r\n\r\n.bg-muted {\r\n    background-color: var(--muted) !important;\r\n}\r\n\r\n.bg-transparent {\r\n    background-color: transparent !important;\r\n}\r\n\r\n.bg-faded, /* deprecated */\r\n.bg-light {\r\n    background-color: rgba(10,12,20,0.06) !important;\r\n}\r\n\r\n.bg-success-tr {\r\n    background-color: rgba(var(--success-rgb), 0.15) !important;\r\n}\r\n\r\n.bg-warning-tr {\r\n    background-color: rgba(var(--warning-rgb), 0.15) !important;\r\n}\r\n\r\n.bg-danger-tr {\r\n    background-color: rgba(var(--danger-rgb), 0.15) !important;\r\n}\r\n\r\n.bg-accent-tr {\r\n    background-color: rgba(var(--accent-rgb) / 0.15) !important;\r\n}\r\n\r\n.bg-secondary-tr {\r\n    background-color: rgba(var(--secure-primary-text-rgb), 0.15) !important;\r\n}\r\n\r\n.bg-muted-tr {\r\n    background-color: rgba(var(--muted-rgb), 0.15) !important;\r\n}\r\n\r\n/* Text coloring */\r\n\r\n.text-success {\r\n    color: var(--success-secure) !important;\r\n}\r\n\r\n.text-warning {\r\n    color: var(--warning-secure) !important;\r\n}\r\n\r\n.text-danger {\r\n    color: var(--danger-secure) !important;\r\n}\r\n\r\n.text-info,\r\n.text-accent,\r\n.text-secondary {\r\n    color: var(--secure-primary-text) !important;\r\n}\r\n\r\n.text-muted {\r\n    color: var(--muted) !important;\r\n}\r\n\r\n.text-disabled {\r\n    color: var(--border-strong) !important;\r\n}\r\n\r\n/* Font size classes */\r\n\r\n.fs-1 {\r\n    font-size: 0.875rem !important;\r\n}\r\n\r\n.fs-2 {\r\n    font-size: 1rem !important;\r\n}\r\n\r\n.fs-3 {\r\n    font-size: 1.125rem !important;\r\n}\r\n\r\n.fs-4 {\r\n    font-size: 1.25rem !important;\r\n}\r\n\r\n.fs-5 {\r\n    font-size: 1.375rem !important;\r\n}\r\n\r\n.lh-0 {\r\n    line-height: 0.75rem !important;\r\n}\r\n\r\n.lh-1 {\r\n    line-height: 0.875rem !important;\r\n}\r\n\r\n/* Other font utilities */\r\n\r\n.word-wrap {\r\n    word-wrap: break-word;\r\n    white-space: normal;\r\n    height: auto;\r\n}\r\n\r\n\r\n.label-accent {\r\n    background: var(--primary-base);\r\n}\r\n\r\n.label-muted {\r\n    background: var(--muted);\r\n}\r\n\r\n.label-secondary {\r\n    background: var(--secure-primary-text);\r\n}\r\n\r\n.label-muted {\r\n    background: var(--muted);\r\n}\r\n\r\n.label-danger {\r\n    background: var(--danger-secure);\r\n}\r\n\r\n.label-warning {\r\n    background: var(--warning-secure);\r\n}\r\n\r\n.label-success {\r\n    background: var(--success);\r\n}\r\n\r\n\r\n.ng-link:hover {\r\n    cursor: pointer;\r\n    text-decoration: underline;\r\n}\r\n\r\n.d-inline {\r\n    display: inline !important;\r\n}\r\n\r\n.d-inline-block {\r\n    display: inline-block !important;\r\n}\r\n\r\n.d-block {\r\n    display: block !important;\r\n}\r\n\r\n.d-table {\r\n    display: table !important;\r\n}\r\n\r\n/* Utilities / Miscellaneous */\r\n\r\n.label-hover {\r\n    background: rgba(var(--primary-rgb), 0.25);\r\n    color: var(--secure-primary-text);\r\n}\r\n\r\n    .label-hover:hover {\r\n        background: rgba(var(--primary-rgb), 0.35);\r\n        cursor: pointer;\r\n    }\r\n\r\n.overflow-visible {\r\n    overflow: visible !important;\r\n}\n\n/* ========================================\n * Source: Components/src/styles/Cpf/Content/Styles/new/n_videojs.css\n * ======================================== */\n\n﻿/* VideoJS Default Styles */\r\n.vjs-default-skin{color:#ccc}@font-face{font-family:'VideoJS';src:url(../images/vjs.eot?v=$ENV(Build));src:url(../images/vjs.eot?v=$ENV(Build)#iefix) format(\"embedded-opentype\"),url(../images/vjs.woff?v=$ENV(Build)) format(\"woff\"),url(../images/vjs.ttf?v=$ENV(Build)) format(\"truetype\"),url(../images/vjs.svg?v=$ENV(Build)#icomoon) format(\"svg\");font-weight:400;font-style:normal}.vjs-default-skin .vjs-slider{outline:0;position:relative;cursor:pointer;padding:0;background-color:#333;background-color:rgba(51,51,51,0.9)}.vjs-default-skin .vjs-slider:focus{-webkit-box-shadow:0 0 2em #fff;-moz-box-shadow:0 0 2em #fff;box-shadow:0 0 2em #fff}.vjs-default-skin .vjs-slider-handle{position:absolute;left:0;top:0}.vjs-default-skin .vjs-slider-handle:before{content:\"\\e009\";text-align:center;text-shadow:0 0 1em #fff;position:absolute;top:0;left:0;-webkit-transform:rotate(-45deg);-moz-transform:rotate(-45deg);-ms-transform:rotate(-45deg);-o-transform:rotate(-45deg);transform:rotate(-45deg);font:1em/1 VideoJS}.vjs-default-skin .vjs-control-bar{display:none;position:absolute;bottom:0;left:0;right:0;height:3em;background-color:#07141e;background-color:rgba(7,20,30,0.7)}.vjs-default-skin.vjs-has-started .vjs-control-bar{display:block;visibility:visible;opacity:1;-webkit-transition:visibility 0.1s,opacity .1s;-moz-transition:visibility 0.1s,opacity .1s;-o-transition:visibility 0.1s,opacity .1s;transition:visibility 0.1s,opacity .1s}.vjs-default-skin.vjs-has-started.vjs-user-inactive.vjs-playing .vjs-control-bar{display:block;visibility:hidden;opacity:0;-webkit-transition:visibility 1s,opacity 1s;-moz-transition:visibility 1s,opacity 1s;-o-transition:visibility 1s,opacity 1s;transition:visibility 1s,opacity 1s}.vjs-default-s