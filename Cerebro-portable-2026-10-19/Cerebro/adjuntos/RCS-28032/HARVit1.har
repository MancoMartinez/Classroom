\t\t\treturn;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tvar $container = $el.closest(\".sticky-container\");\r\n\t\t\t\tif (\r\n\t\t\t\t\t!$(self).has($el) ||\r\n\t\t\t\t\t!$el.is(\":visible\") ||\r\n\t\t\t\t\t$container.length === 0\r\n\t\t\t\t) {\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\t\t\t\tvar c = {\r\n\t\t\t\t\ttop: $container.offset().top,\r\n\t\t\t\t\tleft: $container.offset().left,\r\n\t\t\t\t\twidth: $container.outerWidth(),\r\n\t\t\t\t\theight: $container.outerHeight(),\r\n\t\t\t\t\tbottom: $container.offset().top + $container.outerHeight(),\r\n\t\t\t\t};\r\n\t\t\t\tvar b = {\r\n\t\t\t\t\theight: $el.outerHeight(),\r\n\t\t\t\t};\r\n\t\t\t\tvar sticky =\r\n\t\t\t\t\tc.top <= offset &&\r\n\t\t\t\t\tc.bottom >= offset + $el.outerHeight() * 1.2; // added offset to prevent flickering\r\n\r\n\t\t\t\tif (sticky) {\r\n\t\t\t\t\t$el.css({\r\n\t\t\t\t\t\ttop: $(self).offset().top,\r\n\t\t\t\t\t\tleft: c.left,\r\n\t\t\t\t\t\twidth: c.width,\r\n\t\t\t\t\t});\r\n\t\t\t\t} else {\r\n\t\t\t\t\t$el.css({\r\n\t\t\t\t\t\ttop: 0,\r\n\t\t\t\t\t\tleft: 0,\r\n\t\t\t\t\t\twidth: \"auto\",\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t\t$el.toggleClass(\"sticky-bar-fixed\", sticky);\r\n\t\t\t}\r\n\t\t},\r\n\t},\r\n\tload: function () {\r\n\t\tcpfx.dropdown.init();\r\n\t\tcpfx.labels();\r\n\t\tcpfx.navigation();\r\n\t\tcpfx.avoidingMenus.init();\r\n\t\tcpfx.sticky.init();\r\n\t},\r\n\tsizeMinusSpacing: function (element) {\r\n\t\tvar cs = getComputedStyle(element);\r\n\r\n\t\tvar paddingX =\r\n\t\t\tparseFloat(cs.paddingLeft.replace(\"px\", \"\")) +\r\n\t\t\tparseFloat(cs.paddingRight.replace(\"px\", \"\"));\r\n\t\tvar paddingY =\r\n\t\t\tparseFloat(cs.paddingTop.replace(\"px\", \"\")) +\r\n\t\t\tparseFloat(cs.paddingBottom.replace(\"px\", \"\"));\r\n\r\n\t\tvar borderX =\r\n\t\t\tparseFloat(cs.borderLeftWidth.replace(\"px\", \"\")) +\r\n\t\t\tparseFloat(cs.borderRightWidth.replace(\"px\", \"\"));\r\n\t\tvar borderY =\r\n\t\t\tparseFloat(cs.borderTopWidth.replace(\"px\", \"\")) +\r\n\t\t\tparseFloat(cs.borderBottomWidth.replace(\"px\", \"\"));\r\n\r\n\t\t// Element width and height minus padding and border\r\n\t\treturn {\r\n\t\t\twidth: element.offsetWidth - paddingX - borderX,\r\n\t\t\theight: element.offsetHeight - paddingY - borderY,\r\n\t\t};\r\n\t},\r\n};\r\n\r\ncpfx.load();\r\n\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/datepicker.js\n * ======================================== */\n\n﻿var datePicker = {\r\n\r\n    sortOverriden: false,\r\n\r\n\r\n    load: function ($control, onChangeCallback) {\r\n\r\n        datePicker.initialiseDatePicker($control, onChangeCallback);\r\n        datePicker.change($control);\r\n    },\r\n\r\n    loadWithTimePart: function ($control, onChangeCallback) {\r\n\r\n        datePicker.initialiseDatePicker($control, onChangeCallback);\r\n        datePicker.changeWithTimePart($control);\r\n    },\r\n\r\n    initialiseDatePicker: function ($control, onChangeCallback) {\r\n\r\n        // use jquery ui datepicker.\r\n\r\n        var $calendarControl = $control.find(\".date-picker-control\");\r\n\r\n        if ($calendarControl.length === 0) {\r\n            return;\r\n        }\r\n\r\n        var config = JSON.parse($calendarControl.attr(\"data-config\"));\r\n\r\n        config.changeMonth = true;\r\n        config.changeYear = true;\r\n        config.onSelect = function (dateText, inst) {\r\n            datePicker.setDate(dateText, inst, $control);\r\n\r\n            if (onChangeCallback) {\r\n                onChangeCallback($control);\r\n            }\r\n        };\r\n        config.minDate = new Date(config.minDate);\r\n        config.maxDate = new Date(config.maxDate);\r\n        config.showButtonPanel = true;\r\n        config.showOtherMonths = true;\r\n        config.selectOtherMonths = true;\r\n\r\n        // is there a more global way of doing this?\r\n        if (CULTURE == \"en-US\") {\r\n            config.firstDay = 0;\r\n        }\r\n        else {\r\n            config.firstDay = 1;\r\n        }\r\n\r\n        shortYearCutoff = 99;\r\n\r\n        if (!datePicker.sortOverriden) {\r\n            //override the method that generates the years list and sort it the same way as the dyno control orders the years.\r\n            $.datepicker._generateMonthYearHeader_original = $.datepicker._generateMonthYearHeader;\r\n\r\n            $.datepicker._generateMonthYearHeader = function (inst, dm, dy, mnd, mxd, s, mn, mns) {\r\n                var header = $($.datepicker._generateMonthYearHeader_original(inst, dm, dy, mnd, mxd, s, mn, mns)),\r\n            years = header.find('.ui-datepicker-year');\r\n\r\n                // reverse the years\r\n                years.html(Array.prototype.reverse.apply(years.children()));\r\n\r\n                // return our new html\r\n                return $('<div />').append(header).html();\r\n            };\r\n\r\n            datePicker.sortOverriden = true;\r\n        }\r\n        // check if control should be rendered as inline within parent dynocontrol\r\n        if (undefined === config.inlineCalendar) config.inlineCalendar = false;\r\n        if (!config.inlineCalendar) {\r\n            // default version (non-inlined) always renders by default\r\n            config.buttonImageOnly = true,\r\n            config.beforeShow = function (input, inst) {\r\n                $calendarControl.datepicker(\"setDate\", datePicker.currentDate($control, true));\r\n            };\r\n            config['beforeShow'] = function (input, inst) {\r\n                // wait for animation to finish and dpDiv to become visible. flip datepicker if on left side of screen\r\n                setTimeout(function () {\r\n                    var posLeft = inst.dpDiv.offset().left;\r\n                    inst.dpDiv.css({\r\n                        marginLeft: (posLeft < (inst.dpDiv.width() + 60) ? 0 : \"-221px\")\r\n                    });\r\n                }, 101);\r\n            };\r\n            $calendarControl.datepicker(config);\r\n            // setup click event on the button used to activate the calendar.\r\n            var $button = $control.find(\".date-picker-calendar-button\");\r\n            $button.off(\"click\").on(\"click\", function () {\r\n                if ($button.attr('disabled')) {\r\n                    return false;\r\n                }\r\n                $calendarControl.datepicker(\"show\");\r\n                return false;\r\n            });\r\n        } else {\r\n            // modified behavior only when set explicitely in configuration\r\n            datePickerInline.initialiseDatePicker($control, onChangeCallback, config);\r\n        }\r\n    },\r\n\r\n    change: function ($control) {\r\n\r\n        var changeDate = function ($control) {\r\n            $control.datepicker(\"setDate\", datePicker.currentDate($control));\r\n\r\n        };\r\n\r\n        var id = datePicker.getId($control);\r\n\r\n        $(\"#\" + id + \"-year\", $control).on(\"change\", function () {\r\n            changeDate($control);\r\n        });\r\n\r\n        $(\"#\" + id + \"-month\", $control).on(\"change\", function () {\r\n            changeDate($control);\r\n        });\r\n\r\n        $(\"#\" + id + \"-day\", $control).on(\"change\", function () {\r\n            changeDate($control);\r\n        });\r\n    },\r\n\r\n    changeWithTimePart: function ($control) {\r\n\r\n        var changeDate = function ($control) {\r\n            $control.datepicker(\"setDate\", datePicker.currentDateTime($control));\r\n        };\r\n\r\n        var id = datePicker.getId($control);\r\n\r\n        $(\"#\" + id + \"-year\", $control).on(\"change\", function () {\r\n            changeDate($control);\r\n        });\r\n\r\n        $(\"#\" + id + \"-month\", $control).on(\"change\", function () {\r\n            changeDate($control);\r\n        });\r\n\r\n        $(\"#\" + id + \"-day\", $control).on(\"change\", function () {\r\n            changeDate($control);\r\n        });\r\n    },\r\n\r\n    getControlState: function ($control) {\r\n        var button = $control.find(\".date-picker-calendar-button\");\r\n\r\n        var disabled = button.attr('disabled');\r\n\r\n        if (disabled) {\r\n            return false;\r\n        }\r\n\r\n        return true;\r\n    },\r\n    toggleControlState: function ($control, enabled) {\r\n\r\n        var id = datePicker.getId($control);\r\n\r\n        var year = $(\"#\" + id + \"-year\", $control);\r\n        var month = $(\"#\" + id + \"-month\", $control);\r\n        var day = $(\"#\" + id + \"-day\", $control);\r\n        var hour = $(\"#\" + id + \"-hour\", $control);\r\n        var minute = $(\"#\" + id + \"-minute\", $control);\r\n        var button = $control.find(\".date-picker-calendar-button\");\r\n\r\n        if (enabled) {\r\n            year.removeAttr('disabled');\r\n            month.removeAttr('disabled');\r\n            day.removeAttr('disabled');\r\n            hour.removeAttr('disabled');\r\n            minute.removeAttr('disabled');\r\n            button.removeAttr('disabled');\r\n        }\r\n        else {\r\n            year.attr('disabled', 'disabled');\r\n            month.attr('disabled', 'disabled');\r\n            day.attr('disabled', 'disabled');\r\n            hour.attr('disabled', 'disabled');\r\n            minute.attr('disabled', 'disabled');\r\n            button.attr('disabled', 'disabled');\r\n        }\r\n    },\r\n\r\n    setDate: function (dateText, instance, $control) {\r\n\r\n        var id = datePicker.getId($control);\r\n\r\n        // here we need to update the existing date drop downs.\r\n        $(\"#\" + id + \"-year\", $control).val(instance.selectedYear);\r\n        $(\"#\" + id + \"-month\", $control).val(instance.selectedMonth + 1);\r\n        $(\"#\" + id + \"-day\", $control).val(instance.selectedDay);\r\n\r\n        //set timezone\r\n        if (typeof (DYNOMODE) != \"undefined\" && DYNOMODE.toLowerCase() === \"edit\") {\r\n            var timezone = jstz.determine().name === undefined ? \"\" : jstz.determine().name();\r\n            $(\"#\" + $control.gcop().getAttribute(\"id\") + \"-timezone option\").each(function() {\r\n                if (timezone === this.text) {\r\n                    $(\"#\" + $control.gcop().getAttribute(\"id\") + \"-timezone\").val(this.text);\r\n                    $control.attr(\"data-timezone\", this.text);\r\n                }\r\n            });\r\n        }\r\n\r\n        var hours = instance.selectedHour;\r\n        var minutes = instance.selectedMinute;\r\n\r\n        if (typeof hours != 'undefined' && typeof minutes != 'undefined') {\r\n\r\n            var time = $(\"#\" + id + \"-time\", $control);\r\n\r\n            if (time.hasClass(\"is-12-hour\")) {\r\n                if (hours > 12) {\r\n                    hours = hours - 12;\r\n                    $(\"#\" + id + \"-period\", $control).val(\"pm\");\r\n                } else if (hours >= 12) {\r\n                    $(\"#\" + id + \"-period\", $control).val(\"pm\");\r\n                } else {\r\n                    $(\"#\" + id + \"-period\", $control).val(\"am\");\r\n                }\r\n            }\r\n\r\n            if (hours < 10) {\r\n                hours = \"0\" + hours.toString();\r\n            }\r\n\r\n            if (minutes < 10) {\r\n                minutes = \"0\" + minutes.toString();\r\n            }\r\n\r\n            $(\"#\" + id + \"-hour\", $control).val(hours);\r\n            $(\"#\" + id + \"-minute\", $control).val(minutes);\r\n        }        \r\n    },\r\n\r\n    setTime: function (timeText, instance, $control) {\r\n\r\n        var id = datePicker.getId($control);\r\n\r\n        // here we need to update the existing date drop downs.\r\n        $(\"#\" + id + \"-hour\", $control).val(instance.selectedHour);\r\n        $(\"#\" + id + \"-minute\", $control).val(instance.selectedMinute);\r\n    },\r\n\r\n    currentDate: function ($control, forDisplay) {\r\n\r\n        // get current date displayed in the drop downlists.\r\n        var id = datePicker.getId($control);\r\n        var year = $(\"#\" + id + \"-year\", $control).val();\r\n        var month = $(\"#\" + id + \"-month\", $control).val();\r\n        var day = $(\"#\" + id + \"-day\", $control).val();\r\n        var hour = $(\"#\" + id + \"-hour\", $control).val();\r\n        var minute = $(\"#\" + id + \"-minute\", $control).val();\r\n\r\n        var dateString = \"\";\r\n        var date = new Date();\r\n\r\n        // construct string to create new date.\r\n        // if something is not selected in the dropdown set it to current value for year, month or day.\r\n        if (year != undefined && year !== \"0\") {\r\n            dateString = dateString + year;\r\n        }\r\n        else {\r\n            dateString = date.getFullYear();\r\n        }\r\n\r\n        if (month != undefined && month !== \"0\") {\r\n            dateString = dateString + \"-\" + datePicker.pad(month, 2, \"0\");\r\n        }\r\n        else {\r\n            dateString = dateString + \"-\" + datePicker.pad((date.getMonth() + 1), 2, \"0\");\r\n        }\r\n\r\n        if (day != undefined && day !== \"0\") {\r\n            dateString = dateString + \"-\" + datePicker.pad(day, 2, \"0\");\r\n        }\r\n        else {\r\n            dateString = dateString + \"-\" + datePicker.pad(date.getDate(), 2, \"0\");\r\n        }\r\n\r\n\r\n        if (forDisplay) {\r\n            // use this for displaying the datepicker ui\r\n            var newDate = new Date(dateString);\r\n            return new Date(newDate.getTime() + (newDate.getTimezoneOffset() * 60000));\r\n        }\r\n\r\n        return new Date(dateString);\r\n    },\r\n\r\n    currentDateTime: function ($control, forDisplay) {\r\n\r\n        // get current date displayed in the drop downlists.\r\n        var id = datePicker.getId($control);\r\n        var year = $(\"#\" + id + \"-year\", $control).val();\r\n        var month = $(\"#\" + id + \"-month\", $control).val();\r\n        var day = $(\"#\" + id + \"-day\", $control).val();\r\n        var hour = $(\"#\" + id + \"-hour\", $control).val();\r\n        var minute = $(\"#\" + id + \"-minute\", $control).val();\r\n\r\n        var dateString = \"\";\r\n        var date = new Date();\r\n\r\n        // construct string to create new date.\r\n        // if something is not selected in the dropdown set it to current value for year, month or day.\r\n        if (year != undefined && year !== \"0\") {\r\n            dateString = dateString + year;\r\n        }\r\n        else {\r\n            dateString = date.getFullYear();\r\n        }\r\n\r\n        if (month != undefined && month !== \"0\") {\r\n            dateString = dateString + \"-\" + datePicker.pad(month, 2, \"0\");\r\n        }\r\n        else {\r\n            dateString = dateString + \"-\" + datePicker.pad((date.getMonth() + 1), 2, \"0\");\r\n        }\r\n\r\n        if (day != undefined && day !== \"0\") {\r\n            dateString = dateString + \"-\" + datePicker.pad(day, 2, \"0\");\r\n        }\r\n        else {\r\n            dateString = dateString + \"-\" + datePicker.pad(date.getDate(), 2, \"0\");\r\n        }\r\n\r\n        if (hour != undefined && minute != undefined) {\r\n            if (hour !== \"-1\" && minute !== -1) {\r\n                if (year === undefined && month === undefined && day === undefined) {\r\n                    //dateString = \"0001-01-01\";\r\n                    return new Date(1, 0, 1, hour, minute);\r\n                }\r\n                //dateString = dateString + \"T\" + datePicker.pad(hour, 2, \"0\") + \":\" + datePicker.pad(minute, 2, \"0\") + \":00.000\";\r\n                return new Date(year, Number(month) - 1, day, hour, minute);\r\n            }\r\n        }\r\n\r\n        if (forDisplay) {\r\n            // use this for displaying the datepicker ui\r\n            var newDate = new Date(dateString);\r\n            return new Date(newDate.getTime() + (newDate.getTimezoneOffset() * 60000));\r\n        }\r\n\r\n        return new Date(dateString);\r\n    },\r\n\r\n    getId: function ($control) {\r\n        return $control.attr(\"id\");\r\n    },\r\n\r\n    pad: function (number, count, str) {\r\n        return Array(count - String(number).length + 1).join(str || '0') + number;\r\n    }\r\n};\r\n\r\n$.datepicker._gotoToday = function (id) {\r\n    var target = $(id);\r\n    var inst = this._getInst(target[0]);\r\n    if (this._get(inst, 'gotoCurrent') && inst.currentDay) {\r\n        inst.selectedDay = inst.currentDay;\r\n        inst.drawMonth = inst.selectedMonth = inst.currentMonth;\r\n        inst.drawYear = inst.selectedYear = inst.currentYear;\r\n        inst.drawHour = inst.selectedHour = inst.currentHour;\r\n        inst.drawMinute = inst.selectedMinute = inst.curentMinute;\r\n    }\r\n    else {\r\n        var date = new Date();\r\n        inst.selectedDay = date.getDate();\r\n        inst.drawMonth = inst.selectedMonth = date.getMonth();\r\n        inst.drawYear = inst.selectedYear = date.getFullYear();\r\n        inst.drawHour = inst.selectedHour = date.getHours();\r\n        inst.drawMinute = inst.selectedMinute = date.getMinutes();\r\n        // the below two lines are new\r\n        this._setDateDatepicker(target, date);\r\n        this._selectDate(id, this._getDateDatepicker(target));\r\n    }\r\n    this._notifyChange(inst);\r\n    this._adjustDate(target);\r\n};\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/datetimespan.js\n * ======================================== */\n\n﻿var dateTimeSpan = {\r\n\r\n    // PA20130311 T:#3523 \r\n    load: function ($control, onChangeCallback) {\r\n\r\n        var selectedColumnName = $control.find(\">:first-child\").next().attr(\"id\");\r\n        var valueColumnName = $control.find(\">:first-child\").attr(\"id\");\r\n\r\n        dateTimeSpan.initialiseControl($control, selectedColumnName, valueColumnName);\r\n\r\n        $control.find(\"#\" + selectedColumnName).on(\"change\", function () {\r\n            dateTimeSpan.updateControl($control, selectedColumnName, valueColumnName);\r\n        });\r\n\r\n        $control.find(\"#\" + valueColumnName).on(\"change\", function () {\r\n            $control.find(\"#\" + valueColumnName).validate();\r\n            return false;\r\n        });\r\n    },\r\n\r\n    initialiseControl: function ($control, selectedColumnName, valueColumnName) {\r\n\r\n        this.selectedColumnName = selectedColumnName;\r\n        this.valueColumnName = valueColumnName;\r\n\r\n        var time = $control.find(\"#\" + this.selectedColumnName).val();\r\n        var selectUnit = $control.find(\"#\" + this.selectedColumnName).val();\r\n\r\n        if (selectUnit === \"numberOfDays\") {\r\n\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"maxLength\", \"8\");\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"data-val-max-value\", \"7300\");\r\n        }\r\n        else if (selectUnit === \"numberOfHours\") {\r\n\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"maxLength\", \"2\");\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"data-val-max-value\", \"23\");\r\n        }\r\n        else if (selectUnit === \"numberOfMinutes\") {\r\n\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"maxLength\", \"2\");\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"data-val-max-value\", \"59\");\r\n        }\r\n        else if (selectUnit === \"numberOfSeconds\") {\r\n\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"maxLength\", \"2\");\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"data-val-max-value\", \"59\");\r\n        }\r\n        else if (selectUnit === \"numberOfMonths\") {\r\n\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"maxLength\", \"6\");\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"data-val-max-value\", \"240\");\r\n        }\r\n        return false;\r\n    },\r\n    updateControl: function ($control, selectedColumnName, valueColumnName) {\r\n\r\n        this.selectedColumnName = selectedColumnName;\r\n\r\n        this.valueColumnName = valueColumnName;\r\n\r\n        var time = $control.find(\"#\" + this.selectedColumnName).val();\r\n        var selectUnit = $control.find(\"#\" + this.selectedColumnName).val();\r\n\r\n\r\n        if (selectUnit === \"numberOfDays\") {\r\n\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"maxLength\", \"8\");\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"data-val-max-value\", \"7300\");\r\n            $control.find(\">:first-child\").val(\"\");\r\n        }\r\n        else if (selectUnit === \"numberOfHours\") {\r\n\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"maxLength\", \"2\");\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"data-val-max-value\", \"23\");\r\n            $control.find(\">:first-child\").val(\"\");\r\n        }\r\n        else if (selectUnit === \"numberOfMinutes\") {\r\n\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"maxLength\", \"2\");\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"data-val-max-value\", \"59\");\r\n            $control.find(\">:first-child\").val(\"\");\r\n        }\r\n        else if (selectUnit === \"numberOfSeconds\") {\r\n\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"maxLength\", \"2\");\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"data-val-max-value\", \"59\");\r\n            $control.find(\">:first-child\").val(\"\");\r\n        }\r\n        else if (selectUnit === \"numberOfMonths\") {\r\n\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"maxLength\", \"6\");\r\n            $control.find(\"#\" + this.valueColumnName).gcop().setAttribute(\"data-val-max-value\", \"240\");\r\n            $control.find(\">:first-child\").val(\"\");\r\n        }\r\n        else {\r\n            $control.find(\">:first-child\").val(\"\");\r\n        }\r\n        return false;\r\n    }\r\n};\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/debugger.js\n * ======================================== */\n\n﻿var gcopDebug = {\r\n    codeEditor: null,\r\n    $debugBar: null,\r\n    $output: null,\r\n\r\n    initialise: function () {\r\n        if (ENABLEDEBUGGER === \"true\") {\r\n            gcopDebug.load();\r\n        }\r\n    },\r\n\r\n    load: function () {\r\n\r\n\r\n        gcopDebug.$debugBar = $(\"#debug-bar\");\r\n\r\n        gcopDebug.$output = $(\"#output\");\r\n        gcopDebug.resize();\r\n        gcopDebug.bindEvents();\r\n    },\r\n\r\n    resize: function () {\r\n\r\n        var height = $(window).height();\r\n        if (gcopDebug.$debugBar.hasClass(\"active\")) {\r\n\r\n            $(\"#console-panel\").css(\"width\", $(window).width() - 20);\r\n\r\n        }\r\n    },\r\n\r\n    bindEvents: function () {\r\n\r\n        $(window).on(\"resize.gcopdebug\", function () {\r\n            gcopDebug.resize();\r\n        });\r\n\r\n        $(\"#debug-button\").on(\"click\", function () {\r\n\r\n            if (gcopDebug.$debugBar.hasClass(\"active\")) {\r\n                gcopDebug.showDebugBar(false);\r\n            }\r\n            else {\r\n                gcopDebug.showDebugBar(true);\r\n            }\r\n\r\n            gcopDebug.resize();\r\n        });\r\n\r\n        $(\"#toggle-console\").on(\"click\", function () {\r\n\r\n            if (gcopDebug.$debugBar.hasClass(\"console\")) {\r\n                gcopDebug.showConsole(false);\r\n                $(this).val(\"Show Console\");\r\n            }\r\n            else {\r\n                gcopDebug.showConsole(true);\r\n                $(this).val(\"Hide Console\");\r\n            }\r\n\r\n            gcopDebug.resize();\r\n        });\r\n\r\n        $(\"#toggle-output\").on(\"click\", function () {\r\n\r\n            if (gcopDebug.$debugBar.hasClass(\"output\")) {\r\n                gcopDebug.showOutputConsole(false);\r\n                $(this).val(\"Show Output\");\r\n            }\r\n            else {\r\n                gcopDebug.showOutputConsole(true);\r\n                $(this).val(\"Hide output\");\r\n            }\r\n\r\n            gcopDebug.resize();\r\n        });\r\n\r\n        $(\"#clear-console\").on(\"click\", function () {\r\n            //gcopDebug.codeEditor.setValue(\"\");\r\n            $(\"#console-panel\").val(\"\");\r\n        });\r\n\r\n        $(\"#clear-output\").on(\"click\", function () {\r\n            gcopDebug.$output.html(\"\");\r\n        });\r\n\r\n        $(\"#console-run\").on(\"click\", function () {\r\n\r\n            StartDebugTimer();\r\n            var result = undefined;\r\n            try {\r\n                //result = eval(gcopDebug.codeEditor.getValue());\r\n                result = eval($(\"#console-panel\").val());\r\n            } catch (e) {\r\n                result = e;\r\n                if (e.Message) {\r\n                    result = result + \" - \" + e.Message;\r\n                }\r\n            }\r\n\r\n            DebugExecutionTime(\"\", result);\r\n            gcopDebug.outputBreak();\r\n        });\r\n\r\n    },\r\n\r\n    showDebugBar: function (show) {\r\n        if (show) {\r\n            gcopDebug.$debugBar.addClass(\"active\");\r\n        } else {\r\n            gcopDebug.$debugBar.removeClass(\"active\");\r\n        }\r\n    },\r\n\r\n    // for debugging\r\n    showConsole: function (show) {\r\n        if (show) {\r\n            gcopDebug.$debugBar.addClass(\"console\");\r\n        } else {\r\n            gcopDebug.$debugBar.removeClass(\"console\");\r\n        }\r\n    },\r\n\r\n    // for log output.\r\n    showOutputConsole: function (show) {\r\n        if (show) {\r\n            gcopDebug.$debugBar.addClass(\"output\");\r\n        } else {\r\n            gcopDebug.$debugBar.removeClass(\"output\");\r\n        }\r\n    },\r\n\r\n\r\n    log: function (result, timings) {\r\n        // if an object loop its properties and log the created string.\r\n\r\n        // if its a string just put it on the page as is.\r\n        if (typeof result === 'object' && result.selector === undefined) {\r\n            var output = iterate(result);\r\n            gcopDebug.outPutDebug(output, timings);\r\n        }\r\n        else {\r\n            gcopDebug.outPutDebug(result, timings, true);\r\n        }\r\n    },\r\n\r\n    outPutDebug: function (result, timings, escapeResult) {\r\n\r\n        if (result === null) {\r\n            gcopDebug.$output.append(\"<div class='result'><span class='log-heading'>Result: </span><span class='log-null'> null</span> </div>\");\r\n        }\r\n        else if (result === undefined) {\r\n            gcopDebug.$output.append(\"<div class='result'><span class='log-heading'>Result: </span><span class='log-null'> undefined</span> </div>\");\r\n        }\r\n        else {\r\n            if (escapeResult) {\r\n                result = gcopDebug.replace(result);\r\n            }\r\n            gcopDebug.$output.append(\"<div class='result'> <span class='log-heading'>Result: </span></br>\" + result + \"</div>\");\r\n        }\r\n\r\n        if (timings) {\r\n            gcopDebug.$output.append(\"<div class='result'><span class='log-heading'>Time: </span>\" + timings + \"</div>\");\r\n        }\r\n\r\n        gcopDebug.scrollToBottom();\r\n    },\r\n\r\n    outputBreak: function () {\r\n        gcopDebug.$output.append(\"<div class='log-break'></div>\");\r\n        gcopDebug.$output.append(\"<div style='padding-bottom: 5px;'>Log ></div>\");\r\n        gcopDebug.scrollToBottom();\r\n    },\r\n\r\n    scrollToBottom: function () {\r\n        var $debugOutput = $(\"#debug-output\");\r\n        $debugOutput.scrollTop(($debugOutput[0].scrollHeight));\r\n    },\r\n\r\n    replace: function (value) {\r\n\r\n        var test = value;\r\n        try {\r\n            test = value.replace(\">\", '&gt;');\r\n            test = test.replace(\"<\", '&lt;');\r\n            test = test.replace(/\\</g, '&lt;');\r\n            test = test.replace(/\\>/g, \"&gt;\");\r\n            test = test.replace('\"', \"&quot;\");\r\n            test = test.replace(\"'\", \"&#39;\");\r\n        } catch (e) {\r\n\r\n        }\r\n\r\n        return test;\r\n    }\r\n\r\n\r\n};\r\n\r\n\r\n\r\nfunction iterate(obj) {\r\n\r\n    var createTabs = function (count) {\r\n        var tabString = \"\\t\";\r\n        if (count) {\r\n            for (var i = 0; i < count; i++) {\r\n                tabString = tabString + \"\\t\";\r\n            }\r\n        }\r\n\r\n        return tabString;\r\n    };\r\n\r\n    var result = \"\";\r\n\r\n    var loop = function (obj, tabs) {\r\n\r\n        for (var property in obj) {\r\n            if (obj.hasOwnProperty(property)) {\r\n                if (typeof obj[property] == \"object\") {\r\n                    result = result + createTabs(tabs) + property + \": \" + \"</br>\";\r\n                    loop(obj[property], tabs === undefined ? 1 : tabs + 1);\r\n                }\r\n                else {\r\n                    result = result + createTabs(tabs) + property + \": \" + obj[property] + \"\\n\";\r\n                }\r\n            }\r\n        }\r\n    };\r\n\r\n    loop(obj);\r\n    return \"<pre>\" + result + \"</pre>\";\r\n}\r\nvar StartDebugTime;\r\nfunction StartDebugTimer() {\r\n    StartDebugTime = new Date().getTime();\r\n}\r\n\r\nfunction DebugExecutionTime(name, codeResult) {\r\n    var EndTime = new Date().getTime();\r\n    var executionTime = EndTime - StartDebugTime;\r\n    //console.log(name + \":\" + executionTime + \"ms\");\r\n    gcopDebug.log(codeResult, name ? name + \": \" : \"\" + executionTime + \"ms\", true);\r\n}\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/dynamicToolbar.js\n * ======================================== */\n\n﻿var dynamicToolbar = {\r\n    $mainToolbar: null,\r\n    $navBar: null,\r\n    toolbars: [],\r\n    cacheKey: \"dynamicToolbar\",\r\n\r\n    // markup is passed in from dynoview as it cannot render a toolbar to the page as other pages can.\r\n    load: function (toolbarHtml) {\r\n\r\n        dynamicToolbar.bindEvents();\r\n\r\n        // check if there is a dynamic toolbar\r\n        dynamicToolbar.$mainToolbar = $(\"#main-toolbar\");\r\n        dynamicToolbar.$navBar = dynamicToolbar.$mainToolbar.find(\"#main-nav\");\r\n\r\n        var $angularToolbar = dynamicToolbar.$mainToolbar.find(\"div[ui-view=toolbar]\");\r\n        var $toolbar = dynamicToolbar.$mainToolbar.find(\"#main-nav\");\r\n\r\n        if ($angularToolbar.length > 0) {\r\n            dynamicToolbar.$navBar = $angularToolbar;\r\n        }\r\n        else {\r\n            dynamicToolbar.$navBar = $toolbar;\r\n        }\r\n\r\n        if (dynamicToolbar.$navBar.length > 0) {\r\n\r\n            if (toolbarHtml !== undefined) {\r\n                // if toolbar html has been passed in add it to the dom.\r\n\r\n                var $markUp = $(toolbarHtml);\r\n                dynamicToolbar.addToolbar($markUp);\r\n\r\n            }\r\n\r\n            dynamicToolbar.toolbars = dynamicToolbar.$navBar.find(\".persist-toolbar\");\r\n\r\n            if (dynamicToolbar.toolbars.length > 0) {\r\n                // we need to deal with any persisted toolbars\r\n                dynamicToolbar.storePersistedToolbars();\r\n            }\r\n\r\n            dynamicToolbar.loadExistingToolbars();\r\n\r\n            dynamicToolbar.initialiseButtons();\r\n\r\n        }\r\n    },\r\n\r\n    bindEvents: function () {\r\n        // binding events to elements that should clear the toolbar persistance.\r\n        $(\"#apps-menu a\").on(\"click\", function () {\r\n            dynamicToolbar.purge();\r\n            return true;\r\n        });\r\n\r\n        $(\"#settings-menu a\").on(\"click\", function () {\r\n            dynamicToolbar.purge();\r\n            return true;\r\n        });\r\n\r\n        $(\"#notifications\").on(\"click\", function () {\r\n            dynamicToolbar.purge();\r\n            return true;\r\n        });\r\n\r\n        $(\"#dashboard\").on(\"click\", function () {\r\n            dynamicToolbar.purge();\r\n            return true;\r\n        });\r\n\r\n        $(\"#top-logo\").on(\"click\", function () {\r\n            dynamicToolbar.purge();\r\n            return true;\r\n        });\r\n    },\r\n\r\n    initialiseButtons: function () {\r\n\r\n        // initialise any buttons here. for now there are only app events buttons.\r\n        dynamicToolbar.handleAppEventButtons();\r\n    },\r\n\r\n    handleAppEventButtons: function () {\r\n\r\n        // get the data that we need to send up.\r\n        // for the first cut this only works for dynoview.\r\n        // so get the dynoview data and send up with the request.\r\n\r\n        var success = function (result) {\r\n\r\n            if (result.success) {\r\n\r\n                // what was the required action\r\n                var onSuccess = result.data.model.onSuccess;\r\n\r\n                if (onSuccess !== undefined && onSuccess != null) {\r\n                    onSuccess = JSON.parse(onSuccess);\r\n\r\n                    var actionType = dynamicToolbar.actionTypes[onSuccess.actionType];\r\n                    if (actionType != undefined) {\r\n                        actionType.execute(result.data.model.data, onSuccess);\r\n                    }\r\n                }\r\n            }\r\n        };\r\n\r\n        var fail = function () {\r\n            cpf.alert(\"The app event failed to execute.\", \"e\");\r\n        };\r\n\r\n        var send = function ($button) {\r\n\r\n            // data to send to the server\r\n            if (typeof (APPLICATIONNAME) !== 'undefined' && APPLICATIONNAME !== '') {\r\n\r\n                var payload = { appName: APPLICATIONNAME };\r\n                payload[\"eventName\"] = $button.attr(\"data-event-name\");\r\n                payload[\"successEvent\"] = $button.attr(\"data-app-event\");\r\n\r\n                // if this is an indie app, replace indie.app with the appID\r\n                if (APPLICATIONNAME === \"indie.app\") {\r\n                    payload.appName = APP + \".app\";\r\n                }\r\n\r\n                var payloadData = [];\r\n\r\n                if (typeof (dynoview) !== 'undefined' && dynoview !== null) {\r\n                    //payload[\"data\"] = JSON.stringify(dynoview.val());\r\n                    payloadData = dynoview.val();\r\n                }\r\n\r\n                // if there is a preClientScript available call it and extend the payload.data object.\r\n                var preScriptId = $button.attr(\"id\") + \"PreClientScript\";\r\n                if (window[preScriptId]) {\r\n\r\n                    // this has to return an object.\r\n                    var extendedData = window[preScriptId]();\r\n                    if (typeof(extendedData) == \"object\") {\r\n\r\n                        if (!extendedData.hasOwnProperty(\"id\")) {\r\n                            extendedData[\"id\"] = \"extendedData\"; // assigning a default id if one was not added.\r\n                        }\r\n\r\n                        payloadData.push(extendedData);\r\n                    }\r\n                }\r\n\r\n                payload[\"data\"] = JSON.stringify(payloadData);\r\n                payload.cultureCode = CULTURE;\r\n                payload.identifier = dynoview.identifier;\r\n\r\n                var config = { url: APPLICATIONPATH + \"cpf/appevent\", type: \"POST\", success: success, errorCallback: fail, data: payload };\r\n                cpf.ajax(config);\r\n            }\r\n        };\r\n\r\n        var $eventButtons = dynamicToolbar.$navBar.find(\".app-event-button\");\r\n\r\n        if ($eventButtons.length > 0) {\r\n\r\n            $eventButtons.off(\"click\").on(\"click\", function () {\r\n                send($(this));\r\n                return false;\r\n            });\r\n        }\r\n    },\r\n\r\n    storePersistedToolbars: function () {\r\n        // does the toolbar have the persist class.\r\n        // if so we need to store it in local storage.\r\n\r\n        var persistedToolbar = cpf.store.get(dynamicToolbar.cacheKey, {});\r\n\r\n        for (var i = 0; i < dynamicToolbar.toolbars.length; i++) {\r\n            if ($(dynamicToolbar.toolbars[i]).gcop().hasClass(\"persist-toolbar\")) {\r\n\r\n                var toolbarHtml = $(dynamicToolbar.toolbars[i]).clone().html(),\r\n                html = \"\",\r\n                dynoButton = $(dynamicToolbar.toolbars[i]).hasClass(\"dyno-control\");\r\n\r\n                if (dynoButton) {\r\n                    html = \"<li id='\" + $(dynamicToolbar.toolbars[i]).attr(\"id\") + \"' class='\" + $(dynamicToolbar.toolbars[i]).attr(\"class\") + \"' data-dyno-type='\" + $(dynamicToolbar.toolbars[i]).attr(\"data-dyno-type\") + \"' data-trigger='\" + $(dynamicToolbar.toolbars[i]).attr(\"data-trigger\") + \"'>\" + toolbarHtml + \"</li>\";\r\n                }\r\n                else {\r\n                    html = \"<li id='\" + $(dynamicToolbar.toolbars[i]).attr(\"id\") + \"' class='\" + $(dynamicToolbar.toolbars[i]).attr(\"class\") + \"'>\" + toolbarHtml + \"</li>\";\r\n                }\r\n\r\n                if (persistedToolbar[$(dynamicToolbar.toolbars[i]).attr(\"id\")] == undefined) {\r\n                    persistedToolbar[$(dynamicToolbar.toolbars[i]).attr(\"id\")] = String(html);\r\n                }\r\n            }\r\n        }\r\n\r\n        cpf.store.set(dynamicToolbar.cacheKey, persistedToolbar);\r\n    },\r\n\r\n    loadExistingToolbars: function () {\r\n\r\n        // do we have an existing toolbar in storage\r\n        var toolbar = cpf.store.get(dynamicToolbar.cacheKey, null);\r\n\r\n        if (toolbar != null) {\r\n\r\n            if (dynamicToolbar.$mainToolbar.length > 0) {\r\n\r\n                var $navbar = dynamicToolbar.$mainToolbar.find(\"#main-nav\");\r\n                if ($navbar.length > 0) {\r\n                    for (var key in toolbar) {\r\n                        var $toolbar = $(toolbar[key]);\r\n                        dynamicToolbar.addToolbar($toolbar);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n        navigation.bindToolBar();\r\n    },\r\n\r\n    addToolbar: function ($toolbar) {\r\n\r\n        var id = $toolbar.attr(\"id\");\r\n\r\n        if ($(\"#\" + id).length === 0) {\r\n            dynamicToolbar.$navBar.append($toolbar);\r\n\r\n            dynoview.evaluateVisibility($toolbar, dynoToolbarButton);\r\n        }\r\n    },\r\n\r\n    purge: function () {\r\n        cpf.store.remove(dynamicToolbar.cacheKey);\r\n    },\r\n\r\n    //// toolbarModel = { 'virtualFilePath': '/system/icms/toolbar/testtoolbar.toolbar', 'persist': 'boolean' }\r\n    get: function (toolbarModel) {\r\n\r\n        if (toolbarModel !== undefined && toolbarModel !== null && toolbarModel.persist == undefined) {\r\n            toolbarModel.persist = false;\r\n        }\r\n        var success = function (result, textStatus, jqXHR) {\r\n            cpf.spin(false);\r\n            if (toolbarModel.persist) {\r\n\r\n                var persistedToolbar = cpf.store.get(dynamicToolbar.cacheKey, {});\r\n\r\n                var id = $(result).attr(\"id\");\r\n                persistedToolbar[id] = String(result);\r\n                cpf.store.set(dynamicToolbar.cacheKey, persistedToolbar);\r\n            }\r\n\r\n            dynamicToolbar.addToolbar($(result));\r\n            dynamicToolbar.handleAppEventButtons();\r\n        };\r\n\r\n        var error = function (result, textStatus, jqXHR) {\r\n            cpf.spin(false);\r\n            cpf.alert(\"There was an error fetching the toolbar with name : \" + name, \"w\");\r\n        };\r\n\r\n        if (toolbarModel !== undefined && toolbarModel !== null) {\r\n            cpf.spin(true);\r\n\r\n            var arguments = { url: APPLICATIONPATH + \"cpf/controls/toolbar\", dataType: \"html\", type: \"POST\", data: toolbarModel, success: success, errorCallback: error };\r\n            cpf.ajax(arguments);\r\n        }\r\n    },\r\n\r\n    actionTypes: {\r\n        link: {\r\n            execute: function (data, onSuccess) {\r\n                cpf.spin(true);\r\n                location.href = onSuccess.url;\r\n                \r\n            }\r\n        },\r\n\r\n        alert: {\r\n            execute: function (data, onSuccess) {\r\n                cpf.alert(onSuccess.alertMessage, onSuccess.alertType);\r\n                \r\n            }\r\n        },\r\n\r\n        delayedAlert: {\r\n            execute: function (data, onSuccess) {\r\n                cpf.spin(true);\r\n                cpf.delayedAlert(onSuccess.alertMessage, onSuccess.alertType);\r\n                location.href = onSuccess.url;\r\n                \r\n            }\r\n        },\r\n\r\n        script: {\r\n            execute: function (data, onSuccess) {\r\n                if (window[onSuccess.functionName]) {\r\n                    window[onSuccess.functionName](data);\r\n                }\r\n            }\r\n        }\r\n    }\r\n};\r\n\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/entity.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\n;\r\nvar entity = {\r\n    redirect: function (url) {\r\n        if ($.trim(url).length > 0 && url != null && typeof (url) != undefined) {\r\n            window.location = url;\r\n        }\r\n    }\r\n};\r\n\r\nentity.list = {\r\n    load: function () {\r\n    }\r\n};\r\n\r\nentity.entries = {\r\n    search: null,\r\n    load: function () {\r\n\r\n        var searchId = $(\".search-results-outer\").gcop().getAttribute(\"id\");\r\n        entity.entries.search = SEARCHES[searchId];\r\n\r\n        var data = {\r\n            searchName: entity.entries.search.searchName,\r\n            searchVirtualFilePath: entity.entries.search.searchVirtualFilePath,\r\n            searchableVirtualFilePath: SEARCHABLEVIRTUALFILEPATH\r\n        };\r\n\r\n        cpf.store.set(\"EntityData\", data);\r\n        entity.entries.enableRibbonButtons({ selectedRows: [] });\r\n\r\n        $(\"#results-container\").on(\"selected\", \".search-results\", function (event, eventArgs) {\r\n            entity.entries.enableRibbonButtons(eventArgs);\r\n        });\r\n\r\n        $(\"#entry-button-delete\").on(\"click\", function (e) {\r\n            e.preventDefault();\r\n            if (!$(this).hasClass(\"disabled\")) {\r\n                if (entity.entries.getCheckedItemsCount() > 0) {\r\n                    ConfirmationBox.Show($(\"#delete-data-entries-confirmation\"), entity.entries.deleteDataEntries);\r\n                }\r\n                else {\r\n                    cpf.alert(\"RESOURCE{{entity.js}:{SelectRowToDelete}:{Please select a row to delete a data entry.}}\", \"i\");\r\n                }\r\n            }\r\n            return false;\r\n        });\r\n\r\n        $(\"#entry-button-edit\").on(\"click\", function () {\r\n            if (!$(this).hasClass(\"disabled\")) {\r\n                var selectedItem = entity.entries.getSelectedItems()[0];\r\n                entity.entries.redirectToFields(selectedItem);\r\n            }\r\n            return false;\r\n        });\r\n\r\n        $(\"#entry-button-create\").click(\"click\", function () {\r\n            cpf.store.remove(\"EntryData\");\r\n            entity.entries.redirectToFields();\r\n            return false;\r\n        });\r\n\r\n        entity.entries.search.gridView.redirect = function () {\r\n            var $grid = $(\".grid\");\r\n            $grid.find(\"tbody td:not(.item-selection-column)\").off(\"click\").on(\"click\", function (event) {\r\n                var jsonString = $(this).parent().gcop().getAttribute(\"data-row\");\r\n                var entryObject = JSON.parse(jsonString);\r\n                entity.entries.redirectToFields(entryObject);\r\n                return false;\r\n            });\r\n        };\r\n    },\r\n    getCheckedItemsCount: function () {\r\n        return $(\".search-results .results-container .item-selection-column input[type=checkbox]:checked\").length;\r\n    },\r\n    getSelectedItems: function () {\r\n        var groups = [];\r\n        var checkedItemCount = entity.entries.getCheckedItemsCount();\r\n        for (i = 0; i < checkedItemCount; i++) {\r\n            var jsonString = $(\".search-results .results-container .item-selection-column input[type=checkbox]:checked:eq(\" + i + \")\").parents(\".zugo-item:first\").attr(\"data-row\");\r\n            var selectedItem = JSON.parse(jsonString);\r\n            groups.push(selectedItem);\r\n        }\r\n\r\n        return groups;\r\n    },\r\n    enableRibbonButtons: function (eventArgs) {\r\n        var selected = eventArgs.selectedRows.length;\r\n        if (selected > 0 && selected < 2) {\r\n            $(\"#entry-button-delete\").removeClass(\"disabled\");\r\n            $(\"#entry-button-edit\").removeClass(\"disabled\");\r\n        }\r\n        else if (selected > 1) {\r\n            $(\"#entry-button-delete\").removeClass(\"disabled\");\r\n            $(\"#entry-button-edit\").addClass(\"disabled\");\r\n        } else {\r\n            $(\"#entry-button-edit\").addClass(\"disabled\");\r\n            $(\"#entry-button-delete\").addClass(\"disabled\");\r\n        }\r\n    },\r\n    deleteDataEntries: function () {\r\n        var data = entity.entries.getDeleteModel();\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/entity/DeleteEntries\", success: entity.entries.deleteSuccess, errorCallback: entity.entries.deleteErrorCallback, data: data });\r\n\r\n    },\r\n    getDeleteModel: function () {\r\n        var entityData = cpf.store.get(\"EntityData\");\r\n        var selectedItems = entity.entries.getSelectedItems();\r\n        var deleteModel = {};\r\n        deleteModel.searchVirtualFilePath = entityData[\"searchVirtualFilePath\"];\r\n        deleteModel.searchableVirtualFilePath = entityData[\"searchableVirtualFilePath\"];\r\n        var entries = [];\r\n        var deleteEntry;\r\n        for (var k = 0; k < selectedItems.length; k++) {\r\n            entries.push(entity.entries.getKeys(selectedItems[k]));\r\n        }\r\n        deleteModel.entries = JSON.stringify(entries);\r\n        var data = {};\r\n        data.deleteModel = deleteModel;\r\n        return data;\r\n    },\r\n    deleteSuccess: function (result, textStatus, jqXHR) {\r\n        $(\"body\").trigger(\"saved\");\r\n    },\r\n    deleteErrorCallback: function (result, textStatus, jqXHR) {\r\n        if (result[\"unhandled\"] == true) {\r\n            cpf.alert(\"RESOURCE{{entity.js}:{DeleteEntryFailed}:{There has been an error in the delete entries request.}}\", \"e\");\r\n        }\r\n    },\r\n    redirectToFields: function (selectedItem) {\r\n        var keysInSelectedItem = [];\r\n        var useFilter = false;\r\n        if (selectedItem !== undefined || selectedItem != null) {\r\n            keysInSelectedItem = entity.entries.getKeyValues(selectedItem);\r\n            useFilter = true;\r\n            cpf.store.set(\"EntryData\", keysInSelectedItem);\r\n        }\r\n        else {\r\n            useFilter = false;\r\n            var keys = [];\r\n            var fieldItem = {};\r\n            for (var i = 0; i < entryKeys.length; i++) {\r\n                fieldItem = { name: entryKeys[i] };\r\n                keys.push(fieldItem);\r\n            }\r\n            cpf.store.set(\"EntryData\", keys);\r\n        }\r\n        entity.entries.submitForm(keysInSelectedItem, useFilter);\r\n    },\r\n    submitForm: function (keysInSelectedItem, useFilter) {\r\n\r\n        var data = cpf.store.get(\"EntityData\");\r\n        var url = APPLICATIONPATH + \"cpf/entity/listfields\";\r\n        var $redirectform = $(\"<form action='\" + url + \"' method='POST' ></form>\");\r\n        var postdata = JSON.parse($(\".results-container\").attr(\"data\"));\r\n        var filter = useFilter ? entity.entries.createFilter(keysInSelectedItem, \"\") : \"\";\r\n\r\n        var $sortColumn = $(\"<input type='hidden' name='sortColumn' value='\" + postdata[\"sortColumn\"] + \"'/>\");\r\n        $redirectform.append($sortColumn);\r\n\r\n        var $sortDirection = $(\"<input type='hidden' name='sortDirection' value='\" + postdata[\"sortDirection\"] + \"'/>\");\r\n        $redirectform.append($sortDirection);\r\n\r\n        var $filter = $(\"<input type='hidden' name='filter' value=\\\"\" + filter + \"\\\"/>\");\r\n        $redirectform.append($filter);\r\n\r\n        var $searchName = $(\"<input type='hidden' name='searchName' value='\" + entity.entries.search.searchName + \"'/>\");\r\n        $redirectform.append($searchName);\r\n\r\n        var $searchVirtualFilePath = $(\"<input type='hidden' name='searchVirtualFilePath' value='\" + entity.entries.search.searchVirtualFilePath + \"'/>\");\r\n        $redirectform.append($searchVirtualFilePath);\r\n\r\n        var $searchableVirtualFilePath = $(\"<input type='hidden' name='searchableVirtualFilePath' value='\" + data.searchableVirtualFilePath + \"'/>\");\r\n        $redirectform.append($searchableVirtualFilePath);\r\n\r\n    \r\n        $(\"body\").append($redirectform);\r\n        $redirectform.submit();\r\n    },\r\n    getKeyValues: function (selectedItem) {\r\n        var keysInSelectedItem = [];\r\n        for (var i = 0; i < entryKeys.length; i++) {\r\n            for (var j = 0; j < selectedItem.length; j++) {\r\n                if (selectedItem[j][\"name\"] == entryKeys[i]) {\r\n                    selectedItem[j][\"columnIndex\"] = j;\r\n                    keysInSelectedItem.push(selectedItem[j]);\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n        return keysInSelectedItem;\r\n    },\r\n    createFilter: function (keysInSelectedItem, currentFilters) {\r\n        var filters = [];\r\n        if (currentFilters != \"\" && currentFilters != null && currentFilters !== undefined) {\r\n            filters.push(currentFilters);\r\n        }\r\n        for (var i = 0; i < keysInSelectedItem.length; i++) {\r\n            filters.push(\"field['\" + keysInSelectedItem[i][\"id\"] + \"'] == '\" + keysInSelectedItem[i][\"value\"] + \"'\");\r\n        }\r\n        return filters.join(\" && \");\r\n    },\r\n    getKeys: function (selectedItem) {\r\n        var keysInSelectedItem = [];\r\n        for (var i = 0; i < entryKeys.length; i++) {\r\n            for (var j = 0; j < selectedItem.length; j++) {\r\n                if (selectedItem[j][\"name\"] == entryKeys[i]) {\r\n                    var fieldItem = {\r\n                        name: selectedItem[j][\"name\"],\r\n                        currentValue: selectedItem[j][\"value\"],\r\n                        newValue: null\r\n                    };\r\n                    keysInSelectedItem.push(fieldItem);\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n        var entryItem = {\r\n            fields: keysInSelectedItem\r\n        };\r\n\r\n        return entryItem;\r\n    }\r\n};\r\n\r\nentity.entries.fields = {\r\n    load: function () {\r\n        $(\"#back-button\").on(\"click\", function () {\r\n            cpf.store.remove(\"EntryData\");\r\n            var data = cpf.store.get(\"EntityData\");\r\n            entity.redirect(APPLICATIONPATH + \"cpf/entity/listentries?searchableVirtualFilePath=\" + data.searchableVirtualFilePath + \"&searchVirtualFilePath=\" + data.searchVirtualFilePath);\r\n            return false;\r\n        });\r\n\r\n        $(\"#dataField-button-save\").on(\"click\", function () {\r\n            if ($(\"#fields-wrapper\").validate()) {\r\n                entity.entries.fields.save();\r\n            }\r\n            return false;\r\n        });\r\n    },\r\n    save: function () {\r\n        var data = entity.entries.fields.getData();\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/entity/StoreEntry\", success: entity.entries.fields.saveSuccess, errorCallback: entity.entries.fields.saveErrorCallback, data: data });\r\n    },\r\n    saveSuccess: function (result, textStatus, jqXHR) {\r\n        entity.entries.fields.updateCurrentValues();\r\n        $(\"body\").trigger(\"saved\");\r\n        //entity.redirect(APPLICATIONPATH + result.data.redirect);\r\n    },\r\n    saveErrorCallback: function (result, textStatus, jqXHR) {\r\n        if (result[\"unhandled\"]) {\r\n            cpf.alert(\"RESOURCE{{entity.js}:{SaveEntryFailed}:{There has been an error in the save entries request.}}\", \"e\");\r\n        }\r\n    },\r\n    getData: function () {\r\n        var entityData = cpf.store.get(\"EntityData\");\r\n        var data = {};\r\n        var entryData = {};\r\n        entryData.searchVirtualFilePath = entityData[\"searchVirtualFilePath\"];\r\n        entryData.searchableVirtualFilePath = entityData[\"searchableVirtualFilePath\"];\r\n        entryData.fields = entity.entries.fields.getFieldValues();\r\n        data.entry = entryData;\r\n        data.searchName = entityData[\"searchName\"];\r\n        return data;\r\n    },\r\n    getFieldValues: function () {\r\n        var fields = [];\r\n        var fieldItem = {};\r\n        var $fields = $(\"div.field-value-wrapper\");\r\n        var fieldsLength = $fields.length;\r\n\r\n        var entryData = cpf.store.get(\"EntryData\");\r\n        for (var i = 0; i < fieldsLength; i++) {\r\n            fieldItem = entity.entries.fields.getFieldValue($fields.eq(i));\r\n            if (entryData != null) {\r\n                for (var j = 0; j < entryData.length; j++) {\r\n                    if (entryData[j][\"name\"] == fieldItem.name && entryData[j][\"value\"] !== undefined) {\r\n                        fieldItem.currentValue = entryData[j][\"value\"];\r\n                    }\r\n                }\r\n            }\r\n            fields.push(fieldItem);\r\n        }\r\n\r\n        return fields;\r\n    },\r\n    getFieldValue: function ($field) {\r\n        var fieldItem = {};\r\n        var dataType = $field.gcop().getAttribute(\"data-type\");\r\n        switch (dataType) {\r\n            case \"boolean\":\r\n                fieldItem.name = $field.find(\"input:radio\").gcop().getAttribute(\"name\");\r\n                fieldItem.newValue = $field.find(\"input:radio[name='\" + fieldItem.name + \"']:checked\").val();\r\n                break;\r\n            case \"text\":\r\n                fieldItem.name = $field.find(\"input\").gcop().getAttribute(\"name\");\r\n                fieldItem.newValue = $field.find(\"input\").val();\r\n                break;\r\n            case \"multilinetext\":\r\n                fieldItem.name = $field.find(\"textarea\").gcop().getAttribute(\"name\");\r\n                fieldItem.newValue = $field.find(\"textarea\").val();\r\n                break;\r\n            case \"datetime\":\r\n                fieldItem.name = $field.find(\"input\").gcop().getAttribute(\"name\");\r\n                fieldItem.newValue = $field.find(\"input\").val();\r\n                break;\r\n            default:\r\n                fieldItem.name = $field.find(\"input\").gcop().getAttribute(\"name\");\r\n                fieldItem.newValue = $field.find(\"input\").val();\r\n                break;\r\n        }\r\n\r\n        return fieldItem;\r\n    },\r\n    updateCurrentValues: function () {\r\n        var entryData = cpf.store.get(\"EntryData\");\r\n        var newValues = entity.entries.fields.getFieldValues();\r\n        for (var i = 0; i < entryData.length; i++) {\r\n            for (var j = 0; j < newValues.length; j++) {\r\n                if (entryData[i].name == newValues[j][\"name\"]) {\r\n                    entryData[i].value = newValues[j][\"newValue\"];\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n        cpf.store.remove(\"EntryData\");\r\n        cpf.store.set(\"EntryData\", entryData);\r\n    }\r\n};\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/export.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n// This is intended for the export UI but we have had to stop mid stream, so it lives here for now\r\nvar exporter = {};\r\nvar exportFunctions = {};\r\n\r\n$.extend(exportFunctions, {\r\n    dynoprint: function () {\r\n        return APPLICATIONPATH + \"cpf/core/portal\";\r\n    }\r\n});\r\n\r\n/*\r\n// examples of extending the exportFunctions object:\r\n$.extend(exportFunctions, { dynodata: function () {\r\nreturn {\r\n\"name\": \"Chris\",\r\n\"age\": 30\r\n};\r\n} \r\n});\r\n\r\n$.extend(exportFunctions, { xmldata: function () {\r\nreturn {\r\n\"name\": \"Chris\",\r\n\"age\": 30\r\n};\r\n}});\r\n*/\r\n\r\nexporter = {\r\n    load: function () {\r\n\r\n        $(\"#main-toolbar .export-option\").on(\"click\", function (e) {\r\n            // added $(\".dyno-form\") !== undefined check to ensure dashboards containing search results can be expoted without the row selected check\r\n            if (!$(this).hasClass(\"disabled\") && cpf.noOfRowsSelected() === 1 || $(\".dyno-view\").length !== 0 || window.location.href.toLowerCase().indexOf(APPLICATIONPATH.toLowerCase() + \"explorer/searchresults\") !== -1) {\r\n                cpf.spin();\r\n\r\n                var $option = $(this);\r\n                var optionJson = $option.attr(\"data-json\");\r\n                var option = JSON.parse(optionJson);\r\n\r\n                var route = APPLICATIONPATH + option.route;\r\n                var routeFunction = option.routeFunction;\r\n                var dataFunction = option.dataFunction;\r\n                var customFunction = option.customFunction;\r\n\r\n                var data = {};\r\n\r\n                // check if we need to run a function to get the route\r\n                if (routeFunction) {\r\n                    try {\r\n                        route = window[\"exportFunctions\"][routeFunction]();\r\n                    }\r\n                    catch (ex) {\r\n                        cpf.spin(false);\r\n                        cpf.alert(\"RESOURCE{{cpf.ui.js}:{ExportRouteError}:{Unable to calculate export route: }}\" + routeFunction, \"e\");\r\n                        return false;\r\n                    }\r\n                }\r\n\r\n                // check if we need to run a function to get the json to post to the route\r\n                if (dataFunction) {\r\n                    try {\r\n                        data = window[\"exportFunctions\"][dataFunction](option);\r\n                    }\r\n                    catch (ex) {\r\n                        cpf.spin(false);\r\n                        cpf.alert(\"RESOURCE{{cpf.ui.js}:{ExportDataError}:{Unable to calculate export data: }}\" + dataFunction, \"e\");\r\n                        return false;\r\n                    }\r\n                }\r\n\r\n                // check if there is a custom function to handle this export\r\n                if (customFunction) {\r\n                    try {\r\n                        data = window[\"exportFunctions\"][customFunction](route, data);\r\n                    }\r\n                    catch (ex) {\r\n                        cpf.spin(false);\r\n                        cpf.alert(\"RESOURCE{{cpf.ui.js}:{ExportRouteError}:{Unable to execute custom export function: }}\" + customFunction, \"e\");\r\n                    }\r\n\r\n                    // make sure the spinner is off, just in case the custom function did not deal with it\r\n                    cpf.spin(false);\r\n                    return false;\r\n                }\r\n\r\n                // each export handler should expect a json request of type Sysrepublic.Foundation.Export.ExportRequest\r\n                var exportRequest = {};\r\n                exportRequest.data = data;\r\n                exportRequest.option = option;\r\n                exportRequest.sender = location.href;\r\n\r\n                if ($option.attr(\"data-pop\") == \"True\") {\r\n                    cpf.spin(false);\r\n\r\n                    // TODO : pass the export data on the querystring\r\n\r\n                    var newwindow = window.open(route);\r\n                    if (window.focus) {\r\n                        newwindow.focus();\r\n                    }\r\n\r\n                    return false;\r\n                } else {\r\n                    var success = function (exportResponse) {\r\n                        cpf.spin(false);\r\n\r\n                        // exportResponse should be of type Sysrepublic.Foundation.Export.ExportResponse\r\n                        if (!exportResponse.success) {\r\n                            cpf.alert(exportResponse.message, \"e\");\r\n                        }\r\n                        else {\r\n\r\n                            switch (exportResponse.type) {\r\n                                case \"Redirect\":\r\n                                    window.location = exportResponse.url;\r\n                                    break;\r\n                                case \"Alert\":\r\n                                default:\r\n                                    cpf.alert(exportResponse.message, \"s\");\r\n                                    break;\r\n                            }\r\n                        }\r\n                    };\r\n\r\n                    var failed = function (result, textStatus, jqXHR) {\r\n                        cpf.spin(false);\r\n                        var errorMessage;\r\n\r\n                        if (result.status != undefined && result.statusText != undefined) {\r\n                            errorMessage = result.status + \": \" + result.statusText;\r\n                        }\r\n                        else if (result.message != undefined) {\r\n                            errorMessage = result.message;\r\n                        }\r\n                        else {\r\n                            errorMessage = \"RESOURCE{{cpf.ui.js}:{ExportFailure}:{Failed to export, Please contact your administrator.}}\";\r\n                        }\r\n                        cpf.alert(errorMessage, \"e\");\r\n                    };\r\n\r\n                    cpf.ajax({ url: route, success: success, errorCallback: failed, data: exportRequest });\r\n                }\r\n            }\r\n\r\n            return false;\r\n        });\r\n    }\r\n};\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/gcop/gcop.main.js\n * ======================================== */\n\n﻿(function ($) {\r\n    $.fn.gcop = function () {\r\n        GCOP.$this = this;\r\n        return GCOP;\r\n    };\r\n})(jQuery);\r\n\r\nvar GCOP = {\r\n    $this: 0,\r\n\r\n    // turn the css display to block\r\n    show: function () {\r\n        return this.$this.each(function () {\r\n            $(this).css(\"display\", \"block\");\r\n        });\r\n    },\r\n\r\n    // turn the css display to none\r\n    hide: function () {\r\n        return this.$this.each(function () {\r\n            $(this).css(\"display\", \"none\");\r\n        });\r\n    },\r\n\r\n    // turn the css visibility to visible\r\n    visible: function () {\r\n        return this.$this.each(function () {\r\n            $(this).css(\"visibility\", \"visible\");\r\n        });\r\n    },\r\n\r\n    // turn the css visibility to hidden\r\n    hidden: function () {\r\n        return this.$this.eac