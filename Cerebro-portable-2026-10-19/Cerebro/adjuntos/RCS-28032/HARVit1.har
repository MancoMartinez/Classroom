 $parent, preventAdjustingOffset) {\r\n\t\t\tif ($menu.length === 0) {\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\tvar $container;\r\n\t\t\tvar $parent =\r\n\t\t\t\ttypeof $parent !== \"undefined\" && $parent.length\r\n\t\t\t\t\t? $parent\r\n\t\t\t\t\t: $menu.parent();\r\n\t\t\tvar popTop = false;\r\n\t\t\tvar clipsBottom = false;\r\n\t\t\tvar fixedMenu = $menu.hasClass(\"avoid-menu-fixed\");\r\n\t\t\tvar fixedBottomMenu = $menu.hasClass(\"fixed-bottom\");\r\n\t\t\tvar dDMenuContent = $menu.hasClass(\"dd-menu-content\");\r\n\r\n\t\t\tif (fixedMenu) {\r\n\t\t\t\tif (!preventAdjustingOffset) {\r\n\t\t\t\t\t$menu.css({\r\n\t\t\t\t\t\tbottom: \"auto\",\r\n\t\t\t\t\t\tleft: $parent.offset().left,\r\n\t\t\t\t\t\ttop: $parent.offset().top + $parent.outerHeight(),\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t\t$container = $parent.closest(\".scroll-content\");\r\n\t\t\t} else {\r\n\t\t\t\t$container = $parent.closest(\r\n\t\t\t\t\t\".scroll-content, .dv-body, .lightbox-content\"\r\n\t\t\t\t);\r\n\t\t\t}\r\n\r\n\t\t\tvar menuHeight = $menu.outerHeight();\r\n\r\n\t\t\t// if there is still no container found\r\n\t\t\tif (!$container.length) {\r\n\t\t\t\t$container = $(document.body);\r\n\t\t\t}\r\n\r\n\t\t\t// decide to pop up or down\r\n\r\n\t\t\tspaceAtTop = ($parent.offset().top - $container.offset().top) >> 0;\r\n\t\t\t// i.e.: viewport height - actual position in viewport + trigger height\r\n\t\t\tspaceAtBottom =\r\n\t\t\t\t($container.outerHeight() -\r\n\t\t\t\t\t($parent.offset().top -\r\n\t\t\t\t\t\t$container.offset().top +\r\n\t\t\t\t\t\t$parent.outerHeight())) >>\r\n\t\t\t\t0;\r\n\r\n\t\t\t// decide here about direction (and promote downward if required)\r\n\t\t\tif (spaceAtTop > menuHeight && spaceAtTop > spaceAtBottom) {\r\n\t\t\t\tif (!fixedBottomMenu){\r\n\t\t\t\t\tpopTop = true;\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tif (spaceAtBottom - menuHeight < 0) {\r\n\t\t\t\t\tclipsBottom = true;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\t$menu.toggleClass(\"pop-top\", popTop);\r\n\r\n\t\t\tif (fixedMenu) {\r\n\t\t\t\tif (popTop && !preventAdjustingOffset) {\r\n\t\t\t\t\t$menu.css({\r\n\t\t\t\t\t\ttop: \"auto\",\r\n\t\t\t\t\t\tbottom: window.innerHeight - $parent.offset().top,\r\n\t\t\t\t\t});\r\n\t\t\t\t} else if (clipsBottom) {\r\n\t\t\t\t\t$menu.css({\r\n\t\t\t\t\t\tbottom: 0,\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\t// if the menu has an attribute to pop left always, pop left, otherwise work it out\r\n\t\t\tif ($parent.length && $parent.is(\"[open-left]\")) {\r\n\t\t\t\t// explicit left direction\r\n\t\t\t\t$parent.toggleClass(\"open-left\", true);\r\n\t\t\t} else if (fixedMenu) {\r\n\t\t\t\tvar shouldPopLeft =\r\n\t\t\t\t\twindow.innerWidth - $parent.offset().left <\r\n\t\t\t\t\t$menu.width() + 10;\r\n\t\t\t\tif (window.innerWidth < 991 && !dDMenuContent) {\r\n\t\t\t\t\t// Setup menu for mobile mode.\r\n                    $menu.css({\r\n                        left: ($(window).width() - $menu.outerWidth()) / 2\r\n                    });\r\n\t\t\t\t} else  if(\r\n\t\t\t\t\tshouldPopLeft && !dDMenuContent\r\n\t\t\t\t) {\r\n\t\t\t\t\t// Handle left drop down search composer accordions.\r\n\t\t\t\t\t$menu.css({\r\n\t\t\t\t\t\tleft:\r\n\t\t\t\t\t\t\t$parent.offset().left -\r\n\t\t\t\t\t\t\t$menu.outerWidth() +\r\n\t\t\t\t\t\t\t$parent.outerWidth(),\r\n\t\t\t\t\t});\r\n\t\t\t\t} else {\r\n\t\t\t\t\t$parent.toggleClass(\"open-left\", shouldPopLeft);\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tif (window.innerWidth < 767  && !dDMenuContent) {\r\n\t\t\t\t\t// Setup menu for mobile mode.\r\n\t\t\t\t\t$menu.css({\r\n\t\t\t\t\t\tleft:\r\n\t\t\t\t\t\t\t-(\r\n\t\t\t\t\t\t\t\t$parent.offset().left +\r\n\t\t\t\t\t\t\t\t$(\".scroll-panel\").scrollLeft()\r\n\t\t\t\t\t\t\t) + 12.5,\r\n\t\t\t\t\t});\r\n\t\t\t\t} else {\r\n\t\t\t\t\t// Determine if the menu should pop to the left.\r\n\t\t\t\t\tvar shouldPopLeft =\r\n\t\t\t\t\t\twindow.innerWidth <\r\n\t\t\t\t\t\t$parent.offset().left + $menu.outerWidth();\r\n\t\t\t\t\tif (shouldPopLeft && !dDMenuContent) {\r\n\t\t\t\t\t\t$menu.css({\r\n\t\t\t\t\t\t\tleft: -($menu.outerWidth() - $parent.outerWidth()),\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\tinit: function () {\r\n\t\t\tvar refreshMenus = function () {\r\n\t\t\t\t$menus = $(\".avoid-menu\");\r\n\r\n\t\t\t\tfor (var i = 0, ii = $menus.length; i < ii; i++) {\r\n\t\t\t\t\tif (!$menus.eq(i).is(\":visible\")) {\r\n\t\t\t\t\t\tcontinue;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tcpfx.avoidingMenus.position($menus.eq(i));\r\n\t\t\t\t}\r\n\t\t\t};\r\n\t\t\t// set up listeners\r\n\t\t\t$(\".scroll-content, .lightbox-content, .dyno-view-body\").on(\r\n\t\t\t\t\"scroll.avoidingMenus\",\r\n\t\t\t\trefreshMenus\r\n\t\t\t);\r\n\t\t\t$(document.body).on(\"refreshAvoidingMenus\", refreshMenus);\r\n\t\t\t$(window).on(\"resize.avoidingMenus\", refreshMenus);\r\n\t\t},\r\n\t},\r\n\tlabels: function () {\r\n\t\t$(document.body).on(\r\n\t\t\t\"focus\",\r\n\t\t\t\"input[type=text], input[type=password], input[type=number], textarea, select\",\r\n\t\t\tfunction () {\r\n\t\t\t\t$(this)\r\n\t\t\t\t\t.closest(\".form-group, .prop-panel-control\")\r\n\t\t\t\t\t.find(\"> label:first-child\")\r\n\t\t\t\t\t.addClass(\"focuslabel\");\r\n\t\t\t\t$(this)\r\n\t\t\t\t\t.closest(\".form-control-container\")\r\n\t\t\t\t\t.addClass(\"form-control-container_focused\");\r\n\t\t\t}\r\n\t\t);\r\n\r\n\t\t$(document.body).on(\r\n\t\t\t\"blur\",\r\n\t\t\t\"input[type=text], input[type=password], input[type=number], textarea, select\",\r\n\t\t\tfunction () {\r\n\t\t\t\t$(this)\r\n\t\t\t\t\t.closest(\".form-group, .prop-panel-control\")\r\n\t\t\t\t\t.find(\"> label:first-child\")\r\n\t\t\t\t\t.removeClass(\"focuslabel\");\r\n\t\t\t\t$(this)\r\n\t\t\t\t\t.closest(\".form-control-container\")\r\n\t\t\t\t\t.removeClass(\"form-control-container_focused\");\r\n\t\t\t}\r\n\t\t);\r\n\t},\r\n\tnavigation: function () {\r\n\t\t$(document.body).on(\"click.toolbartoggle\", function (event) {\r\n\t\t\tvar $toggle = $(\".toolbar-toggle:visible\");\r\n