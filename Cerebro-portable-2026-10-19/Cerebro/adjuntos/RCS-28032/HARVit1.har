de.data, \"data\", data);\r\n                    this.diagram.model.setDataProperty(node.data, \"text\", data.displayName);\r\n                    this.diagram.commitTransaction(\"update data\");\r\n                }\r\n\r\n\r\n            }, this),\r\n            noCallback: $.proxy(function (data) {\r\n\r\n            }, this)\r\n        });\r\n    };\r\n\r\n\r\n    goCompose.prototype.clearSelection = function () {\r\n        this.diagram.startTransaction(\"no highlighteds\");\r\n        this.diagram.clearHighlighteds();\r\n        this.diagram.clearSelection();\r\n        this.diagram.commitTransaction(\"no highlighteds\");\r\n    },\r\n\r\n    goCompose.prototype.remove = function () {\r\n        var node = this.currentSelectedObj;\r\n\r\n        this.diagram.startTransaction(\"remove\");\r\n\r\n        var removeList = [],\r\n            nodesInto = [],\r\n            linksOut = [];\r\n\r\n        // get all the links that need to be changed.\r\n        var it = node.findNodesInto(); // get all the nodes going into this\r\n        while (it.next()) {\r\n            var child = it.value;\r\n            nodesInto.push(child.data);\r\n        }\r\n\r\n        it = node.findLinksInto(); // get all the links going into this\r\n        while (it.next()) {\r\n            var child = it.value;\r\n            removeList.push(child.data);\r\n        }\r\n\r\n        it = node.findLinksOutOf(); // get all the nodes going into this\r\n        while (it.next()) {\r\n            var child = it.value;\r\n            linksOut.push(child.data);\r\n        }\r\n\r\n        // remove all the links into the node.\r\n        for (var i = 0; i < removeList.length; i++) {\r\n            this.diagram.model.removeLinkData(removeList[i]);\r\n        }\r\n\r\n        var childrenCount = this.numberOfChildren(nodesInto[0].key);\r\n        if (linksOut.length > 0 || childrenCount == 0) {\r\n            // set the height of the canvas\r\n            var currentHeight = $(this.diagram.div).height();\r\n\r\n            this.diagram.div.style.height = (currentHeight - 105) + \"px\";\r\n            this.diagram.requestUpdate();\r\n        }\r\n\r\n        //remove the node.\r\n        this.diagram.model.removeNodeData(node.data);\r\n\r\n        //set the links\r\n        for (var i = 0; i < linksOut.length; i++) {\r\n            linksOut[i].from = nodesInto[0].key;\r\n        }\r\n\r\n        this.diagram.rebuildParts();\r\n        this.diagram.commitTransaction(\"remove\");\r\n    };\r\n\r\n    goCompose.prototype.add = function () {\r\n        this.showConfigurationLightbox(true);\r\n    };\r\n\r\n    goCompose.prototype.addAbove = function () {\r\n        this.showConfigurationLightbox(true, \"above\");\r\n    };\r\n\r\n    goCompose.prototype.edit = function () {\r\n        this.showConfigurationLightbox(false);\r\n    };\r\n\r\n    goCompose.prototype.showConnections = function showConnections(node) {\r\n        if (node == null || node == undefined) {\r\n            node = this.currentSelectedObj;\r\n        }\r\n\r\n        var diagram = node.diagram;\r\n        diagram.startTransaction(\"highlight\");\r\n\r\n        node.findLinksInto().each(function (l) { l.isHighlighted = true; });\r\n        // for each Node destination for the Node, set Node.isHighlighted\r\n        node.findNodesInto().each($.proxy(function (n) { n.isHighlighted = true; this.showConnections(n); }, this));\r\n        diagram.commitTransaction(\"highlight\");\r\n    };\r\n\r\n    goCompose.prototype.clickOff = function () {\r\n        this.clearSelection();\r\n\r\n        if (this.currentSelectedObj !== null) {\r\n            this.currentSelectedObj.isSelected = false;\r\n        }\r\n    };\r\n\r\n    goCompose.prototype.numberOfChildren = function (key) {\r\n        var numberOfChildrenCount = 0;\r\n        for (var i = 0; i < this.diagram.model.linkDataArray.length; i++) {\r\n            if (this.diagram.model.linkDataArray[i].from === key) {\r\n                numberOfChildrenCount = numberOfChildrenCount + 1;\r\n            }\r\n        }\r\n\r\n        return numberOfChildrenCount;\r\n    };\r\n\r\n    goCompose.prototype.nodeStyle = function () {\r\n        return {\r\n            locationSpot: go.Spot.Center\r\n        };\r\n    };\r\n\r\n    goCompose.prototype.getChildren = function (key) {\r\n        var children = [];\r\n\r\n        for (var i = 0; i < this.diagram.model.linkDataArray.length; i++) {\r\n            if (this.diagram.model.linkDataArray[i].from === key) {\r\n\r\n                var childKey = this.diagram.model.linkDataArray[i].to;\r\n\r\n                for (var k = 0; k < this.diagram.model.nodeDataArray.length; k++) {\r\n                    if (this.diagram.model.nodeDataArray[k].key === childKey) {\r\n                        children.push(this.diagram.model.nodeDataArray[k]);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n        return children;\r\n    };\r\n\r\n    goCompose.prototype.canPerform = function (action) {\r\n\r\n        // if there are not actions specified then it mean all actions are available.\r\n        if (this.options.actions == undefined || this.options.actions.length == 0) {\r\n            return true;\r\n        }\r\n\r\n        for (var i = 0, ii = this.options.actions.length; i < ii; i++) {\r\n            if (this.options.actions[i] == action) {\r\n                return true;\r\n            }\r\n        }\r\n\r\n        return false;\r\n    };\r\n\r\n    this.initialiseGo();\r\n}\r\n\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/inactivity.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n;\r\nvar INACTIVITYSAVE = function (logoffFunc) {\r\n    logoffFunc();\r\n};\r\nfunction inactivity() {\r\n    this.message = \"RESOURCE{{cpf.ui.js}:{LogOffPrompt}:{You have been inactive for too long.<br/><br/>Would you like to continue?}}\";\r\n    this.loggingOffMessage = \"RESOURCE{{cpf.ui.js}:{LoggingOffMessage}:{Logging off...}}\";\r\n    this.waitTime = LOGOFFPROMPTMINUTES * 60000;\r\n    this.promptWaitTime = 30000;\r\n\r\n    this.timeout = 0;\r\n    this.promptTimeout = 0;\r\n\r\n    this.self = 0;\r\n    this.$messageBox = $(\"#inactivity-message\");\r\n\r\n    // call publish inactivity so that the timers start.\r\n    cpf.store.publish(\"inactivity\", \"1\");\r\n\r\n    // setup listener - will restart the timer if another browser tab/window is active.\r\n    cpf.store.subscribe(\"inactivity\", $.proxy(function (channel, payload) {\r\n\r\n        if (payload === \"1\") {\r\n            this.step();\r\n\r\n            if (this.$messageBox.gcop().isVisible()) {\r\n                clearTimeout(this.promptTimeout);\r\n                ConfirmationBox.Hide(this.$messageBox);\r\n            }\r\n        } else if (payload === \"0\") {\r\n            this.logoff(true);\r\n        }\r\n\r\n    }, this));\r\n\r\n    this.step = function () {\r\n        clearTimeout(this.timeout);\r\n\r\n        this.self = this;\r\n        this.timeout = setTimeout($.proxy(this.checkActivity, this), this.waitTime);\r\n    };\r\n\r\n    this.promptToContinue = function () {\r\n\r\n        clearTimeout(this.promptTimeout);\r\n        this.promptTimeout = setTimeout($.proxy(function () { this.logoff(true); }, this), this.promptWaitTime);\r\n\r\n        ConfirmationBox.Show(this.$messageBox, $.proxy(function () {\r\n            // stop the prompt clock\r\n            clearTimeout(this.promptTimeout);\r\n\r\n            if ($.isAnonymous() == false) {\r\n                // touch the server to keep the cookie alive\r\n                var defaults = { url: APPLICATIONPATH + \"cpf/core/timerstep\", dataType: \"json\", type: \"POST\", success: function () { cpf.store.publish(\"inactivity\", \"1\"); }, traditional: false, handleLogon: true };\r\n                cpf.ajax(defaults);\r\n            }\r\n\r\n        }, this), this.message, $.proxy(function () { cpf.store.publish(\"inactivity\", \"0\"); /* this.logoff(false);*/ }, this, 'yes'));\r\n    };\r\n\r\n    this.checkActivity = function () {\r\n\r\n        var self = this;\r\n        clearTimeout(this.promptTimeout);\r\n\r\n        var success = function (result) {\r\n            if (result) {\r\n                self.promptToContinue();\r\n            } else {\r\n                //self.step();\r\n                cpf.store.publish(\"inactivity\", \"1\");\r\n            }\r\n        };\r\n\r\n        var error = function (e) {\r\n            console.log(\"Error checking inactivity. Error details: \" + e);\r\n        };\r\n\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/core/PromptBoxIsInactive\", success: success, errorCallback: error });\r\n    };\r\n\r\n    this.logoff = function (executeInactivitySave) {\r\n\r\n        //resolve destination url against anonymous QUITURL\r\n        var resolveDestinationUrl = function (destinationUrl) {\r\n            \r\n            if (QUITURL != \"\" && typeof QUITURL != \"undefined\" && QUITURL != null) {\r\n                if (QUITURL.indexOf(\"http\") > -1) {\r\n                    destinationUrl = QUITURL;\r\n                }\r\n                else {\r\n                    if (LOGOFFREDIRECTURL != \"\" && typeof LOGOFFREDIRECTURL != \"undefined\" && LOGOFFREDIRECTURL != null) {\r\n                        destinationUrl = LOGOFFREDIRECTURL;\r\n                    } else {\r\n                        destinationUrl = QUITURL.indexOf(\"/\") !== 0 ? APPLICATIONPATH + QUITURL : APPLICATIONPATH + QUITURL.substr(1);\r\n                        \r\n                    }\r\n                }\r\n            }\r\n            return destinationUrl;\r\n        };\r\n\r\n        //get promise for redirect\r\n        var getLogOffPromise = function () {\r\n            var createModeRegExp = new RegExp(\"\\\\\" + APPLICATIONPATH.slice(0, -1) + \"\\/app\\/[a-zA-Z0-9\\-_]+\\#\\/dv\\/create\\/system\\/indieapps\\/[a-zA-Z0-9\\-_]+\\/dynoview\\/[a-zA-Z0-9\\-_]+\");\r\n            if (createModeRegExp.test(location.pathname + location.hash) && dynoview !== null && dynoview !== undefined && angular.element(document.body).injector().has(\"indieService\")) {\r\n                //if user is in create mode return postDynoviewData with isDraft = true and isNew = true promise\r\n                var indieService = angular.element(document.body).injector().get(\"indieService\");\r\n\r\n                if (indieService.dynoviewType == \"dynoview\") {\r\n                    return indieService.postDynoViewData(JSON.stringify(dynoview.val()), dynoview.valAttachments(), true, true);\r\n                }\r\n                else if (indieService.dynoviewType == \"dynoviewplus\") {\r\n                    var dynoService = angular.element(document.body).injector().get(\"dynoService\");\r\n                    return indieService.postDynoViewData(JSON.stringify(dynoService.val('indie')), dynoService.getAttachmentsList('indie'), true, true);\r\n                }\r\n            } else {\r\n                //if user is not in create mode return empty promise\r\n                var deferred = angular.element(document.body).injector().get(\"$q\").defer();\r\n                deferred.resolve();\r\n                return deferred.promise;\r\n            }\r\n        };\r\n\r\n        // if executeInactivitySave is true, we can assume they have not responded, so we will call INACTIVITYSAVE, otherwise the user licked 'No' so we can just logoff\r\n        var logoff = $.proxy(function () {\r\n            cpf.alert(this.loggingOffMessage, \"w\");\r\n\r\n            var promise = getLogOffPromise();\r\n            promise.then(function (response) {\r\n                //var draftUpdateRegExp = new RegExp(\"app\\/[a-zA-Z0-9\\-_]+\\#\\/dv\\/[0-9]+\\/update\\?vfp=\");\r\n                var destinationUrl = APPLICATIONPATH + \"cpf/auth/logoff?url=\" + APPLICATIONPATH + location.href.replace(FULLAPPLICATIONPATH, '');\r\n\r\n                //change the destinationUrl if user was in create mode and record was saved as draft\r\n                if (response !== undefined && response !== null && response.data.success && response.data.redirect !== undefined && response.data.redirect !== \"\") {\r\n                    destinationUrl = APPLICATIONPATH + \"cpf/auth/logoff?url=\" + location.origin + APPLICATIONPATH + response.data.redirect;\r\n                }\r\n\r\n                window.onbeforeunload = null;\r\n\r\n                location.href = resolveDestinationUrl(destinationUrl);\r\n                // tell the other windows/tabs to logoff.\r\n                return false;\r\n            });\r\n        }, this);\r\n\r\n        try {\r\n            if (executeInactivitySave) {\r\n                // this global function should be overridden by the page to handle final saves before a log off\r\n                INACTIVITYSAVE(logoff, this);\r\n            }\r\n            else {\r\n                logoff();\r\n            }\r\n        }\r\n        catch (err) {\r\n            // there was an error in the inactivity call back. Log them off\r\n            logoff();\r\n        }\r\n    };\r\n\r\n\r\n}\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/lightbox.js\n * ======================================== */\n\n﻿var lightbox = {\r\n\r\n    /*\r\n    callback:   function to call when the lightbox is closed. Will pass back the html contained within the lightbox\r\n    loadedCallback: function to call when the lightbox content has been created/loaded - correct UI before user interaction starts\r\n    url:        the url from where the lightbox will get its display html\r\n    height:      sets the height of the lightbox to a fixed value\r\n    width:      sets the width of the lightbox to a fixed value\r\n    */\r\n\r\n    // TODO : could this be used to show simple messages too?? could have a message property??? but would have to deal with error icons etc...\r\n    $noButton: null,\r\n    $yesButton: null,\r\n    $cancelButton: null,\r\n    $lightbox: null,\r\n    settings: null,\r\n    clickX: null,\r\n    clickY: null,\r\n\r\n    load: function (options) {\r\n        // extend the default settings with the options passed in.\r\n        $.extend(lightbox.defaults, options);\r\n\r\n        var defaults = {\r\n            url: \"\",\r\n            data: null,\r\n            html: null,\r\n            title: \"Lightbox\",\r\n            width: -1,\r\n            height: -1,\r\n            yesButtonText: \"Yes\",\r\n            showYesButton: true,\r\n            yesCallback: null,\r\n            noButtonText: \"No\",\r\n            showNoButton: true,\r\n            noCallback: null,\r\n            cancelButtonText: \"Cancel\",\r\n            showCancelButton: false,\r\n            cancelCallback: null,\r\n            yesButtonClass: null,\r\n            noButtonClass: null,\r\n            cancelButtonClass: null,\r\n            showTitle: true,\r\n            showFooter: true,\r\n            showClose:true\r\n        };\r\n\r\n        lightbox.settings = $.extend({}, defaults, options);\r\n        // validate required markup\r\n        lightbox.preInitialiseCheck();\r\n        // set up all references to dom elements.\r\n        lightbox.setReferences();\r\n\r\n        // initialise the lightbox, set the button text etc.\r\n        lightbox.initialise();\r\n    },\r\n\r\n    /**\r\n    * If cpf-lightbox is used in non-standard layout\r\n    * the markup could be missing lightbox markup (e.g. in FTI details view)\r\n    * If not found, inject the markup into document body\r\n    */\r\n    preInitialiseCheck: function () {\r\n        var el = $(\"#cpf-lightbox\").first().get(0);\r\n        if (!el) {\r\n            var tpl = \"<div class=\\\"lightbox-container\\\" id=\\\"cpf-lightbox\\\">\\n    <div class=\\\"lightbox\\\">\\n        <button class=\\\"cpf-lightbox-close fa fa-remove\\\"></button>\\n        <div id=\\\"cpf-lightbox-title\\\" class=\\\"lightbox-title\\\"></div>\\n        <div id=\\\"cpf-lightbox-content\\\" class=\\\"lightbox-content\\\"></div>\\n        <div id=\\\"cpf-lightbox-buttons\\\" class=\\\"lightbox-buttons\\\">\\n            <button id=\\\"lightbox-cancel-button\\\" class=\\\"btn btn-link\\\">Cancel</button>\\n            <button id=\\\"lightbox-no-button\\\" class=\\\"btn\\\">No</button>\\n            <button id=\\\"lightbox-yes-button\\\" class=\\\"btn\\\">Yes</button>\\n        </div>\\n    </div>\\n</div>\";\r\n            $(tpl).appendTo(document.body);\r\n        }\r\n    },\r\n\r\n    setReferences: function () {\r\n        lightbox.$noButton = $(\"#lightbox-no-button\");\r\n        lightbox.$yesButton = $(\"#lightbox-yes-button\");\r\n        lightbox.$cancelButton = $(\"#lightbox-cancel-button\");\r\n        lightbox.$lightbox = $(\"#cpf-lightbox\");\r\n        lightbox.$closeButton = $(\".cpf-lightbox-close\");\r\n        lightbox.$footer = $(\"#cpf-lightbox-buttons\");\r\n        lightbox.$title = lightbox.$lightbox.find(\"#cpf-lightbox-title\");\r\n    },\r\n\r\n    initialise: function () {\r\n\r\n        lightbox.$title.text(lightbox.settings.title);\r\n        lightbox.$yesButton.text(lightbox.settings.yesButtonText);\r\n        lightbox.$noButton.text(lightbox.settings.noButtonText);\r\n        lightbox.$cancelButton.text(lightbox.settings.cancelButtonText);\r\n\r\n        lightbox.settings.showYesButton ? lightbox.$yesButton.show() : lightbox.$yesButton.hide();\r\n        lightbox.settings.showNoButton ? lightbox.$noButton.show() : lightbox.$noButton.hide();\r\n        lightbox.settings.showCancelButton ? lightbox.$cancelButton.show() : lightbox.$cancelButton.hide();\r\n        lightbox.settings.showFooter ? lightbox.$footer.show() : lightbox.$footer.hide();\r\n        lightbox.settings.showTitle ? lightbox.$title.text(lightbox.settings.title) : lightbox.$title.text(\"\");\r\n        lightbox.settings.showClose ? lightbox.$closeButton.show() : lightbox.$closeButton.hide();\r\n\r\n        if (lightbox.settings.yesButtonClass) {\r\n            lightbox.$yesButton.removeClass();\r\n            lightbox.$yesButton.addClass(lightbox.settings.yesButtonClass);\r\n            lightbox.$yesButton.removeAttr(\"disabled\");\r\n        }\r\n\r\n        if (lightbox.settings.noButtonClass) {\r\n            lightbox.$noButton.removeClass();\r\n            lightbox.$noButton.addClass(lightbox.settings.noButtonClass);\r\n            lightbox.$noButton.removeAttr(\"disabled\");\r\n        }\r\n\r\n        if (lightbox.settings.cancelButtonClass) {\r\n            lightbox.$cancelButton.removeClass();\r\n            lightbox.$cancelButton.addClass(lightbox.settings.cancelButtonClass);\r\n        }\r\n\r\n        lightbox.$yesButton.off(\"click\").on(\"click\", function () {\r\n            if ($(this).hasClass(\"disabled\")) return;\r\n            if (lightbox.settings.yesCallback) {\r\n                // does the content have a script function to call to get values?\r\n                var content = lightbox.$lightbox.find(\".content-container\");\r\n                var valueScript = null;\r\n                if (content.length > 0) {\r\n                    valueScript = content.attr(\"data-value-script\");\r\n                }\r\n\r\n                if (valueScript !== null && valueScript !== \"\") {\r\n\r\n                    var returnValue = lightbox.getFunctionFromString(valueScript)();\r\n                    if (isNullOrEmpty(returnValue)) {\r\n                        return;\r\n                    }\r\n\r\n                    lightbox.settings.yesCallback(returnValue);\r\n\r\n                } else {\r\n                    lightbox.settings.yesCallback();\r\n                }\r\n            }\r\n\r\n            lightbox.show(false);\r\n        });\r\n\r\n        lightbox.$noButton.off(\"click\").on(\"click\", function () {\r\n            if ($(this).hasClass(\"disabled\")) return;\r\n            if (lightbox.settings.noCallback) {\r\n                lightbox.settings.noCallback();\r\n            }\r\n\r\n            lightbox.show(false);\r\n        });\r\n\r\n        var cancel = function() {\r\n            lightbox.show(false);\r\n            if (lightbox.settings.cancelCallback) {\r\n                lightbox.settings.cancelCallback();\r\n            }\r\n        };\r\n        lightbox.$cancelButton.off(\"click\").on(\"click\", cancel);\r\n        lightbox.$closeButton.off(\"click\").on(\"click\", cancel);\r\n        cpf.overlay.show(\"cpf-lightbox\");\r\n        lightbox.loadView();\r\n\r\n    },\r\n\r\n    loadView: function () {\r\n\r\n        var success = function (html, loadedCallback) {\r\n\r\n            $(\"#cpf-lightbox-content\").html(html);\r\n\r\n            // call the load script\r\n\r\n            var loadScript = $(\"#cpf-lightbox-content\").find(\".content-container\").attr(\"data-load-script\");\r\n            if (loadScript != null && loadScript !== \"\") {\r\n                var fn = lightbox.getFunctionFromString(loadScript);\r\n                if (fn !== undefined) {\r\n                    fn();\r\n                }\r\n            }\r\n\r\n            lightbox.show(true);\r\n\r\n            if (loadedCallback) {\r\n                loadedCallback();\r\n            }\r\n        };\r\n\r\n\r\n        if (lightbox.settings.html !== null) {\r\n            // we have some existing html to show.\r\n            success(lightbox.settings.html, lightbox.settings.loadedCallback);\r\n\r\n        } else {\r\n            // we dont have the html already. Go and get it!\r\n            cpf.ajax({\r\n                url: lightbox.settings.url,\r\n                dataType: \"html\",\r\n                type: \"POST\",\r\n                data: isNullOrEmpty(lightbox.settings.data) ? null : JSON.stringify(lightbox.settings.data),\r\n                success: function (result) {\r\n                    success(result, lightbox.settings.loadedCallback);\r\n                },\r\n                errorCallback: function () {\r\n                    cpf.overlay.hide(\"cpf-lightbox\");\r\n                }\r\n            });\r\n        }\r\n    },\r\n\r\n    show: function (show) {\r\n        if (lightbox.$lightbox) {\r\n            if (show) {\r\n                lightbox.positionAndShow(lightbox.$lightbox);\r\n            } else {\r\n                lightbox.$lightbox.hide();\r\n                cpf.overlay.hide(\"cpf-lightbox\");\r\n                $('body').gcop().removeClass('noscroll');\r\n            }\r\n        }\r\n    },\r\n\r\n    getFunctionFromString: function (string) {\r\n        var scope = window;\r\n        var scopeSplit = string.split('.');\r\n        for (var i = 0; i < scopeSplit.length - 1; i++) {\r\n            scope = scope[scopeSplit[i]];\r\n            if (scope == undefined) return false;\r\n        }\r\n\r\n        return scope[scopeSplit[scopeSplit.length - 1]];\r\n    },\r\n\r\n    showOverlay: function (show) {\r\n        show ? $(\".black-overlay\").show() : $(\".black-overlay\").hide();\r\n    },\r\n\r\n    positionAndShow: function ($box) {\r\n\r\n        var iframe = !!$box.find(\"iframe\").length;\r\n        if ($box.hasClass(\"lightbox\")) {\r\n            $box.toggleClass(\"lightbox-responsive\", iframe);\r\n        } else {\r\n            $box.find(\".lightbox\").toggleClass(\"lightbox-responsive\", iframe);\r\n        }\r\n        \r\n        // centre the msgbox, skip is dyno lightbox\r\n        if (lightbox.$lightbox && !$box.gcop().hasAttribute(\"data-dyno-type\")) {\r\n            if (lightbox.settings.height !== -1) {\r\n                lightbox.$lightbox.find('.lightbox').height(lightbox.settings.height);\r\n            }\r\n            if (lightbox.settings.width !== -1) {\r\n                lightbox.$lightbox.find('.lightbox').width(lightbox.settings.width);\r\n            }\r\n            lightbox.$lightbox.show();\r\n        }\r\n\r\n        if ($box && !iframe && $box.find(\".dyno-lightbox-content\").length === 0) {\r\n            var pTop = +(Math.round((window.innerHeight - $box[0].children[0].offsetHeight) / 2 / window.innerHeight + \"e+2\") + \"e-2\");\r\n            //$box.css({ 'padding-top': Math.ceil(window.innerHeight * (pTop > 0.325 ? 0.325 : pTop)) + 'px' });\r\n            $box.css('display', 'flex');\r\n        }\r\n\r\n        $('body').gcop().addClass('noscroll');\r\n    },\r\n\r\n    showAtClickPosition: function ($box) {\r\n\r\n        var windowHeight = $(window).height();\r\n        var windowWidth = $(window).width();\r\n        var boxHeight = $box.height();\r\n        var boxWidth = $box.width();\r\n        $box.attr('style', '');\r\n        $box.css({ 'left': windowWidth - 10, 'display': 'inline-block' });\r\n\r\n        //force the box to keep it's width\r\n        $box.css({ 'width': boxWidth });\r\n\r\n        var rightExtent = boxWidth + lightbox.clickX;\r\n        var bottomExtent = boxHeight + lightbox.clickY;\r\n\r\n\r\n\r\n        //make sure none of the lightbox is offscreen.\r\n        if (rightExtent > windowWidth) {\r\n            lightbox.clickX = lightbox.clickX - boxWidth;\r\n        }\r\n\r\n        if (bottomExtent > windowHeight) {\r\n            lightbox.clickY = lightbox.clickY - boxHeight;\r\n        }\r\n\r\n        if (lightbox.clickY < 0) {\r\n            lightbox.clickY = 0;\r\n        }\r\n\r\n        if (lightbox.clickX < 0) {\r\n            lightbox.clickX = 0;\r\n        }\r\n\r\n\r\n        $box.css({ 'left': lightbox.clickX + 'px', 'top': lightbox.clickY + 'px' });\r\n\r\n        lightbox.clickX = null;\r\n        lightbox.clickY = null;\r\n    }\r\n};\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/locationgroups.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\n;\r\nvar locationGroups = {\r\n    redirect: function (url, isCodedRedirect) {\r\n        if (isCodedRedirect) {\r\n            if ($.trim(url).length > 0 && url != null && typeof (url) != undefined) {\r\n                window.location = url;\r\n            }\r\n        } else {\r\n\r\n            // if they checked a box and clicked edit\r\n            var editButtonClicked = false;\r\n            var $editButton = $(\"#location-group-button-edit\");\r\n            if ($editButton.length > 0) {\r\n                if ($editButton.gcop().hasClass(\"selected\")) {\r\n                    editButtonClicked = true;\r\n                }\r\n            }\r\n\r\n            var $checkedDataElement = $($(\"#page .search-results .zugo-item .item-selection-column input:checked\").parent().parent());\r\n            var drill = url;\r\n\r\n            var payload = {};\r\n            payload.ActionType = \"DrillDown\";\r\n            payload.searchVirtualFilePath = \"/system/cpf/search/locationgroups.search\";\r\n            payload.definitionName = null;\r\n            payload.data = $checkedDataElement.gcop().getAttribute(\"data-row\");\r\n\r\n            // if there is a preview, then show it. If not, just drill.\r\n            $checkedDataElement.gcop().addClass(\"selected\");\r\n\r\n            // redirect to drill down url if container or search builder definition is not set. \r\n            // looks like in changeset 12747 on 2016-10-14 a guid was added to the search id to support multiples on a page. Therefore we need to find the id as we cannot index to it\r\n            for (var prop in SEARCHES) {\r\n                if (prop.indexOf(\"systemcpfsearchlocationgroupssearch\") > -1) {\r\n                    SEARCHES[prop].getNavigationTrack(drill, payload);\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n    }\r\n};\r\n\r\nlocationGroups.list = {\r\n    load: function () {\r\n        // disable ribbon buttons that cannot be used.\r\n        locationGroups.list.enableRibbonButtons({ selectedRows: [] });\r\n\r\n\r\n        $(document.body).on(\"selected\", \".search-results\", function (event, eventArgs) {\r\n            locationGroups.list.enableRibbonButtons(eventArgs);\r\n        });\r\n\r\n        $(\"#location-group-button-edit\").on(\"click\", function () {\r\n            if (!$(this).hasClass(\"disabled\")) {\r\n                cpf.spin();\r\n                var url = $(\".search-results .results-container .item-selection-column input[type=checkbox]:checked\").parents(\".zugo-item:first\").attr(\"drillDownUrl\");\r\n                locationGroups.redirect(url);\r\n            }\r\n            return false;\r\n        });\r\n\r\n        $(\"#location-group-button-delete\").on(\"click\", function () {\r\n            if (!$(this).hasClass(\"disabled\")) {\r\n                if (locationGroups.list.getCheckedItemsCount() > 0) {\r\n                    ConfirmationBox.Show($(\"#delete-location-group-confirmation\"), locationGroups.list.deleteLocationGroup);\r\n                }\r\n                else {\r\n                    cpf.alert(\"RESOURCE{{locationgroups.js}:{SelectRowToDelete}:{Please select a row to delete a location group.}}\", \"i\");\r\n                }\r\n            }\r\n            return false;\r\n        });\r\n\r\n    },\r\n    enableRibbonButtons: function (eventArgs) {\r\n        var selected = eventArgs.selectedRows.length;\r\n        if (selected > 0 && selected < 2) {\r\n            $(\"#location-group-button-delete\").removeClass(\"disabled\");\r\n            $(\"#location-group-button-edit\").removeClass(\"disabled\");\r\n        }\r\n        else if (selected > 1) {\r\n            $(\"#location-group-button-delete\").removeClass(\"disabled\");\r\n            $(\"#location-group-button-edit\").addClass(\"disabled\");\r\n        } else {\r\n            $(\"#location-group-button-edit\").addClass(\"disabled\");\r\n            $(\"#location-group-button-delete\").addClass(\"disabled\");\r\n        }\r\n    },\r\n    getCheckedItemsCount: function () {\r\n        return $(\".search-results .results-container .item-selection-column input[type=checkbox]:checked\").length;\r\n    },\r\n    deleteLocationGroup: function () {\r\n        var success = function () {\r\n            //cpf.alert(\"RESOURCE{{locationgroups.js}:{LocationGroupDeleted}:{LocationGroup deleted successfully.}}\", \"s\");\r\n            //locationGroups.redirect(APPLICATIONPATH + \"cpf/locationgroup\");\r\n        };\r\n\r\n        var fail = function (data, textStatus, jqXHR) {\r\n            if (data[\"unhandled\"]) {\r\n                cpf.alert(\"RESOURCE{{locationgroups.js}:{FailedToDeleteLocationGroup}:{Failed to delete the location group.}}\", \"e\");\r\n            }\r\n        };\r\n        var groupIds = locationGroups.list.getLocationGroupIds();\r\n        // get the checked items and send them to the server.\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/locationgroup/remove\", success: success, errorCallback: fail, data: { \"locationGroupIds\": groupIds } });\r\n    },\r\n    getLocationGroupIds: function () {\r\n        var groupIds = [];\r\n        var checkedItemCount = locationGroups.list.getCheckedItemsCount();\r\n        for (i = 0; i < checkedItemCount; i++) {\r\n            var jsonString = $(\".search-results .results-container .item-selection-column input[type=checkbox]:checked:eq(\" + i + \")\").parents(\".zugo-item:first\").attr(\"data-row\");\r\n            var selectedItem = JSON.parse(jsonString);\r\n            for (j = 0; j < selectedItem.length; j++) {\r\n                if (selectedItem[j][\"name\"] == \"GroupID\") {\r\n                    groupIds.push(selectedItem[j][\"value\"]);\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n\r\n        return groupIds.join(\",\");\r\n    }\r\n};\r\n\r\nlocationGroups.edit = {\r\n    load: function () {\r\n        locationGroups.edit.initialiseMenu();\r\n        $(\"#location-group-button-save\").on(\"click\", function () {\r\n            $(\"#group-details\").validate({\r\n                success: function () {\r\n                    locationGroups.edit.save();\r\n                }\r\n            });\r\n            return false;\r\n        });\r\n\r\n        if ($(\"#location-group-name\").val() !== \"\") {\r\n            cpf.title.set(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{LocationGroup_Title}:{Location Group}}\" + \" > \" + $(\"#location-group-name\").val());\r\n        }\r\n        else {\r\n            cpf.title.set(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{LocationGroup_Title}:{Location Group}}\");\r\n        }\r\n    },\r\n    setMenuItemSelected: function ($item) {\r\n        $(\"#location-group-menu li a.selected\").removeClass(\"selected\");\r\n        $item.addClass(\"selected\");\r\n    },\r\n    initialiseMenu: function () {\r\n        $(\"#locationgroup-details-button\").on(\"click\", function () {\r\n            var isValid = $(\"#group-details\").validate();\r\n            if (isValid) {\r\n                locationGroups.edit.setMenuItemSelected($(\"#locationgroup-details-button\"));\r\n                $(\"#users-wrapper\").hide();\r\n                $(\"#unregistered-users-wrapper\").hide();\r\n                $(\"#location-groups-wrapper\").hide();\r\n                $(\"#locations-wrapper\").hide();\r\n                $(\"#group-details\").show();\r\n                autocompleteGrid.toggleSortButtons(false);\r\n            }\r\n            return false;\r\n        });\r\n\r\n        $(\"#locationgroup-users-button\").on(\"click\", function () {\r\n            var isValid = $(\"#group-details\").validate();\r\n            if (isValid) {\r\n                autocompleteGrid.updateInputLabel($(\"#users-grid\"), $(\"#location-group-name\"));\r\n                locationGroups.edit.setMenuItemSelected($(\"#locationgroup-users-button\"));\r\n                $(\"#group-details\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#unregistered-users-grid\"));\r\n                $(\"#unregistered-users-wrapper\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#locationgroup-groups\"));\r\n                $(\"#location-groups-wrapper\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#locationgroup-locations\"));\r\n                $(\"#locations-wrapper\").hide();\r\n\r\n                autocompleteGrid.showWindow($(\"#users-grid\"));\r\n                $(\"#users-wrapper\").show();\r\n                autocompleteGrid.toggleZugoFeatures($(\"#users-grid\"));\r\n\r\n                locationGroups.edit.updateGroupDetails();\r\n            }\r\n\r\n            return false;\r\n        });\r\n\r\n        $(\"#locationgroup-unregisteredusers-button\").on(\"click\", function () {\r\n            var isValid = $(\"#group-details\").validate();\r\n            if (isValid) {\r\n                autocompleteGrid.updateInputLabel($(\"#unregistered-users-grid\"), $(\"#location-group-name\"));\r\n                locationGroups.edit.setMenuItemSelected($(\"#locationgroup-unregisteredusers-button\"));\r\n                $(\"#group-details\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#users-grid\"));\r\n                $(\"#users-wrapper\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#locationgroup-groups\"));\r\n                $(\"#location-groups-wrapper\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#locationgroup-locations\"));\r\n                $(\"#locations-wrapper\").hide();\r\n                \r\n                autocompleteGrid.showWindow($(\"#unregistered-users-grid\"));\r\n                $(\"#unregistered-users-wrapper\").show();\r\n                autocompleteGrid.toggleZugoFeatures($(\"#unregistered-users-grid\"));\r\n                locationGroups.edit.updateGroupDetails();\r\n            }\r\n\r\n            return false;\r\n        });\r\n\r\n        $(\"#locationgroup-groups-button\").on(\"click\", function () {\r\n            var isValid = $(\"#group-details\").validate();\r\n            if (isValid) {\r\n                autocompleteGrid.updateInputLabel($(\"#locationgroup-groups\"), $(\"#location-group-name\"));\r\n                locationGroups.edit.setMenuItemSelected($(\"#locationgroup-groups-button\"));\r\n                $(\"#group-details\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#unregistered-users-grid\"));\r\n                $(\"#unregistered-users-wrapper\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#locationgroup-locations\"));\r\n                $(\"#locations-wrapper\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#users-grid\"));\r\n                $(\"#users-wrapper\").hide();\r\n\r\n                autocompleteGrid.showWindow($(\"#locationgroup-groups\"));\r\n                $(\"#location-groups-wrapper\").show();\r\n                autocompleteGrid.toggleZugoFeatures($(\"#locationgroup-groups\"));\r\n                locationGroups.edit.updateGroupDetails();\r\n            }\r\n\r\n            return false;\r\n        });\r\n\r\n        $(\"#locationgroup-locations-button\").on(\"click\", function () {\r\n            var isValid = $(\"#group-details\").validate();\r\n            if (isValid) {\r\n                autocompleteGrid.updateInputLabel($(\"#locationgroup-locations\"), $(\"#location-group-name\"));\r\n                locationGroups.edit.setMenuItemSelected($(\"#locationgroup-locations-button\"));\r\n                $(\"#group-details\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#users-grid\"));\r\n                $(\"#users-wrapper\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#locationgroup-groups\"));\r\n                $(\"#location-groups-wrapper\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#unregistered-users-grid\"));\r\n                $(\"#unregistered-users-wrapper\").hide();\r\n\r\n                autocompleteGrid.showWindow($(\"#locationgroup-locations\"));\r\n                $(\"#locations-wrapper\").show();\r\n                autocompleteGrid.toggleZugoFeatures($(\"#locationgroup-locations\"));\r\n                locationGroups.edit.updateGroupDetails();\r\n            }\r\n\r\n            return false;\r\n        });\r\n    },\r\n    getLocationGroupData: function () {\r\n\r\n        var users = [];\r\n        var unregisteredUsers = [];\r\n        var groups = [];\r\n        var locations = [];\r\n\r\n        users = autocompleteGrid.getAutoChanges($(\"#users-grid\"));\r\n        unregisteredUsers = autocompleteGrid.getAutoChanges($(\"#unregistered-users-grid\"));\r\n        groups = autocompleteGrid.getAutoChanges($(\"#locationgroup-groups\"));\r\n        locations = autocompleteGrid.getAutoChanges($(\"#locationgroup-locations\"));\r\n\r\n        var data = {\r\n            id: $(\"#location-group-id\").val(),\r\n            name: $(\"#location-group-name\").val(),\r\n            description: $(\"#location-group-description\").val(),\r\n            users: users,\r\n            unregisteredusers: unregisteredUsers,\r\n            groups: groups,\r\n            locations: locations\r\n        };\r\n\r\n        return data;\r\n    },\r\n    save: function () {\r\n        if ($(this).hasClass(\"disabled\")) {\r\n            return false;\r\n        }\r\n        $cpf.alert(\"RESOURCE{{Sysrepublic.Secure.UI.Areas.Cpf.CpfResources}:{Saving}:{Saving...}}\", \"p\");\r\n        $(\"#location-group-button-save\").addClass(\"disabled\");\r\n        var locationGroupData = locationGroups.edit.getLocationGroupData();\r\n\r\n        function checkGroupNameSuccess(result, textStatus, jqXHR) {\r\n            if (result.data !== true) {\r\n                // location group name does not exist, so create the group\r\n                cpf.ajax({ url: APPLICATIONPATH + \"cpf/locationgroup/save\", dataType: \"json\", type: \"POST\", success: locationGroups.edit.saveSuccess, errorCallback: locationGroups.edit.saveFailed, data: locationGroupData });\r\n            } else {\r\n                // location group exists, so show error message\r\n                cpf.alert(\"RESOURCE{{locationgroups.js}:{ErrorLocationGroupExists}:{A location group with the same name already exists. Please try again with a different name. }}\", \"e\");\r\n            }\r\n\r\n            $(\"#location-group-button-save\").removeClass(\"disabled\");\r\n        }\r\n\r\n        var querystring = window.location.search;\r\n\r\n        var isEdit = querystring.indexOf('?locationGroupName=') === 0;\r\n        var hasChangedName = false;\r\n        if (isEdit) {\r\n            var groupName = querystring.substring(19);\r\n            if (groupName !== '') {\r\n                groupName = decodeURIComponent(groupName.replace(/\\+/g, \" \"));\r\n                hasChangedName = locationGroupData.name !== groupName;\r\n            }\r\n        }\r\n\r\n        if (!isEdit || hasChangedName) {\r\n            // new group\r\n            cpf.ajax({ url: APPLICATIONPATH + \"cpf/locationgroup/checkgroupexists\", dataType: \"json\", type: \"POST\", success: checkGroupNameSuccess, errorCallback: locationGroups.edit.saveFailed, data: { groupName: locationGroupData.name } });\r\n        } else {\r\n            // existing group\r\n            cpf.ajax({ url: APPLICATIONPATH + \"cpf/locationgroup/save\", dataType: \"json\", type: \"POST\", success: locationGroups.edit.saveSuccess, errorCallback: locationGroups.edit.saveFailed, data: locationGroupData });\r\n        }\r\n    },\r\n    saveSuccess: function (result, textStatus, jqXHR) {\r\n        $(\"#location-group-button-save\").removeClass(\"disabled\");\r\n        cpf.spin(false);\r\n\r\n        $(\"#location-group-id\").val(result[\"data\"].locationGroupId);\r\n\r\n        // fire an event to say we saved ok, in case we are waiting to navigate away\r\n        $(\"body\").trigger(\"saved\");\r\n    },\r\n    saveFailed: function (result, textStatus, jqXHR) {\r\n        cpf.spin(false);\r\n        if (result[\"unhandled\"]) {\r\n            cpf.alert(\"RESOURCE{{locationgroups.js}:{SaveLocationGroupFailed}:{There has been an error in the save location group request.}}\", \"e\");\r\n        }\r\n        $(\"#location-group-button-save\").removeClass(\"disabled\");\r\n    },\r\n    updateGroupDetails: function () {\r\n        $(\"#location-group-name-text\").html(DOMPurify.sanitize($(\"#location-group-name\").val()));\r\n        $(\"#location-group-description-text\").html(DOMPurify.sanitize($(\"#location-group-description\").val(), {SAFE_FOR_JQUERY: true}));\r\n    }\r\n};\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/multi-select-panel.js\n * ======================================== */\n\n﻿\r\nvar multiselectpanel = {\r\n    bindEvents: function ($control) {\r\n        $(\"a.close-panel\", $control).off(\"click\").on(\"click\", function (event) {\r\n\r\n            // Reset options display clear input box and re-populate the control\r\n            $(this).closest(\".panel-search-control\").find(\".cpftxt\").val(\"\");\r\n            multiselectpanel.filterOptionResults($control);\r\n\r\n            // enable watermark\r\n            var watermark = $(this).closest(\".panel-search-control\").find(\".cpftxt\").attr(\"defaultText\");\r\n            $(this).closest(\".panel-search-control\").find(\".cpftxt\").val(watermark);\r\n            $(this).closest(\".panel-search-control\").find(\".cpftxt\").addClass('inputblank');\r\n\r\n            event.stopPropagation();\r\n            var $panelHeading = $(this).closest(\".panel-heading\");\r\n            $panelHeading.hide();\r\n            var $panelContent = $panelHeading.parent().find(\".panel-content\");\r\n            $panelContent.hide();\r\n            multiselectpanel.setPreviewText($control);\r\n\r\n            return false;\r\n        });\r\n\r\n        $(\".panel-search-control\", $control).off(\"keyup\").on(\"keyup\", function (e) {\r\n            // trigger filter event after timeout expires added fo IE7\r\n\r\n            setTimeout(function () { multiselectpanel.filterOptionResults($control) }, 100);\r\n\r\n        });\r\n\r\n        $(\".panel-search-control\", $control).find(\"input\").on(\"blur\", function (e) {\r\n            var watermark = $(this).attr(\"defaultText\");\r\n            if ($(this).val() == '') {\r\n                $(this)\r\n                    .addClass('inputblank')\r\n                    .val(watermark);\r\n            }\r\n        });\r\n\r\n        $(\".panel-search-control\", $control).find(\"input\").on(\"focus\", function (e) {\r\n            var watermark = $(this).attr(\"defaultText\");\r\n            if ($(this).val() == watermark) {\r\n                $(this)\r\n                    .removeClass('inputblank')\r\n                    .val('');\r\n            }\r\n        });\r\n\r\n        $(\"a.selection-edit\", $control).on(\"click\", function () {\r\n\r\n            var $panel = $(\"div.panel-heading\", $control);\r\n\r\n            var $td = $(this).parents(\"td\");\r\n            var $tr = $(this).parents(\"tr\");\r\n            var offset = $tr.offset();\r\n            offset.top = offset.top + 1;\r\n            offset.left = -5; //(offset.left - $panel.show().outerWidth()) + $tr.outerWidth() + 1;\r\n\r\n            $panel.show();\r\n            $(\".panel-content\", $control).show();\r\n\r\n            $panel.offset(offset);\r\n            var $inner = $(\"div.panel-heading-inner\", $panel);\r\n            $inner.css(\"width\", $td.width() - 40);\r\n\r\n            var off = $td.offset();\r\n            off.top = off.top + 10;\r\n            off.left = off.left + 34;\r\n            $inner.offset(off);\r\n\r\n\r\n\r\n            // update options class height such for consistency\r\n            var optionHeight = 0;\r\n            var newHeight = 0;\r\n            var optionFlag = $panel.find(\".panel-content\").gcop().getAttribute(\"option-update-flag\");\r\n\r\n            var options = $panel.find(\".option\");\r\n            var optionCount = options.length;\r\n\r\n            if (optionFlag == \"true\") {\r\n\r\n                for (var i = 0; i < optionCount; i++) {\r\n                    newHeight = $(options[i]).height();\r\n                    if (newHeight > optionHeight) {\r\n                        optionHeight = newHeight\r\n                    }\r\n                }\r\n\r\n                $panel.find(\".option\").height(optionHeight);\r\n                $panel.find(\".panel-content\").gcop().setAttribute(\"option-update-flag\", \"false\");\r\n            }\r\n\r\n            return false;\r\n        });\r\n    },\r\n    filterOptionResults: function ($control) {\r\n        var value = $control.find(\".cpftxt\").val();\r\n        var displayOptions = $control.find(\".option\");\r\n\r\n        for (var j = 0, lj = displayOptions.length; j < lj; j++) {\r\n\r\n            var option = $(displayOptions[j]).find(\"input\").gcop().getAttribute(\"displayText\");\r\n            if (option.toLowerCase().indexOf(value.toLowerCase()) != -1) {\r\n                $(displayOptions[j]).gcop().show();\r\n            }\r\n            else {\r\n                $(displayOptions[j]).gcop().hide();\r\n            }\r\n        }\r\n        return false;\r\n    },\r\n    getSelectedValues: function ($control) {\r\n        var displayOptions = $control.find(\".option label input:checked\");\r\n        var selectedOptions = [];\r\n        for (var j = 0, lj = displayOptions.length; j < lj; j++) {\r\n            var selectedOption = $.trim($(displayOptions[j]).gcop().getAttribute(\"displayText\"));\r\n            selectedOptions.push(selectedOption);\r\n        }\r\n\r\n        return selectedOptions;\r\n    },\r\n    setPreviewText: function ($control) {\r\n        // create the preview text\r\n        var displayOptions = $control.find(\".option label input:checked\");\r\n        var selectedOptions = [];\r\n        for (var j = 0, lj = displayOptions.length; j < lj; j++) {\r\n            var selectedOption = $.trim($(displayOptions[j]).gcop().getAttribute(\"displayText\"));\r\n            selectedOptions.push(selectedOption);\r\n        }\r\n\r\n        var displayText = $control.find(\"a.selection-edit\").gcop().getAttribute(\"defaultText\");\r\n        if (selectedOptions.length > 0) {\r\n            displayText = selectedOptions.join(\", \");\r\n            if (displayText.length > 45) {\r\n                displayText = displayText.substr(0, 45) + \"...\";\r\n            }\r\n        }\r\n\r\n        $control.find(\"a.selection-edit\").text(displayText);\r\n    }\r\n};\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/navigation.js\n * ======================================== */\n\n﻿var navigation = {\r\n    load: function () {\r\n        navigation.bindToolBar();\r\n        if ($(\"#main-toolbar\").find(\".navbar-nav\").children().length > 0) {\r\n            $(\"#mobile-toolbar-toggle\").removeClass(\"disabled\");\r\n        }\r\n    },\r\n    bindToolBar: function () {\r\n        var $tooltopDrop = $(\"#top-bar\").find(\".drop\");\r\n        $tooltopDrop.off(\"click touchstart\").on(\"click\", function (e) {\r\n            e.stopPropagation();\r\n            $tooltopDrop.not(this).removeClass(\"dropvisible\").addClass(\"cpf-tooltip\");\r\n            if ($(e.target).parent().gcop().hasClass(\"drop\")) {\r\n                $(this).tooltip('dispose');\r\n                $(this).toggleClass(\"dropvisible cpf-tooltip\");\r\n            }\r\n        });\r\n\r\n        var userDisplayName = \"\";\r\n        $(\"#user-menu-button\").on(\"click\", function (e) {\r\n            var $displayName = $(this).find(\"#user-name-display\");\r\n            if (!userDisplayName) {\r\n                cpf.ajax({\r\n                    url: APPLICATIONPATH + \"cpf/core/userdisplayname\",\r\n                    dataType: \"json\",\r\n                    type: \"GET\",\r\n                    cache: false,\r\n                    success: function (data) {\r\n                        userDisplayName = data.data.userDisplayName;\r\n                        $displayName.text(userDisplayName).fadeIn(\"fast\");\r\n                    },\r\n                    errorCallback: function (a, b, c) {\r\n                        $displayName.text(\"\");\r\n                    }\r\n                });\r\n            }\r\n        });\r\n\r\n        $(\"#mobile-toolbar-toggle\").off(\"click\").on(\"click\", function () {\r\n            if (!$(this).hasClass(\"disabled\")) {\r\n                $(\"#main-toolbar\").toggleClass(\"mobile-visible\");\r\n            }\r\n        });\r\n\r\n        $(document).off(\"click.toolbar\").on(\"click.toolbar\", function (e) {\r\n            var $nav = $(\".navbar-nav\");\r\n            $nav.find(\".drop\").removeClass(\"dropvisible\").addClass(\"cpf-tooltip\");\r\n            var $tab = $(e.target).closest(\".open\");\r\n            //prevent autocomplete clicks within dropdowns closing them\r\n            if (!$(e.target).closest(\".ui-autocomplete\").length) {\r\n                $nav.find(\".open\").not($tab).removeClass(\"open\");\r\n            }\r\n\r\n            if (!$(e.target).closest(\".drop\").length) {\r\n                $tooltopDrop.removeClass(\"dropvisible\");\r\n            }\r\n        });\r\n\r\n        $(\".navbar-nav\").find(\".nav-link\").off(\"click.disabled\").on(\"click.disabled\", function(e) {\r\n            if ($(this).hasClass(\"disabled\")) {\r\n                e.preventDefault();\r\n                return false;\r\n            }\r\n        });\r\n    }\r\n};\r\n\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/notificationAlert.js\n * ======================================== */\n\n﻿/**\r\n * Notification manager manages supported notification channels\r\n * This could be:\r\n * - notifications-count - a number of user notificaitons\r\n * - workview-count - a number of user workview items\r\n * The managers updates user interface when value of supported notification\r\n * channel changes\r\n * \r\n * @example\r\n * ```js\r\n * // sets value of notifications count to 10\r\n * NotificationManager.setValueForNotificationChannel('notifications-count', 10);\r\n * // increment value of notifications count by 5\r\n * NotificationManager.increment('notifications-count', 5);\r\n * // decrement value of notifications count by 4\r\n * NotificationManager.decrement('notifications-count', 4);\r\n * ```\r\n */\r\nvar NotificationManager = (function($, cpf, undefined) {\r\n    'use strict';\r\n    /**\r\n     * Supported notification types are:\r\n     * - user notifications\r\n     * - workview items\r\n     * But there is no pre-check to impose this list\r\n     */\r\n    var supportedNotifications = [\r\n        \"notifications-count\",\r\n        \"workview-count\"\r\n    ];\r\n    /**\r\n     * Internal implementation of notification manager\r\n     */\r\n    var manager = {\r\n        /**\r\n         * @public \r\n         * @property {Array} Exposes list of supported channels are readonly property\r\n         */\r\n        get channels() {\r\n            return supportedNotifications;\r\n        },\r\n        /**\r\n         * @private \r\n         * Internal initialization routine\r\n         */\r\n        init: function() {\r\n            $(window).on('load', function() {\r\n                $.each(supportedNotifications, function(index, channel) {\r\n                    cpf.store.subscribe(channel, function(channel, payload) {\r\n                        manager._updateVisibleValue(channel, payload);\r\n                    });\r\n                    var existing = manager._getValueForChannel(channel);\r\n                    manager._updateVisibleValue(channel, existing);\r\n                });\r\n            });\r\n        },\r\n        /**\r\n        * Decrement value stored in channel\r\n        * @public decrement\r\n        * @param {String} channel - a key in storage\r\n        * @param {Number | String} - a value to decrement  existing value\r\n        */\r\n       decrement: function (channel, value) {\r\n           if (channel && value) {\r\n               var existing = manager._getValueForChannel(channel);\r\n               var newValue = manager._checkValue(existing - value);\r\n               manager.setValueForNotificationChannel(channel, newValue);\r\n           }\r\n       },\r\n       /**\r\n        * Increment a value for notification channel\r\n        * @public increment\r\n        * @param {String} channel - a channel - a key ihe storage\r\n        * @param {Number|String} value - a new value\r\n        */\r\n       increment: function (channel, value) {\r\n           if (channel && value) {\r\n               var existing = manager._getValueForChannel(channel);\r\n               var newValue = manager._checkValue(existing + value);\r\n               manager.setValueForNotificationChannel(channel, newValue);\r\n           }\r\n       },\r\n       /**\r\n       * updates information about notification\r\n       * Internally the value is updated in local storage\r\n       * and later changes are reflected in user interface\r\n       * @public setValueForNotificationChannel\r\n       * @param {String} - channel - a key name of notification\r\n       * @param {Number} - value - a new notification value\r\n       */\r\n        setValueForNotificationChannel: function(channel, value) {\r\n            value = manager._checkValue(value);\r\n            cpf.store.set(channel, value);\r\n            cpf.store.publish(channel, value);\r\n        },\r\n       /**\r\n        * @private\r\n        * Updates UI information\r\n        * @param  {String} channel - a key used to correctly match UI \r\n        * @param {Number} value - a new value to show in UI\r\n        */\r\n       _updateVisibleValue: function (channel, value) {\r\n            // will update the notification count icon.\r\n            // Negative value is clearly an error so better hide the count\r\n            if (!channel) return;\r\n            // by convention a selector is created from the channel/key name\r\n            var channelSelector = '.' + channel;\r\n            manager._updateTotalCount();\r\n            value = manager._checkValue(value);\r\n            var existingValue = manager._visibleValue(value);\r\n            // avoid reflowing top page content on page load\r\n            if (existingValue < 1 && value < 1) {\r\n                if (!$(channelSelector).hasClass('hidden')) {\r\n                    $(channelSelector).addClass('hidden');\r\n                }\r\n            }\r\n           if($(channelSelector).hasClass('hidden')) {\r\n                $(channelSelector).removeClass('hidden');\r\n            }\r\n           if (value < 1) {\r\n                $(channelSelector).html(\"\").fadeOut(\"fast\");\r\n           } else {\r\n               $(channelSelector).html(DOMPurify.sanitize(manager._visibleValue(value))).fadeIn(\"fast\");\r\n            }\r\n        },\r\n        /**\r\n         * @private\r\n         * Update information about total notifications\r\n         */\r\n        _updateTotalCount: function() {\r\n            var totalCountSelector = '.total-notifications-count';\r\n            var total  = 0;\r\n            $.each(supportedNotifications, function(index, channel) {\r\n                var existing = manager._getValueForChannel(channel);\r\n                total = total + existing;\r\n            });\r\n            if (total < 1) {\r\n                $(totalCountSelector).html(\"\").fadeOut(\"fast\");\r\n            } else {\r\n                $(totalCountSelector).html(DOMPurify.sanitize(manager._visibleValue(total))).fadeIn(\"fast\");\r\n            }\r\n        },\r\n        /**\r\n         * @private \r\n         * Gets value from storage for notification channel\r\n         * @param {String} channel - a channel name\r\n         */\r\n        _getValueForChannel: function(channel) {\r\n            var existing = cpf.store.get(channel, null);\r\n            try {\r\n                existing = manager._checkValue(parseInt(existing, 10));\r\n            } catch (e) { /* no-op */\r\n            }\r\n            return existing;\r\n        },\r\n        /**\r\n         * @private\r\n         * Wraps value into supported display vlue\r\n         * @param {Number} a value to wrap\r\n         */\r\n        _visibleValue: function(value) \r\n        {\r\n            var MAX_VALUE = 99;\r\n            if(!value || isNaN(value)) return \"\";\r\n            return (value > MAX_VALUE) ? MAX_VALUE + \"+\" : value;\r\n        },\r\n        /**\r\n         * @private \r\n         * Wraps a value with allowed values (positive intigers only)\r\n         * If value is NaN or less then 0, 0 is returned\r\n         * @param {Number} value\r\n         */\r\n        _checkValue: function(value) {\r\n            if(isNaN(value)) return 0;\r\n            return Math.max(value, 0);\r\n        }     \r\n    };\r\n    manager.init();\r\n    // supported public internace\r\n    return {\r\n        channels: manager.channels,\r\n        decrement: manager.decrement,\r\n        increment: manager.increment,\r\n        setValueForNotificationChannel: manager.setValueForNotificationChannel\r\n    }\r\n})(jQuery, cpf);\r\n\r\n/**\r\n * Legacy object for watching user notifications\r\n * Internally it uses notifcation NotificationManager to update UI state\r\n */\r\nvar notificationAlert = {\r\n\r\n    lockKey: \"notificationCheckLock\",\r\n    lastCheckTimeStampKey: \"notificationTimeStamp\",\r\n    checkInterval: null,\r\n    cssTimeout: null,\r\n    checkInMilliseconds: null,\r\n    load: function (checkMinutes) {\r\n        checkMinutes = isNaN(checkMinutes) ? 10 : checkMinutes;\r\n        notificationAlert.checkInMilliseconds = checkMinutes * 60000;\r\n        var channel = \"notifications-count\";\r\n        var existing = cpf.store.get(channel, null);\r\n        if (existing !== null) {\r\n            //if the notification has expired then force refresh\r\n            if (notificationAlert.hasExpired())\r\n                notificationAlert.checkForNotifications(true);\r\n            else {\r\n                NotificationManager.setValueForNotificationChannel(channel, existing);\r\n            }\r\n        } else {\r\n            notificationAlert.checkForNotifications(true);\r\n        }\r\n        notificationAlert.startCheck();\r\n    },\r\n    \r\n\r\n    startCheck: function () {\r\n        // DEAL WITH THIS HERE> WHEN WE FORCE A CHECK ITS NOT PLAYING BALL\r\n        notificationAlert.checkInterval = setInterval($.proxy(function() {\r\n            this.clearCheck();\r\n            this.checkForNotifications();\r\n        }, this), notificationAlert.checkInMilliseconds);\r\n    },\r\n\r\n    clearCheck: function () {\r\n        clearInterval(this.checkInterval);\r\n    },\r\n\r\n    updateTimeStamp: function () {\r\n        cpf.store.set(notificationAlert.lastCheckTimeStampKey, new Date());\r\n    },\r\n\r\n    lock: function () {\r\n        if (cpf.store.get(notificationAlert.lockKey, null) !== null) {\r\n            notificationAlert.startCheck();\r\n            return false;\r\n        }\r\n        // store the lock with a time limit of 5 secs.\r\n        cpf.store.set(notificationAlert.lockKey, 1, 5000);\r\n        return true;\r\n    },\r\n\r\n    hasExpired: function () {\r\n        var lastCheck = cpf.store.get(notificationAlert.lastCheckTimeStampKey, null);\r\n        if (lastCheck !== null) {\r\n            var last = new Date(lastCheck),\r\n                        now = new Date(),\r\n                        difference = (now - last);\r\n\r\n            if (difference > notificationAlert.checkInMilliseconds) {\r\n                return true;\r\n            }\r\n        }\r\n        return false;\r\n    },\r\n\r\n    unlock: function () {\r\n        // delete the lock once done.\r\n        cpf.store.remove(notificationAlert.lockKey);\r\n    },\r\n\r\n    checkForNotifications: function (force) {\r\n\r\n        if (force == undefined) {\r\n            force = false;\r\n        }\r\n\r\n        if (notificationAlert.lock() || force) {\r\n            if (!force && !notificationAlert.hasExpired()) {\r\n                notificationAlert.unlock();\r\n                notificationAlert.startCheck();\r\n                return false;\r\n            }\r\n\r\n            var success = function (result, textStatus, jqXHR) {\r\n                notificationAlert.updateTimeStamp(); // update the stored timestamp with the last check datetime.\r\n                notificationAlert.unlock(); // remove the lock flag\r\n                if (!force) {\r\n                    notificationAlert.startCheck(); // start the timer again\r\n                }\r\n                NotificationManager.setValueForNotificationChannel(\"notifications-count\", result.data.count); // publish the results to all the other windows/tabs\r\n            };\r\n\r\n            var fail = function (data, message, exception) {\r\n                // ignore a fail for now, just restart the check timer.\r\n                if (!force) {\r\n                    notificationAlert.startCheck();\r\n                }\r\n            };\r\n\r\n            var headers = { \"Timestamp-Update\": \"false\" };\r\n\r\n            cpf.ajax({ url: APPLICATIONPATH + \"notifications/api/v1/count\", success: success, errorCallback: fail, headers: headers });\r\n        }\r\n    },\r\n   \r\n    updatesTimeZone: function () {\r\n\r\n        // get iana timezone\r\n        var tzname = \"\";\r\n        try {\r\n            var tz = jstz.determine();\r\n            if (tz) {\r\n                tzname = tz.name();\r\n            }\r\n        } catch (e) {\r\n            tzname = \"UTC\";\r\n        }\r\n\r\n        var success = function (result, textStatus, jqXHR) {\r\n\r\n        };\r\n\r\n        var fail = function (data, message, exception) {\r\n\r\n        };\r\n\r\n        var data = { \"timezone\": tzname };\r\n        var headers = { \"Timestamp-Update\": \"false\" };\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/core/updatetimezone\", success: success, errorCallback: fail, data: data, headers: headers });\r\n    }\r\n};\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/permissions.js\n * ======================================== */\n\n﻿var permissions = {\r\n\r\n    load: function () {\r\n\r\n        cpf.title.set(USERORGROUPNAME + \" > \" + \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{Ribbon_GroupPermissons_Title}:{Permissions}}\");\r\n\r\n        $(\"#user-group-permission-save\").on(\"click\", function (e) {\r\n            if (!$(\"#user-group-permission-save\").hasClass(\"disabled\")) {\r\n                permissions.save($(this), true);\r\n            }\r\n            return false;\r\n        });\r\n\r\n        $('#grouppermissions-application-object-type').on('change', function (e) {\r\n\r\n            var optionSelected = $(\"option:selected\", this).val();\r\n            if (optionSelected != \"default\") {\r\n                var success = function (result) {\r\n                    cpf.spin(false);\r\n                    if (result.success == true) {\r\n                        if (result.data) {\r\n                            var messageArray = [];\r\n                            var counter = 1;\r\n                            messageArray[0] = \"<select id='grouppermissions-application-object-list' name='grouppermissions-application-object-list'>\";\r\n                            for (var i = 0; i < result.data.length; i++) {\r\n                                messageArray[counter++] = \"<option key='\" + result.data[i].id + \"'value='\" + result.data[i].name + \"'>\" + result.data[i].name + \"</option>\";\r\n                            }\r\n                            messageArray[counter + 1] = \"</select>\";\r\n                            $(\"#grouppermissions-application-object-list\").html(DOMPurify.sanitize(messageArray.join()));\r\n                        }\r\n\r\n                        //trigger change event\r\n                        permissions.getObjectPermissions();\r\n                    }\r\n                };\r\n\r\n                var fail = function (result) {\r\n                    cpf.spin(false);\r\n                    if (result.success != \"true\") {\r\n                        cpf.alert(\"RESOURCE{{userorgrouppermission.js}:{FailedToSave}:{Error failed to retrieve application display names.}}\", \"w\");\r\n                    }\r\n                };\r\n                cpf.ajax({ url: APPLICATIONPATH + \"cpf/permission/getobjecttypesnames\", dataType: \"json\", type: \"POST\", success: success, errorCallback: fail, data: { \"objecttype\": optionSelected } });\r\n            }\r\n            else {\r\n                $(\"#user-group-permission-save\").addClass(\"disabled\");\r\n                $('#grouppermissions-application-object-list').gcop().removeAttribute(\"disabled\");\r\n                $('#grouppermissions-application-object-list').html(\"<select><option>\" + DOMPurify.sanitize(\"RESOURCE{{Sysrepublic.Foundation.UserAlerts.CpfResources}:{PleaseChoose}:{Please Choose}}\") + \"</option></select>\");\r\n                $(\".permissions-options\").find(\"#permission-results\").html(DOMPurify.sanitize(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{No_Results_Found}:{No results found.}}\"));\r\n            }\r\n        });\r\n\r\n        $('#grouppermissions-application-object-list').on('change', function (e) {\r\n\r\n            var optionSelected = $(\"option:selected\", this).val();\r\n            if (optionSelected != \"default\") {\r\n                //trigger change event\r\n                permissions.getObjectPermissions();\r\n            }\r\n        });\r\n    },\r\n\r\n    save: function () {\r\n        var $panel = $(\".permissions-options .panel\").parent();\r\n        var model = {};\r\n        model.userorgroupname = $panel.gcop().getAttribute(\"id\");\r\n        model.userorgroupid = $panel.gcop().getAttribute(\"user-or-group-id\");\r\n        model.applicationobjectid = $panel.gcop().getAttribute(\"application-object-permission-id\");\r\n        model.isuser = $(\".permissions-options\").gcop().getAttribute(\"is-user\");\r\n\r\n        var permissions = [];\r\n        var $pemissions = $(\".permissions-options .panel\").find(\"input[type=checkbox]:checked\");\r\n        {\r\n            for (var i = 0, ii = $pemissions.length; i < ii; i++) {\r\n                var permission = {};\r\n                permission.value = $($pemissions[i]).val();\r\n                permission.id = $($pemissions[i]).gcop().getAttribute(\"permission-id\");\r\n                permissions.push(permission);\r\n            }\r\n        }\r\n\r\n        model.userorgrouppermissions = permissions;\r\n\r\n        var success = function (result) {\r\n            cpf.spin(false);\r\n            if (result.success == true) {\r\n                cpf.delayedAlert(\"RESOURCE{{userorgrouppermission.js}:{Saved}:{Saved successfully.}}\", \"s\", false);\r\n                window.history.back();\r\n            }\r\n        };\r\n\r\n\r\n        var fail = function (result) {\r\n            cpf.spin(false);\r\n            if (result.success != \"true\") {\r\n                cpf.alert(\"RESOURCE{{userorgrouppermission.js}:{FailedToSave}:{Failed to save.}}\", \"w\");\r\n            }\r\n        };\r\n\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/permission/save\", dataType: \"json\", type: \"POST\", success: success, errorCallback: fail, data: model });\r\n    },\r\n\r\n    getUserOrGroupPermissions: function (callback) {\r\n        var userorgroupname = $(\"#user-group-permissions-wrapper\").gcop().getAttribute(\"user-group-name\");\r\n        var loaded = $(\"#user-group-permissions-wrapper\").gcop().getAttribute(\"loaded\");\r\n        if (typeof (loaded) == \"string\" && loaded != \"true\" || typeof (loaded) == \"boolean\" && loaded != true) {\r\n\r\n            $(\"#page-loader\").show();\r\n            $(\"#user-group-permissions-wrapper\").show();\r\n\r\n            var success = function (html, textStatus, jqXHR) {\r\n                cpf.spin(false);\r\n                $(\"#page-loader\").hide();\r\n                $(\"#user-group-permissions-wrapper\").html(html);\r\n                $(\"#user-group-permissions-wrapper\").gcop().setAttribute(\"loaded\", true);\r\n\r\n                if (callback) {\r\n                    callback();\r\n                }\r\n\r\n                return false;\r\n            };\r\n\r\n            var fail = function (xmlhttp, message, exception) {\r\n                cpf.spin(false);\r\n                $(\"#page-loader\").hide();\r\n\r\n                cpf.alert(\"RESOURCE{{userorgrouppermission.js}:{FailedToSave}:{Failed to retrieve permission group.}}\", \"w\");\r\n            };\r\n\r\n            cpf.ajax({ url: APPLICATIONPATH + \"cpf/permission/index\", dataType: \"html\", type: \"POST\", success: success, errorCallback: fail, data: { \"userOrGroupName\": userorgroupname } });\r\n        }\r\n        else {\r\n            $(\"#user-group-permissions-wrapper\").show();\r\n        }\r\n        return false;\r\n    },\r\n\r\n    getObjectPermissions: function () {\r\n\r\n        var optionSelected = $(\"#grouppermissions-application-object-list\").find('option:selected').attr('key');\r\n        var userorgroupid = $(\"#grouppermissions-application-object-list\").parent().gcop().getAttribute(\"usergroup-id\");\r\n        var userorgroupname = $(\"#grouppermissions-application-object-list\").parent().gcop().getAttribute(\"usergroup-name\");\r\n\r\n        var success = function (html, textStatus, jqXHR) {\r\n            cpf.spin(false);\r\n\r\n            // check if object has data\r\n            if ($(html).gcop().getAttribute(\"has-data\") === \"true\") {\r\n                $(\"#user-group-permission-save\").removeClass(\"disabled\");\r\n                $('#grouppermissions-application-object-list').gcop().removeAttribute(\"disabled\");\r\n            }\r\n            else {\r\n                $(\"#user-group-permission-save\").addClass(\"disabled\");\r\n                $('#grouppermissions-application-object-list').gcop().setAttribute(\"disabled\", \"disabled\");\r\n                $('#grouppermissions-application-object-list').html(\"<select><option>\" + $(html).gcop().getAttribute(\"data-result\") + \"</option></select>\");\r\n            }\r\n\r\n            $(\"#permission-results\").html(html);\r\n        };\r\n\r\n        var fail = function (xmlhttp, message, exception) {\r\n            cpf.spin(false);\r\n            cpf.alert(\"RESOURCE{{userorgrouppermission.js}:{FailedToSave}:{Error: failed to retrieve object permissions.}}\", \"w\");\r\n        };\r\n\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/permission/getobjectpermissions\", dataType: \"html\", type: \"POST\", success: success, errorCallback: fail, data: { \"objectId\": optionSelected, \"userOrGroupId\": userorgroupid, \"userOrGroupName\": userorgroupname } });\r\n    },\r\n\r\n    resetView: function ($control) {\r\n        if (PAGEVIEW == \"permissions\") {\r\n            // trigger ajax call to permissions       \r\n            $control.trigger('click');\r\n        }\r\n        // reset page view\r\n        PAGEVIEW = \"edit\";\r\n    }\r\n};\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/ribbon.js\n * ======================================== */\n\n; (function ($) {\r\n\r\n    $.fn.ribbon = function (options) {\r\n\r\n        var defaults = { onCreate: false, onChange: false, onSort: false, onRemove: false, onSave: false };\r\n        var opts = $.extend(defaults, options);\r\n\r\n        var initializeButtons = function ($buttons) {\r\n            for (var i = 0, len = $buttons.length; i < len; i++) {\r\n                var $button = $($buttons[i]);\r\n                var image = $button.attr(\"data-image\");\r\n                $button.css(\"background-image\", \"url('\" + image + \"')\");\r\n\r\n                // button hover\r\n                $button.hover(function () {\r\n                    var $b = $(this);\r\n                    if ($b.hasClass(\"disabled\")) {\r\n                    } else {\r\n                        $(this).addClass(\"hover\");\r\n                    }\r\n                }, function () {\r\n                    $(this).removeClass(\"hover\");\r\n                });\r\n            }\r\n        };\r\n\r\n        //        var createTabs=function($sections, $tabOuter){\r\n        //             var tabArray=[];\r\n        //                for(var i=0,len=$sections.length;i<len;i++)\r\n        //                {\r\n        //                    var $section = $($sections[i]);\r\n        //                    var sectionName = $section.attr(\"data-title\");\r\n        //                    var areaTabClass=(!$.isAnonymous() && i==0)?\"areas-tab\":\"\";\r\n        //                    tabArray.push(\"<div class='tab \"+areaTabClass+\"'>\" + sectionName + \"</div>\");\r\n        //                }\r\n\r\n        //            $tabOuter.append(tabArray.join(\"\"));           \r\n        //        };\r\n\r\n        //        var initializeTabs=function($sections, $tabOuter){\r\n        //            // tabs hover\r\n        //            var $tabs = $(\".tab\", $tabOuter);\r\n        //            $tabs.hover(function () {\r\n        //                if (!$(this).hasClass(\"selected\")) {\r\n        //                    $(this).addClass(\"hover\");\r\n        //                }\r\n        //            }, function () { $(this).removeClass(\"hover\"); });\r\n\r\n        //            $tabs.on(\"click\", function () {\r\n        //                    var $currentTab=$(this);\r\n        //                    var index = $tabs.index($currentTab);                   \r\n        //                    if(!$.isAnonymous() && index==0)\r\n        //                    {\r\n        //                         var $appsMenu = $(\"#apps\");\r\n        //                        \r\n        //                         $appsMenu.show();\r\n        //                         // if we have a big page need to go back to the top else you will not see the apps menu.\r\n        //                         window.scrollTo(0, 0);\r\n        //                         navigation.showSideNavigation(false);\r\n\r\n        //                         var windowHeight = $(window).height();\r\n        //                         var bodyHeight = $(\"body\").height();\r\n\r\n        //                         $appsMenu.css(\"height\", ((bodyHeight > windowHeight) ? bodyHeight: (windowHeight - 177)) + \"px\");\r\n\r\n        //                         // HACK: If there is an alert being shown, make it full width.\r\n        //                         var $alert = $(\"#alert\");\r\n        //                            if ($alert.gcop().isVisible()) {            \r\n        //                                $alert.css(\"left\", \"0px\");\r\n        //                            }\r\n        //                         appsMenu.load();\r\n        //                    }\r\n\r\n        //                    $tabs.removeClass(\"selected\");\r\n        //                    $currentTab.addClass(\"selected\");\r\n\r\n        //                    // if this is the areas tab, add the orange border\r\n        //                    if (index == 0) {\r\n        //                        $tabOuter.addClass(\"selected\");\r\n        //                        if($(\"#portal-frame\").length > 0)\r\n        //                        {\r\n        //                            $(\"#page-body-wrapper\").hide();\r\n        //                        }\r\n        //                    } else {\r\n        //                        // turn off orange areas underline\r\n        //                        $tabOuter.removeClass(\"selected\");\r\n        //                        $(\"#apps\").hide();\r\n        //                        if($(\"#portal-frame\").length > 0)\r\n        //                        {\r\n        //                            $(\"#page-body-wrapper\").show();\r\n        //                        }\r\n        //                    } \r\n\r\n        //                    $sections.css(\"display\", \"none\");\r\n        //                    $sections.eq(index).css(\"display\", \"block\");\r\n\r\n        //                    return false;\r\n        //            });\r\n        //        };\r\n\r\n        var initializeGroups = function ($groups) {\r\n            // set up the groups \r\n            for (var i = 0, len = $groups.length; i < len; i++) {\r\n                var $group = $($groups[i]);\r\n                var $groupTitle = $(\"<div class='group-title' style='width:\" + $group.width() + \"px'>\" + $group.attr(\"data-title\") + \"</div>\");\r\n                $group.append($groupTitle);\r\n            }\r\n        };\r\n\r\n        return this.each(function () {\r\n\r\n            var $ribbon = $(this);\r\n            $ribbon.css(\"visibility\", \"hidden\");\r\n            // TFS #1111 trim white space artefacts\r\n            if ($ribbon.children().length === 0) {\r\n                $ribbon.text(\"\");\r\n            }\r\n            // wrap the section(s) in a sections div\r\n            //var $sections = $(\".section\", $ribbon);\r\n\r\n            // loop the sections and build the ribbon\r\n            //var $tabOuter = $(\".tabs\", $ribbon);\r\n\r\n            // set button images\r\n            initializeButtons($(\"#toolbar-container a\", $ribbon));\r\n\r\n            // set groups   \r\n            initializeGroups($(\"#toolbar-container ul\", $ribbon));\r\n\r\n            // create tabs\r\n            //createTabs($sections, $tabOuter);\r\n\r\n            // set click and hover events\r\n\r\n            //initializeTabs($sections, $tabOuter);      \r\n\r\n            // ensure the width\r\n            //$(\".tabs\", $ribbon).width($ribbon.width());\r\n\r\n            // hide other sections and set the default section visible and and its tab selected\r\n            var tabIndex = $.isAnonymous() ? 0 : 1;\r\n            //$(\".section\", $ribbon).css(\"display\",\"none\");\r\n            // PA commented inline-block following re-skin issues in dynoform section 20140319\r\n            //$(\".section:eq(\" + tabIndex + \")\", $ribbon).css(\"display\", \"inline-block\");\r\n\r\n            // LC for now just show everything\r\n            // PA commented inline-block following re-skin issues in dynoform section 20140319\r\n            // $(\".section\").css(\"display\", \"inline-block\");\r\n            $(\".tab:eq(\" + tabIndex + \")\", $ribbon).addClass(\"selected\");\r\n            $ribbon.css(\"visibility\", \"visible\");\r\n        });\r\n    };\r\n})(jQuery);\r\n\r\n$(document).ready(function() {\r\n    $('#main-toolbar .nav.navbar-nav li li a').on('click.closeAllopenItems', function (e) {\r\n        if (!$(this).gcop().hasClass('disabled')) {\r\n            $('#main-toolbar li.open').gcop().removeClass('open');\r\n        }\r\n    });\r\n    $('#main-toolbar .nav.navbar-nav li .dropdown-menu li a span').on('click.closeAllopenItems', function (e) {\r\n        if (!$(this).parent().gcop().hasClass('disabled')) {\r\n            $('#main-toolbar li.open').gcop().removeClass('open');\r\n        }\r\n    });\r\n});\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/settings.js\n * ======================================== */\n\n﻿var settings = {};\r\nsettings.details = {\r\n    load: function () {\r\n        $(\"#save\").on(\"click\", function () {\r\n            settings.details.save($(this));\r\n            return false;\r\n        });\r\n        if ($(\"#first-name\").val() !== \"\") {\r\n            cpf.title.set(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{StatusBar_Settings}:{My Settings}}\" + \" > \" + $(\"#first-name\").val() + \" \" + $(\"#last-name\").val());\r\n        }\r\n        else {\r\n            cpf.title.set(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{StatusBar_Settings}:{My Settings}}\");\r\n        }\r\n    },\r\n    save: function ($button) {\r\n        if (!$(\"#security-settings\").validate()) {\r\n            cpf.alert(\"RESOURCE{{settings.js}:{SettingsValidationText}:{One or more fields were not filled out correctly.}}\");\r\n            return;\r\n        }\r\n        var userModel = {\r\n            firstName: $(\"#first-name\").val(),\r\n            lastName: $(\"#last-name\").val(),\r\n            emailAddress: $(\"#email\").val(),\r\n            timeZone: $(\"#time-zone\").val(),\r\n            language: $(\"#select-language\").val(),\r\n            defaultCurrency: $(\"#default-currency\").val()\r\n        };\r\n        var json = JSON.stringify(userModel);\r\n        var success = function () {\r\n            $button.removeClass(\"disabled\");\r\n\r\n            if (CULTURE != userModel.language) {\r\n                cpf.wait();\r\n                cpf.delayedAlert(\"RESOURCE{{settings.js}:{SettingsSaved}:{Saved Successfully.}}\", \"s\");\r\n                window.location.href = APPLICATIONPATH + \"cpf/user/account?lc=\" + userModel.language;\r\n            } else {\r\n                cpf.alert(\"RESOURCE{{settings.js}:{SettingsSaved}:{Saved Successfully.}}\", \"s\");\r\n            }\r\n        };\r\n        var fail = function () {\r\n            $button.removeClass(\"disabled\");\r\n            cpf.alert(\"RESOURCE{{settings.js}:{SettingsSaveFailed}:{Failed to save the settings. Please try again, or contact support.}}\", \"e\");\r\n        };\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/user/account\", success: success, errorCallback: fail, data: { values: json } });\r\n    }\r\n};\r\n\r\nsettings.password = {\r\n\r\n    load: function () {\r\n\r\n        $(\"#save\").on(\"click\", function () {\r\n            settings.password.save($(this));\r\n            return false;\r\n        });\r\n\r\n        var $oldPassword = $(\"#old-password\");\r\n        var $newPassword = $(\"#new-password\");\r\n        var $confirmPassword = $(\"#password-confirm\");\r\n\r\n        // handle basic keyboard input\r\n        var doSave = function () {\r\n            var $saveButton = $(\"#save\");\r\n            settings.password.save($saveButton);\r\n        };\r\n\r\n        $oldPassword.on(\"keydown\", function (event) {\r\n            if (event.which == 13) {\r\n                $newPassword.focus();\r\n            }\r\n        });\r\n\r\n        $newPassword.on(\"keydown\", function (event) {\r\n            if (event.which == 13) {\r\n                $confirmPassword.focus();\r\n            }\r\n        });\r\n\r\n        $confirmPassword.on(\"keydown\", function (event) {\r\n            if (event.which == 13) {\r\n                doSave();\r\n            }\r\n        });\r\n\r\n        //#3196 CPF Header\r\n        if (typeof CURRENTUSER !== 'undefined') {\r\n            cpf.title.set(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{StatusBar_Settings}:{My Settings}}\" + \" > \" + CURRENTUSER);\r\n        }\r\n        else {\r\n            cpf.title.set(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{StatusBar_Settings}:{My Settings}}\");\r\n        }\r\n\r\n        window.setTimeout(function () { $oldPassword.focus(); }, 0);\r\n    },\r\n\r\n    save: function ($button) {\r\n        var oldPassword = $(\"#old-password\").val();\r\n        var newPassword = $(\"#new-password\").val();\r\n        var confirmPassword = $(\"#password-confirm\").val();\r\n\r\n        if (!$(\"#password-details-section\").validate()) {\r\n            cpf.alert(\"RESOURCE{{settings.js}:{SettingsPasswordValidation}:{There were some mistakes in the form. Please check the highlighted fields above.}}\", \"e\");\r\n            return false;\r\n        }\r\n\r\n        if (newPassword !== confirmPassword) {\r\n            cpf.alert(\"RESOURCE{{settings.js}:{SettingsConfirmPassword}:{New password and confirm password do not match}}\", \"e\");\r\n            return false;\r\n        }\r\n\r\n        if (!$(\"#security-settings\").validate()) {\r\n            cpf.alert(\"RESOURCE{{settings.js}:{SettingsSecurityValidation}:{There were some mistakes in the form. Please check the highlighted fields above.}}\");\r\n            return;\r\n        }\r\n        var validationArray = [];\r\n        if (!$(\"#password-details-section\").validate({ validationArray: validationArray })) {\r\n            cpf.alert(\"RESOURCE{{settings.js}:{SettingsPasswordValidation}:{There were some mistakes in the form. Please check the highlighted fields above.}}\");\r\n            return;\r\n        }\r\n\r\n        var userModel = {};\r\n        userModel.oldPassword = oldPassword;\r\n        userModel.newPassword = newPassword;\r\n        userModel.confirmPassword = confirmPassword;\r\n\r\n        var success = function (result, textStatus, jqXHR) {\r\n\r\n            $button.removeClass(\"disabled\");\r\n\r\n            if (result.success) {\r\n                var path = cpf.querystring.get(\"i\");\r\n\r\n                if (!path)\r\n                {\r\n                    path = cpf.querystring.get(\"url\");\r\n                }\r\n\r\n                if (path) {\r\n                    cpf.wait();\r\n                    location.href = decodeURIComponent(path);\r\n                }\r\n            }\r\n        };\r\n\r\n        var fail = function (data, textStatus, jqXHR) {\r\n            $button.removeClass(\"disabled\");\r\n            if (data[\"unhandled\"]) {\r\n                cpf.alert(\"RESOURCE{{settings.js}:{SettingsSaveFailed}:{Failed to save the password settings. Please try again, or contact support.}}\", \"e\");\r\n            }\r\n        };\r\n\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/user/password\", success: success, errorCallback: fail, data: { model: userModel } });\r\n    }\r\n};\r\n\r\nsettings.preferences = {\r\n\r\n    load: function () {\r\n\r\n        $(\"#save\").on(\"click\", function () {\r\n            settings.preferences.save($(this));\r\n            return false;\r\n        });\r\n    },\r\n\r\n    save: function () {\r\n        var email = $(\"#email\").val();\r\n        var password = $(\"#password\").val();\r\n        var passwordConfirm = $(\"#password-confirm\").val();\r\n        var firstName = $(\"#first-name\").val();\r\n        var lastName = $(\"#last-name\").val();\r\n        var valid = true;\r\n\r\n        if (!$(\"#security-settings\").validate()) {\r\n            cpf.alert(\"RESOURCE{{settings.js}:{SettingsPreferencesValidation}:{There were some mistakes in the form. Please check the highlighted fields above.}}\");\r\n            return;\r\n        }\r\n\r\n        if (password !== passwordConfirm) {\r\n            cpf.alert(\"RESOURCE{{settings.js}:{SettingsPreferencesNotMatched}:{The two passwords you entered do not match. Please try fill them out again.}}\");\r\n            valid = false;\r\n        }\r\n\r\n        if (valid) {\r\n\r\n            var json = JSON.stringify(searchModel);\r\n\r\n            var success = function (html, textStatus, jqXHR) {\r\n                $button.removeClass(\"disabled\");\r\n                cpf.alert(\"RESOURCE{{settings.js}:{SettingsPreferencesSaved}:{Saved Successfully.}}\", \"s\");\r\n            };\r\n\r\n            var fail = function (data, textStatus, jqXHR) {\r\n                $button.removeClass(\"disabled\");\r\n                var msg = \"RESOURCE{{settings.js}:{SettingsPreferencesSaveFailed}:{Failed to save the preferences.}}\";\r\n                cpf.alert(msg.replace(\"{0}\", textStatus), \"e\");\r\n            }\r\n\r\n\r\n            //cpf.ajax({ url: APPLICATIONPATH + \"incidents/mysearches/save\", success: success, errorCallback: fail, data: { values: json } });\r\n        }\r\n\r\n    }\r\n};\r\n\r\nsettings.alerting = {\r\n\r\n    escalatedUser: null,\r\n    delegatedUser: null,\r\n\r\n    load: function () {\r\n\r\n        $(\"#save\").on(\"click\", function () {\r\n            if (settings.alerting.validate()) {\r\n                settings.alerting.save($(this));\r\n            }\r\n            return false;\r\n        });\r\n\r\n        $(\"#escalate\").on(\"change\", function () {\r\n            if ($(this).is(\":checked\")) {\r\n\r\n                settings.alerting.enabledFilteredSelect(\"escalationName\", true);\r\n\r\n                //$(\"#escalationName\").find(\"input\").removeAttr(\"disabled\").focus();\r\n            } else {\r\n                //$(\"#escalationName\").find(\"input\").attr(\"disabled\", \"disabled\");\r\n                settings.alerting.enabledFilteredSelect(\"escalationName\", false);\r\n            }\r\n        });\r\n\r\n        $(\"#redirect\").on(\"change\", function () {\r\n            if ($(this).is(\":checked\")) {\r\n                settings.alerting.enabledFilteredSelect(\"delegateName\", true);\r\n            } else {\r\n                settings.alerting.enabledFilteredSelect(\"delegateName\", false);\r\n            }\r\n        });\r\n\r\n        //if ($(\"#escalate:checked\").length == 1) {\r\n        //    $(\"#escalationName\").find(\"input\").removeAttr(\"disabled\");\r\n        //} else {\r\n        //    $(\"#escalationName\").find(\"input\").attr(\"disabled\", \"disabled\");\r\n        //}\r\n\r\n        if ($(\"#outOfOffice:checked\").length == 1) {\r\n            $(\"#redirect\").removeAttr(\"disabled\");\r\n        }\r\n        else {\r\n            $(\"#redirect\").attr(\"disabled\", \"disabled\");\r\n            $(\"#redirect\").removeAttr(\"checked\");\r\n        }\r\n\r\n        $(\"#outOfOffice\").on(\"change\", function () {\r\n            if ($(this).is(\":checked\")) {\r\n                $(\"#redirect\").removeAttr(\"disabled\");\r\n            }\r\n            else {\r\n                $(\"#redirect\").attr(\"disabled\", \"disabled\");\r\n                $(\"#redirect\").removeAttr(\"checked\");\r\n                $(\"#redirect\").trigger(\"change\");\r\n            }\r\n        });\r\n\r\n        //if ($(\"#redirect:checked\").length == 1) {\r\n        //    //$(\"#delegateName\").find(\"input\").removeAttr(\"disabled\");\r\n        //    settings.alerting.enabledFilteredSelect(\"delegateName\", true);\r\n        //} else {\r\n        //    //$(\"#delegateName\").find(\"input\").attr(\"disabled\", \"disabled\");\r\n        //    settings.alerting.enabledFilteredSelect(\"delegateName\", false);\r\n        //}\r\n\r\n        //#3196 CPF Header\r\n        if (typeof CURRENTUSER !== 'undefined') {\r\n            cpf.title.set(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{StatusBar_Settings}:{My Settings}}\" + \" > \" + CURRENTUSER);\r\n        }\r\n        else {\r\n            cpf.title.set(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{StatusBar_Settings}:{My Settings}}\");\r\n        }\r\n    },\r\n\r\n    enabledFilteredSelect:  function (id, enable) {\r\n        try {\r\n            var filterId = id + \"-filter\";\r\n            var service = angular.element(document.body).injector().get(\"sngFilterboxAccessService\");\r\n            var exists = service.checkIfExists(filterId);\r\n            if (exists) {\r\n                service.setEnabled(filterId, enable);\r\n            }\r\n        } catch (error) {\r\n            console.error(error);\r\n        }\r\n    },\r\n    getFilterSelectVal: function (id) {\r\n        var value = null;\r\n        try {\r\n            var filterId = id + \"-filter\";\r\n            var service = angular.element(document.body).injector().get(\"sngFilterboxAccessService\");\r\n            var exists = service.checkIfExists(filterId);\r\n            if (exists) {\r\n                // the mediator returns value directly at specified index\r\n                value = service.getValueForIndex(filterId, 0);\r\n            }\r\n        } catch (error) {\r\n            console.error(error);\r\n        }\r\n        return value;\r\n    },\r\n\r\n    validate: function () {\r\n        var isValid = true;\r\n\r\n        var delegateUser = settings.alerting.getFilterSelectVal(\"delegateName\");\r\n        var escalationUser = settings.alerting.getFilterSelectVal(\"escalationName\");\r\n\r\n        var msg = '';\r\n        if (CURRENTUSER == delegateUser) {\r\n            msg = \"RESOURCE{{settings.js}:{SettingsSaveFailed}:{Failed to save: Re-directing to yourself is not allowed.}}\";\r\n            isValid = false;\r\n        }\r\n\r\n        if (CURRENTUSER == escalationUser) {\r\n            msg = \"RESOURCE{{settings.js}:{SettingsSaveFailed}:{Failed to save: Escalating to yourself is not allowed.}}\";\r\n            isValid = false;\r\n        }\r\n\r\n        if (!isValid) {\r\n            cpf.alert(msg, \"e\");\r\n        }\r\n\r\n        return isValid;\r\n    },\r\n    save: function ($button) {\r\n\r\n        if ($button.hasClass(\"disabled\")) {\r\n            return;\r\n        }\r\n\r\n        cpf.closeAlert();\r\n\r\n        var $delegateAutoComplete = $(\"#delegateName\");\r\n        var $escalateAutoComplete = $(\"#escalationName\");\r\n        var $outOfOffice = $(\"#outOfOffice:checked\");\r\n        var $forward = $(\"#forward:checked\");\r\n        var $redirect = $(\"#redirect:checked\");\r\n        var $escalate = $(\"#escalate:checked\");\r\n\r\n\r\n        var delegateUser = settings.alerting.getFilterSelectVal(\"delegateName\");\r\n        var escalationUser = settings.alerting.getFilterSelectVal(\"escalationName\");\r\n\r\n        if (escalationUser === null && $escalate.length === 1) {\r\n            cpf.alert(\"RESOURCE{{settings.js}:{PleaseProvideAUserToEscalateTo}:{Please provide a user name to escalate to}}\", \"e\");\r\n            $escalateAutoComplete.find(\".search\").addClass(\"invalid\");\r\n            return;\r\n        }\r\n\r\n        if (delegateUser === null && $redirect.length === 1) {\r\n            cpf.alert(\"RESOURCE{{settings.js}:{PleaseProvideAUserToDelegateTo}:{Please provide a user name to forward your alerts to}}\", \"e\");\r\n            $delegateAutoComplete.find(\".search\").addClass(\"invalid\");\r\n            return;\r\n        }\r\n\r\n\r\n        var data = {\r\n            delegateUserId: delegateUser,\r\n            escalateUserId: escalationUser,\r\n            outOfOffice: $outOfOffice.length > 0,\r\n            sendAlertsAsEmail: $forward.length > 0,\r\n            redirect: $redirect.length > 0,\r\n            escalate: $escalate.length > 0\r\n        };\r\n\r\n        var success = function (result, textStatus, jqXHR) {\r\n            cpf.spin(false);\r\n            $button.removeClass(\"disabled\");\r\n\r\n            if (result.success) {\r\n                cpf.alert(\"RESOURCE{{settings.js}:{SettingsSaved}:{Saved Successfully.}}\", \"s\");\r\n            } else {\r\n                // var msg = \"RESOURCE{{settings.js}:{SettingsSaveFailed}:{Failed to save: {0}}}\";\r\n                // cpf.alert(msg.replace(\"{0}\", result.message), \"e\");\r\n                cpf.alert(\"RESOURCE{{settings.js}:{SettingsSaveFailed}:{Failed to save the settings.}}\", \"e\");\r\n            }\r\n        };\r\n\r\n        var fail = function (data, textStatus, jqXHR) {\r\n            cpf.spin(false);\r\n            $button.removeClass(\"disabled\");\r\n            //var msg = \"RESOURCE{{settings.js}:{SettingsSaveFailed}:{Failed to save: {0}}}\";\r\n            //cpf.alert(msg.replace(\"{0}\", textStatus), \"e\");\r\n            if (data[\"unhandled\"]) {\r\n                cpf.alert(\"RESOURCE{{settings.js}:{SettingsSaveFailed}:{Failed to save the settings.}}\", \"e\");\r\n            }\r\n        };\r\n\r\n        $button.addClass(\"disabled\");\r\n        cpf.spin();\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/user/alerting\", success: success, errorCallback: fail, data: data });\r\n    }\r\n};\r\n\r\nsettings.homepage = {\r\n    load: function () {\r\n        // two way binding between home page url and apps list\r\n        $(\"#apps-list li input.settings-app-radio\").on(\"change\", function () {\r\n            var selectedUrl = $(\"#apps-list li input.settings-app-radio[type='radio']:checked\").gcop().getAttribute(\"data-app-url\");\r\n            $(\"#defaultHomePage-input\").val(selectedUrl);\r\n        });\r\n\r\n        $(\"#defaultHomePage-input\").on(\"change\", function () {\r\n            $(\"#apps-list li input.settings-app-radio[type='radio']:checked\").prop('checked', false);\r\n            var urlValue = $(\"#defaultHomePage-input\").val();\r\n            var correspondingCheckbox = $(\"#apps-list li input.settings-app-radio[type='radio'][data-app-url='\" + urlValue + \"']\");\r\n            if (correspondingCheckbox.length > 0) {\r\n                correspondingCheckbox.prop('checked', true);\r\n            }\r\n        });\r\n\r\n        // if home page is set to one of the app select the radio button\r\n        $(\"#apps-list li input.settings-app-radio[type='radio'][data-app-url='\" + $(\"#defaultHomePage-input\").val() + \"']\").prop('checked', true);\r\n\r\n        $(\"#save\").on(\"click\", function () {\r\n            settings.homepage.save($(this));\r\n            return false;\r\n        });\r\n    },\r\n\r\n    save: function($button) {\r\n\r\n        if ($button.hasClass(\"disabled\")) {\r\n            return;\r\n        }\r\n\r\n        var data = {\r\n            url: $(\"#defaultHomePage-input\").val()\r\n        };\r\n\r\n        var success = function(result, textStatus, jqXHR) {\r\n            cpf.spin(false);\r\n            $button.removeClass(\"disabled\");\r\n            if (result.success) {\r\n                cpf.alert(\"Saved Successfully.\", \"s\");\r\n            } else {\r\n                cpf.alert(\"Failed to save the settings. Please try again, or contact support.\", \"e\");\r\n            }\r\n        };\r\n\r\n        var errorCallback = function(data, textStatus, jqXHR) {\r\n            cpf.spin(false);\r\n            $button.removeClass(\"disabled\");\r\n            if (data[\"unhandled\"]) {\r\n                cpf.alert(\"Failed to save the settings. Please try again, or contact support.\", \"e\");\r\n            }\r\n        };\r\n\r\n        $button.addClass(\"disabled\");\r\n        cpf.spin();\r\n        cpf.ajax({\r\n            url: APPLICATIONPATH + \"cpf/user/updateuserhomepage\",\r\n            success: success,\r\n            errorCallback: errorCallback,\r\n            data: data\r\n        });\r\n    }\r\n};\r\n\r\nvar userpreferences = {\r\n    user: \"\",\r\n\r\n    load: function () {\r\n\r\n        if (userpreferences.user !== \"\") {\r\n            cpf.title.set(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{StatusBar_Settings}:{My Settings}}\" + \" > \" + userpreferences.user);\r\n        }\r\n        else {\r\n            cpf.title.set(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{StatusBar_Settings}:{My Settings}}\");\r\n        }\r\n\r\n        $(\"#save\").on(\"click\", function () {\r\n            userpreferences.save($(this));\r\n            return false;\r\n        });\r\n    },\r\n\r\n    getUserPerferencesData: function ($item) {\r\n        try {\r\n\r\n            var $defaultPage = $item.find(\"input[type=radio]:checked\");\r\n            var appName = $defaultPage.attr(\"data-app-name\");\r\n            var appUrl = $defaultPage.attr(\"app-url\");\r\n\r\n            // set as empty if this is a new preference\r\n            if (appName == null || appName == undefined) {\r\n                appName = \"\";\r\n                appUrl = \"\";\r\n            }\r\n\r\n            var data = {\r\n                key: appName,\r\n                value: appUrl\r\n            };\r\n\r\n            return data;\r\n        } \r\n        catch (err) {\r\n        }\r\n\r\n    },\r\n\r\n    save: function ($button) {\r\n\r\n        if ($button.hasClass(\"disabled\")) {\r\n            return;\r\n        }\r\n\r\n        var data = userpreferences.getUserPerferencesData($(\"#user-apps-list\"));\r\n\r\n        var success = function (result, textStatus, jqXHR) {\r\n            cpf.spin(false);\r\n            $button.removeClass(\"disabled\");\r\n\r\n            if (result.success) {\r\n                cpf.alert(\"RESOURCE{{settings.js}:{SettingsSaved}:{Saved Successfully.}}\", \"s\");\r\n            } else {\r\n                cpf.alert(\"RESOURCE{{settings.js}:{SettingsSaveFailed}:{Failed to save the settings.}}\", \"e\");\r\n            }\r\n        };\r\n\r\n        var fail = function (data, textStatus, jqXHR) {\r\n            cpf.spin(false);\r\n            $button.removeClass(\"disabled\");\r\n            if (data[\"unhandled\"]) {\r\n                cpf.alert(\"RESOURCE{{settings.js}:{SettingsSaveFailed}:{Failed to save the settings.}}\", \"e\");\r\n            }\r\n        };\r\n\r\n        $button.addClass(\"disabled\");\r\n        cpf.spin();\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/user/updateuserpreferences\", success: success, errorCallback: fail, data: data });\r\n    }\r\n};\r\n\r\n/**\r\n * Wrap access to UserThemeOptions with IIF module\r\n * author piotrb\r\n */\r\nsettings.themeOptions = (function($, cpf, applicationPath, userpreferences, undefined) {\r\n    'use strict';\r\n    // endpoint for requests\r\n    var userThemeUpdateUrl = 'cpf/user/updateusertheme';\r\n    // key name for theme options\r\n    var themeOptionsKeyName = \"themevirtualfilepath\";\r\n    var themeDataKeyName = \"theme-virtual-file-path\";\r\n    var themeDefaultValue = \"-1\";\r\n    // container\r\n    var themesOptionsSelector = \"#user-themes-options\";\r\n    // initialize client code (delegated to hosting app\r\n    function load() {\r\n        userpreferences && userpreferences.load\r\n        $(\"#save\").on(\"click\", function() {\r\n            save($(this));\r\n            return false;\r\n        });\r\n    }\r\n    // reads information from UI controls\r\n    function getUserPerferencesData($item) {\r\n        try {\r\n            var $selectedTheme = $item.find(\"input[name=\\\"themes\\\"][type=radio]:checked\");\r\n            var themeVirtualFilePath = $selectedTheme.data(themeDataKeyName);\r\n            if (themeVirtualFilePath == null || themeVirtualFilePath == undefined) {\r\n                themeVirtualFilePath = themeDefaultValue;\r\n            }\r\n            var data = {\r\n                key: themeOptionsKeyName,\r\n                value: themeVirtualFilePath\r\n            };\r\n            return data;\r\n        } catch (err) {}\r\n    }\r\n    //\r\n    function save($button) {\r\n        if ($button.hasClass(\"disabled\")) {\r\n            return;\r\n        }\r\n        var data = getUserPerferencesData($(themesOptionsSelector));\r\n        var success = function(result, textStatus, jqXHR) {\r\n            cpf.spin(false);\r\n            $button.removeClass(\"disabled\");\r\n            if (result.success) {\r\n                cpf.alert(\"Saved Successfully.\", \"s\");\r\n            } else {\r\n                cpf.alert(\"Failed to save the settings. Please try again, or contact support.\", \"e\");\r\n            }\r\n        };\r\n        var errorCallback = function(data, textStatus, jqXHR) {\r\n            cpf.spin(false);\r\n            $button.removeClass(\"disabled\");\r\n            if (data[\"unhandled\"]) {\r\n                cpf.alert(\"Failed to save the settings. Please try again, or contact support.\", \"e\");\r\n            }\r\n        };\r\n        $button.addClass(\"disabled\");\r\n        cpf.spin();\r\n        cpf.ajax({\r\n            url: applicationPath + userThemeUpdateUrl,\r\n            success: success,\r\n            errorCallback: errorCallback,\r\n            data: data\r\n        });\r\n    }\r\n    return {\r\n        load: load\r\n    }\r\n})(jQuery, cpf, APPLICATIONPATH, userpreferences);\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/translation.js\n * ======================================== */\n\n﻿cpf.translation = {\r\n    bindEvents: function ($container) {\r\n        if (typeof $container === \"undefined\" || $container == null) {\r\n            $container = $(\"body\");\r\n        }\r\n        var $translationLanguageSelect = $container.find(\"select.translation-languages\");\r\n        $('.translation-trigger').off('click').on('click', function(e) {\r\n            e.preventDefault();\r\n            e.stopPropagation();\r\n            $(this).focus();\r\n        });\r\n        $container.find(\".translation-trigger\").popover({\r\n            title: \"Translation\",\r\n            content: \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{Translation_Loading}:{Loading...}}\",\r\n            trigger: \"focus\",\r\n            placement: function (context, source) {\r\n                var pos = $(source).offset();\r\n                if (pos.left < 170) return 'right';\r\n                if (pos.left > $(window).width() - 170) return 'left';\r\n                else return 'top';\r\n            }\r\n        });\r\n        $container.find(\".translation-trigger\").off(\"click.active\").on(\"click.active\", function() {\r\n            var self = this;\r\n            var data = cpf.translation.getData($(self));\r\n            var success = function(result) {\r\n                var content = result.data.success ? result.data.responseText : \"RESOURCE{{cpf.ui.js}:{TranslationFailedMessage}:{Attempt to translate failed.}}\";\r\n                $(self).attr(\"data-content\", content);\r\n                $(self).popover(\"show\");\r\n            };\r\n            var fail = function(result) {\r\n                $(self).attr(\"data-content\", \"RESOURCE{{cpf.ui.js}:{TranslationFailedMessage}:{Attempt to translate failed.}}\");\r\n                $(self).popover(\"show\");\r\n            };\r\n            if (data.sourceText === \"\") {\r\n                $(self).attr(\"data-content\", \"RESOURCE{{cpf.ui.js}:{NothingToTranslate}:{No text to translate.}}\");\r\n                $(self).popover(\"show\");\r\n            } else {\r\n                cpf.ajax({ url: APPLICATIONPATH + \"cpf/core/translate\", success: success, errorCallback: fail, data: data });\r\n            }\r\n        }).on('hidden.bs.popover', function() {\r\n            $(this).attr(\"data-content\", \"Loading...\");\r\n        });\r\n        $translationLanguageSelect.off(\"change\").on(\"change\", function () {\r\n            var success = function (result) {\r\n                var content = result.data.success ? result.data.responseText : \"RESOURCE{{cpf.ui.js}:{TranslationFailedMessage}:{Attempt to translate failed.}}\";\r\n                $(self).attr(\"data-content\", content);\r\n                $(self).popover(\"show\");\r\n            };\r\n            var fail = function (result) {\r\n                $(self).attr(\"data-content\", \"RESOURCE{{cpf.ui.js}:{TranslationFailedMessage}:{Attempt to translate failed.}}\");\r\n            };\r\n            var data = cpf.translation.getData($(this));\r\n            cpf.ajax({ url: APPLICATIONPATH + \"cpf/core/translate\", success: success, errorCallback: fail, data: data });\r\n            return false;\r\n        });\r\n    },\r\n    getData: function ($control) {\r\n        var data = {};\r\n        var targetID = $control.attr(\"data-target\");\r\n        data.sourceText = $(\"#\" + targetID).val();\r\n        data.fromLanguage = \"\";\r\n        data.toLanguage = $(\"#language-code\").val().split(\"-\")[0]; //$control.val();\r\n        data.targetID = targetID;\r\n        return data;\r\n    }\r\n};\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/usergroups.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\n;\r\nvar userGroups = {\r\n    redirect: function (url, isBackButton) {\r\n        if (isBackButton) {\r\n            if ($.trim(url).length > 0 && url != null && typeof (url) != undefined) {\r\n                window.location = url;\r\n            }\r\n        } else {\r\n\r\n            // if they checked a box and clicked edit\r\n            var editButtonClicked = false;\r\n            var $editButton = $(\"#user-group-button-edit\");\r\n            if ($editButton.length > 0) {\r\n                if ($editButton.gcop().hasClass(\"selected\")) {\r\n                    editButtonClicked = true;\r\n                }\r\n            }\r\n\r\n            var $checkedDataElement = $($(\"#page .search-results .zugo-item .item-selection-column input:checked\").parent().parent());\r\n            var drill = url;\r\n\r\n            // looks like in changeset 12747 on 2016-10-14 a guid was added to the search id to support multiples on a page. Therefore we need to find the id as we cannot index to it\r\n            var prop;\r\n            for (prop in SEARCHES) {\r\n                if (prop.indexOf(\"systemcpfsearchmemberssearch\") > -1) {\r\n                    break;\r\n                }\r\n            }\r\n\r\n            var payload = {};\r\n            payload.ActionType = \"DrillDown\";\r\n            payload.searchVirtualFilePath = SEARCHES[prop].searchVirtualFilePath;\r\n            //payload.containerName = \"CPF.Core\";\r\n            //payload.searchName = \"GroupsExcludingEveryone\";\r\n            //payload.searchType = \"Search\";\r\n            //payload.definitionName = null;\r\n            payload.data = $checkedDataElement.gcop().getAttribute(\"data-row\");\r\n\r\n            // if there is a preview, then show it. If not, just drill.\r\n            $checkedDataElement.gcop().addClass(\"selected\");\r\n\r\n            // redirect to drill down url if container or search builder definition is not set. \r\n            SEARCHES[prop].getNavigationTrack(drill, payload);\r\n        }\r\n    }\r\n};\r\n\r\nuserGroups.list = {\r\n    load: function () {\r\n        // disable ribbon buttons that cannot be used.\r\n        userGroups.list.enableRibbonButtons({ selectedRows: [] });\r\n\r\n        $(\"#back-button\").on(\"click\", function () {\r\n            userGroups.redirect(APPLICATIONPATH + \"cpf/core/AllApps\", true);\r\n            return false;\r\n        });\r\n\r\n        $(document.body).on(\"selected\", \".search-results\", function (event, eventArgs) {\r\n            userGroups.list.enableRibbonButtons(eventArgs);\r\n        });\r\n\r\n        $(\"#user-group-button-edit\").on(\"click\", function () {\r\n            if (!$(this).hasClass(\"disabled\")) {\r\n                cpf.spin();\r\n                var url = $(\".search-results .results-container .item-selection-column input[type=checkbox]:checked\").parents(\".zugo-item:first\").attr(\"drillDownUrl\");\r\n                userGroups.redirect(url);\r\n            }\r\n            return false;\r\n        });\r\n\r\n        $(\"#user-group-button-delete\").on(\"click\", function () {\r\n            if (!$(this).hasClass(\"disabled\")) {\r\n                if (userGroups.list.getCheckedItemsCount() > 0) {\r\n                    ConfirmationBox.Show($(\"#delete-user-group-confirmation\"), userGroups.list.deleteUserGroup);\r\n                }\r\n                else {\r\n                    cpf.alert(\"RESOURCE{{userGroups.js}:{SelectRowToDelete}:{Please select a row to delete a permission group.}}\", \"i\");\r\n                }\r\n            }\r\n            return false;\r\n        });\r\n    },\r\n    enableRibbonButtons: function (eventArgs) {\r\n        var selected = eventArgs.selectedRows.length;\r\n        if (selected > 0 && selected < 2) {\r\n            $(\"#user-group-button-delete\").removeClass(\"disabled\");\r\n            $(\"#user-group-button-edit\").removeClass(\"disabled\");\r\n        }\r\n        else if (selected > 1) {\r\n            $(\"#user-group-button-delete\").removeClass(\"disabled\");\r\n            $(\"#user-group-button-edit\").addClass(\"disabled\");\r\n        } else {\r\n            $(\"#user-group-button-edit\").addClass(\"disabled\");\r\n            $(\"#user-group-button-delete\").addClass(\"disabled\");\r\n        }\r\n    },\r\n    getCheckedItemsCount: function () {\r\n        return $(\".search-results .results-container .item-selection-column input[type=checkbox]:checked\").length;\r\n    },\r\n\r\n    deleteUserGroup: function () {\r\n        var success = function () {\r\n            //cpf.alert(\"RESOURCE{{userGroups.js}:{UserGroupDeleted}:{User group deleted successfully.}}\", \"s\");\r\n            //userGroups.redirect(APPLICATIONPATH + \"cpf/usergroup\");\r\n        };\r\n\r\n        var fail = function (data, textStatus, jqXHR) {\r\n\r\n            //var msg = \"RESOURCE{{userGroups.js}:{FailedToDeleteUserGroup}:{Failed to delete {0}.}}\";\r\n            //cpf.alert(msg.replace(\"{0}\", textStatus), \"e\");\r\n            if (data[\"unhandled\"]) {\r\n                cpf.alert(\"RESOURCE{{userGroups.js}:{FailedToDeleteUserGroup}:{Failed to delete the permission group(s).}}\", \"e\");\r\n            }\r\n        };\r\n        var groupIds = userGroups.list.getUserGroupIds();\r\n        var groupNames = userGroups.list.getUserGroupNames();\r\n        // get the checked items and send them to the server.\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/usergroup/remove\", success: success, errorCallback: fail, data: { \"userGroupIds\": groupIds, \"userGroupNames\": groupNames } });\r\n    },\r\n    getUserGroupIds: function () {\r\n        var groupIds = [];\r\n        var checkedItemCount = userGroups.list.getCheckedItemsCount();\r\n        for (i = 0; i < checkedItemCount; i++) {\r\n            var jsonString = $(\".search-results .results-container .item-selection-column input[type=checkbox]:checked:eq(\" + i + \")\").parents(\".zugo-item:first\").attr(\"data-row\");\r\n            var selectedItem = JSON.parse(jsonString);\r\n            for (j = 0; j < selectedItem.length; j++) {\r\n                if (selectedItem[j][\"name\"] == \"GroupID\") {\r\n                    groupIds.push(selectedItem[j][\"value\"]);\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n\r\n        return groupIds.join(\",\");\r\n    },\r\n    getUserGroupNames: function () {\r\n        var groupIds = [];\r\n        var checkedItemCount = userGroups.list.getCheckedItemsCount();\r\n        for (i = 0; i < checkedItemCount; i++) {\r\n            var jsonString = $(\".search-results .results-container .item-selection-column input[type=checkbox]:checked:eq(\" + i + \")\").parents(\".zugo-item:first\").attr(\"data-row\");\r\n            var selectedItem = JSON.parse(jsonString);\r\n            for (j = 0; j < selectedItem.length; j++) {\r\n                if (selectedItem[j][\"name\"] == \"Name\") {\r\n                    groupIds.push(selectedItem[j][\"value\"]);\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n\r\n        return groupIds.join(\",\");\r\n    }\r\n};\r\n\r\nuserGroups.edit = {\r\n    load: function () {\r\n\r\n        $(\"#user-group-button-save\").on(\"click\", function () {\r\n            $(\"#group-details\").validate({\r\n                success: function () {\r\n                    userGroups.edit.save();\r\n                }\r\n            });\r\n            return false;\r\n        });\r\n\r\n        userGroups.edit.initialiseMenu();\r\n        autocompleteGrid.initChanges(\"groups-grid\");\r\n        autocompleteGrid.initChanges(\"users-grid\");\r\n        autocompleteGrid.initChanges(\"unregistered-users-grid\");\r\n\r\n        //#3196 CPF Header\r\n        if ($(\"#user-group-name\").val() !== \"\") {\r\n            cpf.title.set(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{UserGroup}:{Permission Group}}\" + \" > \" + $(\"#user-group-name\").val());\r\n        }\r\n        else {\r\n            cpf.title.set(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{UserGroup}:{Permission Group}}\");\r\n        }\r\n\r\n        permissions.resetView($(\"#usergroup-permissions-button\"));\r\n    },\r\n    setMenuItemSelected: function ($item) {\r\n        $(\"#user-group-menu li a.selected\").removeClass(\"selected\");\r\n        $item.addClass(\"selected\");\r\n    },\r\n    initialiseMenu: function () {\r\n\r\n        $(\"#permission-group\").hide();\r\n        $(\"#new-permission\").hide();\r\n\r\n        $(\"#usergroup-details-button\").on(\"click\", function () {\r\n            var isValid = $(\"#group-details\").validate();\r\n            if (isValid) {\r\n\r\n                userGroups.edit.setMenuItemSelected($(\"#usergroup-details-button\"));\r\n\r\n                autocompleteGrid.hideWindow($(\"#groups-grid\"));\r\n                $(\"#groups-wrapper\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#users-grid\"));\r\n                $(\"#users-wrapper\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#unregistered-users-grid\"));\r\n                $(\"#unregistered-users-wrapper\").hide();\r\n\r\n                //$(\"#group-details-labels\").hide();\r\n                $(\"#group-details\").show();\r\n\r\n                $(\"#user-group-permissions-wrapper\").hide();\r\n                $(\"#permission-group\").hide();\r\n                $(\"#new-permission\").hide();\r\n\r\n                autocompleteGrid.toggleSortButtons(false);\r\n            }\r\n            return false;\r\n        });\r\n\r\n        $(\"#usergroup-groups-button\").on(\"click\", function () {\r\n            var isValid = $(\"#group-details\").validate();\r\n            if (isValid) {\r\n                autocompleteGrid.updateInputLabel($(\"#groups-grid\"), $(\"#user-group-name\"));\r\n                userGroups.edit.setMenuItemSelected($(\"#usergroup-groups-button\"));\r\n                $(\"#group-details\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#unregistered-users-grid\"));\r\n                $(\"#unregistered-users-wrapper\").hide();\r\n\r\n                autocompleteGrid.showWindow($(\"#users-grid\"));\r\n                $(\"#users-wrapper\").hide();\r\n\r\n                $(\"#user-group-permissions-wrapper\").hide();\r\n                $(\"#permission-group\").hide();\r\n                $(\"#new-permission\").hide();\r\n\r\n                autocompleteGrid.showWindow($(\"#groups-grid\"));\r\n                $(\"#groups-wrapper\").show();\r\n\r\n                userGroups.edit.updateGroupDetails();\r\n                autocompleteGrid.toggleZugoFeatures($(\"#groups-grid\"));\r\n            }\r\n            return false;\r\n        });\r\n\r\n\r\n        $(\"#usergroup-users-button\").on(\"click\", function () {\r\n            var isValid = $(\"#group-details\").validate();\r\n            if (isValid) {\r\n                autocompleteGrid.updateInputLabel($(\"#users-grid\"), $(\"#user-group-name\"));\r\n                userGroups.edit.setMenuItemSelected($(\"#usergroup-users-button\"));\r\n                $(\"#group-details\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#groups-grid\"));\r\n                $(\"#groups-wrapper\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#unregistered-users-grid\"));\r\n                $(\"#unregistered-users-wrapper\").hide();\r\n\r\n                autocompleteGrid.showWindow($(\"#users-grid\"));\r\n                $(\"#users-wrapper\").show();\r\n\r\n                $(\"#user-group-permissions-wrapper\").hide();\r\n                $(\"#permission-group\").hide();\r\n                $(\"#new-permission\").hide();\r\n\r\n                userGroups.edit.updateGroupDetails();\r\n                autocompleteGrid.toggleZugoFeatures($(\"#users-grid\"));\r\n            }\r\n            return false;\r\n        });\r\n        \r\n        $(\"#usergroup-permissions-button\").on(\"click\", function () {\r\n\r\n            $(\"#permission-group\").show();\r\n            var isValid = $(\"#group-details\").validate();\r\n            if (isValid) {\r\n                userGroups.edit.setMenuItemSelected($(\"#usergroup-permissions-button\"));\r\n                $(\"#group-details\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#users-grid\"));\r\n                $(\"#users-wrapper\").hide();\r\n\r\n                autocompleteGrid.hideWindow($(\"#unregistered-users-grid\"));\r\n                $(\"#unregistered-users-wrapper\").hide();\r\n            }\r\n            $(\"#permission-group\").show();\r\n            $(\"#new-permission\").show();\r\n            permissions.getUserOrGroupPermissions();\r\n            autocompleteGrid.toggleSortButtons(false);\r\n        });\r\n    },\r\n\r\n    getUserGroupData: function () {\r\n        var groupsChanges = autocompleteGrid.getAutoChanges($(\"#groups-grid\"));\r\n        var userChanges = autocompleteGrid.getAutoChanges($(\"#users-grid\"));\r\n        var unregisteredChanges = autocompleteGrid.getAutoChanges($(\"#unregistered-users-grid\"));\r\n\r\n        var data = {\r\n            id: $(\"#user-group-id\").val(),\r\n            name: $(\"#user-group-name\").val(),\r\n            description: $(\"#user-group-description\").val(),\r\n            groups:groupsChanges,\r\n            users: userChanges,\r\n            unregisteredUsers: unregisteredChanges\r\n            //currentUsers: userGroups.edit.currentUsers\r\n        };\r\n\r\n        return data;\r\n    },\r\n    save: function () {\r\n        if ($(this).hasClass(\"disabled\")) {\r\n            return false;\r\n        }\r\n        $cpf.alert(\"RESOURCE{{Sysrepublic.Secure.UI.Areas.Cpf.CpfResources}:{Saving}:{Saving...}}\", \"p\");\r\n        $(\"#user-group-button-save\").addClass(\"disabled\");\r\n        var userGroupData = userGroups.edit.getUserGroupData();\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/usergroup/save\", dataType: \"json\", type: \"POST\", success: userGroups.edit.saveSuccess, errorCallback: userGroups.edit.saveFailed, data: userGroupData });\r\n    },\r\n    saveSuccess: function (result, textStatus, jqXHR) {\r\n        $(\"#user-group-button-save\").removeClass(\"disabled\");\r\n        cpf.spin(false);\r\n\r\n        //        if (result.success == \"true\") {\r\n        //            $(\"#user-group-id\").val(result[\"data\"].userGroupId);\r\n        //            cpf.alert(result[\"message\"], \"s\");\r\n\r\n        // fire an event to say we saved ok, in case we are waiting to navigate away\r\n        $(\"body\").trigger(\"saved\");\r\n        //            userGroups.redirect(APPLICATIONPATH + \"cpf/usergroup\");\r\n        //        } else {\r\n        //            userGroups.edit.saveFailed(null, result.message, null);\r\n        //        }\r\n    },\r\n    saveFailed: function (data, message, exception) {\r\n        cpf.spin(false);\r\n        if (data[\"unhandled\"]) {\r\n            cpf.alert(\"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{SaveUserGroupFailed}:{Failed to to delete the permission group.}}\", \"e\");\r\n        }\r\n        $(\"#user-group-button-save\").removeClass(\"disabled\");\r\n    },\r\n    updateGroupDetails: function () {\r\n        $(\"#user-group-name-text\").html(DOMPurify.sanitize($(\"#user-group-name\").val()));\r\n        $(\"#user-group-description-text\").html(DOMPurify.sanitize($(\"#user-group-description\").val()));\r\n    }\r\n};\r\n\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/validation.js\n * ======================================== */\n\n﻿// @ts-check\r\nvar validation = {\r\n    isDraft: false,\r\n    timeSpanRegex: /^((([0-1][0-9])|([2][0-3])):(([0-5][0-9])|([2][0-3])):(([0-5][0-9])|([2][0-3])))$/,\r\n    emailRegex: /^(?:[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+)*|\"(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21\\x23-\\x5b\\x5d-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])*\")@(?:(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?|\\[(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?|[a-zA-Z0-9-]*[a-zA-Z0-9]:(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21-\\x5a\\x53-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])+)\\])$/,\r\n\r\n    getValidationType: function (typeName) {\r\n\r\n        for (var i = 0, ii = validationTypes.length; i < ii; i++) {\r\n\r\n            if (validationTypes[i].name === typeName) {\r\n                return validationTypes[i];\r\n            }\r\n        }\r\n    },\r\n\r\n    set: function ($element, isValid, errorMsg, validationArray) {\r\n\r\n        // finds and return validation container\r\n        var $errorcontainer = validation.getErrorContainer($element);\r\n\r\n        var controlName = $element.gcop().getAttribute(\"id\");\r\n\r\n        if (!controlName && ($element.is(\"select\") || $element.gcop().getAttribute(\"type\") == \"radio\" || $element.gcop().getAttribute(\"type\") == \"checkbox\")) {\r\n            controlName = $element.gcop().getAttribute(\"name\");\r\n        }\r\n\r\n        var parentIsTable = false;\r\n\r\n        if (USEDYNOVIEW) {\r\n\r\n            if ($element.hasClass(\"dyno-control\")) {\r\n                if ($element.attr(\"data-parent-type\") === \"Table\") {\r\n                    controlName = $element.closest(\"td\").attr(\"data-id\");\r\n                } else if ($element.attr(\"data-parent-type\") === \"ResponsiveTable\") {\r\n                    controlName = $element.closest(\"div.responsiveRowInside\").attr(\"data-id\");\r\n                }\r\n                parentIsTable = true;\r\n            } else {\r\n                if ($element.closest(\".dyno-control\").attr(\"data-parent-type\") === \"Table\") {\r\n                    controlName = $element.closest(\"td\").attr(\"data-id\");\r\n                } else if ($element.closest(\".dyno-control\").attr(\"data-parent-type\") === \"ResponsiveTable\") {\r\n                    controlName = $element.closest(\".dyno-control\").closest(\"div.responsiveRowInside\").attr(\"data-id\");\r\n                }\r\n                parentIsTable = true;\r\n            }\r\n        }\r\n\r\n        // return how many times element is inserted in validation array as invalid\r\n        var invalidElementLength = 0;\r\n\r\n        if (parentIsTable) {\r\n            invalidElementLength = (typeof validationArray === 'undefined') ? 1 : $.grep(validationArray, function (n) { return n.headerId == controlName && n.valid == false; }).length;\r\n        } else {\r\n            invalidElementLength = (typeof validationArray === 'undefined') ? 1 : $.grep(validationArray, function (n) { return n.name == controlName && n.valid == false; }).length;\r\n        }\r\n\r\n        // it does not set error container if it is valid and validation array contains the element as invalid\r\n        if ((isValid && invalidElementLength > 0) == false) {\r\n            // set validation message in tooltip, style and bind events of tool tip\r\n            validation.setErrorContainer($errorcontainer, $element, errorMsg, isValid, invalidElementLength);\r\n        }\r\n\r\n        // set the style of the element\r\n        validation.setElementStyle($element, isValid);\r\n\r\n        return false;\r\n    },\r\n\r\n    reset: function ($control) {\r\n\r\n        var $items = [];\r\n\r\n        for (var i = 0, vlength = validationTypes.length; i < vlength; i++) {\r\n            var validationAttribute = validationTypes[i].dataattribute;\r\n\r\n            if (USEDYNOVIEW) {\r\n                var attributeFound = validation.hasAttribute($control, validationAttribute);\r\n                // input is specified \r\n                if (attributeFound) {\r\n                    $items.push($control[0]);\r\n                }\r\n            }\r\n            else {\r\n                var attributeFound = validation.hasAttribute($control, validationAttribute);\r\n                if (attributeFound) {\r\n                    $items.push($control[0]);\r\n                }\r\n                else {\r\n                    // inputs are in child elements\r\n                    $items = $control.find(\"input[\" + validationAttribute + \"],select[\" + validationAttribute + \"],textarea[\" + validationAttribute + \"], .panel-validation[\" + validationAttribute + \"]\");\r\n                }\r\n            }\r\n\r\n            for (var j = 0, jj = $items.length; j < jj; j++) {\r\n                validation.set($($items[j]), true, \"\", []);\r\n            }\r\n        }\r\n    },\r\n\r\n    getControlIdentifier: function ($control) {\r\n        var controlId = $control.gcop().getAttribute('id');\r\n        var controlName = $control.gcop().getAttribute('name');\r\n\r\n        if ((controlId === undefined || controlId == \"\") && controlName !== undefined && controlName.length > 0) {\r\n            return controlName;\r\n        }\r\n        else {\r\n            return controlId;\r\n        }\r\n    },\r\n\r\n    hasAttribute: function ($control, name) {\r\n        return $control.gcop().hasAttribute(name);\r\n    },\r\n\r\n    getErrorContainer: function ($element) {\r\n        var controlIdentifier = validation.getControlIdentifier($element);\r\n        var $dynoControl = validation.getDynoControl($element);\r\n        if (USEDYNOVIEW) {\r\n            var parentType = $dynoControl.gcop().getAttribute(\"data-parent-type\");\r\n            if (parentType === \"Table\") {\r\n                var $td = $dynoControl.closest(\"td\");\r\n                var $tr = $td.closest(\"tr.dyno-table-row\");\r\n                var $table = $tr.closest(\"table\");\r\n                //var columnIndex = $tr.index($td);\r\n\r\n                var columnIndex = $td.index();\r\n\r\n                $errorcontainer = $table.find(\"thead tr th:eq(\" + columnIndex + \") span.validation-wrapper button\");\r\n            }\r\n            else if ($dynoControl.gcop().getAttribute(\"data-parent-type\") == \"autocomplete-grid\") {\r\n\r\n            }\r\n            else if ($dynoControl.attr(\"data-dyno-type\") === \"datetime\") {\r\n                $errorcontainer = $(\"#\" + $dynoControl.gcop().getAttribute(\"id\") + \"-field-validation\");\r\n            }\r\n            else {\r\n                $errorcontainer = $(\"#\" + validation.getControlIdentifier($element) + \"-field-validation\");\r\n            }\r\n        } else {\r\n            var controlType = $dynoControl.data('dynoType') || '';\r\n            if (controlType === \"date\" || controlType === 'datetime') {\r\n                $errorcontainer = $(\"#\" + $dynoControl.gcop().getAttribute(\"id\") + \"-field-validation\");\r\n            } else {\r\n                $errorcontainer = $(\"#\" + validation.getControlIdentifier($element) + \"-field-validation\");\r\n            }\r\n        }\r\n\r\n        return $errorcontainer;\r\n    },\r\n\r\n    setErrorContainer: function ($errorcontainer, $element, errorMsg, isValid, invalidElementLength) {\r\n        // set error message\r\n        var $gcopErrorContainer = $errorcontainer.gcop();\r\n        $gcopErrorContainer.setAttribute(\"data-valmsg-text\", errorMsg);\r\n        $gcopErrorContainer.setAttribute(\"title\", errorMsg);\r\n\r\n        if (isValid) {\r\n            if (invalidElementLength < 1) {\r\n                // show required indicator\r\n                validation.showRequiredIndicator($errorcontainer);\r\n\r\n                // remove invalid input class and set valid input class to the validation help\r\n                $gcopErrorContainer.removeClass('field-validation-error');\r\n                $gcopErrorContainer.addClass('field-validation-valid');\r\n\r\n                // unbind click event of the validation help\r\n                $errorcontainer.off(\"click\");\r\n            }\r\n        }\r\n        else {\r\n            // hide required indicator\r\n            validation.hideRequiredIndicator($errorcontainer);\r\n\r\n            // remove valid input class and set invalid input class to the validation help\r\n            $gcopErrorContainer.removeClass('field-validation-valid');\r\n            $gcopErrorContainer.addClass('field-validation-error')\r\n        }\r\n    },\r\n\r\n    getDynoControl: function ($element) {\r\n        // return dyno control\r\n        var $dynoControl = $element;\r\n        if (validation.hasAttribute($element, \"dyno-control\") == false) {\r\n            $dynoControl = $element.closest(\"div.dyno-control\");\r\n        }\r\n        return $dynoControl;\r\n    },\r\n\r\n    hideRequiredIndicator: function ($errorcontainer) {\r\n        // hide required indicator\r\n        $errorcontainer.parent().find(\"span.required\").hide();\r\n    },\r\n\r\n    showRequiredIndicator: function ($errorcontainer) {\r\n        // show required indicator\r\n        $errorcontainer.parent().find(\"span.required\").show();\r\n    },\r\n\r\n    setDynoControlStyle: function ($element, isValid) {\r\n        var elementName;\r\n        var $tag = $element;\r\n        var tagName = $tag.tag();\r\n        if (isValid) {\r\n            if (tagName == \"TEXTAREA\") {\r\n                $element.css(\"border\", \"\");\r\n            }\r\n            else if ($tag.isRadioOrCheckBox()) {\r\n                var elementname = $tag.getAttribute(\"name\");\r\n                $(\"input[name='\" + elementname + \"']\").css(\"border\", \"\").css(\"outline\", \"\");\r\n\r\n            } else if ($tag.attr(\"data-dyno-type\") === \"auto-complete\") {\r\n                $tag.find(\".search\").css(\"border\", \"\").css(\"outline\", \"\");\r\n            }\r\n            else {\r\n                $element.closest(\"div.validation-style-wrapper\").css(\"border\", \"\");\r\n            }\r\n        }\r\n        else {\r\n            if (tagName == \"TEXTAREA\") {\r\n                $element.css(\"border\", \"2px solid red\");\r\n            }\r\n            else if ($tag.isRadioOrCheckBox()) {\r\n                var elementname = $tag.attr(\"name\");\r\n                $(\"input[name='\" + elementname + \"']\").css(\"border\", \"2px solid red\").css(\"outline\", \"2px solid red\");\r\n\r\n            } else if ($tag.attr(\"data-dyno-type\") === \"auto-complete\") {\r\n                $tag.find(\".search\").css(\"border\", \"2px solid red\").css(\"outline\", \"2px solid red\");\r\n            }\r\n            else {\r\n                var $wrapper = $element.closest(\"div.validation-style-wrapper\");\r\n                $wrapper.css(\"border\", \"2px solid red\"); //.css(\"outline\", \"2px solid red\");\r\n            }\r\n        }\r\n    },\r\n\r\n    setDefaultControlStyle: function ($element, isValid) {\r\n        var $tag = $element;\r\n        var $parent = $element.parent();\r\n        var $grandParent = $element.parent().parent();\r\n        var $greatParent = $element.parent().parent().parent();\r\n\r\n        if (isValid) {\r\n\r\n            // new currency validation\r\n            if ($greatParent.hasClass(\"currency-container\") && $greatParent.hasClass(\"invalid\")) {\r\n                $greatParent.removeClass(\"invalid\");\r\n            }\r\n            else if ($tag.gcop().isRadioOrCheckBox()) {\r\n                $grandParent.removeClass('invalid');\r\n            }\r\n            else if ($tag.attr(\"data-val-isdatetime\") !== undefined) {\r\n                $tag.find(\"select.date-picker-part\").parent().removeClass(\"invalid\");\r\n                $tag.find(\"select.time-part\").parent().removeClass('invalid');\r\n                // container toggle also supports invalid state\r\n                $tag.find('.datetime-dropdown').removeClass('invalid');\r\n            }\r\n            else if ($tag.hasClass(\"date-picker-part\")) {\r\n                // remove validation style for date control\r\n                $grandParent.removeClass(\"invalid\");\r\n                $tag.parents('.date-dropdown, .datetime-dropdown').removeClass('invalid');\r\n            }\r\n            else if ($tag.hasClass(\"time-part\")) {\r\n                // set validation style for time-control\r\n                $grandParent.find(\"select.time-part\").parent().removeClass('invalid');\r\n            }\r\n            else if ($tag.hasClass(\"panel-validation\")) {\r\n                $tag.removeClass('invalid');\r\n            }\r\n            else if ($tag.hasClass(\"tabbed-window-content\")) {\r\n                var tabId = $tag.gcop().getAttribute(\"id\") + \"-tab-title\";\r\n                var $tabTitle = $(\"#\" + tabId);\r\n                $tabTitle.removeClass(\"invalid\");\r\n            } else if ($tag.attr(\"data-dyno-type\") === \"auto-complete\") {\r\n                $tag.find(\".search\").removeClass(\"invalid\");\r\n            }\r\n            else if ($tag.attr(\"data-dyno-type\") === \"bool\") {\r\n                $tag.find(\"input[type=radio]\").removeClass(\"invalid\");\r\n            }\r\n            else {\r\n                if ($parent.hasClass('select-wrapper')) {\r\n                    $parent.removeClass('invalid');\r\n                } else {\r\n                    $tag.removeClass('invalid');\r\n                }\r\n            }\r\n\r\n            var $validator = $tag.closest(\".dyno-control\").find(\".field-validation-error\");\r\n            $validator.removeClass('field-validation-error');\r\n            $validator.addClass('field-validation-valid');\r\n        }\r\n        else {\r\n            var $ancestor = $element.parent().parent().parent().parent();\r\n\r\n            // new currency validation\r\n            if ($ancestor.hasClass(\"currency-container\")) {\r\n\r\n                if (!$ancestor.hasClass(\"invalid\")) {\r\n                    $ancestor.addClass(\"invalid\");\r\n                    \r\n                }\r\n                else {\r\n                    \r\n                }\r\n            }\r\n\r\n            else if ($tag.gcop().isRadioOrCheckBox()) {\r\n                // set validation style for checkbox and radio buttons\r\n                $grandParent.addClass('invalid');\r\n            }\r\n            else if ($tag.attr(\"data-val-isdatetime\") !== undefined) {\r\n                $tag.find(\"select.date-picker-part\").parent().addClass(\"invalid\");\r\n                $tag.find(\"select.time-part\").parent().addClass('invalid');\r\n                // container toggle also supports invalid state\r\n                $tag.find('.datetime-dropdown').addClass('invalid');\r\n            }\r\n            else if ($tag.hasClass(\"date-picker-part\")) {\r\n                // set validation style for date control\r\n                $grandParent.find(\"select.date-picker-part\").parent().addClass(\"invalid\");\r\n                $tag.parents('.date-dropdown, .datetime-dropdown').addClass('invalid');\r\n            }\r\n            else if ($tag.hasClass(\"time-part\")) {\r\n                // set validation style for time-control\r\n                $grandParent.find(\"select.time-part\").parent().addClass('invalid');\r\n            } else if ($tag.parent().hasClass(\"date-time-span\")) {\r\n                // NB: B#4736 This is a HACK to resolve (empty space) validation on Parameterised searches. If parameterised, on\r\n                // composed search screeen and value is empty then remove \"invalid\" and \"field-validation-error\" classes.\r\n                var $pTd = $tag.closest(\"tr\").find(\"td.parameterised\");\r\n                var parameterised = $pTd.find(\"input[type=checkbox]:checked\").length > 0;\r\n                if (parameterised && $tag.closest(\"tr\").find(\"input.cpftxt\").val().length == 0) {\r\n                    var $validator = $tag.parent().find('.field-validation-error');\r\n                    $tag.removeClass('invalid');\r\n                    $validator.removeClass('field-validation-error');\r\n                    $validator.addClass('field-validation-valid');\r\n                } else {\r\n                    $tag.addClass('invalid');\r\n                }\r\n            } else if ($tag.hasClass(\"tabbed-window-content\")) {\r\n                var tabId = $tag.gcop().getAttribute(\"id\") + \"-tab-title\";\r\n                var $tabTitle = $(\"#\" + tabId);\r\n                $tabTitle.addClass(\"invalid\");\r\n            } else if ($tag.attr(\"data-dyno-type\") === \"auto-complete\") {\r\n                $tag.find(\".search\").addClass(\"invalid\");\r\n            } else if ($tag.attr(\"data-dyno-type\") === \"bool\") {\r\n                $tag.find(\"input[type=radio]\").addClass(\"invalid\");\r\n            } else {\r\n                if ($parent.hasClass('select-wrapper')) {\r\n                    $parent.addClass('invalid');\r\n                } else {\r\n                    $tag.addClass('invalid');\r\n                }\r\n            }\r\n        }\r\n    },\r\n\r\n    setElementStyle: function ($element, isValid) {\r\n        //if (USEDYNOVIEW) {\r\n        //    validation.setDynoControlStyle($element, isValid);\r\n        //}\r\n        //else {\r\n        validation.setDefaultControlStyle($element, isValid);\r\n        //}\r\n    },\r\n\r\n    bindValidationToolTip: function ($errorcontainer) {\r\n        $errorcontainer.off('click.target').on('click.target', function (e) {\r\n            e.preventDefault();\r\n            $(this).focus();\r\n        });\r\n    }\r\n};\r\n\r\n(function ($) {\r\n    $.fn.validate = function (options) {\r\n\r\n        var defaults = { ignoreList: 'template', validationArray: [] };\r\n        options = $.extend(defaults, options);\r\n\r\n        var invalidElements = [];\r\n        va