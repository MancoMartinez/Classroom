            "size": 2179934,
            "mimeType": "text/javascript",
            "text": "/*\n * Bundle: ../../scripts/cpf.ui.js\n * Generated: 2026-08-20T08:38:07.081Z\n * Source files: 52\n */\n\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/zugo/parameterisedConditionValidator.js\n * ======================================== */\n\n/**\r\n * Validates parameterised condition\r\n * @class\r\n */\r\nvar ParameterisedConditionValidator = (function () {\r\n    /**\r\n    * Initializes new instance of ParameterisedConditionValidator\r\n    * @constructs ParameterisedConditionValidator\r\n    */\r\n    function ParameterisedConditionValidator() { };\r\n\r\n    /**\r\n    * Validates expression\r\n    * @param {any} expression Expression\r\n    */\r\n    ParameterisedConditionValidator.prototype.validateParameterisedExpression = function (expression) {\r\n        switch (expression.expType) {\r\n            case \"variable\":\r\n                this.validateParameterisedExpressionOfVariableHasValue(expression);\r\n                return expression.hasMissingValue;\r\n            case \"array\":\r\n                this.validateParameterisedExpressionOfArrayHasValue(expression);\r\n                return expression.hasMissingValue;\r\n            case \"function\":\r\n                this.validateParameterisedExpressionOfFunctionHasValue(expression);\r\n                return expression.hasMissingValue;\r\n        }\r\n    };\r\n\r\n    /**\r\n     * Validates expression that holds the value for variable\r\n     * @function\r\n     * @param {any} expression Expression\r\n     */\r\n    ParameterisedConditionValidator.prototype.validateParameterisedExpressionOfVariableHasValue = function (expression) {\r\n        if (expression.parameterised && (expression.value === undefined || expression.value === null || expression.value === '' || expression.value === [])) {\r\n            expression.hasMissingValue = true;\r\n        } else {\r\n            expression.hasMissingValue = false;\r\n        }\r\n    };\r\n\r\n    /**\r\n     * Validates expression that holds the value for an array\r\n     * @function\r\n     * @param {any} expression Expression\r\n     */\r\n    ParameterisedConditionValidator.prototype.validateParameterisedExpressionOfArrayHasValue = function (expression) {\r\n        var validationResults = [];\r\n\r\n        for (var i = 0; i < expression.elements.length; i++) {\r\n            var hasMissingValue = this.validateParameterisedExpression(expression.elements[i]);\r\n            validationResults.push(hasMissingValue);\r\n        }\r\n\r\n        if (validationResults.filter(function (value) { return value === true }).length > 0) {\r\n            expression.hasMissingValue = true;\r\n        } else {\r\n            expression.hasMissingValue = false;\r\n        }\r\n    };\r\n\r\n    /**\r\n     * Validates expression that holds the value for function\r\n     * @function\r\n     * @param {any} expression Expression\r\n     */\r\n    ParameterisedConditionValidator.prototype.validateParameterisedExpressionOfFunctionHasValue = function (expression) {\r\n        var validationResults = [];\r\n\r\n        for (var i = 0; i < expression.parameters.length; i++) {\r\n            var hasMissingValue = this.validateParameterisedExpression(expression.parameters[i].expression[0]);\r\n            validationResults.push(hasMissingValue);\r\n        }\r\n\r\n        if (validationResults.filter(function (value) { return value === true }).length > 0) {\r\n            expression.hasMissingValue = true;\r\n        } else {\r\n            expression.hasMissingValue = false;\r\n        }\r\n    };\r\n\r\n    /**\r\n     * Validates the expression to check if it holds a value\r\n     * @function\r\n     * @param {any} exp Expression\r\n     */\r\n    ParameterisedConditionValidator.prototype.validateParameterisedConditionHasValue = function (exp) {\r\n        if (exp === undefined) return;\r\n\r\n        this.validateParameterisedExpression(exp);\r\n    