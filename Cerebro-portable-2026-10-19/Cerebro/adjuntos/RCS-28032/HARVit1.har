idate.find(\"input[\" + validationAttribute + \"],select[\" + validationAttribute + \"],textarea[\" + validationAttribute + \"], .panel-validation[\" + validationAttribute + \"]\");\r\n                        }\r\n                    }\r\n\r\n                    var itemlength = $items.length;\r\n                    if (itemlength == 0) {\r\n                        continue;\r\n                    }\r\n\r\n                    for (var j = 0; j < itemlength; j++) {\r\n                        var $control = $($items[j]);\r\n\r\n                        // index of the element id in invalid element array\r\n                        //var $dynoControl = $control.closest(\"div.dyno-control\");\r\n                        var controlName = $control.gcop().getAttribute(\"id\");\r\n\r\n                        if (!controlName && ($control.is(\"select\") || $control.gcop().getAttribute(\"type\") == \"radio\" || $control.gcop().getAttribute(\"type\") == \"checkbox\")) {\r\n                            controlName = $control.gcop().getAttribute(\"name\");\r\n                        }\r\n\r\n                        var dataRow = $control.gcop().getAttribute(\"data-row\");\r\n                        var invalidElementIndex = $.grep(validationArray, function (n) { return n.name == controlName && n.valid == false && n.row == dataRow; }).length;\r\n                        //do not validate if the element is already in invalid elemnts array\r\n                        if (invalidElementIndex < 1) {\r\n                            //invoke validate method\r\n                            var isValid;\r\n                            isValid = validationTypes[i].validate($control);\r\n                            var errorMessageinAttribute = jQuery.trim($control.gcop().getAttribute(validationAttribute));\r\n                            var errorMsg = errorMessageinAttribute.length > 0 ? errorMessageinAttribute : validationTypes[i].getValidationText($control);\r\n                            // complex controls have different error message. Below blocks tries to provide more accurate error message\r\n                            // for Date and DateTime controls using their built-in values\r\n                            if ($control.hasClass('date-picker-part')) {\r\n                                var $dynoControl = $control.parents('.dyno-control');\r\n                                var controlType = $dynoControl.data('dynoType') || '';\r\n                                if (!!controlType) {\r\n                                    var validationType = 'is' + controlType;\r\n                                    errorMsg = validation.getValidationType(validationType).getValidationText($dynoControl);\r\n                                }\r\n                            }\r\n                            var parentIsTable = ($control.closest(\"div.dyno-control\").attr(\"data-parent-type\") === \"Table\" || $control.closest(\"div.dyno-control\").attr(\"data-parent-type\") === \"ResponsiveTable\");\r\n\r\n                            // this code is here to deal with table rows.\r\n                            // if the first row in a table has invalid values and the second doesnt, this code ensures \r\n                            // that the validation icon will be shown in the header.\r\n                            if (!isValid && USEDYNOVIEW && parentIsTable) {\r\n\r\n                                var headerId = $control.closest(\"td\").attr(\"data-id\");\r\n\r\n                                // insert the element id in invalid elements array\r\n                                invalidElements.push(validation.getControlIdentifier($control));\r\n\r\n                                // for now also insert into the validationArray passed in\r\n                                validationArray.push({ name: controlName, valid: isValid, row: dataRow, headerId: headerId });\r\n\r\n                            } else if (!isValid) {\r\n\r\n                                // insert the element id in invalid elements array\r\n                                invalidElements.push(validation.getControlIdentifier($control));\r\n\r\n                                // for now also insert into the validationArray passed in\r\n                                validationArray.push({ name: controlName, valid: isValid, row: dataRow });\r\n                            }\r\n\r\n                            if (typeof dynoValidation === 'undefined') {\r\n                                validation.set($control, isValid, errorMsg, validationArray);\r\n                            }\r\n                            else {\r\n                                validation.set($control, isValid, errorMsg, dynoValidation.validationArray);\r\n                            }\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n\r\n        });\r\n\r\n        //if ($.grep(validationArray, function (n) {\r\n        //    //if (typeof DYNOMODE === \"undefined\") {\r\n        //    //    if (n.valid == false) {\r\n        //    //        return true;\r\n        //    //    } else {\r\n        //    //        return false;\r\n        //    //    }\r\n        //    //} else {\r\n        //            return n.valid == false;\r\n        //    //}\r\n        //}).length == 0) {\r\n        //    // no validation errors\r\n        //    if (options.success) {\r\n        //        options.success();\r\n        //    }\r\n\r\n        //    return true;\r\n        //}\r\n        //else {\r\n        //    if (options.onInvalid) {\r\n        //        options.onInvalid();\r\n        //    }\r\n\r\n        //    defaults.validationArray = validationArray;\r\n        //    return false;\r\n        //}\r\n\r\n        if (invalidElements.length == 0) {\r\n            // no validation errors\r\n            if (options.success) {\r\n                options.success();\r\n            }\r\n\r\n            return true;\r\n\r\n        } else {\r\n            if (options.onInvalid) {\r\n                options.onInvalid();\r\n            }\r\n\r\n            defaults.validationArray = validationArray;\r\n            return false;\r\n        }\r\n\r\n    };\r\n})(jQuery);\r\n\r\n\r\nvar validationTypes = [\r\n    {\r\n        \"name\": \"required\",\r\n        \"dataattribute\": \"data-val-required\",\r\n        \"validate\": function ($control) {\r\n            var val = jQuery.trim($control.val());\r\n\r\n            var isValid = false;\r\n            var $gcopControl = $control.gcop();\r\n            var tagName = $gcopControl.tag();\r\n\r\n            if (validation.isDraft) {\r\n                // ignore required for draft\r\n                return true;\r\n            }\r\n\r\n            //if (tagName == \"checkbox\" || tagName == \"radio\") {\r\n            if ($gcopControl.isCheckBox() || $gcopControl.isRadio()) {\r\n                var $groupname = $gcopControl.getAttribute(\"name\");\r\n                isValid = $(\"input[name='\" + $groupname + \"']:checked\").length > 0;\r\n            }\r\n            else if ($gcopControl.hasClass(\"date-picker-part\")) {\r\n                isValid = $control.val() != \"0\" && jQuery.trim($control.parent().parent().find(\"select.month:eq(0)\").val()) != \"0\" && jQuery.trim($control.parent().parent().find(\"select.year:eq(0)\").val()) != \"0\";\r\n            }\r\n            else if ($gcopControl.hasClass(\"time-part\")) {\r\n                isValid = $control.val() != \"-1\" && jQuery.trim($control.parent().parent().find(\"select.minute:eq(0)\").val()) != \"-1\";\r\n            }\r\n            else if ($gcopControl.hasClass(\"dyno-image-upload\")) {\r\n                isValid = jQuery.trim($gcopControl.getAttribute(\"data-value\")) !== \"\";\r\n            }\r\n            else if ($gcopControl.hasClass(\"dyno-filteredselect\")) {\r\n                try {\r\n                    var filterId = angular.element($gcopControl.$this.find(\".sngfilter\")[0]).prop(\"id\");\r\n                    var service = angular.element(document.body).injector().get(\"sngFilterboxAccessService\");\r\n                    var exists = service.checkIfExists(filterId);\r\n                    if (exists) {\r\n                        var value = service.getValues(filterId) || [];\r\n                        isValid = (value.length > 0);\r\n                    } else {\r\n                        isValid = false;\r\n                    }\r\n                } catch (error) {\r\n                    isValid = false;\r\n                    console.error(error);\r\n                }\r\n            }\r\n            else if ($gcopControl.hasClass(\"panel-validation\")) {\r\n                var $groupname = $control.attr(\"id\");\r\n\r\n                // check if autocomplete grid is not null\r\n                if ($gcopControl.$this.find(\".autocomplete-grid\").length > 0) {\r\n\r\n                    isValid = JSON.parse($gcopControl.$this.find(\".autocomplete-grid\").find(\".data-row:first\").attr(\"data\")).value.length > 0;\r\n                }\r\n                else {\r\n                    isValid = $(\"input[name='\" + $groupname + \"']:checked\").length > 0;\r\n                    //isValid = $(\"input[name='\" + $groupname + \"']\").gcop().isAnyChecked();\r\n                }\r\n            }\r\n            else if ($gcopControl.getAttribute(\"data-dyno-type\") == \"auto-complete\") {\r\n\r\n                var hasValue = autocompleteGrid.hasValue($control.find(\".autocomplete-grid\"));\r\n\r\n                if (hasValue) {\r\n                    isValid = true;\r\n                } else {\r\n                    isValid = false;\r\n                }\r\n                //// single from list\r\n                //var selectedValue = $control.find(\".search\").attr(\"data-selected\");\r\n                //var listType = $control.find().getAttribute(\"list-type\");\r\n                //var allowFreeText = isTrue($gcopControl.getAttribute(\"data-allow-free-text\"));\r\n\r\n\r\n                //// if multiple list - check the rows have something\r\n                //if (listType === \"multiple\") {\r\n                //    if ($gcopControl.find(\".none-selected\").is(':visible')) {\r\n                //        isValid = false;\r\n                //    } else {\r\n                //        isValid = true;\r\n                //    }\r\n                //} else if (listType === \"single\") {\r\n                //    if (selectedValue !== undefined && selectedValue !== \"\") {\r\n                //        isValid = true;\r\n                //    } else {\r\n                //        isValid = false;\r\n                //    }\r\n                //}\r\n            }\r\n            else if ($control.is(\"select\")) {\r\n\r\n                isValid = ($control.val() != \"-1\" && $control.find(\"option\").length > 0);\r\n            }\r\n            else {\r\n                isValid = val.length > 0;\r\n            }\r\n            return isValid;\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            if ($control.gcop().hasClass(\"dyno-image-upload\")) {\r\n                return \"RESOURCE{{cpf.ui.js}:{ImageUploadRequiredValidationText}:{Please select an image.}}\";\r\n            }\r\n            else {\r\n                return \"RESOURCE{{cpf.ui.js}:{GenericRequiredValidationText}:{Please specify a value}}\";\r\n            }\r\n        },\r\n        \"useParameters\": false\r\n    },\r\n    {\r\n        \"name\": \"isnumeric\",\r\n        \"dataattribute\": \"data-val-isnumeric\",\r\n        \"validate\": function ($control) {\r\n            var val = $control.val();\r\n\r\n            var isRequired = $control.parent().gcop().getAttribute(\"data-val-required\");\r\n            if (isNullOrEmpty(isRequired) && isNullOrEmpty(val)) {\r\n                return true;\r\n            }\r\n\r\n            if (DECIMALSEPARATOR) {\r\n                if (DECIMALSEPARATOR == '.') {\r\n                    val = val.replace(\",\", \"\");\r\n                }\r\n                else if (DECIMALSEPARATOR == ',') {\r\n                    val = val.replace(\".\", \"\").replace(\",\", \".\");\r\n                }\r\n            }\r\n            return !isNaN(val);\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            return \"RESOURCE{{cpf.ui.js}:{GenericNumericValidationText}:{Please specify a numeric value}}\";\r\n        },\r\n        \"useParameters\": false\r\n    },\r\n    {\r\n        \"name\": \"isalfanumeric\",\r\n        \"dataattribute\": \"data-val-isalfanumeric\",\r\n        \"validate\": function ($control) {\r\n            var val = $control.val();\r\n            var patt = /^[a-zA-Z0-9 _-]*$/;\r\n            return patt.test(val);\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            return \"RESOURCE{{cpf.ui.js}:{GenericAlfanumericValidationText}:{Please specify alfanumeric value (- and _ signs are additionaly allowed).}}\";\r\n        },\r\n        \"useParameters\": true\r\n    },\r\n    {\r\n        \"name\": \"isint\",\r\n        \"dataattribute\": \"data-val-isint\",\r\n        \"validate\": function ($control) {\r\n\r\n            var val = $control.val();\r\n\r\n            var isRequired = $control.parent().gcop().getAttribute(\"data-val-required\");\r\n            if (isNullOrEmpty(isRequired) && isNullOrEmpty(val)) {\r\n                return true;\r\n            }\r\n\r\n            var patt = /^[0-9]*$/;\r\n            return patt.test(val);\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            return \"RESOURCE{{cpf.ui.js}:{GenericIntegerValidationText}:{Please specify an integer value}}\";\r\n        },\r\n        \"useParameters\": false\r\n    },\r\n    {\r\n        \"name\": \"max\",\r\n        \"dataattribute\": \"data-val-max\",\r\n        \"validate\": function ($control) {\r\n            var val = $control.val();\r\n\r\n            var isRequired = $control.parent().gcop().getAttribute(\"data-val-required\");\r\n            if (isNullOrEmpty(isRequired) && isNullOrEmpty(val)) {\r\n                return true;\r\n            }\r\n\r\n            if (DECIMALSEPARATOR) {\r\n                if (DECIMALSEPARATOR == '.') {\r\n                    val = val.replace(\",\", \"\");\r\n                }\r\n                else if (DECIMALSEPARATOR == ',') {\r\n                    val = val.replace(\".\", \"\").replace(\",\", \".\");\r\n                }\r\n            }\r\n\r\n            var maximumValue = parseFloat($control.gcop().getAttribute(\"data-val-max-value\"));\r\n            return parseFloat(val) <= maximumValue;\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            var msg = \"RESOURCE{{cpf.ui.js}:{GenericMaxValidationText}:{Please specify a value less than maximum value {0}}}\";\r\n            return msg.replace(\"{0}\", $control.gcop().getAttribute(\"data-val-max-value\"));\r\n        },\r\n        \"useParameters\": true\r\n    },\r\n    {\r\n        \"name\": \"min\",\r\n        \"dataattribute\": \"data-val-min\",\r\n        \"validate\": function ($control) {\r\n            var val = $control.val();\r\n\r\n            var isRequired = $control.parent().gcop().getAttribute(\"data-val-required\");\r\n            if (isNullOrEmpty(isRequired) && isNullOrEmpty(val)) {\r\n                return true;\r\n            }\r\n\r\n            if (DECIMALSEPARATOR) {\r\n                if (DECIMALSEPARATOR == '.') {\r\n                    val = val.replace(\",\", \"\");\r\n                }\r\n                else if (DECIMALSEPARATOR == ',') {\r\n                    val = val.replace(\".\", \"\").replace(\",\", \".\");\r\n                }\r\n            }\r\n\r\n            var minimumValue = parseFloat($control.gcop().getAttribute(\"data-val-min-value\"));\r\n            return parseFloat(val) >= minimumValue;\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            var msg = \"RESOURCE{{cpf.ui.js}:{GenericMinValidationText}:{Please specify a value greater than minimum value {0}}}\";\r\n            return msg.replace(\"{0}\", $control.gcop().getAttribute(\"data-val-min-value\"));\r\n        },\r\n        \"useParameters\": true\r\n    },\r\n    {\r\n        \"name\": \"iscurrency\",\r\n        \"dataattribute\": \"data-val-iscurrency\",\r\n        \"validate\": function ($control) {\r\n            var val = $control.val();\r\n            var patt = new RegExp(\"^-|\\\\d*(\\\\.|\\\\,)\\\\d{2}$\", \"g\");\r\n            return patt.test(val);\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            return \"RESOURCE{{cpf.ui.js}:{GenericCurrencyValidationText}:{Please specify a value in a valid currency format}}\";\r\n        },\r\n        \"useParameters\": true\r\n    },\r\n    {\r\n        \"name\": \"decimalplaces\",\r\n        \"dataattribute\": \"data-val-decimalplaces\",\r\n        \"validate\": function ($control) {\r\n            var val = $control.val();\r\n\r\n            var required = $control.gcop().hasAttribute(\"data-val-required\");\r\n            if (!required && !val) {\r\n                return true;\r\n            }\r\n\r\n            var decimalplaces = parseInt($control.gcop().getAttribute(\"data-val-decimalplaces-value\"));\r\n            var patt = decimalplaces > 0 ? new RegExp(\"^\\\\d*.\\\\d{\" + decimalplaces + \"}$\", \"g\") : new RegExp(\"^\\\\d*$\", \"g\");\r\n            return patt.test(val);\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            var msg = \"RESOURCE{{cpf.ui.js}:{GenericDecimalPlacesValidationText}:{Please specify a value in a valid format ( {0} ) decimal places.}}\";\r\n            return msg.replace(\"{0}\", $control.gcop().getAttribute(\"data-val-decimalplaces-value\"));\r\n        },\r\n        \"useParameters\": true\r\n    },\r\n    {\r\n        \"name\": \"isdate\",\r\n        \"dataattribute\": \"data-val-isdate\",\r\n        \"validate\": function ($control) {\r\n            var $parent = $control.parent().parent();\r\n            var day = parseInt($parent.find(\"select.day\").val());\r\n            var month = parseInt($parent.find(\"select.month\").val());\r\n            var year = parseInt($parent.find(\"select.year\").val());\r\n\r\n            var required = $control.gcop().hasAttribute(\"data-val-required\");\r\n\r\n            ////Default Date\r\n            //if (!required && year == 1 && month == 1 && day == 1) {\r\n            //    return true;\r\n            //}\r\n\r\n            ////No Date Selected\r\n            //if (!required && year == 0 && month == 0 && day == 0) {\r\n            //    return true;\r\n            //}\r\n\r\n            if ((!required || validation.isDraft) && day === 0 && month === 0 && year === 0) {\r\n                return true;\r\n            }\r\n\r\n            //// check for any unselected sections\r\n            if (day === 0 || month === 0 || year === 0) {\r\n                return false;\r\n            }\r\n\r\n            var dateObject = new Date(year, month - 1, day);\r\n            return (day == dateObject.getDate() && month == dateObject.getMonth() + 1 && year == dateObject.getFullYear());\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            return \"RESOURCE{{cpf.ui.js}:{GenericDateValidationText}:{Please specify a valid date}}\";\r\n        },\r\n        \"useParameters\": false\r\n    },\r\n    {\r\n        \"name\": \"istime\",\r\n        \"dataattribute\": \"data-val-istime\",\r\n        \"validate\": function ($control) {\r\n            var required = $control.gcop().hasAttribute(\"data-val-required\");\r\n            var hour = $control.val();\r\n            var $parent = $control.parent().parent();\r\n            var minute = $parent.find(\"select.time-part.minute\").val();\r\n            //if (!required && hour == \"\" && minute == \"\") {\r\n            //    return true;\r\n            //}\r\n\r\n            // check for nothing selected\r\n            if ((!required || validation.isDraft) && hour === \"-1\" && minute === \"-1\") {\r\n                return true;\r\n            }\r\n\r\n            // check for any unselected sections\r\n            if (hour === \"-1\" || minute === \"-1\") {\r\n                return false;\r\n            }\r\n\r\n            return jQuery.trim($control.val()).length > 0 && jQuery.trim($parent.find(\"select.time-part\").val()).length > 0;\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            return \"RESOURCE{{cpf.ui.js}:{GenericTimeValidationText}:{Please specify a valid time}}\";\r\n        },\r\n        \"useParameters\": false\r\n    },\r\n    {\r\n        \"name\": \"isdatetime\",\r\n        \"dataattribute\": \"data-val-isdatetime\",\r\n        \"validate\": function ($control) {\r\n\r\n            var dateTimeControlId = $control.gcop().getAttribute(\"id\");\r\n\r\n            var $datePart = $control.find(\"#\" + dateTimeControlId + \"-day\");\r\n            var $timePart = $control.find(\"#\" + dateTimeControlId + \"-hour\");\r\n\r\n            var hour = $timePart.val();\r\n            var minute = $timePart.parent().parent().find(\"select.time-part.minute\").val();\r\n\r\n            var $parent = $datePart.parent().parent();\r\n            var day = parseInt($parent.find(\"select.day\").val());\r\n            var month = parseInt($parent.find(\"select.month\").val());\r\n            var year = parseInt($parent.find(\"select.year\").val());\r\n\r\n            var required = $datePart.gcop().hasAttribute(\"data-val-required\");\r\n\r\n            if ((!required || validation.isDraft) && day === 0 && month === 0 && year === 0 && hour === \"-1\" && minute === \"-1\") {\r\n                return true;\r\n            }\r\n\r\n            //// check for any unselected sections\r\n            if (day === 0 || month === 0 || year === 0 || hour === \"-1\" || minute === \"-1\") {\r\n                return false;\r\n            }\r\n\r\n            var dateObject = new Date(year, month - 1, day);\r\n            return (day == dateObject.getDate() && month == dateObject.getMonth() + 1 && year == dateObject.getFullYear());\r\n\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            return \"RESOURCE{{cpf.ui.js}:{GenericDateTimeValidationText}:{Please specify a valid date time}}\";\r\n        },\r\n        \"useParameters\": false\r\n    },\r\n    {\r\n        \"name\": \"past-date\",\r\n        \"dataattribute\": \"data-val-past-date\",\r\n        \"validate\": function ($control) {\r\n            var $parent = $control.parent().parent();\r\n            var day = parseInt($parent.find(\"select.day\").val());\r\n            var month = parseInt($parent.find(\"select.month\").val());\r\n            var year = parseInt($parent.find(\"select.year\").val());\r\n\r\n            var required = $control.gcop().hasAttribute(\"data-val-required\");\r\n            if ((!required || validation.isDraft) && year == 0 && month == 0 && day == 0) {\r\n                return true;\r\n            }\r\n\r\n            var dateObject = new Date(year, month - 1, day);\r\n            var today = new Date();\r\n            return (dateObject >= today) || (today.getDate() == dateObject.getDate() && today.getMonth() == dateObject.getMonth() && today.getFullYear() == dateObject.getFullYear());\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            return \"RESOURCE{{cpf.ui.js}:{GenericFutureDateValidationText}:{Specified date is out of range. Please specify a later date.}}\";\r\n        },\r\n        \"useParameters\": false\r\n    },\r\n    {\r\n        \"name\": \"future-date\",\r\n        \"dataattribute\": \"data-val-future-date\",\r\n        \"validate\": function ($control) {\r\n            var $parent = $control.parent().parent();\r\n            var day = parseInt($parent.find(\"select.day\").val());\r\n            var month = parseInt($parent.find(\"select.month\").val());\r\n            var year = parseInt($parent.find(\"select.year\").val());\r\n\r\n            var required = $control.gcop().hasAttribute(\"data-val-required\");\r\n            if ((!required || validation.isDraft) && year == 0 && month == 0 && day == 0) {\r\n                return true;\r\n            }\r\n\r\n            var dateObject = new Date(year, month - 1, day);\r\n            var today = new Date();\r\n            return (dateObject <= today) || (today.getDate() == dateObject.getDate() && today.getMonth() == dateObject.getMonth() && today.getFullYear() == dateObject.getFullYear());\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            return \"RESOURCE{{cpf.ui.js}:{GenericPastDateValidationText}:{Specified date is out of range. Please specify a past date.}}\";\r\n        },\r\n        \"useParameters\": false\r\n    },\r\n    {\r\n        \"name\": \"istext\",\r\n        \"dataattribute\": \"data-val-istext\",\r\n        \"validate\": function ($control) {\r\n            return true;\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            return \"\";\r\n        },\r\n        \"useParameters\": false\r\n    },\r\n    {\r\n        \"name\": \"istimespan\",\r\n        \"dataattribute\": \"data-val-istimespan\",\r\n        \"validate\": function ($control) {\r\n            return validation.timeSpanRegex.test($control.val());\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            return \"RESOURCE{{cpf.ui.js}:{GenericTimeSpanValidationText}:{Please specify a valid time span}}\";\r\n        },\r\n        \"useParameters\": false\r\n    },\r\n    {\r\n        \"name\": \"isemail\",\r\n        \"dataattribute\": \"data-val-isemail\",\r\n        \"validate\": function ($control) {\r\n            return validation.emailRegex.test($control.val());\r\n        },\r\n        \"getValidationText\": function ($control) {\r\n            return \"RESOURCE{{cpf.ui.js}:{GenericEmailValidationText}:{Please specify a valid email address}}\";\r\n        },\r\n        \"useParameters\": false\r\n    }\r\n];\r\n\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/zugo/controlDefinition.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\nfunction controlDefintion(parent) {\r\n    var self = this;\r\n    this.sortColumn = '';\r\n    this.sortDirection = '';\r\n    this.rowIndex = 0;\r\n    this.rowCount = 0;\r\n    this.pageSize = 20;\r\n    this.filter = '';\r\n    this.hiddenFilter = '';\r\n    this.filters = [];\r\n    this.search = parent;\r\n    this.hasTracks = false;\r\n\r\n    this.rowIndexMax = -1;\r\n    this.rowIndexMin = -1;\r\n    this.totalPages = 0;\r\n\r\n    this.maxPopTracks = 0;\r\n\r\n    this.resetRows = function() {\r\n        self.rowIndex = 0;\r\n        self.rowCount = 0;\r\n        self.rowIndexMax = -1;\r\n        self.rowIndexMin = -1;\r\n    };\r\n\r\n    this.addFilter = function (filter) {\r\n        if (filter !== null && filter !== undefined && filter.name) {\r\n            var updated = false;\r\n            for (var i = 0; i < this.filters.length; i++) {\r\n                if (this.filters[i].name === filter.name) {\r\n                    this.filters[i].value = filter.value;\r\n                    this.filters[i].originalValue = filter.originalValue;\r\n                    updated = true;\r\n                    break;\r\n                }\r\n            }\r\n\r\n            if (!updated) {\r\n                this.filters.push(filter);\r\n            }\r\n        }\r\n    };\r\n\r\n    this.removeFilter = function (name) {\r\n\r\n        // loop the filters till you find the right one and get its index.\r\n        for (var i = 0, li = this.filters.length; i < li; i++) {\r\n\r\n            if (this.filters[i].name === name) {\r\n                this.filters.splice(i, 1);\r\n                break;\r\n            }\r\n        }\r\n    };\r\n\r\n    this.getFilter = function ($searchBox) {\r\n\r\n        var filterBox = null;\r\n        var filter = '';\r\n\r\n        filterBox = $searchBox.find(\".filter-box\").val(); //search.control.removeSpecialCharacters($searchBox.find(\".filter-box\").val());\r\n\r\n        if (!isNullOrEmpty(filterBox)) {\r\n            filter = filterBox;\r\n        }\r\n\r\n        this.filter = filter;\r\n        return filter;\r\n    };\r\n\r\n    this.removeSpecialCharacters = function (filter) {\r\n\r\n        var expression = new RegExp(/[!$%^&£\\\\*@#()_+~`{}\\[\\]=|;:\"<>?,.¬]/g);\r\n        if (expression.test(filter)) {\r\n            filter = filter.replace(expression, \"\");\r\n            //filter = \"[\" + filter + \"]\";\r\n            return filter;\r\n        } else {\r\n            return filter;\r\n        }\r\n    };\r\n\r\n    this.hideSearchToolbox = function (hide) {\r\n\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $searchBox = $searchContainer.find(\".search-toolbox\");\r\n        if (hide) {\r\n            $searchBox.addClass(\"hidden\");\r\n        } else {\r\n            $searchBox.removeClass(\"hidden\");\r\n        }\r\n    };\r\n\r\n    this.fillControlData = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $searchBox = $searchContainer.find(\".search-toolbox\");\r\n        this.sortColumn = this.search.getSortColumn();\r\n        this.sortDirection = this.sortColumn.length > 0 ? this.search.getSortDirection() : \"\";\r\n\r\n        if (this.pageSize < 1) {\r\n            this.pageSize = 20;\r\n        }\r\n\r\n        if ($searchBox.find(\".results-per-page\").length > 0) // == 1\r\n        {\r\n            this.pageSize = $searchBox.find(\".results-per-page\").val();\r\n        }\r\n\r\n        this.filter = \"\";\r\n        this.getFilter($searchContainer);\r\n    };\r\n\r\n    this.updateControlData = function (searchResultsFound) {\r\n\r\n        // this method puts the search box and the letter indexer back to what the user had selected.\r\n        // doing it here because when we request the next page etc we only bring back the results. not the part with the controls.\r\n\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $searchBox = $searchContainer.find(\".search-toolbox\");\r\n        var searchData = null;\r\n\r\n        try {\r\n            searchData = JSON.parse($searchContainer.find(\".results-container\").attr(\"data\"));\r\n        } catch (e) {\r\n        }\r\n\r\n        var searchBoxFilter = null;\r\n        var indexerFilter = null;\r\n\r\n        if (this.filters.length > 0) {\r\n\r\n            for (var i = 0, li = this.filters.length; i < li; i++) {\r\n\r\n                var filter = this.filters[i];\r\n                switch (filter.type) {\r\n                    case \"search\":\r\n                        searchBoxFilter = filter;\r\n                        break;\r\n                    case \"indexer\":\r\n                        indexerFilter = filter;\r\n                        break;\r\n                    default:\r\n                }\r\n            }\r\n        }\r\n\r\n        if (searchBoxFilter !== null) {\r\n            $searchBox.find(\".filter-box\").val(searchBoxFilter.originalValue);\r\n        } else {\r\n            $searchBox.find(\".filter-box\").val(\"\");\r\n        }\r\n\r\n        ////var $indexer = $searchBox.find(\".indexer-list\");\r\n        ////if (indexerFilter !== null || searchResultsFound) {\r\n\r\n        ////    if (!$indexer.hasClass(\"hidden\")) {\r\n        ////        $indexer.removeClass(\"hidden-no-result\");\r\n        ////    }\r\n\r\n        ////    if (searchData.indexerVisible) {\r\n        ////        $indexer.removeClass(\"hidden-no-result\").removeClass(\"hidden\");\r\n        ////    } else {\r\n        ////        $indexer.addClass(\"hidden\");\r\n        ////    }\r\n\r\n        ////    if (indexerFilter !== null) {\r\n        ////        $indexer.removeClass(\"hidden-no-result\");\r\n        ////        $indexer.find(\"li a[data-value=\" + indexerFilter.originalValue + \"]\").addClass(\"selected\");\r\n        ////    } else {\r\n        ////        $indexer.find(\"li a\").removeClass(\"selected\");\r\n        ////    }\r\n        ////} else {\r\n        ////    if (!searchData.indexerVisible) {\r\n        ////        $indexer.addClass(\"hidden\");\r\n        ////    }\r\n\r\n        ////    $indexer.addClass(\"hidden-no-result\");\r\n        ////}\r\n\r\n        var $bottomSearch = $(\"#search-toolbox-bottom\");\r\n        var minValue = Number(searchData.resultsPerPage);\r\n\r\n        if (searchData.pageIndex === searchData.totalPages) {\r\n            var pageNumber = Number(searchData.pageIndex);\r\n            var totalResults = Number(searchData.totalResults);\r\n            var resultsPerPage = Number(searchData.resultsPerPage);\r\n\r\n            if (totalResults === 0) {\r\n                $bottomSearch.addClass(\"hidden\");\r\n            }\r\n            else if (totalResults < pageNumber * resultsPerPage) {\r\n                $bottomSearch.addClass(\"hidden\");\r\n            } else {\r\n                $bottomSearch.removeClass(\"hidden\");\r\n            }\r\n        } else {\r\n            $bottomSearch.removeClass(\"hidden\");\r\n        }\r\n\r\n        //searchData.pageRowCount >= minValue ? $bottomSearch.removeClass(\"hidden\") : $bottomSearch.addClass(\"hidden\");\r\n    };\r\n\r\n    this.initialise = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $searchBox = $searchContainer.find(\".search-toolbox\");\r\n\r\n        ////$searchBox.find(\".previous-button\").off(\"click\").on(\"click\", $.proxy(function (event) {\r\n        ////    if ($searchBox.find(\".previous-button\").hasClass(\"disabled\") == false) {\r\n        ////        if (self.pageIndexMin === -1) {\r\n        ////            self.pageIndexMin = self.pageIndex;\r\n        ////        }\r\n        ////        self.pageIndex--;\r\n        ////        if (self.pageIndexMin > self.pageIndex) {\r\n        ////            self.pageIndexMin = self.pageIndex;\r\n        ////        }\r\n        ////        self.search.load(null, 'previous');\r\n        ////    }\r\n\r\n        ////    return false;\r\n        ////}, this));\r\n\r\n        ////$searchBox.find(\".next-button\").off(\"click\").on(\"click\", $.proxy(function (event) {\r\n        ////    if ($searchBox.find(\".next-button\").hasClass(\"disabled\") == false) {\r\n        ////        if (self.pageIndexMin === -1) {\r\n        ////            self.pageIndexMin = self.pageIndex;\r\n        ////        }\r\n        ////        self.pageIndex++;\r\n        ////        if (self.pageIndexMin < self.pageIndex) {\r\n        ////            self.pageIndexMin = self.pageIndex;\r\n        ////        }\r\n        ////        self.search.load(null, 'next');\r\n        ////    }\r\n\r\n        ////    return false;\r\n        ////}, this));\r\n\r\n\r\n        ////$searchBox.find(\".results-per-page\").off(\"change\").on(\"change\", $.proxy(function (event) {\r\n        ////    $searchBox.find(\".page-index\").val(\"1\");\r\n        ////    $searchBox.find(\".results-per-page\").val($(event.currentTarget).val());\r\n        ////    self.search.load();\r\n\r\n        ////    return false;\r\n        ////}, this));\r\n\r\n        $searchBox.find(\".filter-button\").off(\"click\").on(\"click\", $.proxy(function (event) {\r\n            $searchBox.find(\".indexer-list li a.selected\").removeClass(\"selected\");\r\n            $searchBox.find(\".page-index\").val(\"1\");\r\n\r\n            var value = $searchBox.find(\".filter-box\").val();\r\n            if (value !== \"\") {\r\n                self.addFilter({ name: \"filter_box\", type: \"search\", value: self.removeSpecialCharacters(value), originalValue: value });\r\n            } else {\r\n                // remove the filter is there is one with the same type.\r\n                self.removeFilter(\"filter_box\");\r\n            }\r\n\r\n            //$searchBox.find(\".filter-box\").val($(event.currentTarget).val());\r\n\r\n            // reset row count when changing the filter.\r\n            self.resetRows();\r\n            self.search.load();\r\n            return false;\r\n        }, this));\r\n\r\n\r\n        //handle cancel button on filter box \r\n        var cancelButton = $(\"#cancel-search-button\");\r\n        var searchBox = $(\"#filter-by-search\");\r\n\r\n\r\n        //handle if user deletes the filter text\r\n        searchBox.off(\"keyup\").on(\"keyup\", $.proxy(function (event) {\r\n            //only do removeFilter if there is one applied\r\n            if (searchBox.val().length === 0) {\r\n\r\n                ////$searchBox.find(\".indexer-list li a.selected\").removeClass(\"selected\");\r\n                // $searchBox.find(\".page-index\").val(\"1\");\r\n\r\n                cancelButton.fadeOut(20);\r\n\r\n                var $searchContainer = self.search.getSearchContainer();\r\n                var resultsData = JSON.parse($searchContainer.find(\".results-container\").attr('data'));\r\n\r\n                if (resultsData.filter.length != 0) {\r\n                    self.removeFilter(\"filter_box\");\r\n\r\n                    // reset row count when changing the filter.\r\n                    self.resetRows();\r\n                    self.search.load();\r\n                }\r\n\r\n                window.setTimeout(function () { searchBox.focus(); }, 100);\r\n                return false;\r\n            } else {\r\n                cancelButton.fadeIn(20);\r\n                window.setTimeout(function () { searchBox.focus(); }, 100);\r\n            }\r\n        }, this));\r\n\r\n        cancelButton.off(\"click\").on(\"click\", $.proxy(function (event) {\r\n\r\n            cancelButton.fadeOut(20);\r\n            searchBox.val('');\r\n\r\n            //remove the filter if there is one applied\r\n            var $searchContainer = self.search.getSearchContainer();\r\n            var resultsData = JSON.parse($searchContainer.find(\".results-container\").attr('data'));\r\n\r\n            if (resultsData.filter.length != 0) {\r\n                $searchBox.find(\".indexer-list li a.selected\").removeClass(\"selected\");\r\n                $searchBox.find(\".page-index\").val(\"1\");\r\n\r\n                self.removeFilter(\"filter_box\");\r\n\r\n                // reset row count when changing the filter.\r\n                self.resetRows();\r\n                self.search.load();\r\n\r\n                return false;\r\n            }\r\n        }, this));\r\n\r\n\r\n\r\n        // handle cancel button if there is value in the search box on page load\r\n        if (searchBox.length > 0) {\r\n            if (searchBox.val().length === 0) {\r\n\r\n                cancelButton.hide();\r\n            } else {\r\n\r\n                cancelButton.show();\r\n            }\r\n        }\r\n\r\n\r\n        $searchBox.find(\".filter-box\").off(\"keypress\").on(\"keypress\", $.proxy(function (event) {\r\n            var code = (event.keyCode ? event.keyCode : event.which);\r\n            if (code == 10 || code == 13) {\r\n                ////$searchBox.find(\".indexer-list li a.selected\").removeClass(\"selected\");\r\n                $searchBox.find(\".page-index\").val(\"1\");\r\n\r\n                var value = $(event.currentTarget).val();\r\n                if (value !== \"\") {\r\n                    self.addFilter({ name: \"filter_box\", type: \"search\", value: self.removeSpecialCharacters(value), originalValue: value });\r\n                } else {\r\n                    // remove the filter is there is one with the same type.\r\n                    self.removeFilter(\"filter_box\");\r\n                }\r\n\r\n                // reset row count when changing the filter.\r\n                self.resetRows();\r\n                this.search.load();\r\n                return false;\r\n            }\r\n        }, this));\r\n        \r\n        // toggle the view options\r\n        $searchBox.find(\".views a\").off(\"click\").on(\"click\", $.proxy(function (event) {\r\n            var $link = $(event.currentTarget);\r\n            $searchBox.find(\".views a.selected\").removeClass(\"selected\");\r\n            $link.addClass(\"selected\");\r\n\r\n            self.search.presentationType = $link.attr(\"data-view\");\r\n\r\n            // reset row count when changing the filter.\r\n            self.resetRows();\r\n            self.search.load();\r\n            return false;\r\n        }, this));\r\n    };\r\n\r\n    this.getControlData = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $resultElement = $searchContainer.find(\".results-container\");\r\n        var data = JSON.parse($resultElement.attr(\"data\"));\r\n        data.presentationType = $resultElement.attr(\"data-presentation-type\");\r\n        return data;\r\n    };\r\n\r\n    this.setControl = function () {\r\n        var controlData = this.getControlData();\r\n        var $searchContainer = this.search.getSearchContainer();\r\n    };\r\n\r\n    this.resetButtons = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var controlData = this.getControlData();\r\n       \r\n        // select the button for the view we have\r\n        $searchContainer.find(\".view-button\").removeClass(\"selected\");\r\n        $searchContainer.find(\".view-button[data-view=\" + controlData.presentationType + \"]\").addClass(\"selected\");\r\n    };\r\n}\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/zugo/controlValueResolver.js\n * ======================================== */\n\n﻿var controlValueResolver = {\r\n    blacklist: ['ls'],\r\n\r\n    // pass in the search object is there is one.\r\n    // priority : 1. Hash, 2. QueryString, 3. Model, 4. DynoModel, 5. Search Variables\r\n    getParameters: function (searchObj, $input, dynoControlData, ignoreQuerystring, ignoreHash) {\r\n\r\n        var includeQuerystringParams = ignoreQuerystring == undefined || ignoreQuerystring == false;\r\n        var includeHashParams = ignoreHash == undefined || ignoreHash == false;\r\n\r\n        var allParameters = [],\r\n            mergedParams = [],\r\n            finalParams = [];\r\n\r\n        // these method calls need to stay in this order.\r\n        allParameters.push(controlValueResolver.parameters.search(searchObj));\r\n        allParameters.push(controlValueResolver.parameters.dyno(dynoControlData));\r\n        allParameters.push(controlValueResolver.parameters.controlParent($input));\r\n        allParameters.push(controlValueResolver.parameters.model($input));\r\n\r\n        if (includeQuerystringParams) {\r\n            allParameters.push(controlValueResolver.parameters.queryString());\r\n        }\r\n\r\n        if (includeHashParams) {\r\n            allParameters.push(controlValueResolver.parameters.arguments());\r\n            allParameters.push(controlValueResolver.parameters.hash());\r\n            allParameters.push(controlValueResolver.parameters.hashParameterCollection());\r\n        }\r\n\r\n        for (var i = 0; i < allParameters.length; i++) {\r\n            controlValueResolver.addParameters(allParameters[i], mergedParams);\r\n        }\r\n\r\n        // remove any blacklisted parameters.\r\n        for (var i = 0; i < mergedParams.length; i++) {\r\n\r\n            var ignore = false;\r\n\r\n            for (var j = 0; j < controlValueResolver.blacklist.length; j++) {\r\n\r\n                if (mergedParams[i] == controlValueResolver.blacklist) {\r\n                    ignore = true;\r\n                    break;\r\n                }\r\n            }\r\n\r\n            if (!ignore) {\r\n                finalParams.push(mergedParams[i]);\r\n            }\r\n        }\r\n\r\n        return finalParams;\r\n    },\r\n\r\n    addParameters: function (parameters, list) {\r\n        for (var i = 0; i < parameters.length; i++) {\r\n\r\n            var added = false;\r\n\r\n            for (var j = 0; j < list.length; j++) {\r\n\r\n                if (list[j].name == parameters[i].name) {\r\n                    list[j].value = parameters[i].value;\r\n                    added = true;\r\n                }\r\n            }\r\n\r\n            if (!added) {\r\n                list.push(parameters[i]);\r\n            }\r\n        }\r\n    },\r\n\r\n    parameters: {\r\n\r\n        dyno: function (allData) {\r\n            var dynoParams = [];\r\n\r\n            if (typeof (allData) !== 'undefined' && allData !== null) {\r\n                // loop each one of these and add to a collection.\r\n                for (var i = 0; i < allData.length; i++) {\r\n                    if (allData[i].value != undefined && allData[i].value != 'undefined' && allData[i].value != 'dynocontrol') {\r\n\r\n                        //dynoParams.push({ 'name': allData[i].id.toLowerCase(), 'value': allData[i].value });\r\n                        dynoParams.push({ 'name': allData[i].id, 'value': allData[i].value });\r\n                    }\r\n                }\r\n            }\r\n\r\n            return dynoParams;\r\n        },\r\n\r\n        controlParent: function ($input) {\r\n\r\n            var modelParams = [];\r\n            if ($input != undefined && $input != null) {\r\n\r\n                var parentType = $input.gcop().getAttribute(\"data-parent-type\");\r\n\r\n                switch (parentType) {\r\n                    case \"Deck\":\r\n                        // need to go up to dyno-deck-card-wrapper and get the row data.\r\n                        var $parentRow = $input.parents(\".dyno-deck-row\");\r\n                        var rowData = $parentRow.gcop().getAttribute(\"row-data\"); // for a deck this will be an array with an object inside.\r\n\r\n                        if (!isNullOrEmpty(rowData)) {\r\n                            var jsonData = JSON.parse(rowData);\r\n                            if (jsonData.length > 0) {\r\n\r\n                                // now loop each one of the properties on the object and add to model parameters as 'name' and 'value' pair.\r\n                                for (var i = 0, ii = jsonData.length; i < ii ; i++) {\r\n                                    //modelParams.push({ 'name': jsonData[i].id.toLowerCase(), 'value': jsonData[i].value });\r\n                                    modelParams.push({ 'name': jsonData[i].id, 'value': jsonData[i].value });\r\n                                }\r\n                            }\r\n                        }\r\n                        break;\r\n                    case \"Card\":\r\n                        // need to go up to dyno-card-card-wrapper and get the row data.\r\n                        var $parentRow = $input.parents(\".dyno-card-card-wrapper\");\r\n                        var rowData = $parentRow.gcop().getAttribute(\"row-data\"); // for a card this will be an array with an object inside.\r\n\r\n                        if (!isNullOrEmpty(rowData)) {\r\n                            var jsonData = JSON.parse(rowData);\r\n                            if (jsonData.length > 0) {\r\n\r\n                                // now loop each one of the properties on the object and add to model parameters as 'name' and 'value' pair.\r\n                                for (var i = 0, ii = jsonData.length; i < ii ; i++) {\r\n                                    //modelParams.push({ 'name': jsonData[i].id.toLowerCase(), 'value': jsonData[i].value });\r\n                                    modelParams.push({ 'name': jsonData[i].id, 'value': jsonData[i].value });\r\n                                }\r\n                            }\r\n                        }\r\n                        break;\r\n                    default:\r\n                        // do nothing\r\n                }\r\n            }\r\n\r\n            return modelParams;\r\n        },\r\n\r\n\r\n        hash: function () {\r\n            var hash = cpf.hash(),\r\n                hashParams = [];\r\n\r\n            // loop each one of these and add to a collection.\r\n            for (var key in hash) {\r\n                if (typeof (hash[key]) == 'object') {\r\n                    continue;\r\n                }\r\n\r\n                //hashParams.push({ 'name': key.toLowerCase(), 'value': hash[key] });\r\n                hashParams.push({ 'name': key, 'value': hash[key] });\r\n            }\r\n\r\n            return hashParams;\r\n        },\r\n\r\n        hashParameterCollection: function () {\r\n            var hash = cpf.hash(\"params\"),\r\n                hashParams = [];\r\n\r\n            // loop each one of these and add to a collection.\r\n            for (var key in hash) {\r\n                if (typeof (hash[key]) == 'object') {\r\n                    continue;\r\n                }\r\n\r\n                //hashParams.push({ 'name': key.toLowerCase(), 'value': hash[key] });\r\n                hashParams.push({ 'name': key, 'value': hash[key] });\r\n            }\r\n\r\n            return hashParams;\r\n        },\r\n\r\n        queryString: function () {\r\n            var queryParams = cpf.getQueryString();\r\n\r\n            //for (var i = 0; i < queryParams.length; i++) {\r\n            //    //queryParams[i].name = queryParams[i].name.toLowerCase();\r\n            //    queryParams[i].name = queryParams[i].name;\r\n            //}\r\n\r\n            return queryParams;\r\n        },\r\n        arguments: function() {\r\n            var arguments = cpf.getArguments();\r\n            return arguments;\r\n        },\r\n        model: function ($input) {\r\n\r\n            var modelParams = [];\r\n            if ($input != undefined && $input != null) {\r\n\r\n                var requiredParameters = $input.find(\".dyno-control-wrapper\").gcop().getAttribute(\"data-required-parameters\");\r\n                var paramArray = !isNullOrEmpty(requiredParameters) ? JSON.parse(requiredParameters) : [];\r\n\r\n                // check we have some parameters\r\n                if (paramArray.length > 0 && typeof ($MODEL) !== 'undefined') {\r\n                    // lets find the values for these parameters.\r\n                    for (var i = 0; i < paramArray.length; i++) {\r\n                        var key = paramArray[i];\r\n                        if ($MODEL[key]) {\r\n                            //modelParams.push({ 'name': key.toLowerCase(), 'value': $MODEL[key] });\r\n                            modelParams.push({ 'name': key, 'value': $MODEL[key] });\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n\r\n            return modelParams;\r\n        },\r\n\r\n        search: function (searchObj) {\r\n\r\n            var searchParams = [];\r\n\r\n            if (searchObj !== null && typeof (searchObj) !== 'undefined' && searchObj.searchParameters != null) {\r\n                searchParams = searchObj.searchParameters;\r\n\r\n                for (var i = 0; i < searchParams.length; i++) {\r\n                    //searchParams[i][\"value\"].name = searchParams[i][\"value\"].toLowerCase();\r\n                    searchParams[i][\"value\"].name = searchParams[i][\"value\"];\r\n                }\r\n            }\r\n\r\n            return searchParams;\r\n        }\r\n    }\r\n};\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/zugo/gridViewDefinition.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\nfunction gridViewDefinition(parent) {\r\n    this.$preview = 0;\r\n    this.search = parent;\r\n\r\n    this.initialise = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $grid = $searchContainer.find(\".grid\");\r\n        $grid.find(\"th:not(.sort-disabled)\").off(\"click\").on(\"click\", $.proxy(function (event) {\r\n            var $th = $(event.currentTarget);\r\n            var $span = $th.find(\"span.sort\");\r\n            if ($th.hasClass(\"sort-column\")) {\r\n                if ($span.hasClass(\"desc\")) {\r\n                    $span.removeClass(\"desc\").addClass(\"asc\");\r\n                } else {\r\n                    $span.removeClass(\"asc\").addClass(\"desc\");\r\n                }\r\n            } else {\r\n                $grid.find(\"th.sort-column span.sort\").removeClass(\"asc\").removeClass(\"desc\");\r\n                $grid.find(\"th.sort-column\").removeClass(\"sort-column\");\r\n                $th.addClass(\"sort-column\");\r\n                $span.addClass(\"asc\");\r\n            }\r\n            this.search.load(null, null, true);\r\n            return false;\r\n        }, this));\r\n\r\n        $grid.find(\"input.grid-select-all\").off(\"change\").on(\"change\", $.proxy(function (event) {\r\n            var selectAll = $(event.currentTarget).is(\":checked\");\r\n            $searchContainer = this.search.getSearchContainer();\r\n            $grid = $searchContainer.find(\".grid\");\r\n            $grid.find(\"td.item-selection-column input.grid-row-select\").prop(\"checked\", selectAll);\r\n            this.search.fireSelectRowEvent();\r\n        }, this));\r\n\r\n        $grid.find(\"input.grid-row-select\").off(\"change\").on(\"change\", $.proxy(function (event) {\r\n            if ($('input.grid-row-select:checked').length == $('input.grid-row-select').length) {\r\n                $('input.grid-select-all').prop('checked', true);\r\n            } else {\r\n                $('input.grid-select-all').prop('checked', false);\r\n            }\r\n            var $searchResults = this.search.getSearchContainer().find(\".search-results\");\r\n            $searchResults.trigger(\"selected\", { selectedRows: $('input.grid-row-select:checked') });\r\n        }, this));\r\n\r\n        this.redirect();\r\n        this.search.getSortAscButton().parent().hide();\r\n\r\n        // hovers\r\n        $grid.find(\"tr\").hover(function () {\r\n            $(this).addClass(\"hover\");\r\n        }, function () {\r\n            $(this).removeClass(\"hover\");\r\n        });\r\n\r\n        $grid.find(\"tr.no-results\").off(\"hover\");\r\n    };\r\n\r\n\r\n    this.getSortColumn = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $grid = $searchContainer.find(\".fixed-table-js\");\r\n        var $resultsGrid = $searchContainer.find(\".results-table-js\");\r\n        var sortColumn = \"\";\r\n        // added new code to check the results table too.\r\n        if ($grid.find(\".sort-column\").length === 1 || $resultsGrid.find(\".sort-column\").length === 1) {\r\n            if ($resultsGrid.find(\".sort-column\").length === 1) {\r\n                sortColumn = $resultsGrid.find(\".sort-column\").attr(\"data\");\r\n            } else {\r\n                sortColumn = $grid.find(\".sort-column\").attr(\"data\");\r\n            }\r\n        }\r\n\r\n        return sortColumn;\r\n    };\r\n\r\n    this.getSortDirection = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $grid = $searchContainer.find(\".fixed-table-js\");\r\n        var $resultsGrid = $searchContainer.find(\".results-table-js\");\r\n        var sortDirection = \"\";\r\n        var $sortColumn = \"\";\r\n        if ($grid.find(\".sort-column span.sort\").length === 1 || $resultsGrid.find(\".sort-column span.sort\").length === 1) {\r\n            if ($resultsGrid.find(\".sort-column span.sort\").length === 1){\r\n                $sortColumn = $resultsGrid.find(\".sort-column span.sort\");\r\n            } else {\r\n                $sortColumn = $grid.find(\".sort-column span.sort\");\r\n            }\r\n        }\r\n        this.search.control.sortDirection = \"\";\r\n        if ($sortColumn.hasClass(\"asc\")) {\r\n            sortDirection = \"asc\";\r\n        } else if ($sortColumn.hasClass(\"desc\")) {\r\n            sortDirection = \"desc\";\r\n        }\r\n\r\n        return sortDirection;\r\n    };\r\n\r\n    this.redirect = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $grid = $searchContainer.find(\".grid\");\r\n\r\n        $grid.find(\"tbody td:not(.item-selection-column):not(.popup-track-icons)\").off(\"click.tracks\").on(\"click.tracks\", $.proxy(function (event) {\r\n\r\n            if (this.search.disableDrill == false && !this.search.usingInlineData) {\r\n                // if they checked a box and clicked edit\r\n                var editButtonClicked = false;\r\n                var $editButton = $(\"#button-edit\");\r\n                if ($editButton.length > 0) {\r\n                    if ($editButton.gcop().hasClass(\"selected\")) {\r\n                        editButtonClicked = true;\r\n                    }\r\n                }\r\n\r\n                var $tr = $(event.currentTarget).parent().gcop();\r\n\r\n                if ($tr.hasClass(\"no-results\")) {\r\n                    return;\r\n                }\r\n\r\n                var drill = $tr.getAttribute(\"drillDownUrl\");\r\n                var preview = $tr.getAttribute(\"data-preview-url\");\r\n\r\n                var payload = {};\r\n                payload.ActionType = \"DrillDown\";\r\n                payload.searchVirtualFilePath = this.search.searchVirtualFilePath;\r\n\r\n                //Will need to update this if other types of searches become available\r\n                //if (this.search.isDefaultSearch === true) {\r\n                //    payload.searchType = \"DefaultSearch\";\r\n                //} else {\r\n                //    payload.searchType = \"Search\";\r\n                //}\r\n\r\n                payload.searchBuilderDefVirtualFilePath = this.search.searchBuilderDefVirtualFilePath;\r\n                payload.data = $(event.currentTarget).parent().attr(\"data-row\");\r\n\r\n                // if there is a preview, then show it. If not, just drill.\r\n                if (preview && this.search.preview.isOn == true && this.search.preview.$preview !== 0 && editButtonClicked == false) {\r\n                    $grid.find(\"tbody\").find(\"tr\").removeClass(\"selected\");\r\n                    this.preview(preview);\r\n                    $tr.addClass(\"selected\");\r\n                } else {\r\n                    $grid.find(\"tbody\").find(\"tr\").removeClass(\"selected\");\r\n                    $tr.addClass(\"selected\");\r\n\r\n                    // redirect to drill down url if container or search builder definition is not set. \r\n                    // Nb: this indicates that we are not in the compose search screen so tracks are not required.\r\n                    //if (this.search.containerName == \"\" || this.search.definitionName == \"\") {\r\n                    //    this.search.redirectTo(drill);\r\n                    //} else {\r\n                    this.search.getNavigationTrack(drill, payload, event);\r\n                    //}\r\n                }\r\n            }\r\n            return false;\r\n        }, this));\r\n    };\r\n\r\n    this.preview = function (url) {\r\n\r\n        if (this.search.preview.isOn == true && this.search.preview.$preview !== 0) {\r\n            var $iframe = this.search.preview.$preview.find(\"iframe\");\r\n            $iframe.fadeOut(\"fast\", $.proxy(function () {\r\n                this.search.preview.$preview.find(\"#preview-spinner\").show();\r\n                this.search.preview.$preview.find(\"iframe\").attr(\"src\", url);\r\n                this.search.preview.lastSelectedRowID = url;\r\n                this.search.preview.save();\r\n            }, this));\r\n        }\r\n\r\n        return false;\r\n    };\r\n}\r\n\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/zugo/multigridViewDefinition.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\nfunction multigridViewDefinition(parent) {\r\n    this.$preview = 0;\r\n    this.search = parent;\r\n\r\n    this.initialise = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $grid = $searchContainer.find(\".multigrid\");\r\n        $grid.find(\"th:not(.sort-disabled)\").off(\"click\").on(\"click\", $.proxy(function (event) {\r\n            var $th = $(event.currentTarget);\r\n            var $span = $th.find(\"span.sort\");\r\n            if ($th.hasClass(\"sort-column\")) {\r\n                if ($span.hasClass(\"desc\")) {\r\n                    $span.removeClass(\"desc\").addClass(\"asc\");\r\n                } else {\r\n                    $span.removeClass(\"asc\").addClass(\"desc\");\r\n                }\r\n            } else {\r\n                $grid.find(\"th.sort-column span.sort\").removeClass(\"asc\").removeClass(\"desc\");\r\n                $grid.find(\"th.sort-column\").removeClass(\"sort-column\");\r\n                $th.addClass(\"sort-column\");\r\n                $span.addClass(\"asc\");\r\n            }\r\n\r\n            this.search.load(null, null, true);\r\n            return false;\r\n        }, this));\r\n\r\n        $grid.find(\"input.grid-select-all\").off(\"change\").on(\"change\", $.proxy(function (event) {\r\n            var selectAll = $(event.currentTarget).is(\":checked\");\r\n            $searchContainer = this.search.getSearchContainer();\r\n            $grid = $searchContainer.find(\".multigrid\");\r\n            $grid.find(\"td.item-selection-column input.grid-row-select\").prop(\"checked\", selectAll);\r\n            this.search.fireSelectRowEvent();\r\n        }, this));\r\n\r\n        $grid.find(\"input.grid-row-select\").off(\"change\").on(\"change\", $.proxy(function (event) {\r\n            if ($('input.grid-row-select:checked').length == $('input.grid-row-select').length) {\r\n                $('input.grid-select-all').prop('checked', true);\r\n            } else {\r\n                $('input.grid-select-all').prop('checked', false);\r\n            }\r\n        }, this));\r\n\r\n        this.redirect();\r\n        this.search.getSortAscButton().parent().hide();\r\n\r\n        // hovers\r\n        $grid.find(\"tr\").hover(function () {\r\n            $(this).addClass(\"hover\");\r\n        }, function () {\r\n            $(this).removeClass(\"hover\");\r\n        });\r\n\r\n        $grid.find(\"tr.no-results\").off(\"hover\");\r\n    };\r\n\r\n\r\n    this.getSortColumn = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $grid = $searchContainer.find(\".multigrid\");\r\n        var sortColumn = \"\";\r\n        if ($grid.find(\".sort-column\").length == 1) {\r\n            sortColumn = $grid.find(\".sort-column\").attr(\"data\");\r\n        }\r\n\r\n        return sortColumn;\r\n    };\r\n\r\n    this.getSortDirection = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $grid = $searchContainer.find(\".multigrid\");\r\n        var sortDirection = \"\";\r\n        var $sortColumn = $grid.find(\".sort-column span.sort\");\r\n        this.search.control.sortDirection = \"\";\r\n        if ($sortColumn.hasClass(\"asc\")) {\r\n            sortDirection = \"asc\";\r\n        } else if ($sortColumn.hasClass(\"desc\")) {\r\n            sortDirection = \"desc\";\r\n        }\r\n\r\n        return sortDirection;\r\n    };\r\n\r\n    this.redirect = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $grid = $searchContainer.find(\".multigrid\");\r\n\r\n        $grid.find(\"tbody td:not(.item-selection-column):not(.popup-track-icons)\").on(\"click\", $.proxy(function (event) {\r\n\r\n            if (this.search.disableDrill == false) {\r\n                // if they checked a box and clicked edit\r\n                var editButtonClicked = false;\r\n                var $editButton = $(\"#button-edit\");\r\n                if ($editButton.length > 0) {\r\n                    if ($editButton.gcop().hasClass(\"selected\")) {\r\n                        editButtonClicked = true;\r\n                    }\r\n                }\r\n\r\n                var $tr = $(event.currentTarget).parent().gcop();\r\n\r\n                if ($tr.hasClass(\"no-results\")) {\r\n                    return;\r\n                }\r\n\r\n\r\n                var drill = $tr.getAttribute(\"drillDownUrl\");\r\n                var preview = $tr.getAttribute(\"data-preview-url\");\r\n\r\n                var payload = {};\r\n                payload.ActionType = \"DrillDown\";\r\n                payload.searchVirtualFilePath = this.search.searchVirtualFilePath;\r\n                payload.searchBuilderDefVirtualFilePath = this.search.searchBuilderDefVirtualFilePath;\r\n                //payload.data = JSON.stringify($(event.currentTarget).parent().attr(\"data-row\"));\r\n                payload.data = $(event.currentTarget).parent().attr(\"data-row\");\r\n\r\n\r\n\r\n                // if there is a preview, then show it. If not, just drill.\r\n                if (preview && this.search.preview.isOn == true && editButtonClicked == false) {\r\n                    $grid.find(\"tbody\").find(\"tr\").removeClass(\"selected\");\r\n                    this.preview(preview);\r\n                    $tr.addClass(\"selected\");\r\n                } else {\r\n                    $grid.find(\"tbody\").find(\"tr\").removeClass(\"selected\");\r\n                    $tr.addClass(\"selected\");\r\n\r\n                    // redirect to drill down url if container or search builder definition is not set. \r\n                    // Nb: this indicates that we are not in the compose search screen so tracks are not required.\r\n                    //if (this.search.containerName == \"\" || this.search.definitionName == \"\") {\r\n                    //    this.search.redirectTo(drill);\r\n                    //} else {\r\n                    this.search.getNavigationTrack(drill, payload, event);\r\n                    //}\r\n                }\r\n            }\r\n            return false;\r\n        }, this));\r\n    };\r\n\r\n\r\n    this.preview = function (url) {\r\n\r\n        if (this.search.preview.isOn == true) {\r\n            var $iframe = this.search.preview.$preview.find(\"iframe\");\r\n            $iframe.fadeOut(\"fast\", $.proxy(function () {\r\n                this.search.preview.$preview.find(\"#preview-spinner\").show();\r\n                this.search.preview.$preview.find(\"iframe\").attr(\"src\", url);\r\n                this.search.preview.lastSelectedRowID = url;\r\n                this.search.preview.save();\r\n            }, this));\r\n        }\r\n\r\n        return false;\r\n    };\r\n}\r\n\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/zugo/panelViewDefinition.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\nfunction panelViewDefinition(parent) {\r\n    this.$preview = 0;\r\n    this.search = parent;\r\n\r\n    this.initialise = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $panel = $searchContainer.find(\".panel\");\r\n\r\n        //if (this.search.enableDrillDown && this.search.enableDrillDown == true) {\r\n        //    $panel.find(\".panel-item .content\").on(\"click\", $.proxy(function (event) {\r\n        //        if (this.search.disableDrill == false) {\r\n        //            this.search.redirectTo($(event.currentTarget).parent().attr(\"drillDownUrl\"));\r\n        //        }\r\n        //       // return false;\r\n        //    }, this));\r\n        //}\r\n\r\n        this.search.initialiseSortButtons();\r\n\r\n        $panel.find(\"input.panel-select-all\").on(\"change\", $.proxy(function (event) {\r\n            var selectAll = $(event.currentTarget).is(\":checked\");\r\n            $searchContainer = this.search.getSearchContainer();\r\n            $panel = $searchContainer.find(\".panel\");\r\n            $panel.find(\"div.item-selection-column input.panel-row-select\").prop(\"checked\", selectAll);\r\n            this.search.fireSelectRowEvent();\r\n        }, this));\r\n\r\n        this.setUpRedirect($panel);\r\n\r\n        //$panel.find('.panel-item .explorer-panel').on(\"click\", function (event) {\r\n        //    event.preventDefault();\r\n        //    cpf.button.splash.click(event, $(this),\r\n        //      $.proxy(function () {\r\n        //          cpf.spin();\r\n        //          window.location = $(this).find('a').attr('href');\r\n        //      }, this));\r\n\r\n        //});\r\n\r\n        $panel.find('.panel-item .explorer-panel').on(\"click\", function (event) {\r\n            cpf.teleport();\r\n        });\r\n\r\n\r\n    };\r\n\r\n    this.isSortButtonsEnabled = function () {\r\n        return $.trim(this.search.getSortColumn()).length > 0;\r\n    };\r\n\r\n    this.setUpRedirect = function ($panel) {\r\n        if (this.search.enableDrillDown && this.search.enableDrillDown == true && this.search.control.hasTracks) {\r\n            $panel.find(\".panel-item .content\").on(\"click\", $.proxy(function (event) {\r\n                if (this.search.disableDrill == false) {\r\n                    //this.search.redirectTo($(event.currentTarget).parent().attr(\"drillDownUrl\"));\r\n\r\n                    var $tr = $(event.currentTarget).parent();\r\n\r\n                    //if ($tr.hasClass(\"no-results\")) {\r\n                    //    return;\r\n                    //}\r\n\r\n\r\n                    var drill = $tr.gcop().getAttribute(\"drillDownUrl\");\r\n                    var preview = $tr.gcop().getAttribute(\"data-preview-url\");\r\n\r\n                    var payload = {};\r\n                    payload.ActionType = \"DrillDown\";\r\n                    payload.searchVirtualFilePath = this.search.searchVirtualFilePath;\r\n                    payload.searchBuilderDefVirtualFilePath = this.search.searchBuilderDefVirtualFilePath;\r\n                    //payload.data = JSON.stringify($(event.currentTarget).parent().attr(\"data-row\"));\r\n\r\n                    var panelOverrideData = $(event.currentTarget).find('div[data-row]');\r\n                    if (panelOverrideData && panelOverrideData.length === 1) {\r\n                        payload.data = panelOverrideData.attr(\"data-row\");\r\n                    } else {\r\n                        payload.data = $(event.currentTarget).parent().attr(\"data-row\");\r\n                    }\r\n\r\n\r\n\r\n\r\n\r\n                    // if there is a preview, then show it. If not, just drill.\r\n                    if (preview && this.search.preview.isOn == true && editButtonClicked == false) {\r\n                        $grid.find(\"tbody\").find(\"tr\").removeClass(\"selected\");\r\n                        this.preview(preview);\r\n                        $tr.addClass(\"selected\");\r\n                    } else {\r\n                        $tr.addClass(\"selected\");\r\n\r\n                        //if (this.search.containerName == \"\" || this.search.definitionName == \"\") {\r\n                        //    this.search.redirectTo(drill);\r\n                        //} else {\r\n                        this.search.getNavigationTrack(drill, payload, event);\r\n                        //}\r\n                    }\r\n\r\n\r\n                    cpf.spin();\r\n\r\n\r\n                }\r\n                return false;\r\n            }, this));\r\n        }\r\n    };\r\n}\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/zugo/parameterisedDefinition.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\nfunction parameterisedDefinition(parent) {\r\n    var self = this;\r\n    this.search = parent;\r\n    this.initialise = function (data) {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        this.search.control.hideSearchToolbox(true);\r\n\r\n        // there may be a run button on the ribbon, but if this search is on a dyno form and there is now run button on the ribbon, we need to enable the hidden run button with class 'inline-run'\r\n        if ($(\"#run\").length == 1) {\r\n            // Add event to the run button that is returned when parameters are required by a search.\r\n            $(\"#run\").off(\"click\").on(\"click\", $.proxy(function () {\r\n                self.search.parameterised.runSearch($searchContainer);\r\n                return false;\r\n            }, this));\r\n        } else {\r\n            // find the inline run\r\n            var $inlineRun = this.search.$context.find(\".inline-run\");\r\n            $inlineRun.gcop().show();\r\n            $inlineRun.find(\"a\").off(\"click\").on(\"click\", $.proxy(function (event) {\r\n                self.search.parameterised.runSearch($searchContainer);\r\n                return false;\r\n            }, this));\r\n        }\r\n\r\n        this.search.parameterised.showRun(true);\r\n        var parametrisedEl = $searchContainer.find('#parameter-window');\r\n        if (parametrisedEl.length > 0) {\r\n            try {\r\n                var service = angular.element(document.body).injector().get(\"parameterisedSearchAccessService\");\r\n                service.safelyLoadParameterisedData(parametrisedEl[0], data.pageData)\r\n                    .then(function() {\r\n                        composeSearch.details.setUpConditionEvents($(\"#parameter-window\")); \r\n                    }, function(error) {\r\n                        composeSearch.details.setUpConditionEvents($(\"#parameter-window\")); \r\n                        throw error;\r\n                    });\r\n            } catch(error) {\r\n                console.error(error);\r\n            }\r\n        }\r\n    };\r\n\r\n    this.runSearch = function ($searchContainer) {\r\n        try {\r\n            var service = angular.element(document.body).injector().get(\"parameterisedSearchAccessService\");\r\n            service.safelyValidateAndReturnData()\r\n                .then(function(result) {\r\n                /*var $control = $searchContainer.find(\"#parameter-window\");\r\n                validation.reset($control);\r\n                var dataArray = [];\r\n                var valid = true;*/\r\n\r\n                /*var conditions = $control.find(\"tr.compose-searh-row\");\r\n                for (var i = 0, ii = conditions.length; i < ii; i++) {\r\n                    var $row = $(conditions.eq(i));\r\n                    var columnId = $row.find(\"div.column-name\").gcop().getAttribute(\"data-column-id\");\r\n                    var $valueTr = $row.find(\"td.condition-value\");\r\n                    var $valueDiv = $valueTr.find(\"div\").eq(0);\r\n\r\n\r\n                    var type = new conditionControl($valueDiv, columnId);\r\n\r\n                    //            var conditionValueType = $valueDiv.gcop().getAttribute(\"data-type\");\r\n                    //            var type = new conditionTypes[conditionValueType]($valueDiv, columnId);\r\n\r\n                    var result = type.validate(false);\r\n                    if (!result) {\r\n                        valid = false;\r\n                    }\r\n\r\n                    // add parameter to parameterisedArray\r\n                    //var parameter = {\r\n                    //    name: columnId,\r\n                    //    value: type.val()\r\n                    //};\r\n\r\n                    var values = type.val();\r\n\r\n                    // replace default (\"00/00/0000T00:00:00\") datetime values with null otherwise searches will not run.\r\n                    //var controlType = type.controlType();\r\n                    //if (controlType == \"date\") {\r\n                    //    for (var x = 0; x < parameter.value.length; x++) {\r\n                    //        for (var j = 0; j < parameter.value[x].value.length; j++) {\r\n                    //            if (parameter.value[x].value[j] == \"00/00/0000\") {\r\n                    //                parameter.value[x].value[j] = null;\r\n                    //            }\r\n                    //        }\r\n                    //    }\r\n                    //}\r\n\r\n                    for (var a = 0; a < values.length; a++) {\r\n                        dataArray.push(values[a]);\r\n                    }\r\n                }*/\r\n\r\n                if (result.isValid) {\r\n                    if (typeof incidents != \"undefined\" && incidents != null && incidents.list != null) {\r\n                        incidents.list.unbindHashChangedListener();\r\n                    }\r\n\r\n                    var dataArray = result.parameters;\r\n                    var settings = searchCache.get(this.search.searchCacheName, null);\r\n\r\n                    if (settings === null) {\r\n                        settings = this.search.createSearchData(null);\r\n                    }\r\n\r\n\r\n                    if (settings.searchParameters !== undefined) {\r\n\r\n                        for (var i = 0; i < settings.searchParameters.length; i++) {\r\n                            dataArray.push(settings.searchParameters[i]);\r\n                        }\r\n                    }\r\n\r\n                    //settings.cacheName = this.search.searchCacheName;\r\n                    settings.searchCacheName = this.search.searchCacheName;\r\n                    //settings.parameters = JSON.stringify(dataArray);\r\n\r\n                    this.search.parameterised.prepareForHash(dataArray);\r\n\r\n                    this.search.searchParameters = dataArray;\r\n                    this.search.run(settings);\r\n                            }\r\n                }, function(error) {\r\n                    throw(error);\r\n                });\r\n        } catch(error) {\r\n            console.error(error);\r\n        }\r\n        return false;\r\n    };\r\n\r\n    this.prepareForHash = function (parameters) {\r\n\r\n        var hashParams = {};\r\n\r\n        for (var i = 0; i < parameters.length; i++) {\r\n            hashParams[parameters[i].name] = parameters[i].value;\r\n        }\r\n\r\n        cpf.hash(\"params\", hashParams);\r\n    };\r\n\r\n    this.showRun = function (show) {\r\n        if (show) {\r\n            $(\"#run\").show();\r\n            //$(\"#parameterised-ribbon\").show();\r\n            $(\"#parameterised-ribbon\").css(\"display\", \"block\");\r\n            $(\"a.button-export-searchresults\").gcop().addClass(\"disabled\");\r\n        } else {\r\n            $(\"#run\").hide();\r\n            //$(\"#parameterised-ribbon\").show();\r\n            $(\"#parameterised-ribbon\").css(\"display\", \"block\");\r\n            $(\"a.button-export-searchresults\").gcop().removeClass(\"disabled\");\r\n        }\r\n\r\n        var changeParamsEl = $(\"#change-parameters\");\r\n        changeParamsEl.hide();\r\n        if (typeof ISPARAMETERISED !== 'undefined') {\r\n            if (ISPARAMETERISED && !show) {\r\n                changeParamsEl.show();\r\n            } else {\r\n                changeParamsEl.hide();\r\n            }\r\n        }\r\n    };\r\n}\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/zugo/previewDefinition.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\n// preview box to review details of zugo search results  \r\nfunction previewDefinition(parent) {\r\n    this.$preview = 0;\r\n    this.isOn = false;\r\n    this.$_results = 0;\r\n    this.$_button = 0;\r\n    this.leftMargin = 0;\r\n    this.lastSelectedRowID = 0;\r\n    this.search = parent;\r\n\r\n    this.getResultsElement = function () {\r\n        if (this.$_results == 0) {\r\n            this.$_results = $(\".search-results\");\r\n        }\r\n\r\n        return this.$_results;\r\n    };\r\n\r\n    this.getLeftMargin = function () {\r\n        if (this.leftMargin == 0) {\r\n            this.leftMargin = $(\".page-header-margin\").css(\"margin-left\");\r\n        }\r\n\r\n        return this.leftMargin;\r\n    };\r\n\r\n    this.getButton = function () {\r\n        if (this.$_button == 0) {\r\n            this.$_button = $(\"#button-preview\");\r\n        }\r\n\r\n        return this.$_button;\r\n    };\r\n\r\n    this.save = function () {\r\n        var previewStorageName = this.search.searchName + \"_previewOn\";\r\n        cpf.store.set(previewStorageName, { state: this.isOn, rowID: this.lastSelectedRowID });\r\n    };\r\n\r\n    this.load = function () {\r\n        var previewStorageName = this.search.searchName + \"_previewOn\";\r\n        var previewData = cpf.store.get(previewStorageName, false);\r\n\r\n        if (previewData) {\r\n            this.isOn = previewData.state;\r\n            this.lastSelectedRowID = previewData.rowID;\r\n        }\r\n    };\r\n}\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/zugo/search.js\n * ======================================== */\n\n/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\n;\r\nvar SEARCHES = {};\r\nfunction searchContext(id, $context) {\r\n    var self = this;\r\n    this.id = id;\r\n    this.$context = $context;\r\n    this.sortButtonsPrefix = '';\r\n    this.presentationType = 'grid';\r\n    this.initialLoad = true;\r\n    this.sortButtonsOnLoad = true;\r\n    this.sortButtonsInitialised = false;\r\n    this.displayName = '';\r\n    this.searchVirtualFilePath = '';\r\n    this.searchBuilderDefVirtualFilePath = '';\r\n    this.parameterValues = '';\r\n\r\n    this.maxCount = 0;\r\n    this.maxGrids = 1;\r\n    this.options = {};\r\n    this.$results = 0;\r\n    this.disableDrill = false;\r\n    this.onComplete = null;\r\n    this.identifier = '';\r\n\r\n    this.searchParameters = [];\r\n\r\n    this.showFullLoader = false;\r\n    this.forceRun = false;\r\n    this.enableDrillDown = true;\r\n    this.xjr = null;\r\n    this.control = new controlDefintion(this);\r\n    this.gridView = new gridViewDefinition(this);\r\n    this.angularGridView = new angularGridViewDefinition(this);\r\n    this.stackView = new stackViewDefinition(this);\r\n    this.panelView = new panelViewDefinition(this);\r\n    this.multigridView = new multigridViewDefinition(this);\r\n    this.searchLoader = new searchLoaderDefinition(this);\r\n    this.parameterised = new parameterisedDefinition(this);\r\n    this.preview = new previewDefinition(this);\r\n\r\n    this.maxOpenedPopTracks = 0;\r\n    this.openedPopTracks = [];\r\n\r\n    this.searchCacheName = \"\";\r\n    this.zugostyles = \"\";\r\n    this.searchUrlOverride = \"\";\r\n    this.usingInlineData = false;\r\n\r\n    this.inlineZugoStyleTemplate = null;\r\n\r\n    this.baseFilter = \"\";\r\n\r\n    this.setPageSize = function (pageSize) {\r\n        if (this.control != null) {\r\n            this.control.pageSize = pageSize\r\n        }\r\n    };\r\n\r\n    // parameter black list contains a list of querystring parameters that should be ignored.\r\n    this.parameterBlackList = [\"ls\"];\r\n\r\n    this.load = function (indexerFilter, pageDirection, reload) {\r\n\r\n        // use this flag to reset search reader properties, this is necessary when re-running searches after a record has been added or deleted.\r\n        if (reload) {\r\n            this.control.resetRows();\r\n        }\r\n\r\n        if (cpf.hash(\"deaggregate\") === \"true\") {\r\n            this.loadDeaggregate(indexerFilter, null);\r\n        } else {\r\n            // load existing search or create the new search data.\r\n            var data = this.createSearchData(indexerFilter);\r\n            if (reload) {\r\n                data.rowIndex = 0;\r\n            }\r\n\r\n            this.execute(\"\", data, pageDirection);\r\n            return false;\r\n        }\r\n\r\n        $('#mobile-search-toggle').off('click').on('click', function () {\r\n            $(this).parent().removeClass('mobile-hidden');\r\n        });\r\n    };\r\n\r\n    this.execute = function (indexerFilter, searchPayloadData, pageDirection) {\r\n\r\n        if (searchPayloadData.filters === \"[]\" && (searchPayloadData.filter === \"\" || searchPayloadData.filter === undefined)) {\r\n            if (!(this.baseFilter === undefined) && this.baseFilter !== \"\") {\r\n                searchPayloadData.filter = this.baseFilter;\r\n            }\r\n        }\r\n\r\n        if (searchPayloadData.initialLoad) {\r\n            this.control.resetRows();\r\n        }\r\n\r\n        if (pageDirection == null\r\n            || (searchPayloadData != null && searchPayloadData.initialLoad)) {\r\n\r\n            this.control.resetRows();\r\n        }\r\n\r\n        if (searchPayloadData != null && searchPayloadData.initialLoad) {\r\n            searchPayloadData.rowIndex = this.control.rowIndex;\r\n            searchPayloadData.pageSize = this.control.pageSize;\r\n        }\r\n\r\n        if (cpf.hash(\"deaggregate\") === \"true\") {\r\n            this.loadDeaggregate(indexerFilter, null);\r\n        } else {\r\n            // turn on the spinner\r\n            cpf.spin();\r\n            var $searchContainer = this.getSearchContainer();\r\n            this.$results = this.initialLoad ? $searchContainer : $searchContainer.find(\".search-results\");\r\n\r\n            // set the values of the control\r\n            //this.control.fillControlData();\r\n\r\n            // this.hideSearchContainer(true);\r\n            this.searchLoader.load(this.displayName, this.showFullLoader, this.cancelSearchCallback);\r\n            this.searchLoader.showLoader(true);\r\n\r\n            // these properties of data do not get saved to local storage\r\n            searchPayloadData.maxCount = this.maxCount;\r\n            searchPayloadData.showSearchControls = this.showSearchControls;\r\n            searchPayloadData.showSearchName = this.showSearchName;\r\n\r\n            var url = APPLICATIONPATH + (this.searchUrlOverride !== \"\" ? this.searchUrlOverride : \"cpf/search/display\");\r\n\r\n            var postData = searchPayloadData;\r\n\r\n            if (this.supplementDataFunc != undefined && typeof (this.supplementDataFunc) == \"function\") {\r\n                postData.dynoData = encodeURI(this.supplementDataFunc());\r\n            }\r\n\r\n            var arguments = { url: url, dataType: \"html\", type: \"POST\", data: postData, success: $.proxy(this.success, this, { pageDirection: pageDirection }), errorCallback: $.proxy(this.error, this) };\r\n            this.abortSearch();\r\n            this.xjr = cpf.ajax(arguments);\r\n\r\n            return false;\r\n        }\r\n    };\r\n\r\n    this.forceReRun = function () {\r\n\r\n        this.control.resetRows();\r\n\r\n        if (cpf.hash(\"deaggregate\") === \"true\") {\r\n            this.loadDeaggregate(indexerFilter, null);\r\n        } else {\r\n\r\n            // load existing search or create the new search data.\r\n            var data = this.getPayloadDataFromBrowserCache();\r\n\r\n            //reset row count\r\n            if (data != null && data.rowIndex != null) {\r\n                data.rowIndex = 0;\r\n            }\r\n\r\n            this.saveSearch(data);\r\n\r\n            // non cached\r\n            data.maxGrids = this.maxGrids;\r\n            data.initialLoad = false;\r\n            data.forceRun = true;\r\n            data.zugostyles = this.zugostyles;\r\n\r\n            this.execute(\"\", data);\r\n\r\n            return false;\r\n        }\r\n    };\r\n\r\n    this.getPayloadDataFromBrowserCache = function () {\r\n        var data = searchCache.get(this.searchCacheName, null);\r\n        if (data !== null) {\r\n            data.options = this.options;\r\n\r\n            this.setParametersFromURL();\r\n\r\n            data.parameters = this.searchParameters !== null ? JSON.stringify(this.searchParameters) : [];\r\n            this.control.filters = JSON.parse(data.filters);\r\n        }\r\n\r\n        return data;\r\n    };\r\n\r\n    this.loadDeaggregate = function (indexerFilter, rowData) {\r\n        // turn on the spinner\r\n        cpf.spin();\r\n        var $searchContainer = this.getSearchContainer();\r\n        this.$results = this.initialLoad ? $searchContainer : $searchContainer.find(\".search-results\");\r\n\r\n        // set the values of the control\r\n        this.control.fillControlData();\r\n\r\n        // load existing search or create the new search data.\r\n        var data = this.createSearchData(indexerFilter);\r\n\r\n        //this.hideSearchContainer(true);\r\n        this.searchLoader.load(this.displayName, this.showFullLoader, this.cancelSearchCallback);\r\n        this.searchLoader.showLoader(true);\r\n\r\n        // these properties of data do not get saved to local storage\r\n        data.maxCount = this.maxCount;\r\n        data.showSearchControls = this.showSearchControls;\r\n        data.showSearchName = this.showSearchName;\r\n        if (rowData === null) {\r\n            rowData = cpf.hash(\"deaggregateData\");\r\n        } else {\r\n            cpf.hash(\"deaggregateData\", rowData);\r\n            data.rowIndex = 0;\r\n        }\r\n\r\n        data.deaggregateRowData = rowData;\r\n        data.deaggregate = true;\r\n\r\n        var url = APPLICATIONPATH + (this.searchUrlOverride !== \"\" ? this.searchUrlOverride : \"cpf/search/display\");\r\n\r\n        var postData = data;\r\n\r\n        if (this.supplementDataFunc != undefined && typeof (this.supplementDataFunc) == \"function\") {\r\n            postData.dynoData = encodeURI(this.supplementDataFunc());\r\n        }\r\n\r\n        var arguments = { url: url, dataType: \"html\", type: \"POST\", data: postData, success: $.proxy(this.success, this, null), errorCallback: $.proxy(this.error, this) };\r\n        this.abortSearch();\r\n        this.xjr = cpf.ajax(arguments);\r\n\r\n        return false;\r\n    };\r\n\r\n    this.extendUrlWithQueryString = function (url) {\r\n        var searchUrl = APPLICATIONPATH + url;\r\n\r\n        if (window.location.href.indexOf('?') > 0) {\r\n            searchUrl = searchUrl + window.location.href.slice(window.location.href.indexOf('?'));\r\n        }\r\n\r\n        return searchUrl;\r\n    };\r\n\r\n    this.resizeSplitView = function (splitViewOn) {\r\n        if (splitViewOn) {\r\n            var $results = this.preview.getResultsElement();\r\n            var screenHeight = $(window).height();\r\n            var resultsControlHeight = $results.parent().height();\r\n            var height = resultsControlHeight - ((screenHeight / 2) + 20);\r\n            $results.css(\"height\", height + \"px\");\r\n        }\r\n    };\r\n\r\n    this.setSplitView = function (splitViewOn) {\r\n        var $results = this.preview.getResultsElement();\r\n\r\n        // we need to figure out how big to make the two horizontal 'windows', here we are 1 part results and 3 part preview\r\n        var screenHeight = $(window).height();\r\n        var resultsControlHeight = $results.parent().height();\r\n        var height = resultsControlHeight - ((screenHeight / 2) + 20);\r\n        var $button = this.preview.getButton();\r\n\r\n        if (splitViewOn) {\r\n            // set the left margin to whatever the \".page-header-margin\" is\r\n            var leftMargin = this.preview.getLeftMargin();\r\n\r\n            $results.css(\"height\", height + \"px\");\r\n\r\n            if (!this.preview.$preview) {\r\n                this.buildPreviewElement();\r\n            }\r\n\r\n            // add class to search results wrapper\r\n            $results.gcop().addClass(\"split-view\");\r\n            this.preview.isOn = true;\r\n\r\n            $button.gcop().addClass(\"selected\");\r\n            $button.gcop().addClass(\"disabled\");\r\n            this.preview.$preview.gcop().show();\r\n\r\n            if (this.preview.lastSelectedRowID) {\r\n                var $searchContainer = this.getSearchContainer();\r\n                var $rows = $searchContainer.find(\".results-container\").find(\".zugo-item\");\r\n                for (var i = 0, ii = $rows.length; i < ii; i++) {\r\n                    if ($rows.eq(i).gcop().getAttribute(\"data-preview-url\") == this.preview.lastSelectedRowID) {\r\n                        $rows.eq(i).find(\"td\").eq(1).click();\r\n                    }\r\n                }\r\n            }\r\n        } else {\r\n            // set the iframe back to the preview message\r\n            this.gridView.preview(APPLICATIONPATH + \"cpf/search/previewpleasechoose\");\r\n\r\n            $results.gcop().removeClass(\"split-view\");\r\n            this.preview.isOn = false;\r\n\r\n            $button.gcop().removeClass(\"selected\");\r\n            $button.gcop().removeClass(\"disabled\");\r\n            this.preview.$preview.gcop().hide();\r\n            this.getSearchContainer().find(\"tr\").removeClass(\"selected\");\r\n\r\n            $results.css(\"height\", \"\");\r\n        }\r\n\r\n        // refresh fixed header\r\n        if (cpf.browser.isIE() && cpf.browser.IEVersion() <= 9) {\r\n            // do not display fixed header\r\n        } else {\r\n            // display fixed header for all other browsers and IE > 9\r\n            var resultsContainer = this.$context.find('.search-results');\r\n            if (resultsContainer.length === 1) {\r\n                this.$results = resultsContainer;\r\n            }\r\n\r\n            this.buildGridViewTableFixedHeader();\r\n        }\r\n\r\n        this.preview.save();\r\n    };\r\n\r\n    // retuns false if the preview is already built\r\n    this.buildPreviewElement = function () {\r\n\r\n        var building = false;\r\n\r\n        if (this.preview.$preview == 0) {\r\n            this.preview.$preview = $(\"#preview-outer\");\r\n\r\n            if (this.preview.$preview.length == 0) {\r\n                building = true;\r\n\r\n                cpf.ajax({\r\n                    url: APPLICATIONPATH + \"cpf/search/preview\",\r\n                    dataType: \"html\",\r\n                    type: \"POST\",\r\n                    data: {},\r\n                    success: $.proxy(function (html) {\r\n                        this.preview.$preview = $(html);\r\n                        $(\"body\").append(this.preview.$preview);\r\n\r\n                        this.preview.$preview.find(\".close\").on(\"click\", $.proxy(function () {\r\n                            this.preview.$preview.gcop().hide();\r\n                            this.getSearchContainer().find(\"tr\").removeClass(\"selected\");\r\n\r\n                            this.preview.getButton().gcop().removeClass(\"selected\");\r\n                            this.preview.isOn = false;\r\n\r\n                            this.setSplitView(false);\r\n                        }, this));\r\n\r\n                        var $iframe = this.preview.$preview.find(\"iframe\");\r\n                        $iframe.on(\"load\", $.proxy(function () {\r\n                            this.preview.$preview.find(\"#preview-spinner\").hide();\r\n                            $iframe.fadeIn(\"fast\");\r\n                            this.preview.$preview.find(\"iframe\").contents().find(\"#scroll-content\").css(\"top\", \"0\");\r\n                        }, this));\r\n\r\n                        var timer = null;\r\n                        // handle window resizes\r\n                        $(window).resize($.proxy(function () {\r\n                            if (timer != null) {\r\n                                clearTimeout(timer);\r\n                                timer = null;\r\n                            }\r\n                            timer = setTimeout(function () {\r\n                                self.resizeSplitView(isNullOrEmpty(self.preview) ? false : self.preview.isOn);\r\n                                clearTimeout(timer);\r\n                                timer = null;\r\n                            }, 100);\r\n                        }, this));\r\n\r\n                        // now it's loaded, set the splitview\r\n                        this.setSplitView(isNullOrEmpty(this.preview) ? false : this.preview.isOn);\r\n                    }, this)\r\n                });\r\n            }\r\n        }\r\n\r\n        // check if the results support previews\r\n        var previews = this.getSearchContainer().find(\".zugo-item:first\").attr(\"data-preview-url\");\r\n        if (previews) {\r\n            // show the preview button\r\n            $(\"#preview-button\").show();\r\n            this.preview.getButton().off(\"click\").on(\"click\", $.proxy(function (event) {\r\n                var $button = $(event.currentTarget);\r\n\r\n                if ($button.gcop().hasClass(\"disabled\")) {\r\n                    return false;\r\n                }\r\n                else if ($button.gcop().hasClass(\"selected\")) {\r\n                    // remove class to search results wrapper\r\n                    this.setSplitView(false);\r\n\r\n                } else {\r\n                    // add class to search results wrapper\r\n                    this.setSplitView(true);\r\n                }\r\n\r\n                return false;\r\n            }, this));\r\n        }\r\n\r\n        return building;\r\n    };\r\n\r\n    this.createSearchData = function (indexerFilter) {\r\n\r\n        var useIndexer = true;\r\n        if (!indexerFilter || indexerFilter === \"\") {\r\n            useIndexer = false;\r\n        }\r\n\r\n        //var useIndexer = !(typeof (indexerFilter) == \" undefined\" || indexerFilter == null || $.trim(indexerFilter).length == 0);\r\n\r\n        ////// if we have already selected indexer use selected indexer\r\n        ////if (this.control.isIndexerSelected() && !useIndexer) {\r\n        ////    useIndexer = true;\r\n        ////    indexerFilter = this.control.getIndexerFilter();\r\n        ////}\r\n\r\n        var data = null;\r\n\r\n        if (this.initialLoad) {\r\n            data = this.getPayloadDataFromBrowserCache();\r\n        }\r\n\r\n        this.control.fillControlData();\r\n\r\n        // This IF was changed, if incident searches has an issue this might need to be reviewed\r\n        //if (data === null || (data !== null && this.identifier !== this.identifier)) {\r\n        if (data === null || (data !== null && data.identifier !== this.identifier)) {\r\n            this.setParametersFromURL();\r\n            data = {};\r\n            data.rowIndex = this.control.rowIndex;\r\n            data.pageSize = this.control.pageSize;\r\n            data.sortColumn = this.control.sortColumn;\r\n            data.sortDirection = this.control.sortDirection;\r\n            data.filter = useIndexer ? indexerFilter : this.control.filter;\r\n            data.displayName = this.displayName;\r\n            data.searchVirtualFilePath = this.searchVirtualFilePath;\r\n            data.searchBuilderDefVirtualFilePath = this.searchBuilderDefVirtualFilePath;\r\n            data.presentationType = this.presentationType;\r\n            data.parameterValues = this.parameterValues;\r\n            data.disableDrill = this.disableDrill;\r\n            if (this.options !== '' && this.options !== null) {\r\n                data.options = JSON.stringify(this.options);\r\n            }\r\n            data.identifier = this.identifier;\r\n            data.filters = JSON.stringify(this.control.filters);\r\n            data.parameters = this.searchParameters !== null ? encodeURI(JSON.stringify(this.searchParameters)) : [];\r\n            data.showFullLoader = this.showFullLoader;\r\n            //data.cacheName = this.searchCacheName;\r\n            data.searchCacheName = this.searchCacheName;\r\n            data.zugostyles = this.zugostyles;\r\n            data.searchUrlOverride = this.searchUrlOverride;\r\n        }\r\n\r\n        if (this.inlineZugoStyleTemplate != null) {\r\n            data.inlineZugoStyleTemplate = JSON.stringify(this.inlineZugoStyleTemplate);\r\n        }\r\n\r\n        if (useIndexer === true) {\r\n            data.filter = indexerFilter;\r\n        }\r\n        //else {\r\n        //    data.filter = \"\";\r\n        //}\r\n\r\n        this.saveSearch(data);\r\n\r\n        // non cached\r\n        data.maxGrids = this.maxGrids;\r\n        data.initialLoad = this.initialLoad;\r\n        // data.forceRun = (indexerFilter !== null && indexerFilter !== undefined) ? indexerFilter.forceRun : this.forceRun;\r\n        data.forceRun = this.forceRun;\r\n\r\n        return data;\r\n    };\r\n\r\n    this.saveSearch = function (searchOptions) {\r\n\r\n        if (this.settings !== null && this.settings !== undefined) {\r\n            //searchOptions.cacheName = this.settings.cacheName;\r\n            searchOptions.resultPanel = this.settings.resultPanel;\r\n            searchOptions.searchCacheName = this.settings.searchCacheName;\r\n\r\n            searchCache.set(this.settings.searchCacheName + \"_\" + searchOptions.filter, searchOptions);\r\n\r\n        } else {\r\n            searchCache.set(searchOptions.searchCacheName + \"_\" + searchOptions.filter, searchOptions);\r\n        }\r\n    };\r\n\r\n    this.setParametersFromURL = function () {\r\n\r\n        this.searchParameters = controlValueResolver.getParameters(this);\r\n\r\n        return this.searchParameters;\r\n    };\r\n\r\n    this.generateCacheName = function (searchName) {\r\n        var name = decodeURIComponent(searchName).replace(\" \", \"\");\r\n        name = USERID + \"_search_\" + name;\r\n        return name;\r\n    };\r\n\r\n    this.run = function (settings) {\r\n        // turn on the spinner\r\n        cpf.spin();\r\n\r\n        //create a class to flag that the search is present on the page (for mobile styling)\r\n        $('body').addClass('component-search');\r\n\r\n\r\n        this.settings = settings;\r\n\r\n        var $searchContainer = this.getSearchContainer();\r\n        this.$results = this.initialLoad ? $searchContainer : $searchContainer.find(\".search-results\");\r\n        this.searchVirtualFilePath = settings.searchVirtualFilePath;\r\n        this.searchBuilderDefVirtualFilePath = settings.searchBuilderDefVirtualFilePath;\r\n        this.containerName = settings.containerName;\r\n        this.searchName = settings.searchName;\r\n        this.searchNameEncoded = settings.searchNameEncoded;\r\n        this.cacheName = settings.cacheName;\r\n        this.definitionName = settings.definitionName;\r\n        this.showFullLoader = settings.showFullLoader ? settings.showFullLoader : false;\r\n        this.forceRun = settings.forceRun ? settings.forceRun : false;\r\n\r\n        var patt = /^[\"+\\\\+]+$/g;\r\n        var isValidOptions = patt.test(settings.options);\r\n        if (!isValidOptions) {\r\n            this.options = '';\r\n        }\r\n        else {\r\n            this.options = (settings.options == null || settings.options == undefined) ? '' : JSON.stringify(settings.options);\r\n        }\r\n\r\n        this.control.rowIndex = this.initialLoad ? 0 : settings.rowIndex;\r\n        this.control.sortColumn = settings.sortColumn;\r\n        this.control.sortDirection = settings.sortDirection;\r\n        this.searchCacheName = settings.searchCacheName;\r\n        this.maxGrids = settings.maxGrids;\r\n        this.zugostyles = settings.zugostyles;\r\n        this.displayName = settings.displayName;\r\n\r\n        if (settings.filters !== \"\" && settings.filters !== undefined && $.isArray(settings.filter)) {\r\n            this.control.filters = settings.filters;\r\n        } else {\r\n\r\n            var filters = [];\r\n            try {\r\n                filters = JSON.parse(settings.filters);\r\n            } catch (e) {\r\n\r\n            }\r\n\r\n            this.control.filters = filters;\r\n        }\r\n\r\n        // set the values of the control\r\n        this.control.fillControlData();\r\n\r\n        //if (!settings.forcedParameterChange) {\r\n        var parametersFromURL = this.setParametersFromURL();\r\n        if (parametersFromURL != undefined && parametersFromURL.length > 0) {\r\n            settings.parameters = JSON.stringify(parametersFromURL);\r\n        }\r\n        //}\r\n\r\n        var presentationType = settings.presentationType === undefined ? this.presentationType : settings.presentationType;\r\n\r\n        var maxGrids = 1;\r\n        if (presentationType == \"multigrid\") {\r\n            maxGrids = 1;\r\n        }\r\n\r\n        //build the request\r\n        var data = {\r\n            rowIndex: settings.rowIndex === undefined ? this.control.rowIndex : settings.rowIndex,\r\n            pageSize: settings.pageSize === undefined ? this.control.pageSize : settings.pageSize,\r\n            sortColumn: settings.sortColumn === undefined ? this.control.sortColumn : settings.sortColumn,\r\n            sortDirection: settings.sortDirection === undefined ? this.control.sortDirection : settings.sortDirection,\r\n            filter: settings.filter === undefined ? this.control.filter : settings.filter,\r\n            filters: (settings.fitlers === undefined || settings.filters.length === 0) ? JSON.stringify(this.control.filters) : settings.filters,\r\n            searchVirtualFilePath: settings.searchVirtualFilePath,\r\n            searchBuilderDefVirtualFilePath: settings.searchBuilderDefVirtualFilePath,\r\n            containerName: settings.containerName,\r\n            searchName: settings.searchName,\r\n            searchNameEncoded: settings.searchNameEncoded,\r\n            presentationType: presentationType,\r\n            definitionName: settings.definitionName,\r\n            parameterValues: settings.parameterValues,\r\n            disableDrill: settings.disableDrill,\r\n            options: this.options === null ? '' : JSON.stringify(settings.options),\r\n            initialLoad: this.initialLoad,\r\n            parameters: settings.parameters === undefined ? '' : encodeURI(JSON.stringify(settings.parameters)),\r\n            showFullLoader: settings.showFullLoader,\r\n            sortButtonsOnLoad: settings.sortButtonsOnLoad,\r\n            forceRun: settings.forceRun,\r\n            maxCount: settings.maxCount,\r\n            searchCacheName: settings.searchCacheName,\r\n            origin: settings.origin,\r\n            deaggregate: settings.deaggregate,\r\n            deaggregateRowData: settings.deaggregateRowData,\r\n            maxGrids: settings.maxGrids,\r\n            zugostyles: settings.zugostyles,\r\n            displayName: settings.displayName,\r\n            searchUrlOverride: settings.searchUrlOverride,\r\n            inlineZugoStyleTemplate: settings.inlineZugoStyleTemplate\r\n            //showSearchControls: settings.showSearchControls\r\n        };\r\n\r\n        if (this.initialLoad) {\r\n            //reset page index to 0 when initial load\r\n            data.rowIndex = 0;\r\n        }\r\n\r\n        this.saveSearch(data);\r\n\r\n        //this.hideSearchContainer(true);\r\n        this.searchLoader.load(this.displayName, this.showFullLoader, this.cancelSearchCallback);\r\n        this.searchLoader.showLoader(true);\r\n\r\n        // these properties of data do not get saved to local storage\r\n        data.maxCount = this.maxCount;\r\n        data.showSearchControls = this.showSearchControls;\r\n        data.showSearchName = this.showSearchName;\r\n        data.forcedParameterChange = settings.forcedParameterChange ? settings.forcedParameterChange : false;\r\n\r\n        var url = APPLICATIONPATH + (this.searchUrlOverride != \"\" ? this.searchUrlOverride : \"cpf/search/display\");\r\n\r\n        var postData = data;\r\n\r\n        if (this.supplementDataFunc != undefined && typeof (this.supplementDataFunc) == \"function\") {\r\n            postData.dynoData = encodeURI(this.supplementDataFunc());\r\n        }\r\n\r\n        var arguments = { url: url, dataType: \"html\", type: \"POST\", data: postData, success: $.proxy(this.success, this, null), errorCallback: $.proxy(this.error, this) };\r\n        this.abortSearch();\r\n        this.xjr = cpf.ajax(arguments);\r\n\r\n        return false;\r\n    };\r\n\r\n    this.abortSearch = function () {\r\n        if (!isNullOrEmpty(this.xjr)) {\r\n            this.xjr.abort();\r\n        }\r\n    };\r\n\r\n    this.success = function (runParams, resultString, textStatus, jqXHR) {\r\n        cpf.loader({\r\n            selector: \"#page\",\r\n            state: \"off\"\r\n        });\r\n\r\n        var result = JSON.parse(resultString);\r\n\r\n        var html = result.data.html;\r\n\r\n        // filter or new search so scroll to top of results\r\n        var scrollContainer = this.$results.find(\".mCSB_container\")[0] ||\r\n            this.$results.find(\".cscroll\")[0] ||\r\n            this.$results[0];\r\n        var scrollTo = !scrollContainer\r\n            ? 0\r\n            : scrollContainer.className.indexOf(\"mCSB_container\") > -1\r\n                ? Math.abs(scrollContainer.offsetTop)\r\n                : scrollContainer.scrollTop;\r\n\r\n        if (html.indexOf('id=\"parameter-window\"') !== -1) {\r\n            //do nothing here, the html is populated in the if else statememnt below\r\n            this.$results.html(html);\r\n            this.$results.parent().find('.fixed-table-head').hide();\r\n            BIND_SCROLLBARS(scrollContainer.className.indexOf(\"cscroll\") > -1\r\n                ? $(scrollContainer)\r\n                : $(scrollContainer).find(\".cscroll\"));\r\n\r\n        } else if (runParams != null && runParams.pageDirection != null) {\r\n            //do nothing here, the html is populated in the try block below\r\n        } else {\r\n            try {\r\n                // being here we do not have idea about the element id\r\n                var service = angular.element(document.body).injector().get(\"gridService\");\r\n                var gridId = service.getDefaultAngularGridViewId();\r\n                if(gridId) {\r\n                    service.setHTML(this.$results, html);\r\n                } else {\r\n                    this.$results.html(html);    \r\n                }\r\n            } catch (error) {\r\n                console.error(error);\r\n            }\r\n            BIND_SCROLLBARS(scrollContainer.className.indexOf(\"cscroll\") > -1\r\n                ? $(scrollContainer)\r\n                : $(scrollContainer).find(\".cscroll\"));\r\n\r\n            this.$results.parent().find('.fixed-table-head').show();\r\n        }\r\n\r\n\r\n        this.$results.trigger(\"loaded-data\"); // fire an event letting listeners know the data has been loaded\r\n\r\n        var maxScroll = this.$results[0].scrollHeight - this.$results[0].offsetHeight;\r\n        if (scrollTo >= maxScroll) scrollTo = maxScroll;\r\n        this.$results[0].scrollTop = scrollTo;\r\n\r\n        cpf.loader({\r\n            selector: this.$results.find('.loading-bar-container'),\r\n            state: \"off\"\r\n        });\r\n        cpf.loadingBar(this.$results.find('.loading-bar-container'), false);\r\n        $(\"#results\").gcop().show();\r\n\r\n        var $searchContainer = this.getSearchContainer();\r\n        var $searchResults = $(\".search-results\", $searchContainer);\r\n        var $resultsContainer = $(\".results-container\", $searchContainer);\r\n\r\n        this.searchLoader.showLoader(false);\r\n        //this.hideSearchContainer(false);\r\n\r\n        var fixedHeader = this.$context.find('.search-results').find('.fixed-table-head');\r\n\r\n        var resultsFound = false;\r\n        var hasRows = false;\r\n        var hashedSearchIdentifier = \"\";\r\n        //check if there is an exception\r\n        if ($searchContainer.find(\".exception\").length > 0) {\r\n            //remove fixed header\r\n            if (fixedHeader.length > 0) {\r\n                fixedHeader.remove();\r\n            }\r\n\r\n\r\n            $searchContainer.find(\"#exception-retry-button\").on(\"click\", $.proxy(function () {\r\n                this.load();\r\n                return false;\r\n            }, this));\r\n        }// check if any parameteres are required for this search\r\n        else if ($searchContainer.find(\"#parameter-window\").length > 0) {\r\n            //remove fixed header\r\n            if (fixedHeader.length > 0) {\r\n                fixedHeader.remove();\r\n            }\r\n            this.parameterised.initialise(result.data);\r\n\r\n            //reset row index, ready for next run\r\n            this.control.resetRows();\r\n        } else {\r\n\r\n            // check if there was any results.\r\n            try {\r\n                var data = JSON.parse(result.data.pageData);\r\n                resultsFound = data.totalResults === \"0\" ? false : true;\r\n                hashedSearchIdentifier = data.hashedSearchIdentifier;\r\n\r\n                // handle anything system search specific\r\n                $(\"#results\").trigger(\"systemsearch\", data.isSystemSearch);\r\n\r\n                var searchTitle = $('#results').attr('title');\r\n                $('#results .header h3').text(searchTitle);\r\n                if (searchTitle != undefined) {\r\n                    document.title = document.title + \" - \" + searchTitle;\r\n                }\r\n\r\n                //set control max pages\r\n                this.control.totalPages = data.totalPages;\r\n\r\n                if (data.hasTracks != null) {\r\n                    this.control.hasTracks = data.hasTracks;\r\n                    this.control.maxPopTracks = data.maxPopTracks;\r\n                }\r\n\r\n                //grab whoami\r\n                cpf.whoami.add(\"totalResults\", data.totalResults);\r\n                cpf.whoami.add(\"dateRan\", data.dateRan);\r\n\r\n                var indexMax = -1;\r\n                var indexMin = -1;\r\n\r\n                hasRows = data.pageRowCount !== 0;\r\n\r\n                if (data.startRowIndex == 0) {\r\n                    this.control.resetRows();\r\n                }\r\n\r\n                if (hasRows) {\r\n                    //set control row indexes\r\n                    if (data.startRowIndex < data.endRowIndex) {\r\n                        indexMax = data.endRowIndex;\r\n                        indexMin = data.startRowIndex;\r\n                    } else {\r\n                        indexMax = data.startRowIndex;\r\n                        indexMin = data.endRowIndex;\r\n                    }\r\n\r\n                    if (this.control.rowIndexMin === -1) {\r\n                        this.control.rowIndexMin = this.control.rowIndex;\r\n                    }\r\n                    if (indexMin < this.control.rowIndexMin) {\r\n                        this.control.rowIndexMin = indexMin;\r\n                    }\r\n\r\n                    if (this.control.rowIndexMax === -1) {\r\n                        this.control.rowIndexMax = this.control.rowIndex;\r\n                    }\r\n                    if (indexMax > this.control.rowIndexMax) {\r\n                        this.control.rowIndexMax = indexMax;\r\n                    }\r\n\r\n                    // put html onto the page\r\n                    if (runParams != null && runParams.pageDirection != null) {\r\n                        // append grid data\r\n                        var tbodyStartIndex = html.indexOf(\"<tbody>\");\r\n                        var tbodyEndIndex = html.indexOf(\"</tbody>\");\r\n\r\n                        if (tbodyStartIndex !== -1 && tbodyEndIndex !== -1) {\r\n                            var tbodyContent = html.substring(tbodyStartIndex + 7, tbodyEndIndex);\r\n                            if (runParams.pageDirection === 'next') {\r\n                                try {\r\n                                    var service = angular.element(document.body).injector().get(\"gridService\");\r\n                                    var gridId = service.getDefaultAngularGridViewId();\r\n                                    if(gridId) {\r\n                                        service.appendElement(this.$results.find('tbody'), tbodyContent);\r\n                                    } else {\r\n                                        this.$results.find('tbody').append(tbodyContent);\r\n                                    }\r\n                                } catch (error) {\r\n                                    console.error(error);\r\n                                }\r\n                            } else if (runParams.pageDirection === 'previous') {\r\n                                this.$results.find('tbody').prepend(tbodyContent);\r\n                            }\r\n                        } else {\r\n                            // not grid data, So append stack data\r\n                            var tempElement = document.createElement('div');\r\n                            tempElement.innerHTML = result.data.html;\r\n\r\n                            var stackResultsEl = this.$results.find('.stack.results-container');\r\n\r\n                            if (stackResultsEl.length === 1) {\r\n                                this.$results.find('.stack.results-container').append($(tempElement).find('.zugo-item'));\r\n                            } else {\r\n                                //not grid or stack, so try panel\r\n                                var panelResultsEl = this.$results.find('.panel.results-container');\r\n\r\n                                if (panelResultsEl.length === 1) {\r\n                                    this.$results.find('.panel.results-container').append($(tempElement).find('.zugo-item'));\r\n                                }\r\n                            }\r\n\r\n                        }\r\n                    }\r\n\r\n                    // (re)bind scroll event\r\n                    if (runParams == null\r\n                        || (runParams != null && runParams.pageDirection == null)\r\n                        || (runParams != null && runParams.pageDirection === 'next' && hasRows)) {\r\n\r\n                        this.$results.one(\"scrollBottom\", function () {\r\n                            self.loadNextPage();\r\n                        });\r\n                    }\r\n\r\n                    this.control.rowCount = this.control.rowCount + data.pageRowCount;\r\n                }\r\n                var $scrollPanels = this.$results.find(\".cscroll\");\r\n                if (!$scrollPanels.length) {\r\n                    BIND_SCROLLBARS(this.$results);\r\n                }\r\n                if (!hasRows) {\r\n                    this.$results.off(\"scrollBottom\");\r\n                }\r\n                this.updateCounts(data);\r\n            } catch (e) {\r\n                cpf.alert(\"RESOURCE{{search.js}:{SearchError}:{No search results to return.}}\", \"e\");\r\n                cpf.whoami.add(\"totalResults\", \"0\");\r\n            }\r\n\r\n            cpf.whoami.add(\"type\", \"Search\");\r\n\r\n            this.control.hideSearchToolbox(false);\r\n            this.parameterised.showRun(false);\r\n\r\n            var searchResultsFound = $searchResults.length > 0;\r\n            var isNoitemsFound = $resultsContainer.find(\".no-results\").length > 0;\r\n\r\n            // if paramterised search then show change parameters button\r\n            if ((typeof this.settings === \"undefined\") || (typeof this.settings.parameters === \"undefined\") || this.settings.parameters === null || this.searchParameters.length == 1) {\r\n                if ($(\"#parameterised-ribbon\").length) {\r\n                    $(\"#parameterised-ribbon\").hide();\r\n                }\r\n            }\r\n\r\n            if (!searchResultsFound || isNoitemsFound) {\r\n                $(\"a.button-export-searchresults\").gcop().addClass(\"disabled\");\r\n            } else {\r\n                $(\"a.button-export-searchresults\").gcop().removeClass(\"disabled\");\r\n            }\r\n\r\n            this.fireSelectRowEvent();\r\n            if (searchResultsFound) {\r\n                if (this.initialLoad) {\r\n                    // initial load that includes data presentation control\r\n                    this.initialLoad = false;\r\n                    this.control.initialise();\r\n                    this.setUpEvents();\r\n                } else {\r\n                    // reset data control\r\n                    this.control.setControl();\r\n                    this.setUpEvents();\r\n                }\r\n                if (!this.usingInlineData) {\r\n                    this.setUpPopTracks();\r\n                }\r\n                // enable or disable buttons\r\n                this.control.resetButtons();\r\n\r\n                //pump in search values.\r\n                this.control.updateControlData(resultsFound);\r\n\r\n                // initialise gridview, stack view or panel view events\r\n                this.initialiseResultControl();\r\n\r\n                if (this.onComplete) {\r\n                    this.onComplete();\r\n                }\r\n            }\r\n\r\n            //hide spinner (fix for tabbed windows) todo: review\r\n            var $spinner = $(\"#\" + this.$context.attr(\"id\")).parent().parent().prev();\r\n            //if ($spinner.gcop().hasClass(\"spinner\")) {\r\n            //    $spinner.hide();\r\n            //}\r\n\r\n            this.preview.load();\r\n\r\n            var $button = this.preview.getButton();\r\n            $button.off().on(\"click\", $.proxy(function (e) {\r\n                var buttonDiv = $(e.target);\r\n                if (buttonDiv.gcop().hasClass(\"disabled\")) {\r\n                    return false;\r\n                } else {\r\n                    this.setSplitView(true);\r\n                }\r\n            }, this));\r\n\r\n            // removing preview.\r\n            //if (this.buildPreviewElement() == false) {\r\n            //    this.setSplitView(this.preview.isOn);\r\n            //}\r\n\r\n            var cacheKey = \"\";\r\n            if (this.options !== '' && this.options !== null) {\r\n                cacheKey = this.options.cacheKey !== '' ? this.options.cacheKey : '';\r\n            }\r\n\r\n\r\n            //// (re)build fixed header\r\n            if (cpf.browser.isIE() && cpf.browser.IEVersion() <= 9) {\r\n                // do not display fixed header\r\n            } else {\r\n                // display fixed header for all other browsers and IE > 9\r\n                this.buildGridViewTableFixedHeader(this.showSearchControls);\r\n            }\r\n\r\n            this.ValidateSearchResults(cacheKey, hashedSearchIdentifier);\r\n        }\r\n\r\n        //once the results returned fire custom trigger \r\n        $(this.$context).parent().parent().parent().parent().trigger('searchResultsReturned');\r\n\r\n        //event used for resizing fixed headers after page content change\r\n        angular.element('.fixed-table-js').trigger('update.fixedHeader');\r\n\r\n        if (hasRows) {\r\n            this.loadNextPageIfNoScroll();\r\n        }\r\n        return false;\r\n    };\r\n\r\n    this.updateCounts = function (pageData) {\r\n        var displayName = \"\";\r\n        if (pageData.startRowIndex === 0 && pageData.pageRowCount === 0) {\r\n            displayName = 0 + \"RESOURCE{{search.js}:{Results}:{ results}}\";\r\n        }\r\n        else if (isNullOrEmpty(pageData.filter) || pageData.totalResults > pageData.pageRowCount) {\r\n            // to have dynamic expression supported we should consider using standards-based message format like: \r\n            // https://docs.angularjs.org/guide/i18n#messageformat-extensions\r\n            if (this.control.rowCount >= pageData.totalResults) {\r\n                displayName = pageData.totalResults + \"RESOURCE{{search.js}:{Of}:{ of }}\" + pageData.totalResults + \"RESOURCE{{search.js}:{Results}:{ results}}\";\r\n            } else {\r\n                displayName = this.control.rowCount + \"RESOURCE{{search.js}:{Of}:{ of }}\" + pageData.totalResults + \"RESOURCE{{search.js}:{Results}:{ results}}\";\r\n            }\r\n        } else {\r\n            displayName = pageData.totalResults + \"RESOURCE{{search.js}:{Results}:{ results}}\";\r\n        }\r\n\r\n        if ($(\".results-count-message\").length > 1) {\r\n            $('#' + this.id + \" .results-count-message\").text(displayName);\r\n        } else {\r\n            $(\".results-count-message\").text(displayName);\r\n        }\r\n    },\r\n\r\n        this.error = function (xmlhttp, message, exception) {\r\n            cpf.spin(false);\r\n\r\n            // clear the cache for this search so we dont get stuck.\r\n            searchCache.remove(this.searchCacheName);\r\n            this.searchLoader.cancelSearch();\r\n\r\n            $(\"a.button-export-searchresults\").gcop().addClass(\"disabled\");\r\n            //search.$results.html(message);\r\n            cpf.alert(\"RESOURCE{{search.js}:{SearchError}:{There has been an error in a search request. Please contact your administrator.}}\", \"e\");\r\n        };\r\n\r\n    this.cancelSearchCallback = function () {\r\n        this.control.filter = null;\r\n        this.control.filters = [];\r\n        this.control.hiddenFilter = null;\r\n        this.load();\r\n    };\r\n\r\n    this.getSortAscButton = function () {\r\n        return this.sortButtonsPrefix.length > 0 ? $(\"#\" + this.sortButtonsPrefix + \"-sort-asc\") : $(\"#sort-asc\");\r\n    };\r\n\r\n    this.getSortDescButton = function () {\r\n        return this.sortButtonsPrefix.length > 0 ? $(\"#\" + this.sortButtonsPrefix + \"-sort-desc\") : $(\"#sort-desc\");\r\n    };\r\n\r\n    this.getSearchContainer = function () {\r\n        if (this.settings !== null && this.settings !== undefined) {\r\n            var $resultPanel = $(this.settings.resultPanel);\r\n            if ($resultPanel.length == 1) {\r\n                return $resultPanel;\r\n            } else {\r\n                return this.$context;\r\n            }\r\n        }\r\n\r\n        return this.$context;\r\n    };\r\n\r\n    this.hideSearchContainer = function (hide) {\r\n        if (hide) {\r\n            this.getSearchContainer().hide();\r\n        } else {\r\n            this.getSearchContainer().fadeIn(75);\r\n        }\r\n    };\r\n\r\n    this.createSelectedItemFilter = function () {\r\n        var filters = [];\r\n        var selectedItems = this.selectedRows();\r\n\r\n        // RowID is always at position 0\r\n        var rowIdColumnIndex = 0;\r\n        for (var i = 0; i < selectedItems.length; i++) {\r\n            filters.push('field[\"' + selectedItems[i][rowIdColumnIndex][\"id\"] + '\"]==\"' + selectedItems[i][rowIdColumnIndex][\"value\"] + '\"');\r\n        }\r\n\r\n        return filters.join(\"||\");\r\n    };\r\n\r\n    this.fireSelectRowEvent = function () {\r\n        var $searchContainer = this.getSearchContainer();\r\n        var selectedRows = [];\r\n\r\n        $searchContainer.find(\".results-container .item-selection-column input[type=checkbox]:checked\").closest(\".zugo-item\").each(function (i) {\r\n            var rowData = JSON.parse($(this).attr(\"data-row\"));\r\n            selectedRows.push(rowData);\r\n        });\r\n\r\n        var eventsArgs = {};\r\n        eventsArgs.selectedRows = selectedRows;\r\n        $searchContainer.find(\".search-results\").trigger(\"selected\", [eventsArgs]);\r\n    };\r\n\r\n    //this.fireRemoveRowEvent = function () {\r\n    //    var $searchContainer = this.getSearchContainer();\r\n    //    var removedRows = new Array();\r\n\r\n    //    $searchContainer.find(\".results-container .item-selection-column input[type=checkbox]:checked\").closest(\".zugo-item\").each(function (i) {\r\n    //        var rowData = JSON.parse($(this).attr(\"data-row\"));\r\n    //        removedRows.push(rowData);\r\n    //    });\r\n\r\n    //    var eventsArgs = {};\r\n    //    eventsArgs.selectedRows = selectedRows;\r\n    //    $searchContainer.find(\".search-results\").trigger(\"selected\", [eventsArgs]);\r\n    //};\r\n\r\n    // when rows are selected, an event is fired with an array of the selected rows\r\n    this.setUpEvents = function () {\r\n        var $searchContainer = this.getSearchContainer();\r\n        var $checkboxes = $searchContainer.find(\".results-container .item-selection-column input[type=checkbox]\");\r\n        $checkboxes.off(\"click\").on(\"click\", $.proxy(function () {\r\n            this.fireSelectRowEvent();\r\n        }, this));\r\n\r\n        if ($(\"#button-export-to-excel\").length > 0) {\r\n            $(\"#button-export-to-excel\").off(\"click\").on(\"click\", $.proxy(function () {\r\n\r\n                if ($(\"#button-export-to-excel\").hasClass(\"disabled\") === true) {\r\n                    return false;\r\n                } else {\r\n                    var exportSelectedItemsOnly = this.selectedRows().length > 0;\r\n                    var url = APPLICATIONPATH + \"cpf/core/ExportCSV\";\r\n                    var $exportform = $(\"<form action='\" + url + \"' method='POST' ></form>\");\r\n                    var postdata = JSON.parse($(\".results-container\").attr(\"data\"));\r\n                    var filter = exportSelectedItemsOnly ? this.createSelectedItemFilter() : postdata[\"filter\"];\r\n\r\n                    /*var $rowIndex = $(\"<input type='hidden' name='rowIndex' value=''/>\");\r\n                    $exportform.append($rowIndex);*/\r\n\r\n                    var $pageSize = $(\"<input type='hidden' name='pageSize' value=''/>\");\r\n                    $exportform.append($pageSize);\r\n\r\n                    var $sortColumn = $(\"<input type='hidden' name='sortColumn' value='\" + postdata[\"sortColumn\"] + \"'/>\");\r\n                    $exportform.append($sortColumn);\r\n\r\n                    var $sortDirection = $(\"<input type='hidden' name='sortDirection' value='\" + postdata[\"sortDirection\"] + \"'/>\");\r\n                    $exportform.append($sortDirection);\r\n\r\n                    var $filter = $(\"<input type='hidden' name='filter' value='\" + filter + \"'/>\");\r\n                    $exportform.append($filter);\r\n\r\n                    var $searchVirtualFilePath = $(\"<input type='hidden' name='searchVirtualFilePath' value='\" + this.searchVirtualFilePath + \"'/>\");\r\n                    $exportform.append($searchVirtualFilePath);\r\n\r\n                    var parameterValues = isNullOrEmpty(this.parameterValues) ? \"\" : this.parameterValues;\r\n                    var $parameterValues = $(\"<input type='hidden' name='parameterValues' value='\" + parameterValues + \"'/>\");\r\n                    $exportform.append($parameterValues);\r\n\r\n                    if (!isNullOrEmpty(this.options) && !isNullOrEmpty(this.options.cacheKey)) {\r\n                        var $cacheKey = $(\"<input type='hidden' name='cacheKey' value='\" + this.options.cacheKey + \"'/>\");\r\n                        $exportform.append($cacheKey);\r\n                    }\r\n\r\n                    var searchParameters = this.searchParameters !== null ? JSON.stringify(this.searchParameters) : [];\r\n                    var $searchParameters = $(\"<input type='hidden' name='searchParameters' value='\" + searchParameters + \"'/>\");\r\n                    $exportform.append($searchParameters);\r\n\r\n                    $(\"body\").append($exportform);\r\n                    $exportform.submit();\r\n\r\n                    return false;\r\n                }\r\n            },\r\n                this));\r\n        }\r\n\r\n        $(\"#force-run-search\").off(\"click\").on(\"click\", $.proxy(function () {\r\n            $(\"#refresh-results-box\").fadeOut(\"fast\");\r\n            this.forceReRun();\r\n        }, this));\r\n\r\n        $(\"#cancel-force-run-search\").off(\"click\").on(\"click\", function () {\r\n            $(\"#refresh-results-box\").fadeOut(\"fast\");\r\n        });\r\n\r\n        return false;\r\n    };\r\n\r\n    this.setUpPopTracks = function () {\r\n        function getNextPopTrackZIndex() {\r\n            var popTrackWindows = $(\"#scroll-content\").find('.pop-track-wrapper');\r\n            var nextIndex = \"3\";\r\n            for (var i = 0, len = popTrackWindows.length; i < len; i++) {\r\n                var zIndex = $(popTrackWindows[i]).css('z-index');\r\n                if (zIndex != null && zIndex > nextIndex) {\r\n                    nextIndex = zIndex;\r\n                }\r\n            }\r\n\r\n            return (nextIndex + 1).toString();\r\n        }\r\n\r\n        var $searchContainer = this.getSearchContainer();\r\n        var $popupBoxes = $searchContainer.find(\".pop-track-button\");\r\n        $popupBoxes.off(\"click.poptrack\").on(\"click.poptrack\", $.proxy(function (event) {\r\n            var $popUpButton = $(event.target);\r\n            $popUpButton.parent().parent().parent().find(\"tr\").removeClass(\"selected\");\r\n            $popUpButton.parent().parent().gcop().addClass('selected');\r\n\r\n            var popUpUrl = $popUpButton.attr(\"pop-url\");\r\n            var resolvedPopUpUrl = trackLite.popUp.getPopNavigationTrack(popUpUrl, $popUpButton);\r\n\r\n            if (resolvedPopUpUrl === false) {\r\n                cpf.alert(\"RESOURCE{{search.js}:{ErrorFetchingPopUpWindow}:{There was an error fetching pop up window. There are missing values for parameters. Please contact support.}}\", \"e\");\r\n                return false;\r\n            } else {\r\n                //get the content for the pop up box\r\n                var popupWindowId = trackLite.popUp.createPopupID($popUpButton);\r\n                //var popUpContent = trackLite.popUp.getPopUpWindowContent(resolvedPopUpUrl, popupWindowId);\r\n                var popUpRowId = trackLite.popUp.getPopUpRowID($popUpButton);\r\n                var nextRowId = $popUpButton.attr(\"pop-next-row-id\");\r\n                var prevRowId = $popUpButton.attr(\"pop-prev-row-id\");\r\n                var popUpHeaderText = $popUpButton.attr(\"alt\");\r\n                if (popUpHeaderText == null) {\r\n                    popUpHeaderText = '';\r\n                }\r\n\r\n                var popWindows = $('#scroll-content').find('.pop-track-wrapper');\r\n\r\n                if ($(\"#\" + popupWindowId).length > 0) {\r\n                    //there is already a pop up box for the \r\n                    var popUpWindow = $(\"#\" + popupWindowId);\r\n                    popUpWindow.css('z-index', getNextPopTrackZIndex());\r\n                    popUpWindow.show();\r\n                } else {\r\n                    //create unique pop up box\r\n\r\n                    if (resolvedPopUpUrl.indexOf(\"http\") !== 0) {\r\n                        resolvedPopUpUrl = FULLAPPLICATIONPATH + resolvedPopUpUrl;\r\n                    }\r\n\r\n                    // clear the list of opened tracks of any that have been closed by the user\r\n                    function clearClosedTracks() {\r\n                        var closed = [];\r\n                        if (self.openedPopTracks != null && self.openedPopTracks.length > 0) {\r\n                            for (var i = 0, len = self.openedPopTracks.length; i < len; i++) {\r\n                                if (self.openedPopTracks[i].winRef.closed) {\r\n                                    closed.push(i);\r\n                                }\r\n                            }\r\n                        }\r\n\r\n                        for (var j = closed.length - 1; j > -1; j--) {\r\n                            // remove closed tracks\r\n                            self.openedPopTracks.splice(closed[j], 1);\r\n                        }\r\n                    }\r\n\r\n                    clearClosedTracks();\r\n\r\n                    //make previous child windows visible\r\n                    function bringChildWindowsToFront() {\r\n                        for (var i = 0, len = self.openedPopTracks.length; i < len; i++) {\r\n                            self.openedPopTracks[i].winRef.focus();\r\n                        }\r\n                    }\r\n\r\n                    // Check opened pop tracks, if url in list then bring window to front\r\n                    function checkOpenedPopTracks() {\r\n                        for (var i = 0, len = self.openedPopTracks.length; i < len; i++) {\r\n                            if (self.openedPopTracks[i].url === resolvedPopUpUrl) {\r\n                                bringChildWindowsToFront();\r\n                                self.openedPopTracks[i].winRef.focus();\r\n                                return true;\r\n                            }\r\n\r\n                        }\r\n\r\n                        return false;\r\n                    }\r\n\r\n                    var alreadyOpened = checkOpenedPopTracks();\r\n\r\n                    if (alreadyOpened) {\r\n                        // already opened, so end\r\n                        return false;\r\n                    }\r\n\r\n                    // check max tracks and close first if there are too many open\r\n                    function popTrackMaxOpened() {\r\n                        if (self.control.maxPopTracks != null && (self.control.maxPopTracks !== 0 && self.openedPopTracks.length >= self.control.maxPopTracks)) {\r\n                            // close first track\r\n                            self.openedPopTracks[0].winRef.close();\r\n                            self.openedPopTracks.splice(0, 1);\r\n                        }\r\n                    }\r\n\r\n                    popTrackMaxOpened();\r\n\r\n                    // Calculate next window position\r\n                    function getNextWindowPosition(newWindowWidth, newWindowheight) {\r\n                        if (newWindowWidth == null) {\r\n                            newWindowWidth = window.screen.width * 0.8;\r\n                        }\r\n\r\n                        if (newWindowheight == null) {\r\n                            newWindowheight = window.screen.height * 0.8;\r\n                        }\r\n\r\n                        if (self.openedPopTracks == null || self.openedPopTracks.length === 0) {\r\n                            //no open window so return top left of screen\r\n                            return {\r\n                                left: window.screen.availLeft,\r\n                                top: window.screen.availTop,\r\n                                width: newWindowWidth,\r\n                                height: newWindowheight\r\n                            }\r\n                        } else {\r\n                            //get last open track and open the next window on a slight offset (similar to windows cascade)\r\n                            var right = window.screen.availLeft + window.screen.availWidth;\r\n                            var bottom = window.screen.availTop + window.screen.availHeight;\r\n\r\n                            var winRef = self.openedPopTracks[self.openedPopTracks.length - 1].winRef;\r\n                            var newWinPosition = {\r\n                                left: winRef.screenX + 30,\r\n                                top: winRef.screenY + 30,\r\n                                width: newWindowWidth,\r\n                                height: newWindowheight\r\n                            };\r\n\r\n                            if ((newWinPosition.left + newWindowWidth) > right || (newWinPosition.top + newWindowheight) > bottom) {\r\n                                // goes past the screen edge so reset cascade to top left of screen\r\n                                newWinPosition.left = window.screen.availLeft;\r\n                                newWinPosition.top = window.screen.availTop;\r\n                            }\r\n\r\n                            return newWinPosition;\r\n                        }\r\n                    }\r\n\r\n                    bringChildWindowsToFront();\r\n\r\n                    //set up selected pop track\r\n                    var newWindowDimensions = getNextWindowPosition();\r\n                    var winRef = window.open(resolvedPopUpUrl, Date.now().toString(), 'width=' + newWindowDimensions.width + ',height=' + newWindowDimensions.height + ',top=' + newWindowDimensions.top + ', left=' + newWindowDimensions.left);\r\n\r\n                    var openedTrack = {\r\n                        url: resolvedPopUpUrl,\r\n                        winRef: winRef\r\n                    };\r\n\r\n                    self.openedPopTracks.push(openedTrack);\r\n                    /*\r\n                    //This is the old pop track code - opening in iframe\r\n                    \r\n                    var popUpContainerString =\r\n                        '<div id=\\\"' + popupWindowId + '\\\" data-row-id=\\\"' + popUpRowId + '\\\" pop-next-row-id=\\\"' + nextRowId + '\\\" pop-prev-row-id=\\\"' + prevRowId + '\\\" pop-url=\\\"' + popUpUrl + '\\\">' +\r\n                            '<div class=\"pop-track-container\">' +\r\n                                '<div class=\"pop-track-header\">' +\r\n                                    '<span class=\"track-close fa fa-remove\"></span>' +\r\n                                    '<h3>' + popUpHeaderText + '</h3>' +\r\n                                '</div>' +\r\n                                '<div class=\"pop-track-content\">' +\r\n                                    '<iframe src=\"' + resolvedPopUpUrl + '\"></iframe>' +\r\n                                '</div>' +\r\n                            '</div>' +\r\n                        '</div>';\r\n\r\n                    $(\"#scroll-content\").append(popUpContainerString);\r\n\r\n                    var popUpElement = $(\"#\" + popupWindowId);\r\n                    popUpElement.addClass(\"pop-up-draggable-box pop-track-wrapper\");\r\n                    popUpElement.draggable({ containment: \"document\", stack: \".pop-track-wrapper\" });\r\n                    popUpElement.find('.track-close').off('click.close').on('click.close', function () { $(\"#\" + popupWindowId).hide(); });\r\n                    popUpElement.css('z-index', getNextPopTrackZIndex());\r\n\r\n                    //TODO: sort out draw of the window*/\r\n                }\r\n            }\r\n            return false;\r\n        }, this));\r\n    };\r\n\r\n    this.selectedRows = function () {\r\n        var $searchContainer = this.getSearchContainer();\r\n        var selectedRows = [];\r\n        $searchContainer.find(\".results-container .item-selection-column input[type=checkbox]:checked\").closest(\".zugo-item\").each(function (i) {\r\n            var rowData = JSON.parse($(this).attr(\"data-row\"));\r\n            selectedRows.push(rowData);\r\n        });\r\n\r\n        return selectedRows;\r\n    };\r\n\r\n    this.initialiseResultControl = function () {\r\n        var $searchContainer = this.getSearchContainer();\r\n        var presentationType = $searchContainer.find(\".results-container\").attr(\"data-presentation-type\");\r\n\r\n        switch (presentationType) {\r\n            case \"grid\":\r\n                this.presentationType = \"grid\";\r\n                this.gridView.initialise();\r\n                break;\r\n            case \"stack\":\r\n                this.presentationType = \"stack\";\r\n                this.stackView.initialise();\r\n                break;\r\n            case \"panel\":\r\n                this.presentationType = \"panel\";\r\n                this.panelView.initialise();\r\n                break;\r\n            case \"multigrid\":\r\n                this.presentationType = \"multigrid\";\r\n                this.multigridView.initialise();\r\n                break;\r\n            case \"angulargrid\":\r\n                this.presentationType = \"angulargrid\";\r\n                this.angularGridView.initialise();\r\n                break;\r\n            default:\r\n                break;\r\n        }\r\n    };\r\n\r\n    // redirect to drill down link\r\n    this.redirectTo = function (url) {\r\n        cpf.spin();\r\n        cpf.wait();\r\n        if ($.trim(url).length > 0 && url != null) {\r\n            window.location = url;\r\n        }\r\n    };\r\n\r\n    // get sort column from each base presentation type\r\n    this.getSortColumn = function () {\r\n        var $searchContainer = this.getSearchContainer();\r\n        var sortColumn = \"\";\r\n        switch (this.presentationType) {\r\n            case \"grid\":\r\n                sortColumn = $searchContainer.find(\".fixed-table-js\").length === 1 ? this.gridView.getSortColumn() : \"\";\r\n                break;\r\n            case \"stack\":\r\n                sortColumn = $searchContainer.find(\".stack\").length === 1 ? this.control.getControlData().sortColumn : \"\";\r\n                break;\r\n            case \"panel\":\r\n                sortColumn = $searchContainer.find(\".panel\").length === 1 ? this.control.getControlData().sortColumn : \"\";\r\n                break;\r\n            case \"multigrid\":\r\n                sortColumn = $searchContainer.find(\".multigrid\").length === 1 ? this.multigridView.getSortColumn() : \"\";\r\n                break;\r\n            case \"angulargrid\":\r\n                sortColumn = $searchContainer.find(\".grid\").length === 1 ? this.angularGridView.getSortColumn() : \"\";\r\n                break;\r\n        }\r\n\r\n        return sortColumn;\r\n    };\r\n\r\n    // get sort direction from each presentation type\r\n    this.getSortDirection = function () {\r\n        var sortDirection = \"\";\r\n        switch (this.presentationType) {\r\n            case \"grid\":\r\n                sortDirection = this.gridView.getSortDirection();\r\n                break;\r\n            case \"angulargrid\":\r\n                sortDirection = this.angularGridView.getSortDirection();\r\n                break;\r\n            case \"multigrid\":\r\n                sortDirection = this.multigridView.getSortDirection();\r\n                break;\r\n            case \"stack\":\r\n            case \"panel\":\r\n                sortDirection = this.control.getControlData().sortDirection;\r\n                if (sortDirection != \"asc\" && sortDirection != \"desc\") {\r\n                    sortDirection = \"\";\r\n                }\r\n                break;\r\n        }\r\n\r\n        return sortDirection;\r\n    };\r\n\r\n    this.storeSortDirection = function (sortDirection) {\r\n        var data = this.control.getControlData();\r\n        data.sortDirection = sortDirection;\r\n        data.pageRowCount = 0;\r\n        data.startRowIndex = 0;\r\n        data.endRowIndex = 0;\r\n        var $searchContainer = this.getSearchContainer();\r\n        $searchContainer.find(\".results-container\").attr(\"data\", JSON.stringify(data));\r\n    };\r\n\r\n    // initilaise the sort buttons on the ribbon\r\n    this.initialiseSortButtons = function () {\r\n\r\n        // sortButtonsOnLoad has been added to support multiple stack view searches on the same page such that sorting can be bound to different search results.\r\n        if (this.sortButtonsOnLoad) {\r\n            var $ascButton = this.getSortAscButton();\r\n            var $descButton = this.getSortDescButton();\r\n            //var $sortButtonsContainer = $ascButton.parent().parent();\r\n            var isEnabled = $.trim(this.getSortColumn()).length > 0;\r\n            if (isEnabled) {\r\n                if (!this.sortButtonsInitialised) {\r\n                    var sortDirection = this.getSortDirection();\r\n                    if (sortDirection === \"asc\") {\r\n                        $descButton.removeClass(\"clicked\");\r\n                        $ascButton.addClass(\"clicked\");\r\n                    } else if (sortDirection === \"desc\") {\r\n                        $ascButton.removeClass(\"clicked\");\r\n                        $descButton.addClass(\"clicked\");\r\n                    } else {\r\n                        $ascButton.removeClass(\"clicked\");\r\n                        $descButton.removeClass(\"clicked\");\r\n                    }\r\n\r\n                    if ($ascButton.attr(\"data-format\") && $descButton.attr(\"data-format\")) {\r\n                        var data = this.control.getControlData();\r\n                        var sortAscText = $ascButton.attr(\"data-format\").replace(\"{0}\", data[\"sortColumnDisplayName\"]);\r\n                        var sortDescText = $descButton.attr(\"data-format\").replace(\"{0}\", data[\"sortColumnDisplayName\"]);\r\n                        $ascButton.find(\".sort-button-label\").html(sortAscText);\r\n                        $descButton.find(\".sort-button-label\").html(sortDescText);\r\n\r\n                        if ($ascButton.attr(\"title\")) {\r\n                            var sortAscTitle = $ascButton.attr(\"title\").replace(\"{0}\", data[\"sortColumnDisplayName\"]);\r\n                            $ascButton.attr(\"title\", sortAscTitle);\r\n                        }\r\n\r\n                        if ($descButton.attr(\"title\")) {\r\n                            var sortDescTitle = $descButton.attr(\"title\").replace(\"{0}\", data[\"sortColumnDisplayName\"]);\r\n                            $descButton.attr(\"title\", sortDescTitle);\r\n                        }\r\n                    }\r\n\r\n                    $ascButton.off('click').on(\"click\", $.proxy(function (event) {\r\n                        $descButton.removeClass(\"clicked\");\r\n                        sortDirection = \"\";\r\n                        if ($ascButton.hasClass(\"clicked\")) {\r\n                            // $ascButton.removeClass(\"clicked\");\r\n                            return false;\r\n                        } else {\r\n                            $ascButton.addClass(\"clicked\");\r\n                            sortDirection = \"asc\";\r\n                        }\r\n\r\n                        this.storeSortDirection(sortDirection);\r\n                        this.load(null, null, true);\r\n                    }, this));\r\n\r\n                    $descButton.off('click').on(\"click\", $.proxy(function (event) {\r\n                        $ascButton.removeClass(\"clicked\");\r\n                        sortDirection = \"\";\r\n                        if ($descButton.hasClass(\"clicked\")) {\r\n                            //$descButton.removeClass(\"clicked\")\r\n                            return false;\r\n                        } else {\r\n                            $descButton.addClass(\"clicked\");\r\n                            sortDirection = \"desc\";\r\n                        }\r\n\r\n                        this.storeSortDirection(sortDirection);\r\n                        this.load(null, null, true);\r\n                    }, this));\r\n\r\n                    this.sortButtonsInitialised = true;\r\n                }\r\n\r\n                // $sortButtonsContainer.show();\r\n                // button container has been removed for the new toolbar so we have to do the buttons manually\r\n                $ascButton.parent().show();\r\n                $descButton.parent().show();\r\n            } else {\r\n                //$sortButtonsContainer.hide();\r\n                $ascButton.parent().hide();\r\n                $descButton.parent().hide();\r\n            }\r\n        }\r\n    };\r\n\r\n    this.getNavigationTrack = function (url, payload, event) {\r\n        if (!this.usingInlineData) {\r\n            payload.isDeaggregate = Boolean(cpf.hash(\"deaggregate\"));\r\n\r\n            var success = function (result, textStatus, jqXHR) {\r\n                if (result.success) {\r\n\r\n                    ////grab click positions\r\n                    //if (event != null && event != undefined) {\r\n                    //    lightbox.clickX = event.pageX;\r\n                    //    lightbox.clickY = event.pageY;\r\n                    //}\r\n\r\n                    //show tracks\r\n                    var $dataObj = $(result.data);\r\n                    var tableRows = $dataObj.find(\"tr\");\r\n                    if (tableRows.length > 1) {\r\n                        trackLite.showNavigationTracks(result.data, true, event);\r\n                        return false;\r\n                    } else {\r\n                        var rowData = jQuery.parseJSON($dataObj.attr(\"row-data\")),\r\n                            redirectUrl = $(tableRows[0]).attr(\"track-url\");\r\n\r\n                        if (redirectUrl === \"{{deaggregate}}\") {\r\n                            cpf.hash(\"deaggregate\", \"true\");\r\n                            this.loadDeaggregate(null, payload.data);\r\n                        } else if ($(tableRows[0]).gcop().hasAttribute(\"frame-pop\")) {\r\n                            // render url as a frame pop\r\n                            redirectUrl = trackLite.resolveUrl(redirectUrl, rowData);\r\n                            trackLite.popUp.framePop(redirectUrl, $(tableRows[0]).gcop().getAttribute(\"title\"));\r\n                            return false;\r\n                        }\r\n                        else {\r\n                            redirectUrl = trackLite.resolveUrl(redirectUrl, rowData);\r\n\r\n                            if (redirectUrl !== null && redirectUrl !== undefined) {\r\n                                if (redirectUrl.charAt(0) === '#' && typeof (dynoview) !== \"undefined\") {\r\n                                    //TODO check to see if you want to remove existing hash\r\n\r\n                                    // convert hash into keyValue pair collection\r\n                                    var hashObj = {};\r\n                                    var hash = JSON.parse(redirectUrl.slice(1, redirectUrl.length));\r\n                                    if (hash[\"params\"]) {\r\n                                        var paramObj = hash[\"params\"];\r\n                                        for (prop in paramObj) {\r\n                                            hashObj[prop] = paramObj[prop];\r\n                                        }\r\n                                    }\r\n\r\n                                    dynoview.dynoHash.updateHash(hashObj);\r\n\r\n                                } else {\r\n                                    var target = $(tableRows[0]).attr(\"target\");\r\n                                    if (target !== null && target !== undefined) {\r\n                                        window.open(redirectUrl, target);\r\n                                    } else {\r\n                                        window.location = redirectUrl;\r\n                                    }\r\n                                }\r\n                            } else {\r\n                                return false;\r\n                            }\r\n                        }\r\n                    }\r\n                }\r\n            };\r\n\r\n            var error = function (result, textStatus, jqXHR) {\r\n                if (result[\"unhandled\"]) {\r\n                    cpf.alert(\"RESOURCE{{email.js}:{ErrorEmailingDashoard}:{There was an error fetching navigation tracks. Please contact support.}}\", \"e\");\r\n                }\r\n                return false;\r\n            };\r\n\r\n            cpf.ajax({ url: url, success: $.proxy(success, this), errorCallback: error, data: payload });\r\n        }\r\n        return false;\r\n    };\r\n\r\n    this.ValidateSearchResults = function (cacheKey, hashedSearchIdentifier) {\r\n\r\n        var success = function (result, textStatus, jqXHR) {\r\n            if (result.data.newResults) {\r\n                // instead of alert show a custom box \r\n                var $resultBox = $(\"#refresh-results-box\"),\r\n                    message = \"RESOURCE{{search.js}:{NewResultMessage}:{There may be newer results for this search. Would you like to check for changes?}}\";\r\n\r\n                // get data from the search grid.\r\n\r\n                var data = this.$context.find(\".results-container\").attr(\"data\");\r\n                if (data != null || data != undefined || data != \"\") {\r\n                    data = JSON.parse(data);\r\n                }\r\n\r\n                if (!isNullOrEmpty(data.executedAgo)) {\r\n                    message = \"RESOURCE{{search.js}:{NewResultMessageAgeText}:{This search is }}\" + data.executedAgo + \" \" + \"RESOURCE{{search.js}:{NewResultMessageAgeTextPartTwo}:{old. Would you like to check for changes?}}\";\r\n                }\r\n\r\n                $resultBox.find(\".message\").text(message);\r\n                $resultBox.find(\"#force-run-search\").attr(\"data-search-name\", this.id);\r\n\r\n                if ($(\"#alert\").gcop().isVisible()) {\r\n                    setTimeout(function () {\r\n                        if ($(\"#alert\").gcop().isVisible()) {\r\n                            //$(\"#alert\").hide();\r\n                            $(\"#alert\").removeClass(\"alert-vis\");\r\n                        }\r\n\r\n                        $(\"#refresh-results-box\").show();\r\n                        $(\"#refresh-results-box\").addClass(\"alert-vis\");\r\n\r\n                    }, 2000);\r\n                }\r\n                else {\r\n                    $(\"#refresh-results-box\").show();\r\n                    $(\"#refresh-results-box\").addClass(\"alert-vis\");\r\n                }\r\n            }\r\n        };\r\n\r\n        var error = function (result, textStatus, jqXHR) {\r\n            if (result[\"unhandled\"]) {\r\n                cpf.alert(\"RESOURCE{{search.js}:{SearchError}:{There was an error while validating whether the search result was outdated or not.}}\", \"e\");\r\n            }\r\n            else {\r\n                cpf.alert(result.message, \"e\");\r\n            }\r\n            return false;\r\n        };\r\n\r\n        if (this.usingInlineData) {\r\n            return false;\r\n        }\r\n\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/search/validatesearchresults\", success: $.proxy(success, this), errorCallback: error, data: { searchVirtualFilePath: this.searchVirtualFilePath, hashedSearchIdentifier: hashedSearchIdentifier, cacheKey: cacheKey } });\r\n        return false;\r\n    };\r\n\r\n\r\n    this.buildGridViewTableFixedHeader = function (showSearchControls) {\r\n        if (this.$results != null && this.$results !== 0) {\r\n            var resultsTable = this.$results.find('table');\r\n            var $elem = this.$context.find(\".fixed-table-head\");\r\n\r\n            if (resultsTable.length === 1 && (resultsTable.attr('data-presentation-type') === 'grid' || resultsTable[0].getAttribute('data-presentation-type') === 'angulargrid')) {\r\n\r\n                if ((!$elem || !$elem.length) && this.$context.find('.header').length == 0) {\r\n                    if (showSearchControls === false) {\r\n                        $elem = $('<div class=\"fixed-table-head-no-controls\"></div>');\r\n                    } else {\r\n                        $elem = $('<div class=\"fixed-table-head\"></div>');\r\n                    }\r\n\r\n                    this.$context.find('.search-container').append($elem);\r\n                }\r\n                if (this.$context.is(\":visible\")) {\r\n                    // clear fixed header child elements and binded events\r\n                    $elem.empty();\r\n                    var headers = this.$results.find('table thead tr th');\r\n                    var headersLength = headers.length;\r\n\r\n                    var fixedTable = document.createElement('table');\r\n                    fixedTable.className = 'table table-fixed-head';\r\n                    var fixedTBody = document.createElement('thead');\r\n                    fixedTBody.innerHTML = this.$results.find('table thead').html();\r\n\r\n\r\n                    var fixedTBodyItems = $(fixedTBody).find('th');\r\n\r\n                    function clickEvent(input) {\r\n                        return function () {\r\n                            input.click();\r\n                        }\r\n                    }\r\n\r\n                    //var hiddenInteval = null;\r\n                    function resizeHeaderItemWidths() {\r\n                        if (headersLength > 0 && headers.is(\":visible\")) {\r\n                            for (var i = 0; i < headersLength; i++) {\r\n                                var headerItem = $(headers[i]);\r\n                                var fixedHeaderItem = $(fixedTBodyItems[i]);\r\n                                fixedHeaderItem.css('width', headerItem.outerWidth() + 'px');\r\n                            }\r\n\r\n                            /*if (hiddenInteval != null) {\r\n                                clearInterval(hiddenInteval);\r\n                                hiddenInteval = null;\r\n                            }*/\r\n                        }\r\n                    }\r\n\r\n                    if (headersLength > 0) {\r\n                        for (var i = 0; i < headersLength; i++) {\r\n                            var headerItem = $(headers[i]);\r\n                            var fixedHeaderItem = $(fixedTBodyItems[i]);\r\n                            var headerItemInputs = headerItem.find(\"input\");\r\n\r\n                            if (headerItemInputs.length > 0) {\r\n                                var fixedHeaderItemInputs = fixedHeaderItem.find(\"input\");\r\n                                for (var j = 0, len = headerItemInputs.length; j < len; j++) {\r\n                                    $(fixedHeaderItemInputs[j]).off('click.headerClick').on('click.headerClick', clickEvent($(headerItemInputs[j])));\r\n                                }\r\n                            } else {\r\n                                fixedHeaderItem.off('click.headerClick').on('click.headerClick', clickEvent(headerItem));\r\n                            }\r\n                        }\r\n                    }\r\n\r\n                    /*if (hiddenInteval != null) {\r\n                        clearInterval(hiddenInteval);\r\n                        hiddenInteval = null;\r\n                    }*/\r\n\r\n                    var eventName = 'resize.fixedTableHeader' + this.$context.attr('id');\r\n                    $(window).off(eventName).on(eventName, function () {\r\n                        /*if (hiddenInteval != null) {\r\n                            clearInterval(hiddenInteval);\r\n                            hiddenInteval = null;\r\n                        }*/\r\n\r\n                        if (headers.is(\":visible\")) {\r\n                            resizeHeaderItemWidths();\r\n                        } else {\r\n                            //hiddenInteval = setInterval(resizeHeaderItemWidths, 500);\r\n                        }\r\n                    });\r\n\r\n                    resizeHeaderItemWidths();\r\n                    fixedTable.appendChild(fixedTBody);\r\n                    $elem.html(fixedTable);\r\n                }\r\n            }\r\n        }\r\n    };\r\n\r\n\r\n\r\n    /*this.bindInfinteScrollUp = function () {\r\n        if (this.control != null) {\r\n            var viewableArea = this.$results.height();\r\n            var tablePosition = -(this.$results.find('table.grid').position().top);\r\n    \r\n            var hasReachedLoadPoint = tablePosition < (viewableArea /2);\r\n    \r\n            if (this.control.rowIndex <= 0) {\r\n                //min pages reached, so kill scroll up binding\r\n                this.$results.find('.search-results').off('scroll.infiniUp');\r\n            }\r\n            else if (hasReachedLoadPoint) {\r\n                // load point reached, so take of scroll event and load next page\r\n                this.loadPreviousPage();\r\n            }\r\n        }\r\n    }*/\r\n    /*\r\n    this.bindInfinteScrollDown = function () {\r\n        if (this.control != null) {\r\n            var viewableArea = this.$results.height();\r\n            if (!this.$results.hasClass('search-results')) {\r\n                viewableArea = this.$results.find('.search-results').height();\r\n            };\r\n\r\n            var topPosition = 0;\r\n            var elementHeight = 0;\r\n\r\n            switch (this.presentationType) {\r\n                case \"grid\":\r\n                    var tableEl = this.$results.find('table.grid');\r\n                    topPosition = -(tableEl.position().top);\r\n                    elementHeight = tableEl.outerHeight();\r\n                    break;\r\n                case \"stack\":\r\n                    var stackEl = this.$results.find('.stack');\r\n                    topPosition = -(stackEl.position().top);\r\n                    elementHeight = stackEl.outerHeight();\r\n                    break;\r\n                case \"panel\":\r\n                    var panelEl = this.$results.find('.panel');\r\n                    topPosition = -(panelEl.position().top);\r\n                    elementHeight = panelEl.outerHeight();\r\n                    break;\r\n                case \"angulargrid\":\r\n                    var tableEl = this.$results.find('table.grid');\r\n                    topPosition = -(tableEl.position().top);\r\n                    elementHeight = tableEl.outerHeight();\r\n                    break;\r\n            }\r\n\r\n            var hasReachedLoadPoint = (topPosition + viewableArea) > (elementHeight - (viewableArea / 2));\r\n            if (hasReachedLoadPoint) {\r\n                // load point reached, so take of scroll event and load next page\r\n                if (this.$results.hasClass('search-results')) {\r\n                    this.$results.off('scroll.infiniDown');\r\n                } else {\r\n                    this.$results.find('.search-results').off('scroll.infiniDown');\r\n                }\r\n                this.loadNextPage();\r\n            }\r\n        }\r\n    }\r\n    */\r\n    this.loadNextPageIfNoScroll = function () {\r\n        if (this.control != null) {\r\n            var viewableArea = this.$results.height();\r\n            if (!this.$results.hasClass('search-results')) {\r\n                viewableArea = this.$results.find('.search-results').height();\r\n            }\r\n            var elementHeight = 0;\r\n            switch (this.presentationType) {\r\n                case \"grid\":\r\n                    var tableEl = this.$results.find(\".results-table-js\");\r\n                    elementHeight = tableEl.outerHeight();\r\n                    break;\r\n                case \"stack\":\r\n                    var stackEl = this.$results.find('.stack');\r\n                    elementHeight = stackEl.outerHeight();\r\n                    break;\r\n                case \"panel\":\r\n                    var panelEl = this.$results.find('.panel');\r\n                    elementHeight = panelEl.outerHeight();\r\n                    break;\r\n                case \"angulargrid\":\r\n                    var tableEl = this.$results.find('table.grid');\r\n                    elementHeight = tableEl.outerHeight();\r\n                    break;\r\n\r\n            }\r\n\r\n            var hasScroll = viewableArea < elementHeight;\r\n            //check if loadNextPage is needed\r\n            if (!hasScroll && viewableArea !== 0 && viewableArea !== elementHeight) {\r\n                // no scroll bar so load next page\r\n                if (this.$results.hasClass('search-results')) {\r\n                    this.$results.off('scroll.infiniDown');\r\n                } else {\r\n                    this.$results.find('.search-results').off('scroll.infiniDown');\r\n                }\r\n                this.loadNextPage();\r\n            }\r\n        }\r\n    };\r\n\r\n    /*this.loadPreviousPage = function () {\r\n        if (this.control.rowIndex > 0) {\r\n            this.control.rowIndex = this.control.rowIndex - 1;\r\n            if (this.control.rowIndexMin > this.control.rowIndex) {\r\n                this.$results.find('.search-results').off('scroll.infiniUp');\r\n                this.control.rowIndexMin = this.control.rowIndex;\r\n                this.load(null, 'previous');\r\n            }\r\n        }\r\n    }*/\r\n\r\n    this.loadNextPage = function () {\r\n        this.control.rowIndex = this.control.rowIndexMax + 1;\r\n        cpf.loadingBar(this.$results.find('.loading-bar-container'), true, 'tiny');\r\n        this.load(null, 'next');\r\n    }\r\n\r\n}\r\nvar searchCache = {\r\n    sanitiseName: function (searchName) {\r\n        return searchName.replace(/\\W/g, '').toLowerCase();\r\n    },\r\n\r\n    generateCacheName: function (searchName) {\r\n        // append the querystring to the search name to make the name more unique.\r\n        var queryString = \"\";\r\n\r\n        // if we have a query string grab the whole lot including the hash\r\n        if (window.location.href.indexOf('?') != -1) {\r\n            queryString = window.location.href.slice(window.location.href.indexOf('?') + 1);\r\n        }\r\n        else {\r\n            // we have no querystring. lets check for a hash.\r\n            var hash = cpf.hash();\r\n            if (hash) {\r\n                queryString = JSON.stringify(hash);\r\n            }\r\n        }\r\n\r\n        return USERID + \"_search_\" + searchCache.sanitiseName(searchName) + \"_\" + searchCache.sanitiseName(queryString);\r\n    },\r\n\r\n    get: function (searchName) {\r\n        var key = searchCache.generateCacheName(searchName);\r\n        return cpf.store.get(key, null);\r\n    },\r\n\r\n    set: function (searchName, data) {\r\n        var key = searchCache.generateCacheName(searchName);\r\n        cpf.store.set(key, data);\r\n    },\r\n\r\n    remove: function (searchName) {\r\n        var key = searchCache.generateCacheName(searchName);\r\n        cpf.store.remove(key);\r\n    }\r\n};\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/zugo/searchLoaderDefinition.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\nfunction searchLoaderDefinition(parent) {\r\n\r\n    this.searchInterval = null;\r\n    this.displayInterval = null;\r\n    this.$timerElement = null;\r\n    this.showFullLoader = false;\r\n    this.cancelCallback = null;\r\n    this.search = parent;\r\n    this.$loader = null;\r\n    this.controlWrapper = null;\r\n\r\n    this.load = function (searchName, showFullLoader, cancelCallback) {\r\n\r\n        this.controlWrapper = parent.$context.parent();\r\n\r\n        this.$loader = this.controlWrapper.find('#search-loader');\r\n        if (this.$loader.hasClass(\"abort\")) {\r\n            this.showLoader(false);\r\n            this.$loader.removeClass(\"abort\");\r\n        }\r\n\r\n        this.showFullLoader = (showFullLoader === \"true\" || showFullLoader === true) ? true : false;\r\n\r\n        var msg = \"RESOURCE{{searchLoader.js}:{RunSearchMessageBasic}:{Search is running...}}\";\r\n        if (this.showFullLoader) {\r\n            if (searchName !== \"unsavedsearch\") {\r\n                msg = \"RESOURCE{{searchLoader.js}:{RunSearchMessage}:{'{0}' search is now running...}}\";\r\n                msg = msg.replace(\"{0}\", unescape(searchName));\r\n            } else {\r\n                msg = \"RESOURCE{{searchLoader.js}:{RunSearchMessage}:{Search is now running...}}\";\r\n            }\r\n        }\r\n\r\n        this.$loader.find(\"#search-loader-message\").text(msg);\r\n\r\n        if (this.showFullLoader) {\r\n            this.$timerElement = this.$loader.find(\"#search-run-time\");\r\n            clearTimeout(this.displayInterval);\r\n            clearInterval(this.searchInterval);\r\n            this.$timerElement.text(\"0\");\r\n            this.bindEvents();\r\n        }\r\n        else {\r\n            this.$loader.find(\".section-controls\").hide();\r\n        }\r\n\r\n        this.cancelCallback = cancelCallback;\r\n    };\r\n\r\n    this.bindEvents = function () {\r\n\r\n        $(\"#cancel-search\").off(\"click\").on(\"click\", $.proxy(function () {\r\n            this.cancelSearch();\r\n        }, this));\r\n    };\r\n\r\n    this.showLoader = function (show) {\r\n\r\n        this.clearSearchInterval();\r\n\r\n        if (show === true) {\r\n            if (this.displayInterval == null) {\r\n                this.displayInterval =\r\n                setTimeout($.proxy(function () {\r\n                    this.search.searchLoader.$loader.show();\r\n                    if (this.search.searchLoader.showFullLoader) {\r\n                        this.search.searchLoader.startTimer();\r\n                    }\r\n                }, this), 1000);\r\n            }\r\n        } else {\r\n            clearTimeout(this.displayInterval);\r\n            this.displayInterval = null;\r\n            this.$loader.hide();\r\n        }\r\n    };\r\n\r\n    this.startTimer = function () {\r\n        var self = this;\r\n        this.searchInterval = setInterval(function () {\r\n            var $timerElem = self.$loader.find(\"#search-run-time\");\r\n            $timerElem.text(Number($timerElem.text()) + 1);\r\n        }, 1000);\r\n    };\r\n\r\n    this.cancelSearch = function (message) {\r\n        this.search.abortSearch();\r\n\r\n        this.$loader.addClass(\"abort\");\r\n        var errorMessage = \"RESOURCE{{searchLoader.js}:{CancelSearchMessage}:{Your search has been cancelled}}\";\r\n\r\n        if (this.showFullLoader && !isNullOrEmpty(this.cancelCallback)) {\r\n            var buttonMessage = \"RESOURCE{{searchLoader.js}:{CancelSearchOk}:{Ok}}\";\r\n            errorMessage = errorMessage + \"<input id='search-loader-error' type='button' class='pill-button' value='\" + buttonMessage + \"'>\";\r\n            this.$loader.find(\"#search-loader-message\").html(errorMessage);\r\n\r\n            $(\"#search-loader-error\").off(\"click\").on(\"click\", $.proxy(function () {\r\n                this.cancelCallback();\r\n            }, this));\r\n        } else {\r\n            this.$loader.find(\"#search-loader-message\").html(errorMessage);\r\n        }\r\n\r\n        return false;\r\n    };\r\n\r\n    this.clearSearchInterval = function () {\r\n        clearInterval(this.searchInterval);\r\n    };\r\n}\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/zugo/stackViewDefinition.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\nfunction stackViewDefinition(parent) {\r\n    this.$preview = 0;\r\n    this.search = parent;\r\n\r\n    this.initialise = function () {\r\n        var $searchContainer = this.search.getSearchContainer();\r\n        var $stack = $searchContainer.find(\".stack\");\r\n        if ($stack.find(\".stack-item\").length > 0) {\r\n            $stack.find(\".stack-item td:not(.item-selection-column)\").off(\"click\").on(\"click\", $.proxy(function (event) {\r\n                if ($(event.target).closest(\".autocomplete-remove\").length) {\r\n                    return false;\r\n                } else {\r\n                    this.search.stackView.redirect(event);\r\n                    return false;\r\n                }\r\n            }, this));\r\n        }\r\n        else {\r\n            $stack.find(\".stackview-content\").off(\"click\").on(\"click\", $.proxy(function (event) {\r\n                if (this.search.enableDrillDown == true) {\r\n                    this.search.redirectTo($(event.currentTarget).parent().attr(\"drillDownUrl\"));\r\n                }\r\n                return false;\r\n            }, this));\r\n        }\r\n\r\n        $stack.find(\".stackview-toggle\").off(\"click\").on(\"click\", $.proxy(function (event) {\r\n            var $toggle = $(event.currentTarget);\r\n            this.search.stackView.toggle($toggle);\r\n            return false;\r\n        }, this));\r\n        this.search.initialiseSortButtons();\r\n\r\n        $stack.find(\"input.stack-select-all\").off(\"click\").on(\"change\", $.proxy(function (event) {\r\n            var selectAll = $(event.currentTarget).is(\":checked\");\r\n            $searchContainer = this.search.getSearchContainer();\r\n            $stack = $searchContainer.find(\".stack\");\r\n            $stack.find(\"td.item-selection-column input.stack-row-select\").prop(\"checked\", selectAll);\r\n            this.search.fireSelectRowEvent();\r\n        }, this));\r\n\r\n        $stack.find(\"input.stack-row-select\").off(\"click\").on(\"change\", $.proxy(function (event) {\r\n            if ($(\"input.stack-row-select:checked\").length == $(\"input.stack-row-select\").length) {\r\n                $(\"input.stack-select-all\").prop(\"checked\", true);\r\n            } else {\r\n                $(\"input.stack-select-all\").prop(\"checked\", false);\r\n            }\r\n            var $searchResults = this.search.getSearchContainer().find(\".search-results\");\r\n            $searchResults.trigger(\"selected\", { selectedRows: $(\"input.stack-row-select:checked\") });\r\n        }, this));\r\n\r\n        // bind autocomplete remove/inject\r\n\r\n        $searchContainer.off(\"loaded-data\").on(\"loaded-data\", function () {\r\n            var rows = $searchContainer.find(\".stack-item\");\r\n            var windowId = $searchContainer.closest(\"div.autocomplete-grid\").attr(\"id\");\r\n            var remove = (autocompleteGrid.changes.hasOwnProperty(windowId) && autocompleteGrid.changes[windowId].remove.length) ?\r\n                autocompleteGrid.changes[windowId].remove.map(function (el) { return el.value; }) : []; // strip the 'to remove' values down to their guids only\r\n            if (!rows.length || !remove.length) {\r\n                return;\r\n            }\r\n            var removeRows = rows.filter(function () {\r\n                for (var i = 0, ii = remove.length; i < ii; i++) {\r\n                    if (this.outerHTML.indexOf(remove[i]) > -1) return this; // if the HTML of the row contains one of those guids put it in a new array of rows to delete\r\n                }\r\n                return false;\r\n            });\r\n            for (var i = 0, ii = removeRows.length; i < ii; i++) {\r\n                if (removeRows[i].className.indexOf(\"to-remove\") > -1) continue;\r\n                removeRows[i].className += \" to-remove\";\r\n            }\r\n        });\r\n\r\n        // bind autocomplete events\r\n        this.bindAutoComplete($stack);\r\n    };\r\n\r\n\r\n    this.toggle = function ($toggle) {\r\n    };\r\n\r\n    this.isSortButtonsEnabled = function () {\r\n        return $.trim(this.search.getSortColumn()).length > 0;\r\n    };\r\n\r\n    this.redirect = function (eventSender) {\r\n        var $sender = $(eventSender.currentTarget);\r\n        if (this.search.disableDrill === false) {\r\n            // if they checked a box and clicked edit\r\n            var editButtonClicked = false;\r\n            var $editButton = $(\"#button-edit\");\r\n            if ($editButton.length > 0) {\r\n                if ($editButton.gcop().hasClass(\"selected\")) {\r\n                    editButtonClicked = true;\r\n                }\r\n            }\r\n\r\n            //TODO need to review this\r\n            var $tr;\r\n            if ($sender[0].nodeName === \"TD\") {\r\n                $tr = $(eventSender.currentTarget).parent().gcop();\r\n            } else {\r\n                $tr = $sender.gcop();\r\n            }\r\n\r\n            if ($tr.hasClass(\"no-results\")) {\r\n                return false;\r\n            }\r\n\r\n\r\n            var drill = $tr.getAttribute(\"drillDownUrl\");\r\n\r\n            var preview = $tr.getAttribute(\"data-preview-url\");\r\n\r\n            var payload = {};\r\n            payload.ActionType = \"DrillDown\";\r\n            payload.searchVirtualFilePath = this.search.searchVirtualFilePath;\r\n            payload.searchBuilderDefVirtualFilePath = this.search.searchBuilderDefVirtualFilePath;\r\n            payload.data = $tr.getAttribute(\"data-row\");\r\n\r\n            // if there is a preview, then show it. If not, just drill.\r\n            if (preview && this.search.preview.isOn == true && editButtonClicked == false) {\r\n                $grid.find(\"tbody\").find(\"tr\").removeClass(\"selected\");\r\n                this.preview(preview);\r\n                $tr.addClass(\"selected\");\r\n            } else {\r\n                $tr.addClass(\"selected\");\r\n\r\n                // redirect to drill down url if container or search builder definition is not set. \r\n                // Nb: this indicates that we are not in the compose search screen so tracks are not required.\r\n                //if (this.search.containerName == \"\" || this.search.definitionName == \"\") {\r\n                //    this.search.redirectTo(drill);\r\n                //} else {\r\n                this.search.getNavigationTrack(drill, payload, eventSender);\r\n                //}\r\n            }\r\n        }\r\n        return false;\r\n    };\r\n\r\n\r\n    this.bindAutoComplete = function ($stack) {\r\n        if (autocompleteGrid != undefined) {\r\n            $stack.find(\".autocomplete-remove\").off(\"click\").on(\"click\", function () {\r\n                var $row = $(this).closest(\".stack-item\");\r\n                var $grid = $(this).closest(\".autocomplete-grid\");\r\n                var gridId = $grid.gcop().getAttribute(\"id\");\r\n                var dataRow = JSON.parse($row.gcop().getAttribute(\"data-row\"));\r\n                if (typeof autocompleteGrid.changes[gridId] == \"undefined\") {\r\n                    return;\r\n                }\r\n                var data = dataRow[0];\r\n                data.label = (dataRow[1] != undefined ? dataRow[1].value : dataRow[0].value);\r\n\r\n                if (autocompleteGrid.checkDuplicate($window, data) || !$row.gcop().hasClass(\"to-remove\")) {\r\n                    autocompleteGrid.trackChanges($grid, \"remove\", dataRow[0]);\r\n                    $row.addClass('to-remove');\r\n                } else {\r\n                    autocompleteGrid.trackChanges($grid, \"add\", dataRow[0]);\r\n                    $row.removeClass('to-remove');\r\n                }\r\n            });\r\n\r\n            //update autocomplete change array\r\n            var $zugoItems = $($stack).find(\".stack-item.zugo-item\");\r\n\r\n            var $window = $stack.closest(\"div.autocomplete-grid\");\r\n            var windowId = $window.attr(\"id\");\r\n            if (windowId == null) windowId = $window.parent().attr(\"id\");\r\n\r\n            if (!autocompleteGrid.changes.hasOwnProperty(windowId)) {\r\n                autocompleteGrid.changes[windowId] = { load: [], add: [], remove: [] };\r\n            }\r\n            for (var i = 0, li = $zugoItems.length; i < li; i++) {\r\n\r\n                var dataRow = JSON.parse($($zugoItems[i]).attr(\"data-row\"));\r\n                var data = dataRow[0];\r\n\r\n                // add label if it exists\r\n                data.label = (dataRow[1] != undefined ? dataRow[1].value : dataRow[0].value);\r\n\r\n                // set checkbox to checked if 'select all' is checked\r\n                if (!autocompleteGrid.checkDuplicate($window, data)) {\r\n\r\n                    if ($($stack).find(\".stack-select-all\").is(\":checked\")) {\r\n\r\n                        $($zugoItems[i]).find(\".stack-row-select\").prop('checked', true);\r\n                    }\r\n\r\n                    //check if control has child item, add child template if required\r\n                    var $childItem = $window.find(\".child-item-template\").clone();\r\n                    if ($childItem.length > 0) {\r\n                        var childValue = $($zugoItems[i]).find(\".child-item\").gcop().getAttribute(\"data\");\r\n                        data.childValue = childValue;\r\n\r\n                        $($zugoItems[i]).find(\".child-item select\").val(childValue);\r\n                        $($zugoItems[i]).find(\".child-item select\").attr(\"selected-id\", dataRow[0].value);\r\n\r\n                        //bind events\r\n                        $($zugoItems[i]).find(\".child-item select\").on(\"change\", function () {\r\n                            //find object and then update dictionary \r\n                            var selectedId = $(this).gcop().getAttribute(\"selected-id\");\r\n\r\n                            for (var i = 0, li = autocompleteGrid.changes[windowId][\"load\"].length; i < li; i++) {\r\n                                var item = autocompleteGrid.changes[windowId][\"load\"][i];\r\n                                if (item.value === selectedId) {\r\n                                    autocompleteGrid.trackChanges($window, \"remove\", item);\r\n\r\n                                    item.childValue = $(this).val();\r\n\r\n                                    autocompleteGrid.trackChanges($window, \"add\", item);\r\n                                    //autocompleteGrid.changes[windowId][\"load\"][i].childValue = $(this).val();\r\n                                    return true;\r\n                                }\r\n                            }\r\n                            return false;\r\n                        });\r\n                    }\r\n\r\n                    autocompleteGrid.changes[windowId][\"load\"].push(data);\r\n                }\r\n            }\r\n        }\r\n    };\r\n}\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/zugo/trackLite.js\n * ======================================== */\n\n﻿var trackLite = {\r\n    load: function () {\r\n        trackLite.initialiseMenu();\r\n        trackLite.bindEvents();\r\n    },\r\n\r\n    getFirstTrack: function (payload, event) {\r\n        //returns first track\r\n        payload.isDeaggregate = Boolean(cpf.hash(\"deaggregate\"));\r\n\r\n        var success = function (result, textStatus, jqXHR) {\r\n\r\n            if (result.success) {\r\n                //show tracks\r\n                var $dataObj = $(result.data);\r\n                var tableRows = $dataObj.find(\"tr\");\r\n                if (tableRows.length > 0) {\r\n                    var rowData = jQuery.parseJSON($dataObj.attr(\"row-data\"));\r\n                    var redirectUrl = $(tableRows[0]).attr(\"track-url\");\r\n                    redirectUrl = trackLite.resolveUrl(redirectUrl, rowData);\r\n\r\n                    if ($(tableRows[0]).gcop().hasAttribute(\"frame-pop\")) {\r\n                        // render url as a frame pop\r\n                        trackLite.popUp.framePop(redirectUrl, $(tableRows[0]).gcop().getAttribute(\"title\"));\r\n                        return false;\r\n                    }\r\n\r\n                    if (redirectUrl !== null && redirectUrl !== undefined) {\r\n                        var target = $(tableRows[0]).attr(\"target\");\r\n                        if (target !== null && target !== undefined) {\r\n                            window.open(redirectUrl, target);\r\n                        } else {\r\n                            window.location = redirectUrl;\r\n                        }\r\n                    } else {\r\n                        return false;\r\n                    }\r\n                }\r\n            }\r\n        };\r\n\r\n        var error = function (result, textStatus, jqXHR) {\r\n            if (result[\"unhandled\"]) {\r\n                cpf.alert(\"RESOURCE{{trackLite.js}:{ErrorFetchingNavigationTracks}:{There was an error fetching navigation tracks. Please contact support.}}\", \"e\");\r\n            }\r\n            return false;\r\n        };\r\n\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/search/gettrack\", success: success, errorCallback: error, data: payload });\r\n\r\n        return false;\r\n    },\r\n\r\n    getTracks: function (payload, event) {\r\n        payload.isDeaggregate = Boolean(cpf.hash(\"deaggregate\"));\r\n        var currentTarget = event.currentTarget;\r\n\r\n        var success = function (result, textStatus, jqXHR) {\r\n\r\n            if (result.success) {\r\n                //show tracks\r\n                var $dataObj = $(result.data);\r\n                var tableRows = $dataObj.find(\"tr\");\r\n                if (tableRows.length > 1) {\r\n                    trackLite.showNavigationTracks(result.data, true, event);\r\n                    return false;\r\n                } else {\r\n                    var rowData = jQuery.parseJSON($dataObj.attr(\"row-data\"));\r\n                    var redirectUrl = $(tableRows[0]).attr(\"track-url\");\r\n\r\n                    if ($(tableRows[0]).gcop().hasAttribute(\"frame-pop\")) {\r\n                        // render url as a frame pop\r\n                        trackLite.popUp.framePop(redirectUrl, $(tableRows[0]).gcop().getAttribute(\"title\"));\r\n\r\n                        /* Deselect pressed chart element (10016) */\r\n                        var allCharts = Highcharts.charts;\r\n                        var clickedChartId = currentTarget.getAttribute('id');\r\n                        for (var i = 0; i < allCharts.length; i++)\r\n                        {\r\n                            var chart = Highcharts.charts[i];\r\n                            if(chart == undefined)\r\n                                continue; // Sometimes array contains \"undefined\" elements (e.g. when some chart was recreated with new dataset - parametrized charts)\r\n\r\n                            var chartId = chart.container.getAttribute('id');\r\n\r\n                            if(clickedChartId == chartId)\r\n                            {\r\n                                var selectedPoints = Highcharts.charts[i].getSelectedPoints();\r\n                                for (var j = 0; j < selectedPoints.length; j++)\r\n                                    selectedPoints[j].select(false);\r\n\r\n                                break;\r\n                            }\r\n                        }\r\n\r\n                        return false;\r\n                    }\r\n\r\n                    redirectUrl = trackLite.resolveUrl(redirectUrl, rowData);\r\n                    if (redirectUrl !== null && redirectUrl !== undefined) {\r\n                        var target = $(tableRows[0]).attr(\"target\");\r\n                        if (target !== null && target !== undefined) {\r\n                                window.open(redirectUrl, target);\r\n                        } else {\r\n                            window.location = redirectUrl;\r\n                        }\r\n                    } else {\r\n                        return false;\r\n                    }\r\n                }\r\n            }\r\n        };\r\n\r\n        var error = function (result, textStatus, jqXHR) {\r\n            if (result[\"unhandled\"]) {\r\n                cpf.alert(\"RESOURCE{{trackLite.js}:{ErrorFetchingNavigationTracks}:{There was an error fetching navigation tracks. Please contact support.}}\", \"e\");\r\n            }\r\n            return false;\r\n        };\r\n\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/search/gettrack\", success: success, errorCallback: error, data: payload });\r\n\r\n        return false;\r\n    },\r\n    initialiseMenu: function () {\r\n        trackLite.$detailsLoader = $(\".track-loader\");\r\n        trackLite.$trackLite = $(\"#track-lite\");\r\n    },\r\n\r\n    bindEvents: function () {\r\n\r\n        //bind row click events\r\n        $(\"#track-detail-container-lite table tr\").off(\"click\").on(\"click\", function (e) {\r\n            var url = $(this).attr(\"track-url\");\r\n\r\n            if (url == null) {\r\n                return;\r\n            }\r\n\r\n            var $tableRow = $(this).closest(\"table\");\r\n            var rowData = jQuery.parseJSON($tableRow.attr(\"row-data\"));\r\n\r\n            //frame pop\r\n            var isFramePop = $(this).attr(\"frame-pop\") != null;\r\n            if (isFramePop) {\r\n                var title = $(this).attr(\"title\");\r\n                if (title == null) {\r\n                    title = '';\r\n                }\r\n\r\n                url = trackLite.resolveUrl(url, rowData);\r\n\r\n                var options = {\r\n                    html: '<iframe src=\"' + url + '\"  width=\"100%\" height=\"100%\" frameborder=\"0\"></iframe>',\r\n                    title: title,\r\n                    yesButtonText: null,\r\n                    showYesButton: false,\r\n                    yesCallback: function () { },\r\n                    noButtonText: null,\r\n                    showNoButton: false,\r\n                    noCallback: function () { },\r\n                    showCancelButton: false,\r\n                    showFooter: false\r\n                };\r\n                lightbox.load(options);\r\n                lightbox.show(true);\r\n                return;\r\n            }\r\n\r\n            //drilldown\r\n            var searchName;\r\n            if (typeof SEARCHNAME === 'undefined') {\r\n                searchName = $tableRow.attr(\"search-name\");\r\n            } else {\r\n                searchName = SEARCHNAME;\r\n            }\r\n\r\n            var target = $(this).attr(\"target\");\r\n\r\n            if (target == null || target !== '_blank') {\r\n                trackLite.showLoader(true);\r\n            }\r\n\r\n            trackLite.redirectTo(url, rowData, searchName, target);\r\n        });\r\n\r\n        //bind close events\r\n        $(\"#track-lite-close\").off(\"click\").on(\"click\", function () {\r\n            trackLite.dialogShow(trackLite.$trackLite, false);\r\n            $('body').gcop().removeClass('noscroll');\r\n        });\r\n    },\r\n\r\n    showNavigationTracks: function ($trackData, show, event) {\r\n        var $trackDiv = $(\"#track-lite\");\r\n\r\n        //grab click positions\r\n        if (event != null && event != undefined) {\r\n            lightbox.clickX = event.pageX;\r\n            lightbox.clickY = event.pageY;\r\n        }\r\n\r\n        $trackDiv.find(\"#track-detail-container-lite\").html($trackData);\r\n        $trackDiv.find(\".lightbox-content\").scrollTop(0);\r\n        trackLite.load();\r\n\r\n        //show lite box\r\n        trackLite.dialogShow(trackLite.$trackLite, show);\r\n        $('body').off('scrolling.tracklite').on('scrolling.tracklite', function () {\r\n            trackLite.dialogShow(trackLite.$trackLite, false);\r\n        });\r\n    },\r\n\r\n    showPopNavigationTrack: function ($popTrackData, show) {\r\n        //bind close events\r\n        $(\"#track-pop-close\").off(\"click\").on(\"click\", function () {\r\n            $(\"#track-pop\").hide();\r\n        });\r\n\r\n        //var $row = $(\"#results input.grid-row-pop-select\");\r\n\r\n        var $seletedRow = $(\"#results input.grid-row-pop-select.seleted\");\r\n        var seletedPos = $seletedRow.offset().top;\r\n\r\n        $(\"#track-pop\").find(\"#detail-container-pop\").html($popTrackData);\r\n        $(\"#track-pop\").css(\"top\", seletedPos + \"px\");\r\n        $(\"#track-pop\").show();\r\n\r\n        //removed class\r\n        $(\"#results input.grid-row-pop-select\").removeClass(\"seleted\");\r\n    },\r\n\r\n\r\n    dialogShow: function ($box, show) {\r\n\r\n        if (show) {\r\n\r\n            trackLite.showLoader(false);\r\n            // cpf.overlay.show($box.attr(\"id\"));\r\n            //lightbox.positionAndShow($box);\r\n            lightbox.showAtClickPosition($box);\r\n\r\n        } else {\r\n            $box.hide();\r\n            // cpf.overlay.hide($box.attr(\"id\"));\r\n        }\r\n    },\r\n\r\n    showLoader: function (show) {\r\n        if (show) {\r\n            trackLite.$detailsLoader.show();\r\n        } else {\r\n            trackLite.$detailsLoader.hide();\r\n        }\r\n    },\r\n    // redirect to drill down link\r\n    redirectTo: function (url, rowData, searchName, target) {\r\n        if (url == null) {\r\n            return;\r\n        }\r\n\r\n        if (url === \"{{deaggregate}}\") {\r\n            cpf.hash(\"deaggregate\", \"true\");\r\n\r\n            for (var search in SEARCHES) {\r\n                if (searchName === SEARCHES[search].searchName) {\r\n                    SEARCHES[search].loadDeaggregate(null, JSON.stringify(rowData));\r\n                    trackLite.$trackLite.hide();\r\n                }\r\n            }\r\n        } else {\r\n            if ($.trim(url).length > 0) {\r\n                url = trackLite.resolveUrl(url, rowData);\r\n                if (url !== null) {\r\n                    if (target !== null && target !== undefined) {\r\n                        window.open(url, target);\r\n                    } else {\r\n                        window.location = url;\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    },\r\n\r\n    resolveUrl: function (url, data) {\r\n        if (url !== undefined) {\r\n            // evaluate url\r\n            if (url.indexOf(\"http\") !== -1) {\r\n                return url;\r\n            }\r\n            else if (url.indexOf(\"#\") !== -1) {\r\n                var hashIndex = url.indexOf(\"#\") + 1;\r\n\r\n                if (url.substring(hashIndex, url.length).indexOf(\"?\")) {\r\n                    return APPLICATIONPATH + url;\r\n                }\r\n                \r\n                return trackLite.resolveHashUrl(url, data);\r\n            }\r\n            else {\r\n                return APPLICATIONPATH + url;\r\n            }\r\n        } else {\r\n            return null;\r\n        }\r\n    },\r\n\r\n    resolveHashUrl: function (url, data) {\r\n        var hashIndex = (url.indexOf(\"#\")) + 1;\r\n        var trimmedUrl = url.slice(hashIndex, url.length);\r\n        var jsonObj = JSON.parse(trimmedUrl);\r\n\r\n        for (property in jsonObj) {\r\n            if (property === \"params\") {\r\n                var jsonObj2 = jsonObj[property];\r\n                for (propertyInternal in jsonObj2) {\r\n                    jsonObj2[propertyInternal] = trackLite.popUp.resolveUrl(jsonObj2[propertyInternal], data);\r\n                }\r\n            } else {\r\n                jsonObj[property] = trackLite.popUp.resolveUrl(jsonObj[property], data);\r\n            }\r\n        }\r\n\r\n        return url.substring(0, hashIndex) + JSON.stringify(jsonObj);\r\n    }\r\n};\r\n\r\ntrackLite.popUp = {\r\n    load: function ($popUpDiv) {\r\n        trackLite.popUp.initialiseMenu($popUpDiv);\r\n        trackLite.popUp.bindEvents($popUpDiv);\r\n        //$popUpDiv.find(\".track-loader\").hide();\r\n    },\r\n\r\n    initialiseMenu: function ($popUpDiv) {\r\n    },\r\n\r\n    bindEvents: function ($popUpDiv) {\r\n        //bind close events\r\n        $popUpDiv.find(\"#poptrack-lite-close\").off(\"click\").on(\"click\", function (event) {\r\n            $(event.target).closest(\".pop-up-draggable-box\").remove();\r\n            $('body').gcop().removeClass('noscroll');\r\n            return false;\r\n        });\r\n\r\n        //bind previous events\r\n        $popUpDiv.find(\"#track-lite-prev\").off(\"click\").on(\"click\", function (event) {\r\n            trackLite.popUp.prev($popUpDiv);\r\n            return false;\r\n        });\r\n\r\n        //bind next events\r\n        $popUpDiv.find(\"#track-lite-next\").off(\"click\").on(\"click\", function (event) {\r\n            trackLite.popUp.next($popUpDiv);\r\n            return false;\r\n        });\r\n\r\n        //handle z-index so selected pop up is at the top\r\n        $popUpDiv.on(\"mousedown\", function () {\r\n            trackLite.popUp.pushToTop($(this));\r\n            var $targetRow = $(\"#\" + $(this).attr('data-row-id'));\r\n            $targetRow.parent().find(\"tr\").removeClass(\"selected\");\r\n            $targetRow.gcop().addClass('selected');\r\n        });\r\n\r\n\r\n    },\r\n\r\n    next: function ($popUpDiv) {\r\n        var popupWindowId = $popUpDiv.attr(\"id\");\r\n        var targetRowId = $popUpDiv.attr(\"pop-next-row-id\");\r\n\r\n        if (targetRowId) {\r\n\r\n            $popUpDiv.find(\".track-loader\").show();\r\n\r\n            var $targetRow = $(\"#\" + targetRowId);\r\n\r\n            $targetRow.parent().find(\"tr\").removeClass(\"selected\");\r\n            $targetRow.gcop().addClass('selected');\r\n\r\n            var nextRowId = $targetRow.attr(\"pop-next-row-id\");\r\n            var prevRowId = $targetRow.attr(\"pop-prev-row-id\");\r\n            var popUpUrl = $popUpDiv.attr(\"pop-url\");\r\n            var resolvedPopUpUrl = trackLite.popUp.getPopNavigationTrack(popUpUrl, $targetRow, true);\r\n\r\n            if (resolvedPopUpUrl === false) {\r\n                cpf.alert(\"RESOURCE{{trackLite.js}:{ErrorFetchingPopUpWindow}:{There was an error fetching pop up window. There are missing values for parameters. Please contact support.}}\", \"e\");\r\n                return false;\r\n            } else {\r\n                //update next and previous row id\r\n                $popUpDiv.attr(\"pop-next-row-id\", nextRowId);\r\n                $popUpDiv.attr(\"pop-prev-row-id\", prevRowId);\r\n\r\n                //get the content for the pop up box\r\n                var popUpContent = trackLite.popUp.getPopUpWindowContent(resolvedPopUpUrl, popupWindowId);\r\n            }\r\n        }\r\n\r\n        return false;\r\n    },\r\n\r\n    prev: function ($popUpDiv) {\r\n        var popupWindowId = $popUpDiv.attr(\"id\");\r\n        var targetRowId = $popUpDiv.attr(\"pop-prev-row-id\");\r\n\r\n        if (targetRowId) {\r\n\r\n            $popUpDiv.find(\".track-loader\").show();\r\n            var $targetRow = $(\"#\" + targetRowId);\r\n\r\n            $targetRow.parent().find(\"tr\").removeClass(\"selected\");\r\n            $targetRow.gcop().addClass('selected');\r\n\r\n            var nextRowId = $targetRow.attr(\"pop-next-row-id\");\r\n            var prevRowId = $targetRow.attr(\"pop-prev-row-id\");\r\n            var popUpUrl = $popUpDiv.attr(\"pop-url\");\r\n            var resolvedPopUpUrl = trackLite.popUp.getPopNavigationTrack(popUpUrl, $targetRow, true);\r\n\r\n            if (resolvedPopUpUrl === false) {\r\n                cpf.alert(\"RESOURCE{{trackLite.js}:{ErrorFetchingPopUpWindow}:{There was an error fetching pop up window. There are missing values for parameters. Please contact support.}}\", \"e\");\r\n            } else {\r\n                //update next and previous row id\r\n                $popUpDiv.attr(\"pop-next-row-id\", nextRowId);\r\n                $popUpDiv.attr(\"pop-prev-row-id\", prevRowId);\r\n\r\n                //get the content for the pop up box\r\n                var popUpContent = trackLite.popUp.getPopUpWindowContent(resolvedPopUpUrl, popupWindowId);\r\n            }\r\n        }\r\n\r\n        return false;\r\n    },\r\n\r\n    getPopUpWindowContent: function (url, popupWindowId) {\r\n        var dataObj;\r\n\r\n        var success = function (result, textStatus, jqXHR) {\r\n\r\n            if (result.length > 0) {\r\n                //show tracks\r\n                //trackLite.showNavigationTracks(result.data, true);\r\n\r\n                var $popUpWindowWrapper = $(result);\r\n                var popUpWindowContent = $popUpWindowWrapper.html();\r\n\r\n                $popUpDiv = $(\"#\" + popupWindowId);\r\n                $popUpDiv.html(popUpWindowContent);\r\n\r\n\r\n                this.getInternalPopUpWindowContent(url, popupWindowId);\r\n\r\n                trackLite.popUp.load($popUpDiv);\r\n\r\n                //$popUpDiv.find(\"#track-lite-close\").off(\"click\").on(\"click\", function () {\r\n                //    // trackLite.dialogShow(trackLite.$trackLite, false);\r\n                //    $(this).closest(\".pop-up-draggable-box\").remove();\r\n                //});\r\n\r\n                return popUpWindowContent;\r\n            } else {\r\n                cpf.alert(\"RESOURCE{{trackLite.js}:{ErrorFetchingPopUpWindow}:{There was an error fetching pop up window. Please contact support.}}\", \"e\");\r\n                return false;\r\n            }\r\n        };\r\n\r\n        var error = function (result, textStatus, jqXHR) {\r\n            cpf.alert(\"RESOURCE{{trackLite.js}:{ErrorFetchingPopUpWindow}:{There was an error fetching pop up window. Please contact support.}}\", \"e\");\r\n            return false;\r\n        };\r\n\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/search/PopAction\", success: $.proxy(success, this), errorCallback: error, data: dataObj, dataType: \"html\" });\r\n    },\r\n\r\n    getInternalPopUpWindowContent: function (url, popupWindowId) {\r\n        var dataObj;\r\n\r\n        var success = function (result, textStatus, jqXHR) {\r\n\r\n            if (result.length > 0) {\r\n\r\n                var $popUpObj = $(\"#\" + popupWindowId);\r\n                var $container = $($popUpObj.find(\"#track-details-container\"));\r\n\r\n                trackLite.popUp.pushToTop($popUpObj);\r\n\r\n                $container.fadeOut(\"fast\", function () {\r\n                    $container.html(result);\r\n                    var $content = $($popUpObj.find(\"#track-details-container div\"));\r\n                    $container.css(\"visibility\", \"hidden\");\r\n                    $container.css(\"display\", \"block\");\r\n\r\n\r\n\r\n                    //sort out height and width of pop up window\r\n\r\n                    $popUpObj.animate({\r\n                        width: $content.width() + 50,\r\n                        height: $content.height() + 76\r\n                    }, {\r\n                        queue: false,\r\n                        duration: 50,\r\n                        complete: function () {\r\n                            if (($content.height() + 75) > $popUpObj.height()) {\r\n                                $popUpObj.find('#track-lite-details').css({\r\n                                    'overflow-y': 'auto',\r\n\r\n                                });\r\n                                //$popUpObj.width($popUpObj.width() + 17);\r\n\r\n                            }\r\n                        }\r\n                    });\r\n\r\n\r\n                    $container.css({ opacity: 0, visibility: \"visible\" }).animate({ opacity: 1.0 }, 200);\r\n\r\n                    if (!$popUpObj.attr(\"pop-next-row-id\")) {\r\n                        $popUpDiv.find(\"#track-lite-next\").gcop().addClass(\"disabled\");\r\n                    } else {\r\n                        $popUpDiv.find(\"#track-lite-next\").gcop().removeClass(\"disabled\");\r\n                    }\r\n\r\n                    if (!$popUpObj.attr(\"pop-prev-row-id\")) {\r\n                        $popUpDiv.find(\"#track-lite-prev\").gcop().addClass(\"disabled\");\r\n                    } else {\r\n                        $popUpDiv.find(\"#track-lite-prev\").gcop().removeClass(\"disabled\");\r\n                    }\r\n\r\n                });\r\n\r\n                return result;\r\n            } else {\r\n                cpf.alert(\"RESOURCE{{trackLite.js}:{ErrorFetchingPopUpWindow}:{There was an error fetching pop up window. Please contact support.}}\", \"e\");\r\n                return false;\r\n            }\r\n        };\r\n\r\n        var error = function (result, textStatus, jqXHR) {\r\n            cpf.alert(\"RESOURCE{{trackLite.js}:{ErrorFetchingPopUpWindow}:{There was an error fetching pop up window. Please contact support.}}\", \"e\");\r\n            return false;\r\n        };\r\n\r\n        cpf.ajax({ url: url, success: success, errorCallback: error, data: dataObj, dataType: \"html\" });\r\n    },\r\n\r\n    createPopupID: function ($popUpButton) {\r\n        return \"pop-up-draggable-box-\" + this.getPopUpRowID($popUpButton) + \"-\" + $popUpButton.attr(\"id\");\r\n    },\r\n\r\n    getPopUpRowID: function ($popUpButton) {\r\n        //TODO: review as rowID is now the ID...of...the row...\r\n        //var data = jQuery.parseJSON($popUpButton.parent().parent().attr(\"data-row\"));\r\n        var rowID = $popUpButton.parent().parent().attr(\"id\");\r\n\r\n        //for (var j = 0; j < data.length; j++) {\r\n        //    if (data[j][\"id\"] === \"RowID\") {\r\n        //        rowID = data[j][\"value\"];\r\n        //    }\r\n        //}\r\n\r\n        return rowID;\r\n    },\r\n\r\n    getPopNavigationTrack: function (url, $element, isTrackLiteNavFlag) {\r\n        var resolvedUrl = url;\r\n\r\n        //get row data\r\n        var rowData;\r\n        if (!isTrackLiteNavFlag) {\r\n            rowData = jQuery.parseJSON($element.parent().parent().attr(\"data-row\"));\r\n        } else {\r\n            rowData = jQuery.parseJSON($element.attr(\"data-row\"));\r\n        }\r\n        resolvedUrl = this.resolveUrl(url, rowData);\r\n\r\n        return resolvedUrl;\r\n    },\r\n\r\n    resolveUrl: function (url, data) {\r\n        var matches = url.match(/{([^}]+)}/g);\r\n        var resolvedUrl = url;\r\n\r\n        if (matches !== null) {\r\n            var numberOfParams = matches.length;\r\n\r\n            //replace values\r\n            for (var i = 0; i < matches.length; i++) {\r\n                var matchName = matches[i].replace(\"{\", \"\").replace(\"}\", \"\");\r\n                var dataValue = null;\r\n                for (var j = 0; j < data.length; j++) {\r\n                    if (data[j][\"id\"] === matchName) {\r\n                        dataValue = data[j][\"value\"];\r\n                        numberOfParams--;\r\n                    }\r\n                }\r\n\r\n                resolvedUrl = resolvedUrl.replace(matches[i], dataValue);\r\n            }\r\n\r\n            //If there are parameters missing when resolving URL\r\n            if (numberOfParams > 0) {\r\n                return false;\r\n            }\r\n        }\r\n\r\n        return resolvedUrl;\r\n    },\r\n    pushToTop: function ($popUpDiv) {\r\n\r\n        var maxZIndex = 0;\r\n        var gf = 0;\r\n        $('.pop-up-draggable-box').each(function () {\r\n            if ($(this).css('z-index') > maxZIndex) {\r\n                maxZIndex = $(this).css('z-index');\r\n            }\r\n            gf++;\r\n        });\r\n\r\n\r\n        $popUpDiv.css('z-index', parseInt(maxZIndex) + 1);\r\n    },\r\n    framePop: function (resolvedPopUpUrl, title) {\r\n        var options = {\r\n            html: '<iframe src=\"' + resolvedPopUpUrl + '\"  width=\"100%\" height=\"100%\" frameborder=\"0\"></iframe>',\r\n            title: title,\r\n            yesButtonText: null,\r\n            showYesButton: false,\r\n            yesCallback: function () { },\r\n            noButtonText: null,\r\n            showNoButton: false,\r\n            noCallback: function () { },\r\n            showCancelButton: false,\r\n            showFooter: false\r\n        };\r\n        lightbox.load(options);\r\n        lightbox.show(true);\r\n    }\r\n};\r\n\n"
          },
          "redirectURL": "",
