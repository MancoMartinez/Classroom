r\n\t\t\tcpf.tour.toursToView = tours;\r\n\r\n\t\t\t// check if the user has already read any of the toursToView using the readTours array\r\n\t\t\tfor (const tour of cpf.tour.toursToView) {\r\n\t\t\t\tif (cpf.tour.readTours.includes(tour.id)) {\r\n\t\t\t\t\tcpf.tour.toursToView.splice(cpf.tour.toursToView.indexOf(tour), 1);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\t// iterate through each tour, and start it, await completion before moving to the next\r\n\t\t\tfor (const tour of cpf.tour.toursToView) {\r\n\t\t\t\tawait cpf.tour.playTour(tour.id, tour.steps);\r\n\t\t\t\tcpf.tour.tourIndex++;\r\n\t\t\t};\r\n\t\t},\r\n\t\tplayTour: async function (tourId, tourItems) {\r\n\t\t\treturn new Promise((resolve) => {\r\n\t\t\t\tcpf.tour.start(tourId, tourItems, resolve);\r\n\t\t\t});\r\n\t\t},\r\n\t\t// start the steps for the given tour\r\n\t\tstart: function (tourId, tourItems, resolve) {\r\n\t\t\tif (cpf.tour.readTours.includes(tourId)) {\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\r\n\t\t\tcpf.tour.id = tourId;\r\n\r\n\t\t\t$(\".tour-preview-container\")?.remove();\r\n\t\t\t$(\".tour-overlay\")?.remove();\r\n\t\t\t$(\".tour-desc-box\")?.remove();\r\n\r\n\t\t\tcpf.tour.steps = tourItems;\r\n\r\n\t\t\tconst $overlay = $(\r\n\t\t\t\t\"<div class='tour-overlay ng-lightbox-overlay'></div>\"\r\n\t\t\t);\r\n\t\t\t$overlay.css({ display: \"none\" });\r\n\r\n\t\t\t$(\"body\").append($overlay);\r\n\r\n\t\t\t$overlay.fadeIn(150);\r\n\r\n\t\t\tconst $tourBox = $(`\r\n\t\t\t  <div class=\"tour-desc-box lightbox\">\r\n\t\t\t\t<h2 class=\"d-flex\">\r\n\t\t\t\t\t<span>Title</span>\r\n\t\t\t\t\t<span id=\"tour-close\" class=\"btn ml-auto\"><i class=\"fa fa-times\"></i></span>\r\n\t\t\t\t</h2>\r\n\t\t\t\t<p>\r\n\t\t\t\t  Description\r\n\t\t\t\t</p>\r\n\t\t\t\t<div class=\"tour-desc-buttons\">\r\n\t\t\t\t  <button class=\"btn\" id=\"tour-desc-prev\" disabled>$RESX('Global', 'Previous', 'Previous')</button>\r\n\t\t\t\t  <span class=\"text-muted\" id=\"tour-desc-steps\">${\r\n\t\t\t\t\t`$RESX('UserTour', 'StepsOf', '{0} of {1}')`\r\n\t\t\t\t\t\t.replace('{0}', (cpf.tour.stepIndex + 1).toString())\r\n\t\t\t\t\t\t.replace('{1}', cpf.tour.steps?.length.toString())\r\n\t\t\t      }</span>\r\n\t\t\t\t  <button class=\"btn\" id=\"tour-desc-next\">$RESX('Global', 'Next', 'Next')</button>\r\n\t\t\t\t</div>\r\n\t\t\t  </div>\r\n\t\t\t  `);\r\n\r\n\t\t\tconst $tourNext = $tourBox.find(\"#tour-desc-next\");\r\n\t\t\tconst $tourPrev = $tourBox.find(\"#tour-desc-prev\");\r\n\t\t\tconst $tourClose = $tourBox.find(\"#tour-close\");\r\n\r\n\t\t\t$tourNext.click(() => {\r\n\t\t\t\tcpf.tour.nextStep(resolve);\r\n\t\t\t});\r\n\r\n\t\t\t$tourPrev.click(() => {\r\n\t\t\t\tcpf.tour.prevStep();\r\n\t\t\t});\r\n\r\n\t\t\t$tourClose.click(() => {\r\n\t\t\t\tcpf.tour.end(resolve);\r\n\t\t\t});\r\n\r\n\t\t\tif (tourItems.length === 1) {\r\n\t\t\t\t$tourNext.html(\"$RESX('Global', 'Finish', 'Finish')\");\r\n\t\t\t}\r\n\r\n\t\t\t$tourBox.css({\r\n\t\t\t\tdisplay: \"none\",\r\n\t\t\t});\r\n\t\t\t$(\"body\").append($tourBox);\r\n\t\t\tcpf.tour.handleTourKeyWrapper = function (e) {\r\n\t\t\t\tcpf.tour.handleTourKey(e, resolve);\r\n\t\t\t};\r\n\r\n\t\t\t$(\"body\").on(\"keyup\", cpf.tour.handleTourKeyWrapper);\r\n\r\n\t\t\t$(window).on(\"resize\", cpf.tour.resize);\r\n\r\n\t\t\tcpf.tour.showTourItem(tourItems[cpf.tour.stepIndex]);\r\n\t\t},\r\n\t\tshowTourItem: function (tourItem, fadeOverride) {\r\n\t\t\tcpf.tour.transitioning = true;\r\n\t\t\t$(\".tour-desc-box\")?.fadeOut(fadeOverride ? fadeOverride : 150);\r\n\t\t\t$(\".tour-preview-container\")?.fadeOut(fadeOverride ? fadeOverride : 150);\r\n\t\t\tvar $scrollContent = $(\"#scroll-content\");\r\n\r\n\t\t\tvar executeTour = function () {\r\n\t\t\t\tconst previewContainer = $(\r\n\t\t\t\t\t\"<div class='tour-preview-container'></div>\"\r\n\t\t\t\t);\r\n\t\t\t\tlet initialItemBox;\r\n\r\n\t\t\t\tconst itemVisible = !!initialItem?.length && initialItem.is(\":visible\") && initialItem.css(\"visibility\") !== \"hidden\"\r\n\r\n\t\t\t\tif (itemVisible) {\r\n\r\n\t\t\t\t\tconst initialItemPreview = $(initialItem[0].outerHTML);\r\n\r\n\t\t\t\t\t// copy the style of the initial item\r\n\t\t\t\t\tcopyNodeStyle(initialItem[0], initialItemPreview[0]);\r\n\r\n\t\t\t\t\t// Clear any holdover styles\r\n\t\t\t\t\tinitialItemPreview.css({\r\n\t\t\t\t\t\tposition: \"relative\",\r\n\t\t\t\t\t\ttransform: \"none\",\r\n\t\t\t\t\t\ttop: \"auto\",\r\n\t\t\t\t\t\tleft: \"auto\",\r\n\t\t\t\t\t\tright: \"auto\",\r\n\t\t\t\t\t\tbottom: \"auto\",\r\n\t\t\t\t\t\tmargin: \"0\",\r\n\t\t\t\t\t\tpointerEvents: \"none\"\r\n\t\t\t\t\t});\r\n\t\t\t\t\tinitialItemPreview[0].className =\r\n\t\t\t\t\t\t\"tour-preview \" + initialItem[0].className;\r\n\r\n\t\t\t\t\t// add the preview to the body\r\n\r\n\t\t\t\t\t// get bounding box of the initial item\r\n\t\t\t\t\tinitialItemBox = initialItem[0].getBoundingClientRect();\r\n\r\n\t\t\t\t\tpreviewContainer.append(initialItemPreview);\r\n\r\n\t\t\t\t\t// check bottom of the item is off the screen\r\n\t\t\t\t\tif ($scrollContent.length == 1 && (initialItemBox.top + initialItemBox.height > window.innerHeight || initialItemBox.top < 0)) {\r\n\t\t\t\t\t\tif (initialItemBox.top > 0) {\r\n\t\t\t\t\t\t\t$scrollContent[0].scrollTop = initialItemBox.top + initialItemBox.height;\r\n\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t$scrollContent[0].scrollTop = initialItemBox.top + initialItemBox.height - 40;\r\n\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\tinitialItemBox = initialItem[0].getBoundingClientRect();\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t\t// apply to the preview\r\n\t\t\t\t\tpreviewContainer.css({\r\n\t\t\t\t\t\tposition: \"fixed\",\r\n\t\t\t\t\t\ttop: initialItemBox.top,\r\n\t\t\t\t\t\tleft: initialItemBox.left,\r\n\t\t\t\t\t\tdisplay: \"none\",\r\n\t\t\t\t\t});\r\n\r\n\t\t\t\t\t$(\"body\").append(previewContainer);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tsetTimeout(() => {\r\n\t\t\t\t\tconst $tourBox = $(\".tour-desc-box\");\r\n\t\t\t\t\t$tourBox.find(\"h2 > span:first-child\").html(tourItem.title);\r\n\t\t\t\t\t$tourBox.find(\"p\").html(tourItem.description);\r\n\r\n\t\t\t\t\t$tourBox.fadeIn(150);\r\n\r\n\t\t\t\t\tif (itemVisible) {\r\n\r\n\t\t\t\t\t\tpreviewContainer.fadeIn(150);\r\n\r\n\t\t\t\t\t\tconst height = $tourBox.outerHeight();\r\n\r\n\t\t\t\t\t\t// position the tour box\r\n\t\t\t\t\t\tvar tourboxTop = Math.min(\r\n\t\t\t\t\t\t\t(window.innerHeight - height - initialItem.outerHeight() - 20),\r\n\t\t\t\t\t\t\tinitialItemBox.top + initialItemBox.height + 20\r\n\t\t\t\t\t\t);\r\n\r\n\t\t\t\t\t\t// check we don't go above the top of the document\r\n\t\t\t\t\t\tif (tourboxTop < 10) {\r\n\t\t\t\t\t\t\ttourboxTop = 10;\r\n\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\t$tourBox.css({\r\n\t\t\t\t\t\t\tposition: \"fixed\",\r\n\t\t\t\t\t\t\ttop: tourboxTop + tourItem.topOffset,\r\n\t\t\t\t\t\t\ttransform: \"none\",\r\n\t\t\t\t\t\t});\r\n\r\n\t\t\t\t\t\tif (\r\n\t\t\t\t\t\t\t$tourBox.width() + initialItemBox.left >\r\n\t\t\t\t\t\t\twindow.innerWidth\r\n\t\t\t\t\t\t) {\r\n\t\t\t\t\t\t\t$tourBox.css({\r\n\t\t\t\t\t\t\t\tleft: window.innerWidth - $tourBox.width() - 20,\r\n\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t$tourBox.css({\r\n\t\t\t\t\t\t\t\tleft: initialItemBox.left + tourItem.leftOffset,\r\n\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\t$tourBox.css({\r\n\t\t\t\t\t\t\tposition: \"fixed\",\r\n\t\t\t\t\t\t\ttop: \"50%\",\r\n\t\t\t\t\t\t\tleft: \"50%\",\r\n\t\t\t\t\t\t\ttransform: \"translate(-50%, -50%)\",\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t\tcpf.tour.transitioning = false;\r\n\t\t\t\t}, 300);\r\n\t\t\t}\r\n\r\n\t\t\tvar initialItem = tourItem.id ? $(tourItem.id) : null;\r\n\r\n\t\t\t// check if this bit of dom is loaded yet\r\n\t\t\tif (initialItem && initialItem.length == 0) {\r\n\t\t\t\t// not found, wait\r\n\t\t\t\tvar wait = 2000;\r\n\t\t\t\tif (tourItem.retryTimeoutMilliseconds) {\r\n\t\t\t\t\twait = tourItem.retryTimeoutMilliseconds;\r\n\t\t\t\t}\r\n\t\t\t\tsetTimeout(() => {\r\n\t\t\t\t\tinitialItem = tourItem.id ? $(tourItem.id) : null;\r\n\t\t\t\t\texecuteTour();\r\n\t\t\t\t}, wait);\r\n\t\t\t} else {\r\n\t\t\t\t// fount it, execute the tour\r\n\t\t\t\texecuteTour();\r\n\t\t\t}\r\n\t\t},\r\n\r\n\t\tend: function (resolve) {\r\n\t\t\t// reset step index\r\n\t\t\tcpf.tour.stepIndex = 0;\r\n\r\n\t\t\t// if this is the final tour for this page, remove the overlay\r\n\t\t\tif (cpf.tour.tourIndex === cpf.tour.toursToView.length - 1) {\r\n\t\t\t\t$(\".tour-preview-container\")?.fadeOut(150, () => {\r\n\t\t\t\t\t$(\".tour-preview-container\").remove();\r\n\t\t\t\t});\r\n\t\t\t\t$(\".tour-overlay\")?.fadeOut(150, () => {\r\n\t\t\t\t\t$(\".tour-overlay\").remove();\r\n\t\t\t\t});\r\n\t\t\t\t$(\".tour-desc-box\")?.fadeOut(150, () => {\r\n\t\t\t\t\t$(\".tour-desc.box\").remove();\r\n\t\t\t\t});\r\n\t\t\t}\r\n\r\n\t\t\t$(\"body\").off(\"keyup\", cpf.tour.handleTourKeyWrapper);\r\n\t\t\t$(window).off(\"resize\", cpf.tour.resize);\r\n\r\n\t\t\tcpf.tour.readTours.push(cpf.tour.id);\r\n\t\t\t$(\"#scroll-content\")[0].scrollTop = 0;\r\n\r\n\t\t\t// mark this tour as read\r\n\t\t\tcpf.ajax({\r\n\t\t\t\turl: APPLICATIONPATH + \"cpf/core/tour/markasread\",\r\n\t\t\t\tdataType: \"json\",\r\n\t\t\t\ttype: \"POST\",\r\n\t\t\t\tdata: {\r\n\t\t\t\t\ttourUrl: cpf.tour.id\r\n\t\t\t\t},\r\n\t\t\t\tcache: false,\r\n\t\t\t\tsuccess: function () {\r\n\t\t\t\t\tcpf.tour.id = \"\";\r\n\t\t\t\t\tresolve();\r\n\t\t\t\t},\r\n\t\t\t\terrorCallback(data) {\r\n\t\t\t\t\tconsole.log(\"Could not mark tour as read.\");\r\n\t\t\t\t\tconsole.log(data);\r\n\t\t\t\t\tresolve();\r\n\t\t\t\t},\r\n\t\t\t});\r\n\t\t},\r\n\r\n\t\tclear: function () {\r\n\t\t\tcpf.tour.readTours.splice(cpf.tour.id);\r\n\t\t}\r\n\t},\r\n};\r\n\r\ncpf.JSONDateFormat = function (jsondate) {\r\n\tif (jsondate != undefined) {\r\n\t\tjsondate = jsondate.replace(\"/Date(\", \"\").replace(\")/\", \"\");\r\n\t\tif (jsondate.indexOf(\"+\") > 0) {\r\n\t\t\tjsondate = jsondate.substring(0, jsondate.indexOf(\"+\"));\r\n\t\t} else if (jsondate.indexOf(\"-\") > 0) {\r\n\t\t\tjsondate = jsondate.substring(0, jsondate.indexOf(\"-\"));\r\n\t\t}\r\n\r\n\t\treturn new Date(parseInt(jsondate, 10));\r\n\t}\r\n};\r\n\r\ncpf.whoami = {\r\n\tdata: {},\r\n\r\n\tload: function () {},\r\n\r\n\tval: function () {\r\n\t\tvar objectIdentifier = cpf.whoami.getAttachmentObjectIdentifier();\r\n\r\n\t\tthis.data[\"url\"] = window.location.href;\r\n\t\tthis.data[\"title\"] = document.title;\r\n\r\n\t\tfor (var key in objectIdentifier) {\r\n\t\t\tif (objectIdentifier.hasOwnProperty(key)) {\r\n\t\t\t\tthis.data[key] = objectIdentifier[key];\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\treturn cpf.whoami.data;\r\n\t},\r\n\r\n\tadd: function (key, value) {\r\n\t\tthis.data[key] = value;\r\n\t},\r\n\r\n\tgetAttachmentObjectIdentifier: function () {\r\n\t\tvar identifier = {};\r\n\r\n\t\tif (typeof undefined != typeof $MODEL) {\r\n\t\t\tidentifier = $MODEL;\r\n\t\t}\r\n\r\n\t\t//Add page type parameters (is this needed after dymo parameters are set?)\r\n\t\tvar $dynoForm = $(\"#scroll-content\").find(\".dyno-form\");\r\n\r\n\t\tif ($dynoForm.length > 0) {\r\n\t\t\tvar identifierString = $dynoForm\r\n\t\t\t\t.gcop()\r\n\t\t\t\t.getAttribute(\"data-identifier\");\r\n\r\n\t\t\t//CRDM___Dashboard___Transaction Viewer___1\r\n\t\t\tif (identifierString) {\r\n\t\t\t\tvar properties = identifierString.split(\"___\");\r\n\r\n\t\t\t\tidentifier.container = properties[0];\r\n\t\t\t\tidentifier.type = properties[1];\r\n\t\t\t\tidentifier.name = properties[2];\r\n\t\t\t\tidentifier.version = properties[3];\r\n\t\t\t\tidentifier.objectType = 3;\r\n\t\t\t}\r\n\t\t} else if ($(\"#scroll-content\").length > 0) {\r\n\t\t\tvar $searchType = $(\"#scroll-content\").find(\"#search-wrapper\");\r\n\t\t\t//Explorer Search\r\n\t\t\tif ($searchType.length > 0) {\r\n\t\t\t\tvar $results = $searchType.find(\"#results\");\r\n\r\n\t\t\t\tif ($results.gcop().hasAttribute(\"data-container\")) {\r\n\t\t\t\t\tidentifier.container = $results\r\n\t\t\t\t\t\t.gcop()\r\n\t\t\t\t\t\t.getAttribute(\"data-container\");\r\n\r\n\t\t\t\t\t