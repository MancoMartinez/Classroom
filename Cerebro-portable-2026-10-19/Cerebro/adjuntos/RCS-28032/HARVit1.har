            "mimeType": "application/x-javascript",
            "text": "var isProcessed = false;\r\nvar isValid = false;\r\nfunction btnSave_Click(s, e) {\r\n\tvar ret = true;\r\n\t//check DevExpress required fields\r\n\tif (window.ASPxClientEdit != undefined) {\r\n\t\tif (window.ASPxClientEdit.ValidateEditorsInContainer(null) == false) {\r\n\t\t\tret = false;\r\n\t\t}\r\n\r\n\t\tif (ProcessRequiredHTMLEditor(s, e) == false) {\r\n\t\t\tret = false;\r\n\t\t}\r\n\r\n\t\tif (ProcessRequiredUCO(s, e) == false) {\r\n\t\t\tret = false;\r\n\t\t}\r\n\r\n\t\tif (ret == false) {\r\n\t\t\tHideLoadingPanel();\r\n\t\t\te.processOnServer = false;\r\n\t\t\treturn ret;\r\n\t\t}\r\n\t}\r\n\t//check fields using asp built in validators\r\n\tif (validatorPresent() == true) {\r\n\t\twindow.Page_ClientValidate();\r\n\t\tif (!window.Page_IsValid) {\r\n\t\t\tHideLoadingPanel();\r\n\t\t\te.processOnServer = false;\r\n\t\t\treturn false;\r\n\t\t}\r\n\t}\r\n\tif (!isValid) {\r\n\t\twindow.cbBusinessRules.PerformCallback();\r\n\t\te.processOnServer = false;\r\n\t\t//HideLoadingPanel();\r\n\t} else {\r\n\t\te.processOnServer = true;\r\n\t\tShowLoadingPanel(s, e);\r\n\t}\r\n}\r\n\r\nfunction btnSave_ClickWithSuspectCheck(s, e) {\r\n\tvar goSave = false;\r\n\tisProcessed = false;\r\n\r\n\t//Check empty SuspectPhoto\r\n\tif (typeof fld_Suspect_SuspectPhoto != \"undefined\") {\r\n\t\tif (fld_Suspect_SuspectPhoto.GetValue() == \"\") {\r\n\t\t\tif (actioncheck.value == \"1\") {\r\n\t\t\t\te.processOnServer = false;\r\n\r\n\t\t\t\tif (AllowEmptySuspectPhoto(s, e) == true) {\r\n\t\t\t\t\t// allow save, remove SuspectPhoto;\r\n\t\t\t\t}\r\n\t\t\t\telse {\r\n\t\t\t\t\t// not save, keep SuspectPhoto;\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tgoSave = true;\r\n\t\t\t}\r\n\r\n\t\t} else {\r\n\t\t\tgoSave = true;\r\n\t\t}\r\n\t} else {\r\n\t\tgoSave = true;\r\n\t}\r\n\t//isProcessed for second round call if there is any\r\n\tif (goSave && isProcessed == false) {\r\n\t\tisProcessed = true;\r\n\t\tlps.Show();\r\n\t\tbtnSave_Click(s, e);\r\n\t}\r\n}\r\n\r\n\r\nfunction AllowEmptySuspectPhoto(s, e) {\r\n\te.processOnServer = false;\r\n\r\n\tvar gSuspectPhototTitle = \"Check Suspect Photo\";\r\n\tvar gSuspectPhototHtml = \"Suspect Photo is empty.  Do you want to remove it from this Case?\";\r\n\tvar gSuspectPhototDenyBtn = \"No\";\r\n\tvar gSuspectPhototConfirmBtn = \"Yes\";\r\n\tvar gSuspectPhototCancelBtn = \"Cancel\";\r\n\tswal.fire({\r\n\t\ttitle: gSuspectPhototTitle,\r\n\t\thtml: gSuspectPhototHtml,\r\n\t\tcustomClass: 'swal-wide',\r\n\t\tshowConfirmButton: true,\r\n\t\tconfirmButtonColor: 'gray',\r\n\t\tconfirmButtonText: gSuspectPhototConfirmBtn,\r\n\t\tshowDenyButton: true,\r\n\t\tdenyButtonColor: 'gray',\r\n\t\tdenyButtonText: gSuspectPhototDenyBtn,\r\n\t\tshowCancelButton: false,\r\n\t\tcancelButtonText: gSuspectPhototCancelBtn,\r\n\t\tallowOutsideClick: false\r\n\t}).then(function (result) {\r\n\t\tif (result.isConfirmed) {\r\n\t\t\t//Allow\r\n\t\t\tactioncheck.value = \"0\";\r\n\t\t\tbtn_Save.DoClick();\r\n\t\t}\r\n\t\telse if (result.isDenied) {\r\n\t\t\t//DenyButton\r\n\t\t\tactioncheck.value = \"2\";\r\n\t\t\tbtn_Save.DoClick();\r\n\t\t}\r\n\t\telse {\r\n\t\t\t//CancelButton: Not Allow, not save\r\n\t\t}\r\n\t})\r\n}\r\n\r\nfunction ValidationBeforeSave(s, e) {\r\n\tlps.Show();\r\n\tbtnSave_Click(s, e);\r\n}\r\nfunction SuccessMessage(msg, closeRedirectPage) {\r\n\twindow.jSuccess(msg, {\r\n\t\tautoHide: true,\r\n\t\tTimeShown: 1000,\r\n\t\tHorizontalPosition: \"center\",\r\n\t\tShowOverlay: false,\r\n\t\tonClosed: function () {\r\n\t\t\tif (closeRedirectPage != undefined && closeRedirectPage.length !== 0)\r\n\t\t\t\twindow.location.replace(closeRedirectPage);\r\n\t\t},\r\n\t});\r\n}\r\nfunction WarningMessage(msg, displayTime) {\r\n\tdisplayTime = displayTime || 3000;\r\n\r\n\twindow.jNotify(msg, {\r\n\t\tautoHide: true,\r\n\t\tTimeShown: displayTime,\r\n\t\tHorizontalPosition: \"center\",\r\n\t\tShowOverlay: false,\r\n\t});\r\n}\r\nfunction ErrorMessage(msg) {\r\n\twindow.jError(msg, {\r\n\t\tautoHide: true,\r\n\t\tTimeShown: 3000,\r\n\t\tHorizontalPosition: \"center\",\r\n\t\tShowOverlay: false,\r\n\t});\r\n}\r\nfunction clientBusineeRules_BeginCallback(s, e) {\r\n\tisValid = true;\r\n\tif (typeof window.grd_Merch != \"undefined\") {\r\n\t\tif (window.grd_Merch.batchEditApi.HasChanges()) {\r\n\t\t\tif (window.grd_Merch.batchEditApi.ValidateRows() == true) {\r\n\t\t\t\twindow.grd_Merch.UpdateEdit();\r\n\t\t\t} else {\r\n\t\t\t\tisValid = false;\r\n\t\t\t}\r\n\t\t}\r\n\t\t//AALPS-1719 04/06/2021 SJB - Removed the RETURN so the rest of the fields can get processed\r\n\t\t//return;\r\n\t}\r\n\tif (typeof window.grd_Stores != \"undefined\") {\r\n\t\tif (window.grd_Stores.batchEditApi.HasChanges()) {\r\n\t\t\tif (window.grd_Stores.batchEditApi.ValidateRows() == true) {\r\n\t\t\t\twindow.grd_Stores.UpdateEdit();\r\n\t\t\t} else {\r\n\t\t\t\tisValid = false;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tif (typeof window.grd_RelatedDoc != \"undefined\") {\r\n\t\t//if (window.grd_RelatedDoc.batchEditApi.HasChanges()) {\r\n\t\tif (window.grd_RelatedDoc.batchEditApi.ValidateRows() == true) {\r\n\t\t\twindow.grd_RelatedDoc.UpdateEdit();\r\n\t\t} else {\r\n\t\t\tisValid = false;\r\n\t\t}\r\n\t\t//}\r\n\t}\r\n\tif (typeof window.grdSecurity != \"undefined\") {\r\n\t\tif (window.grdSecurity.batchEditApi.ValidateRows() == true) {\r\n\t\t\twindow.grdSecurity.UpdateEdit();\r\n\t\t} else {\r\n\t\t\tisValid = false;\r\n\t\t}\r\n\t}\r\n\tif (typeof window.grd_People != \"undefined\") {\r\n\t\tif (window.grd_People.batchEditApi.HasChanges()) {\r\n\t\t\tif (window.grd_People.batchEditApi.ValidateRows() == true) {\r\n\t\t\t\twindow.grd_People.UpdateEdit();\r\n\t\t\t} else {\r\n\t\t\t\tisValid = false;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\nfunction clientBusineeRules_CallbackComplete(s, e) {\r\n\tif (e.result == \"Valid\" && isValid) {\r\n\t\twindow.btn_Save.DoClick();\r\n\t} else {\r\n\t\tif (e.result != \"Valid\" || isValid == false) {\r\n\t\t\tisValid = false;\r\n\t\t\tif (e.result == \"Valid\") {\r\n\t\t\t\te.result =\r\n\t\t\t\t\t\"Cannot Process.  Please check page for required fields and try again.\";\r\n\t\t\t}\r\n\t\t\tHideLoadingPanel();\r\n\t\t\tif (document.getElementById(\"LPSRoundPanel_status\") != null)\r\n\t\t\t\tdocument.getElementById(\"LPSRoundPanel_status\").innerHTML = e.result;\r\n\r\n\t\t\tif (document.getElementById(\"LPSRoundPanel_lbl01_ErrorStatus\") != null)\r\n\t\t\t\tdocument.getElementById(\"LPSRoundPanel_lbl01_ErrorStatus\").innerHTML =\r\n\t\t\t\t\te.result;\r\n\r\n\t\t\tif (document.getElementById(\"lpsRoundPanel_lbl01_ErrorStatus\") != null)\r\n\t\t\t\tdocument.getElementById(\"lpsRoundPanel_lbl01_ErrorStatus\").innerHTML =\r\n\t\t\t\t\te.result;\r\n\r\n\t\t\tif (document.getElementById(\"LPSRoundPanel_lbl01_SuccessStatus\") != null)\r\n\t\t\t\tdocument.getElementById(\"LPSRoundPanel_lbl01_SuccessStatus\").innerHTML =\r\n\t\t\t\t\t\"\";\r\n\r\n\t\t\tif (document.getElementById(\"lbl01_ErrorStatus\") != null)\r\n\t\t\t\tdocument.getElementById(\"lbl01_ErrorStatus\").innerHTML = e.result;\r\n\t\t\tif (document.getElementById(\"lbl01_SuccessStatus\") != null)\r\n\t\t\t\tdocument.getElementById(\"lbl01_SuccessStatus\").innerHTML = \"\";\r\n\r\n\t\t\t//btn_Save.Focus();\r\n\t\t\t//Might want to add check here to make sure field exists\r\n\t\t\tif (document.getElementById(\"erow\") != null) {\r\n\t\t\t\tif (window.parent == window.self) {\r\n\t\t\t\t\tdocument.getElementById(\"erow\").scrollIntoView();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif (document.getElementById(\"nextpage\") != null)\r\n\t\t\t\tdocument.getElementById(\"nextpage\").value = \"\"; //reset nextpage on error\r\n\t\t}\r\n\t}\r\n}\r\nfunction validatorPresent() {\r\n\tvar isValidatorPresent = true;\r\n\tif (typeof window.Page_Validators == \"undefined\") {\r\n\t\tisValidatorPresent = false;\r\n\t}\r\n\treturn isValidatorPresent;\r\n}\r\nfunction ShowLoadingPanel(s, e) {\r\n\tif (document.getElementById(\"LPSRoundPanel_btn_Save\") != null) {\r\n\t\tdocument.getElementById(\"LPSRoundPanel_btn_Save\").disabled = true;\r\n\t}\r\n\tif (document.getElementById(\"btn_Save\") != null) {\r\n\t\tdocument.getElementById(\"btn_Save\").disabled = true;\r\n\t}\r\n}\r\nfunction HideLoadingPanel() {\r\n\twindow.lps.Hide();\r\n}\r\nfunction goback() {\r\n\thistory.go(-1);\r\n}\r\nfunction gobackToAdminMenu() {\r\n\twindow.location.href = \"Admin/SystemAdmin.aspx\";\r\n}\r\nfunction gobackeditmenu() {\r\n\t//history.go(-1);\r\n\tif (typeof HTTP !== \"undefined\" && HTTP.clientExternalEnvironmentUrl) {\r\n\t\twindow.location.href = HTTP.clientExternalEnvironmentUrl + \"/nettrack/LPMS/LPMSEditMenu.aspx\" + window.location.search;\r\n\t} else {\r\n\t\t// Fallback: use a default path if HTTP is not defined\r\n\t\twindow.location.href = \"LPMSEditMenu.aspx\" + window.location.search;\r\n\t}\r\n}\r\nfunction gobackeditmenusystem(smenu) {\r\n\t//history.go(-1);\r\n\tif (smenu == \"S\") {\r\n\t\tif (typeof HTTP !== \"undefined\" && HTTP.clientExternalEnvironmentUrl) {\r\n\t\t\twindow.location.href = HTTP.clientExternalEnvironmentUrl + \"/nettrack/LPMS/LPMSEditMenuSRMS.aspx\" + window.location.search;\r\n\t\t} else {\r\n\t\t\t// Fallback: use a default path if HTTP is not defined\r\n\t\t\twindow.location.href = \"LPMSEditMenuSRMS.aspx\" + window.location.search;\r\n\t\t}\r\n\t} else if (smenu == \"X\") {\r\n\t\thistory.go(-1);\r\n\t\t//window.location.href = '../SystemSelect.aspx' + window.location.search;\r\n\t} else {\r\n\t\tif (typeof HTTP !== \"undefined\" && HTTP.clientExternalEnvironmentUrl) {\r\n\t\t\twindow.location.href = HTTP.clientExternalEnvironmentUrl + \"/nettrack/LPMS/LPMSEditMenu.aspx\" + window.location.search;\r\n\t\t} else {\r\n\t\t\t// Fallback: use a default path if HTTP is not defined\r\n\t\t\twindow.location.href = \"LPMSEditMenu.aspx\" + window.location.search;\r\n\t\t}\r\n\t}\r\n}\r\nfunction gobackmainmenu() {\r\n\t//history.go(-1);\r\n\twindow.location.href = \"Menu.aspx\" + window.location.search;\r\n}\r\nfunction getQueryStringItem(variable, url) {\r\n\tvar query = window.location.search.substring(1);\r\n\tif (url) query = url.substring(url.indexOf(\"?\") + 1);\r\n\tvar vars = query.split(\"&\");\r\n\tfor (var i = 0; i < vars.length; i++) {\r\n\t\tvar pair = vars[i].split(\"=\");\r\n\t\tif (pair[0] == variable) {\r\n\t\t\treturn pair[1];\r\n\t\t}\r\n\t}\r\n}\r\nfunction setDropDownList(elementRef, valueToSetTo) {\r\n\tvar isFound = false;\r\n\r\n\tfor (var i = 0; i < elementRef.GetItemCount(); i++) {\r\n\t\tif (elementRef.GetItem(i).value == valueToSetTo) {\r\n\t\t\telementRef.SetSelectedIndex(i);\r\n\t\t\tisFound = true;\r\n\t\t}\r\n\t}\r\n}\r\nfunction setDropDownListBasic(elementRef, valueToSetTo) {\r\n\tvar isFound = false;\r\n\r\n\tfor (var i = 0; i < elementRef.options.length; i++) {\r\n\t\tif (elementRef.options[i].value == valueToSetTo) {\r\n\t\t\telementRef.options[i].selected = true;\r\n\t\t\tisFound = true;\r\n\t\t}\r\n\t}\r\n}\r\nfunction isExisting(obj) {\r\n\ttry {\r\n\t\treturn typeof eval(obj) != undefined;\r\n\t} catch (e) {\r\n\t\treturn false;\r\n\t}\r\n}\r\nfunction SetPopupSize(sender, e) {\r\n\tvar popupWidth, popupHeight;\r\n\tif (sender.IsVisible()) {\r\n\t\tif (screen.height > 1) {\r\n\t\t\tsender.SetSize(window.innerWidth * 0.9, window.innerHeight * 0.95);\r\n\t\t\tsender.UpdatePosition();\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunction ScrollPage() {\r\n\twindow.scrollTo(0, 0);\r\n\tvar padding = 50;\r\n\tvar footerHeight = 100; //footerHeight = footer height + element height + buffer\r\n\t$(\"input, textarea, select, div\").focus(function () {\r\n\t\tvar element = $(this);\r\n\t\tif (element.offset().top - $(window).scrollTop() < 165) {\r\n\t\t\t$(\"html, body\").animate(\r\n\t\t\t\t{\r\n\t\t\t\t\tscrollTop:\r\n\t\t\t\t\t\telement.offset().top -\r\n\t\t\t\t\t\t165 /* 80 is height of navbar + input label */,\r\n\t\t\t\t},\r\n\t\t\t\t500\r\n\t\t\t);\r\n\t\t}\r\n\t\tif (\r\n\t\t\telement.offset().top - $(window).scrollTop() >\r\n\t\t\t$(window).height() - footerHeight\r\n\t\t) {\r\n\t\t\t$(\"html, body\").animate(\r\n\t\t\t\t{\r\n\t\t\t\t\tscrollTop: element.offset().top - ($(window).height() - footerHeight),\r\n\t\t\t\t},\r\n\t\t\t\t500\r\n\t\t\t);\r\n\t\t}\r\n\t});\r\n}\r\n\r\nfunction ProcessRequiredHTMLEditor(s, e) {\r\n\tvar htmleditor;\r\n\tif (jQueryIncluded()) {\r\n\t\t$(\"[id$='_DesignViewCell_ETC']\").each(function () {\r\n\t\t\tif ($(this).is(\":visible\")) {\r\n\t\t\t\thtmleditor = this.id.replace(\"_DesignViewCell_ETC\", \"_DesignIFrame\");\r\n\t\t\t\t$(\"#\" + htmleditor).focus();\r\n\t\t\t\tdocument.getElementById(htmleditor).scrollIntoView();\r\n\t\t\t\t$(window).scrollTop($(window).scrollTop() - 200);\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n}\r\nfunction ProcessRequiredUCO(s, e) {\r\n\tvar grdEditorID;\r\n\tvar ret = true;\r\n\tvar grdFirst = \"\";\r\n\tif (jQueryIncluded()) {\r\n\t\t$(\"[id$='_DXEmptyRow']\").each(function () {\r\n\t\t\tif ($(this).is(\":visible\")) {\r\n\t\t\t\tgrdEditorID = this.id.replace(\"_DXEmptyRow\", \"\");\r\n\t\t\t\t//get editor\r\n\t\t\t\tvar editor =\r\n\t\t\t\t\tASPxClientControl.GetControlCollection().GetByName(grdEditorID);\r\n\r\n\t\t\t\tif (editor.cpRequired !== undefined) {\r\n\t\t\t\t\tif ((editor.cpRequired == \"yes\")) {\r\n\t\t\t\t\t\t//set the First uco;\r\n\t\t\t\t\t\tif (grdFirst == \"\") {\r\n\t\t\t\t\t\t\tgrdFirst = grdEditorID;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\t$(this).addClass(\"dxheErrorFrame_Moderno\");\r\n\t\t\t\t\t\t$(this).css(\"background-color\", \"#FBC7C7\");\r\n\t\t\t\t\t\t$(this).find(\"td.dxgv div\").html(editor.cpRequiredText);\r\n\t\t\t\t\t\t$(this).find(\"td.dxgv\").removeClass(\"dxgv\").addClass(\"dxhe\");\r\n\t\t\t\t\t\tret = false;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t\tif (ret == false) {\r\n\t\t\t$(\"#\" + grdFirst).focus();\r\n\t\t\t//show First uco in screen\r\n\t\t\tif (document.getElementById(grdFirst)) {\r\n\t\t\t\tdocument.getElementById(grdFirst).scrollIntoView();\r\n\t\t\t\t$(window).scrollTop($(window).scrollTop() - 100);\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\treturn ret;\r\n}\r\n\r\nfunction jQueryIncluded() {\r\n\tvar f = true;\r\n\r\n\tif (typeof jQuery === \"undefined\") {\r\n\t\t//jQuery is NOT included\r\n\t\tf = false;\r\n\t}\r\n\r\n\treturn f;\r\n}\r\n\r\n// Add cookie functions\r\n\r\nfunction createCookie(name, value, days) {\r\n\tvar expires;\r\n\r\n\tif (days) {\r\n\t\tvar date = new Date();\r\n\t\tdate.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);\r\n\t\texpires = \"; expires=\" + date.toGMTString();\r\n\t} else {\r\n\t\texpires = \"\";\r\n\t}\r\n\t//document.cookie = escape(name) + \"=\" + escape(value) + expires + \"; path=/; Secure;\"\r\n\tdocument.cookie = escape(name) + \"=\" + escape(value) + expires + \"; path=/;\";\r\n}\r\n\r\nfunction readCookie(name) {\r\n\tvar nameEQ = escape(name) + \"=\";\r\n\tvar ca = document.cookie.split(\";\");\r\n\tfor (var i = 0; i < ca.length; i++) {\r\n\t\tvar c = ca[i];\r\n\t\twhile (c.charAt(0) === \" \") c = c.substring(1, c.length);\r\n\t\tif (c.indexOf(nameEQ) === 0)\r\n\t\t\treturn unescape(c.substring(nameEQ.length, c.length));\r\n\t}\r\n\treturn null;\r\n}\r\n\r\nfunction eraseCookie(name) {\r\n\tcreateCookie(name, \"\", -1);\r\n}\r\n\r\nfunction getUrlParameter(name) {\r\n\tname = name.replace(/[\\[]/, \"\\\\[\").replace(/[\\]]/, \"\\\\]\");\r\n\tvar regex = new RegExp(\"[\\\\?&]\" + name + \"=([^&#]*)\");\r\n\tvar results = regex.exec(location.search);\r\n\treturn results === null\r\n\t\t? \"\"\r\n\t\t: decodeURIComponent(results[1].replace(/\\+/g, \" \"));\r\n}\r\n\r\n//isDate is moved from DateCals.js\r\n//Value parameter - required. All other parameters are optional.\r\nfunction isDate(value, sepVal, dayIdx, monthIdx, yearIdx, isAnyYear) {\r\n\ttry {\r\n\t\t//Allow date from future year\r\n\t\tif (!isAnyYear) isAnyYear = false;\r\n\t\t//Change the below values to determine which format of date you wish to check. It is set to dd/mm/yyyy by default.\r\n\t\tvar MonthIndex = monthIdx !== undefined ? monthIdx : 0;\r\n\t\tvar DayIndex = dayIdx !== undefined ? dayIdx : 1;\r\n\t\tvar YearIndex = yearIdx !== undefined ? yearIdx : 2;\r\n\r\n\t\t//Bring in the correct Date Format based on the Culture\r\n\t\tvar dformat = getLanguageDateFormat();\r\n\t\tvar regex;\r\n\r\n\t\tDayIndex = dformat[0];\r\n\t\tMonthIndex = dformat[1];\r\n\t\tYearIndex = dformat[2];\r\n\r\n\t\tvalue = value\r\n\t\t\t.replace(/-/g, \"/\")\r\n\t\t\t.replace(/T.+/, \"\")\r\n\t\t\t.replace(/ .+/, \"\")\r\n\t\t\t.replace(/\\./g, \"/\");\r\n\r\n\t\tvar SplitValue = value.split(\"/\");\r\n\t\tif (SplitValue[YearIndex].length > 4) {\r\n\t\t\tSplitValue[YearIndex] = SplitValue[YearIndex].substring(0, 4);\r\n\t\t}\r\n\t\t//SJB Need to re-adjust the values here since the TIME field may be appended ' 00:00:00'\r\n\t\t//  Previously this was only checked on the Year index because it assumed it was the last field. With different cultures, it could append to any field now\r\n\t\tif (SplitValue[DayIndex].length == 8) {\r\n\t\t\tSplitValue[DayIndex] = SplitValue[DayIndex].substring(0, 2);\r\n\t\t}\r\n\t\tif (SplitValue[MonthIndex].length == 8) {\r\n\t\t\tSplitValue[MonthIndex] = SplitValue[MonthIndex].substring(0, 2);\r\n\t\t}\r\n\t\t//End of new check\r\n\r\n\t\tvar OK = true;\r\n\t\tif (\r\n\t\t\t!(SplitValue[DayIndex].length == 1 || SplitValue[DayIndex].length == 2)\r\n\t\t) {\r\n\t\t\tOK = false;\r\n\t\t}\r\n\t\tif (\r\n\t\t\tOK &&\r\n\t\t\t!(\r\n\t\t\t\tSplitValue[MonthIndex].length == 1 || SplitValue[MonthIndex].length == 2\r\n\t\t\t)\r\n\t\t) {\r\n\t\t\tOK = false;\r\n\t\t}\r\n\t\tif (OK && SplitValue[YearIndex].length != 4) {\r\n\t\t\tOK = false;\r\n\t\t}\r\n\t\tif (OK) {\r\n\t\t\tvar Day = parseInt(SplitValue[DayIndex], 10);\r\n\t\t\tvar Month = parseInt(SplitValue[MonthIndex], 10);\r\n\t\t\tvar Year = parseInt(SplitValue[YearIndex], 10);\r\n\r\n\t\t\tif (\r\n\t\t\t\t(OK = Year > 1900 && (Year <= new Date().getFullYear() || isAnyYear))\r\n\t\t\t) {\r\n\t\t\t\tif ((OK = Month <= 12 && Month > 0)) {\r\n\t\t\t\t\tvar LeapYear = (Year % 4 == 0 && Year % 100 != 0) || Year % 400 == 0;\r\n\r\n\t\t\t\t\tif ((OK = Day > 0)) {\r\n\t\t\t\t\t\tif (Month == 2) {\r\n\t\t\t\t\t\t\tOK = LeapYear ? Day <= 29 : Day <= 28;\r\n\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\tif (Month == 4 || Month == 6 || Month == 9 || Month == 11) {\r\n\t\t\t\t\t\t\t\tOK = Day <= 30;\r\n\t\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t\tOK = Day <= 31;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn OK;\r\n\t} catch (e) {\r\n\t\treturn false;\r\n\t}\r\n}\r\n\r\n//getDateFormat is moved from DateCals.js\r\nfunction getDateFormat() {\r\n\tvar DateFormat = \"\";\r\n\r\n\t//Referring to a hidden field using 'window.LocalLanguage' does not return a STRING value\r\n\t//var cformat = window.LocalLanguage;\r\n\tvar cformat = document.getElementById(\"LocalLanguage\").value;\r\n\r\n\t//Use the Culture code to return the correct Date Format to use in the 'IsDate' function\r\n\t//Returning this as an array [Day], [Month], [Year] Position\r\n\r\n\tif (cformat === \"AF\") {\r\n\t\t//strLCID = 1078  ' Afrikaans\r\n\t\t//DateFormat = \"yyyy/MM/dd\"\r\n\t\tDateFormat = \"2,1,0\";\r\n\t}\r\n\tif (cformat === \"SQ\") {\r\n\t\t//strLCID = 1052  ' Albanian\r\n\t\t//DateFormat = \"yyyy-MM-dd\"\r\n\t\tDateFormat = \"1,2,0\";\r\n\t}\r\n\tif (cformat === \"ar-SA\") {\r\n\t\t//strLCID = 1025  ' Arabic(Saudi Arabia)\r\n\t\t//DateFormat = \"dd/MM/yy\"\r\n\t\tDateFormat = \"0,1,2\";\r\n\t}\r\n\tif (cformat === \"ar-IQ\") {\r\n\t\t//strLCID = 2049  ' Arabic(Iraq)\r\n\t\t//DateFormat = \"dd/MM/yyyy\"\r\n\t\tDateFormat = \"0,1,2\";\r\n\t}\r\n\tif (cformat === \"ar-EG\") {\r\n\t\t//strLCID = 3073  ' Arabic(Egypt)\r\n\t\t//DateFormat = \"dd/MM/yyyy\"\r\n\t\tDateFormat = \"0,1,2\";\r\n\t}\r\n\tif (cformat === \"ar-LY\") {\r\n\t\t//strLCID = 4097  ' Arabic(Libya)\r\n\t\t//DateFormat = \"dd/MM/yyyy\"\r\n\t\tDateFormat = \"0,1,2\";\r\n\t}\r\n\tif (cformat === \"ar-DZ\") {\r\n\t\t//strLCID = 5121  ' Arabic(Algeria)\r\n