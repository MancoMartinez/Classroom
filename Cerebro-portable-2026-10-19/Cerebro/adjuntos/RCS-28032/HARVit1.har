            "text": "/*\n * Bundle: ../../styles/new.ui.css\n * Generated: 2026-08-20T08:38:07.164Z\n * Source files: 26\n */\n\n\n/* ========================================\n * Source: Components/src/styles/Cpf/Content/Styles/new/n_workview.css\n * ======================================== */\n\n.fti-body {\r\n    overflow-y: visible;\r\n}\r\n\r\n    .fti-body > .row {\r\n        width: 100%;\r\n        margin: 0;\r\n    }\r\n\r\n.wv-search-details {\r\n    border: none;\r\n    font-size: 0.875rem;\r\n    color: var(--muted);\r\n}\r\n\r\n.wv-filter {\r\n    color: var(--muted);\r\n}\r\n\r\n.workview-dv-body .dv-body {\r\n    padding: 0;\r\n    overflow-x: hidden;\r\n}\r\n\r\n.wv-tag {\r\n    background: rgba(var(--primary-rgb), 0.25);\r\n    border-radius: 0.75rem;\r\n    font-size: 0.875rem;\r\n    color: var(--secure-primary-text);\r\n    padding: 0.25rem .5rem;\r\n    transition: all .2s ease;\r\n    display: flex;\r\n    line-height: 0.875rem;\r\n}\r\n\r\n    .wv-tag span {\r\n        display: block;\r\n        overflow: hidden;\r\n        text-overflow: ellipsis;\r\n        white-space: pre;\r\n        text-align: left;\r\n    }\r\n\r\n        .wv-tag span:first-child {\r\n            font-size: 0.75rem;\r\n            color: var(--muted);\r\n        }\r\n\r\n        /* last-of-type because there could be another elem after the tags, like remove comp */\r\n        .wv-tag span:last-of-type:not(:first-child) {\r\n            margin-left: auto;\r\n        }\r\n\r\n    .wv-tag:not(:last-child) {\r\n        margin-bottom: .25rem;\r\n    }\r\n\r\n    .wv-tag[ng-click]:hover {\r\n        cursor: pointer;\r\n        background: rgba(var(--primary-rgb), 0.35);\r\n    }\r\n\r\n    .wv-tag .watch-item {\r\n        display: inline;\r\n        padding: 0.07rem 0.3rem;\r\n        padding-right: 1.20rem;\r\n    }\r\n\r\n        .wv-tag .watch-item span:last-child {\r\n            width: inherit;\r\n            color: inherit;\r\n        }\r\n\r\n        .wv-tag .watch-item .watch-btn {\r\n            padding: 0;\r\n            line-height: 1;\r\n            display: flex;\r\n            flex-direction: column;\r\n            justify-content: center;\r\n        }\r\n\r\n        .wv-tag .watch-item .context-item-btn {\r\n            position: initial;\r\n            padding: 0 0.3rem;\r\n        }\r\n\r\n.wv-tag-btn {\r\n    background: rgba(var(--primary-rgb), 0.25);\r\n    cursor: pointer;\r\n    color: var(--secure-primary-text);\r\n    text-align: center;\r\n}\r\n\r\n    .wv-tag-btn:hover,\r\n    .wv-tag.wv-tag-btn:hover {\r\n        background: rgba(var(--primary-rgb), 0.35);\r\n    }\r\n\r\n#filterDialogFilters div.wv-tag.wv-tag-btn.clearAllBtn-right {\r\n\tfloat: right;\r\n\tbackground: transparent;\r\n\tjustify-content: right;\r\n}\r\n\r\n.workview-app-filter {\r\n    padding: .1rem .5rem .1rem 1rem;\r\n    background: rgba(var(--primary-rgb), 0.25);\r\n    border-radius: 1rem;\r\n    font-size: 0.875rem;\r\n    display: inline-block;\r\n}\r\n\r\n    .workview-app-filter label {\r\n        font-weight: bold;\r\n        opacity: 0.75;\r\n        margin: 0;\r\n    }\r\n\r\n    .workview-app-filter .btn.btn-fa {\r\n        padding: 0;\r\n    }\r\n\r\n.prescribed-workview-app-filter {\r\n    padding: .1rem .5rem .1rem 1rem;\r\n    background: rgba(var(--primary-rgb), 0.25);\r\n    color: var(--secure-primary-text);\r\n    border-radius: 1rem;\r\n    font-size: 0.875rem;\r\n    display: inline-block;\r\n}\r\n\r\n    .prescribed-workview-app-filter label {\r\n        font-weight: bold;\r\n        margin: 0;\r\n    }\r\n\r\n    .prescribed-workview-app-filter .btn.btn-fa {\r\n        padding: 0;\r\n    }\r\n\r\n\t\t.prescribed-workview-app-filter .btn.btn-fa.workview-filter-remove {\r\n\t\t\tbackground-color: transparent;\r\n\t\t}\r\n\r\n\t\t\t.prescribed-workview-app-filter .btn.btn-fa.workview-filter-remove  span.fa-times-circle.text-light {\r\n\t\t\t\tcolor: #627895!important;\r\n\t\t\t}\r\n\r\n.wv-header.zugo-header {\r\n    padding: 0.5rem 1rem;\r\n}\r\n\r\n.wv-header .zugo-title {\r\n    display: none !important;\r\n}\r\n\r\n.wv-body {\r\n    padding: 1rem;\r\n    overflow: auto;\r\n}\r\n\r\n.wv-loader {\r\n    z-index: 200;\r\n    position: fixed;\r\n    width: 100%;\r\n    bottom: 0;\r\n    height: 10rem;\r\n}\r\n\r\n.wv-app-icon {\r\n    display: table-cell;\r\n    width: 3rem;\r\n    vertical-align: middle;\r\n    text-align: center;\r\n    cursor: pointer;\r\n}\r\n\r\n.wv-item-date {\r\n    font-size: .75rem;\r\n    color: var(--muted);\r\n}\r\n\r\n.wv-body iframe {\r\n    width: 100%;\r\n    height: calc(100% - 8rem);\r\n    border: 0;\r\n    overflow: hidden;\r\n    position: absolute;\r\n    left: 0;\r\n    right: 0;\r\n    padding-top: 1rem;\r\n}\r\n\r\n.workview-content {\r\n    width: 100%;\r\n}\r\n\r\n.wv-body iframe.load-off-screen {\r\n    position: absolute;\r\n    margin-left: -10000px;\r\n}\r\n\r\n\r\n/* WorkView card styles  */\r\n\r\n.wv-card {\r\n    margin-bottom: 0.5rem;\r\n    width: 100%;\r\n    display: flex;\r\n}\r\n\r\n\r\n    .wv-card.wv-card-stack {\r\n        border: 1px solid var(--border-strong);\r\n        margin: 0 0 1rem;\r\n        position: relative;\r\n    }\r\n\r\n        .wv-card.wv-card-stack:before, .wv-card.wv-card-stack:after {\r\n            background: var(--border-strong);\r\n            height: 3px;\r\n            position: absolute;\r\n            content: '';\r\n            display: block;\r\n            bottom: -4px;\r\n            border-radius: 0 0 .25rem .25rem\r\n        }\r\n\r\n        .wv-card.wv-card-stack:before {\r\n            bottom: -6px;\r\n            left: .5rem;\r\n            right: .5rem;\r\n        }\r\n\r\n        .wv-card.wv-card-stack:after {\r\n            bottom: -10px;\r\n            left: 1rem;\r\n            right: 1rem;\r\n        }\r\n\r\n\r\n/* WorkView card columns */\r\n\r\n.wv-col {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    padding-bottom: 1.5rem;\r\n    position: relative;\r\n    text-align: center;\r\n    flex-grow: 1;\r\n}\r\n\r\n    .wv-col h3 {\r\n        position: absolute;\r\n        bottom: 0;\r\n        left: 0;\r\n        width: 100%;\r\n        text-align: center;\r\n        padding: 0;\r\n        margin: 0;\r\n        font-size: .875rem;\r\n        border: 0;\r\n        font-weight: normal;\r\n    }\r\n\r\n    .wv-col > div {\r\n        padding: 1rem;\r\n        width: 100%;\r\n    }\r\n\r\n    .wv-col + .wv-col:before {\r\n        display: block;\r\n        content: '';\r\n        position: absolute;\r\n        top: 1rem;\r\n        left: 0;\r\n        bottom: 1rem;\r\n        border-left: 1px solid var(--border-light);\r\n    }\r\n\r\n    .wv-col.wv-col-desc:before {\r\n        display: none;\r\n    }\r\n\r\n    .wv-col.wv-section-col {\r\n        padding: 0;\r\n        flex-grow: 1;\r\n        flex-basis: 42%;\r\n        width: 42%;\r\n    }\r\n\r\n        .wv-col.wv-section-col > div {\r\n            display: flex;\r\n            height: 100%;\r\n            width: 100%;\r\n            padding: 1rem;\r\n        }\r\n\r\n\r\n        .wv-col.wv-section-col .wv-col > div {\r\n            font-size: 1.325rem;\r\n            word-break: break-word;\r\n            font-weight: bold;\r\n            letter-spacing: -0.05rem;\r\n        }\r\n\r\n        .wv-col.wv-section-col .wv-col {\r\n            background: var(--background);\r\n            margin: 0 0.25rem;\r\n            border-radius: 1rem;\r\n        }\r\n\r\n            .wv-col.wv-section-col .wv-col:before {\r\n                display: none;\r\n            }\r\n\r\nwv-col-details-options {\r\n    display: flex;\r\n}\r\n\r\n.wv-col-details-options .btn {\r\n    margin-top: .25rem;\r\n}\r\n\r\n.wv-col-tags {\r\n    width: 16rem;\r\n}\r\n\r\n.wv-col-desc {\r\n    width: 32%;\r\n    text-align: left;\r\n    justify-content: left;\r\n    display: flex;\r\n    padding-bottom: 0;\r\n}\r\n\r\n.wv-col.wv-col-details .wv-col-details-options {\r\n    width: 16rem;\r\n}\r\n\r\n.wv-col.wv-col-indicator {\r\n    padding: 0;\r\n    flex: 0 0 auto;\r\n    display: flex;\r\n}\r\n\r\n    .wv-col.wv-col-indicator > div {\r\n        padding: 0;\r\n        height: 100%;\r\n        display: flex;\r\n        flex-wrap: nowrap;\r\n    }\r\n\r\n.wv-embedded-resource {\r\n    width: 100%;\r\n    height: 100%;\r\n    vertical-align: baseline;\r\n    display: block;\r\n    border: 0;\r\n    margin: 0;\r\n    padding: 0;\r\n    -webkit-box-flex: 1;\r\n    -ms-flex-positive: 1;\r\n    flex-grow: 1;\r\n}\r\n\r\n\r\n.card-indicator,\r\na.card-indicator {\r\n    width: 2rem;\r\n    background: var(--muted);\r\n    color: var(--text-contrast);\r\n    display: flex;\r\n    flex-direction: column;\r\n    text-align: center;\r\n    justify-content: center;\r\n    text-decoration: none;\r\n    cursor: pointer;\r\n}\r\n\r\n    .card-indicator.bg-mild,\r\n    a.card-indicator.bg-mild {\r\n        background: var(--section-border);\r\n        color: var(--muted);\r\n    }\r\n\r\n    .card-indicator:first-child {\r\n        border-radius: .25rem 0 0 .25rem;\r\n    }\r\n\r\n    .card-indicator.noclick {\r\n        cursor: default;\r\n    }\r\n\r\n/* filters styles */\r\n.wv-filter-dialog .btn {\r\n    margin-right: 0;\r\n}\r\n\r\n.wv-filter-dialog .filter-controls {\r\n    display: -webkit-box;\r\n    display: -ms-flexbox;\r\n    display: flex;\r\n    -webkit-box-orient: horizontal;\r\n    -webkit-box-direction: normal;\r\n    -ms-flex-direction: row;\r\n    flex-direction: row;\r\n    -ms-flex-wrap: nowrap;\r\n    flex-wrap: nowrap;\r\n    -webkit-box-pack: justify;\r\n    -ms-flex-pack: justify;\r\n    justify-content: space-between;\r\n    -webkit-box-align: center;\r\n    -ms-flex-align: center;\r\n    align-items: center;\r\n}\r\n\r\n.wv-filter-dialog .tag-filter-controls {\r\n    display: -webkit-box;\r\n    display: -ms-flexbox;\r\n    display: flex;\r\n    gap: .5rem;\r\n}\r\n\r\n    .wv-filter-dialog .tag-filter-controls sng-filterbox,\r\n    .wv-