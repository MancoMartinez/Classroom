\");\r\n\r\n        // if auto complete grid contains zugo grid\r\n        if (searchId != undefined) {\r\n            //var $searchContainer = $(\"#\" + searchId);\r\n            var $zugoRow = $($window).find(\".autocomplete-hidden:hidden\").clone();\r\n\r\n            //append help container if row contains help information otherwise, set text value\r\n            var $helpcontainer = $zugoRow.find(\".autocomplete-help-wrapper\");\r\n            if ($helpcontainer.length === 0) {\r\n                $(\".display-name\", $zugoRow).text(selected.label);\r\n            }\r\n            else {\r\n                $(\".display-name\", $zugoRow).text(selected.label).append($helpcontainer);\r\n\r\n                //re-wire close event for newly added row\r\n                $helpClose = $(\".autocomplete-help-close\", $zugoRow);\r\n\r\n                $helpClose.off(\"click\").on(\"click\", function () {\r\n                    $(this).parent().parent().hide();\r\n\r\n                    //remove table after close\r\n                    $(\"#auto-complete-nested-search > table\", $zugoRow).remove();\r\n                    return false;\r\n                });\r\n            }\r\n\r\n            //hide no results control\r\n            var $noResults = $(\"#\" + searchId).find(\".search-results .no-results\");\r\n            if ($noResults.length > 0 && !$noResults.hasClass(\"hidden\")) {\r\n                $noResults.addClass(\"hidden\");\r\n            }\r\n\r\n            //update values and show new row\r\n            $zugoRow.attr(\"data-row\", JSON.stringify(selected));\r\n            $zugoRow.find(\".stackview-title span\").text(selected.label);\r\n\r\n            //chech if control has child item, add child template if required\r\n            var $childItem = $window.find(\".child-item-template\").clone();\r\n            if ($childItem.length > 0) {\r\n\r\n                // $zugoRow.find(\".stackview-title\").after().append($childItem);\r\n                $zugoRow.find(\".child-item\").append($childItem).removeClass(\"hidden\");\r\n                $childItem.removeClass(\"child-item-template hidden\");\r\n                selected.childValue = $zugoRow.find(\".child-item select\").val();\r\n\r\n                $zugoRow.find(\".child-item select\").attr(\"selected-id\", selected.value);\r\n\r\n                //bind events\r\n                $zugoRow.find(\".child-item select\").on('change', function () {\r\n                    //find object and then update dictionary \r\n                    var selectedId = $(this).gcop().getAttribute(\"selected-id\");\r\n\r\n                    for (var i = 0, li = autocompleteGrid.changes[windowId][\"add\"].length; i < li; i++) {\r\n                        var item = autocompleteGrid.changes[windowId][\"add\"][i];\r\n                        if (item.value === selectedId) {\r\n\r\n                            autocompleteGrid.changes[windowId][\"add\"][i].childValue = $(this).val();\r\n                            return true;\r\n                        }\r\n                    }\r\n                    return false;\r\n                });\r\n            }\r\n\r\n            if (!autocompleteGrid.checkDuplicate($window, selected)) {\r\n                autocompleteGrid.trackChanges($window, \"add\", selected);\r\n                $($window).find(\".results-container\").append($zugoRow.addClass(\"stack-item zugo-item\"));\r\n\r\n\r\n                $zugoRow.find(\".autocomplete-remove\").off(\"click\").on(\"click\", $.proxy(function (event) {\r\n                    var selected = JSON.parse($($(event.currentTarget)[0]).parent().parent().parent().attr(\"data-row\"));\r\n                    autocompleteGrid.trackChanges($window, \"remove\", selected);\r\n                    try {\r\n                        var filterId = angular.element($window.find('.sngfilter')[0]).prop('id');\r\n                        var service = angular.element(document.body).injector().get('sngFilterboxAccessService');\r\n                        var exists = service.checkIfExists(filterId);\r\n                        if(exists) {\r\n                            // go figure: the old version of code (2 years old)\r\n                            // there is a remove method accepting an index - but here is no clear method accepting value\r\n                            // it could be: service.clear(filterId, value);\r\n                            service.clear(filterId);\r\n                        }\r\n                    } catch(error) {\r\n                        console.error(error);\r\n                    }\r\n                    $(event.currentTarget).closest(\".stack-item.zugo-item\").remove();\r\n                }, this));\r\n\r\n                $zugoRow.removeClass(\"autocomplete-hidden hidden\");\r\n            } else {\r\n                cpf.alert(selected.label + \" \" + \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{AutoCompleteGrid_Duplicate_Message}:{already added to list.}}\", \"i\");\r\n            }\r\n\r\n        }\r\n        else {\r\n            var $row = $window.find(\".autocomplete-table .data-row:hidden\");\r\n            var exists = false;\r\n            if ($row.length === 0) {\r\n                exists = true;\r\n                if (cpf.isIE7) {\r\n                    var $firstNow = $window.find(\".autocomplete-table .data-row\").first();\r\n                    $row = $($('<div>').append($firstNow.clone()).html());\r\n                }\r\n                else {\r\n                    $row = $window.find(\".autocomplete-table .data-row\").first().clone();\r\n                }\r\n            }\r\n\r\n            //append help container if row contains help information otherwise, set text value\r\n            var $helpcontainer = $row.find(\".autocomplete-help-wrapper\");\r\n            if ($helpcontainer.length === 0) {\r\n                $(\".display-name\", $row).text(selected.label);\r\n            }\r\n            else {\r\n                $(\".display-name\", $row).text(selected.label).append($helpcontainer);\r\n\r\n                //re-wire close event for newly added row\r\n                $helpClose = $(\".autocomplete-help-close\", $row);\r\n\r\n                $helpClose.off(\"click\").on(\"click\", function () {\r\n                    $(this).parent().parent().hide();\r\n\r\n                    //remove table after close\r\n                    $(\"#auto-complete-nested-search > table\", $row).remove();\r\n                    return false;\r\n                });\r\n            }\r\n\r\n            if ($row.find(\".child-item\").length > 0) {\r\n                // we have child items. we need to store this value too.\r\n                var childValue = $(\".child-item select\", $row).val();\r\n                selected[\"childValue\"] = childValue;\r\n            }\r\n\r\n            //  autocompleteGrid.trackChanges($window, \"add\", selected);\r\n\r\n            $row.attr(\"data\", JSON.stringify(selected));\r\n\r\n            if (exists) {\r\n\r\n                // validate seleted input is not a duplicate before appending to table\r\n                if (!autocompleteGrid.checkDuplicate($window, selected)) {\r\n                    autocompleteGrid.trackChanges($window, \"add\", selected);\r\n                    autocompleteGrid.rebindRow($window, $row);\r\n                    $(\".autocomplete-table tbody tr:last\", $window).after($row);\r\n                }\r\n                else {\r\n                    cpf.alert(selected.label + \" \" + \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{AutoCompleteGrid_Duplicate_Message}:{already added to list.}}\", \"i\");\r\n                }\r\n            }\r\n\r\n            $row.show();\r\n            $(\".search\", $window).attr(\"data-selected\", \"\").val(\"\");\r\n        }\r\n        return false;\r\n    },\r\n\r\n    /**\r\n     * @public\r\n     * @param {any} $window \r\n     * @param {any} selected \r\n     * @param {String} filterId identifier for sngFilterBox - use for service/mediator calls\r\n     * @returns \r\n     */\r\n    sngAdd: function ($window, selected, filterId) {\r\n        var windowId = $window.gcop().getAttribute(\"id\");\r\n        if (!autocompleteGrid.changes.hasOwnProperty(windowId)) { // if we aren't able to insert it, return\r\n            return;\r\n        }\r\n        var toRemove = -1;\r\n        for (var i = 0, ii = autocompleteGrid.changes[windowId].remove.length; i < ii; i++) {\r\n            if (autocompleteGrid.changes[windowId].remove[i].value !== selected.value.toLowerCase()) continue;\r\n            autocompleteGrid.changes[windowId].load.push(autocompleteGrid.changes[windowId].remove.splice(i, 1)[0]);\r\n            toRemove = i;\r\n            break;\r\n        }\r\n        if (toRemove > -1) {\r\n            var removeRows = $window[0].getElementsByClassName(\"to-remove\");\r\n            for (var j = 0, jj = removeRows.length; j < jj; j++) {\r\n                var data = removeRows[i].getAttribute(\"data-row\");\r\n                if (data.indexOf(selected.value.toLowerCase()) === -1) continue;\r\n                removeRows[i].className = removeRows[i].className.replace(/\\bto-remove\\b/, \"\");\r\n                try {\r\n                    var service = angular.element(document.body).injector().get(\"sngFilterboxAccessService\");\r\n                    var exists = service.checkIfExists(filterId);\r\n                    if(exists) {\r\n                        var oldValue = (service.getValues(filterId) || []);\r\n                        var newValue = oldValue.filter(function (el) { return el.value !== selected.value });\r\n                        service.setValues(filterId, newValue);\r\n                    }\r\n                } catch(error) {\r\n                    console.error(error);\r\n                }\r\n                break;\r\n            }\r\n        } else if (autocompleteGrid.checkDuplicate($window, selected)) { /// if the value is either added or loaded, don't add, but if it's in the remove array, undelete it.\r\n            if (autocompleteGrid.changes[windowId].add.filter(function (el) { return el.value === selected.value }).length === 0) { // if it's not in the Add array, we need to remove it from the filters values and show a message\r\n                try {\r\n                    var service = angular.element(document.body).injector().get(\"sngFilterboxAccessService\");\r\n                    var exists = service.checkIfExists(filterId);\r\n                    if(exists) {\r\n                        var oldValue = (service.getValues(filterId) || []);\r\n                        var newValue = oldValue.filter(function (el) { return el.value !== selected.value });\r\n                        service.setValues(filterId, newValue);\r\n                    }\r\n                } catch(error) {\r\n                    console.error(error);\r\n                }\r\n            }\r\n            cpf.alert(selected.label + \" \" + \"RESOURCE{{Sysrepublic.Foundation.CPF.CpfResources}:{AutoCompleteGrid_Duplicate_Message}:{already added to list.}}\", \"i\");\r\n        } else {\r\n            autocompleteGrid.trackChanges($window, \"add\", selected);\r\n            $window.find(\".no-results\").hide();\r\n        }\r\n    },\r\n\r\n    sngRemove: function ($window, selected) {\r\n        if (selected[\"Value\"]) {\r\n            selected.value = selected[\"Value\"];\r\n            delete selected.Value\r\n        }\r\n\r\n        if (autocompleteGrid.checkDuplicate($window, selected)) {\r\n            autocompleteGrid.trackChanges($window, \"remove\", selected);\r\n            if ($window.find(\".sngfilter-existing li\").length === 1 && $window.find(\".no-results\").length) {\r\n                $window.find(\".no-results\").show();\r\n            }\r\n        }\r\n    },\r\n\r\n    initChanges: function (windowId) {\r\n        if (typeof windowId != \"undefined\" && !autocompleteGrid.changes.hasOwnProperty(windowId)) {\r\n            autocompleteGrid.changes[windowId] = { load: [], add: [], remove: [] };\r\n        }\r\n    },\r\n\r\n    // track changes that have been made to the items in the grid.\r\n    trackChanges: function ($window, action, data) {\r\n        var windowId = $window.attr(\"id\");\r\n        if (!autocompleteGrid.changes.hasOwnProperty(windowId) && typeof windowId != \"undefined\") {\r\n            autocompleteGrid.changes[windowId] = { load: [], add: [], remove: [] };\r\n        }\r\n        if (action === \"load\" || action === \"add\") {\r\n            autocompleteGrid.changes[windowId][\"load\"].push(data);\r\n            // now make sure its not in the remove collection, if if was previously remove and added again.\r\n            for (var i = 0; i < autocompleteGrid.changes[windowId][\"remove\"].length; i++) {\r\n                var item = autocompleteGrid.changes[windowId][\"remove\"][i];\r\n                if (item.value !== data.value) continue;\r\n                autocompleteGrid.changes[windowId][\"remove\"].splice(i, 1);\r\n                return;\r\n            }\r\n            autocompleteGrid.changes[windowId][\"add\"].push(data);\r\n        }\r\n        else {\r\n            autocompleteGrid.changes[windowId][\"remove\"].push(data);\r\n\r\n            // now make sure its not in the add collection, if it was previously added then removed.\r\n            for (var i = 0; i < autocompleteGrid.changes[windowId][\"load\"].length; i++) {\r\n                var loadItem = autocompleteGrid.changes[windowId][\"load\"][i];\r\n                if (loadItem != undefined)\r\n                    if (loadItem.value === data.value) {\r\n                        autocompleteGrid.changes[windowId][\"load\"].splice(i, 1);\r\n                    }\r\n\r\n                var item = autocompleteGrid.changes[windowId][\"add\"][i];\r\n                if (item != undefined) {\r\n                    if (item.value === data.value) {\r\n                        autocompleteGrid.changes[windowId][\"add\"].splice(i, 1);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    },\r\n\r\n    getChanges: function ($window) {\r\n        return autocompleteGrid.changes[$window.attr(\"id\")];\r\n    },\r\n\r\n    //retrieve group permissions\r\n    searchHelp: function ($button, $window) {\r\n\r\n        var allowEntries = isTrue($window.attr(\"data-allow-free-text\"));\r\n\r\n        var selected = autocompleteGrid.selectedValue($window);\r\n\r\n        if (selected === null && !allowEntries) {\r\n            return false;\r\n        }\r\n        if ((selected === null || selected == undefined) && allowEntries) {\r\n            var searchValue = $(\".search\", $window).val();\r\n            if (searchValue == \"\") {\r\n                return false;\r\n            }\r\n            selected = {};\r\n            selected.label = searchValue;\r\n            selected.value = searchValue;\r\n        }\r\n\r\n        var $control = $button.parent().parent();\r\n        //get child data\r\n        autocompleteGrid.getChildData(selected, $control, $window);\r\n        return false;\r\n    },\r\n\r\n    getChildData: function (input, $control, $window) {\r\n\r\n        //get child path \r\n        var childpath = $window.attr(\"child-path\");\r\n        var messageArray = [];\r\n        var success = function (result, status, xhr) {\r\n            if (result.length > 0) {\r\n\r\n                var $message = $(\"#membership-permission\");\r\n\r\n                var arrayKeys = $.map(result[0], function (value, key) {\r\n                    return key;\r\n                });\r\n\r\n\r\n                messageArray[0] = \"<table width='100%'>\";\r\n                messageArray[1] = \"<thead><td>\" + arrayKeys[0] + \"</td><td>\" + arrayKeys[1] + \"</td><td>\" + arrayKeys[2] + \"</td></thead><tbody>\";\r\n\r\n                var $row = null;\r\n                var arraylength = result.length;\r\n                var permissionsList = \"\";\r\n                var count = 3;\r\n\r\n                for (var i = 0, li = result.length; i < li; i++) {\r\n\r\n                    if (i === 0) {\r\n                        messageArray[2] = \"<tr><td>\" + result[i].Type + \"</td><td>\" + result[i].Name + \"</td><td>\" + result[i].Permission + \"</td></tr>\";\r\n                    } else {\r\n\r\n                        //build comma seperated permissions\r\n                        if (result[i].Type === result[i - 1].Type && result[i].Name === result[i - 1].Name) {\r\n\r\n                            //reset messageArray index, and overwrite messageArray[2] existing value if the first row has already be set\r\n                            if ((i - 1) === 0) {\r\n                                count--;\r\n                            }\r\n\r\n                            if (permissionsList.length === 0) {\r\n\r\n                                var firstrecord = result[i - 1].Permission + \", \";\r\n                            }\r\n\r\n                            permissionsList += result[i].Permission + \", \";\r\n                        } else {\r\n\r\n                            if (permissionsList.length > 0) {\r\n                                messageArray[count] = \"<tr><td>\" + result[i - 1].Type + \"</td><td>\" + result[i - 1].Name + \"</td><td>\" + firstrecord + permissionsList.substring(0, permissionsList.length - 2) + \"</td></tr>\";\r\n                            }\r\n\r\n                            count++;\r\n                            messageArray[count] = \"<tr><td>\" + result[i].Type + \"</td><td>\" + result[i].Name + \"</td><td>\" + result[i].Permission + \"</td></tr>\";\r\n\r\n                            //reset variables\r\n                            permissionsList = \"\";\r\n                        }\r\n                    }\r\n                }\r\n\r\n                messageArray[count + 1] = \"</tbody></table>\";\r\n\r\n                $control.find(\"#auto-complete-nested-search\").html(messageArray.join(\"\"));\r\n\r\n                //TFS Bug 5620\r\n                $(\".autocomplete-help-wrapper\", $window).hide();\r\n\r\n                //remove display none\r\n                $autoCompleteHelpWrapper = $(\".autocomplete-help-wrapper\", $control);\r\n                $autoCompleteHelpWrapper.show();\r\n            } else {\r\n\r\n                messageArray[0] = \"<table width='100%'><tr><thead><td> No results found </td><thead></tr></table>\";\r\n                $control.find(\"#auto-complete-nested-search\").html(messageArray.join(\"\"));\r\n                var $autoCompleteHelpWrapper = $(\".autocomplete-help-wrapper\", $control);\r\n                $autoCompleteHelpWrapper.show();\r\n            }\r\n        };\r\n\r\n        var fail = function (result, status, xhr) {\r\n            if (!result[\"message\"]) {\r\n                cpf.alert(\"There was an error fetching the auto complete data.\", \"e\"); // Error:+ status\r\n            }\r\n        };\r\n\r\n        var data = input.value;\r\n\r\n        // get nested child results\r\n        cpf.ajax({ url: APPLICATIONPATH + childpath, success: success, errorCallback: fail, data: { \"groupId\": data } });\r\n    },\r\n\r\n    rowsearchHelp: function ($button, $window) {\r\n\r\n        var $newRow = $button.closest(\"tr\");\r\n        var $rowdata = $button.closest(\"tr\").attr(\"data\");\r\n\r\n        var data = JSON.parse($rowdata);\r\n        //get child data\r\n        autocompleteGrid.getChildData(data, $newRow, $window);\r\n\r\n        return false;\r\n    },\r\n\r\n    closeHelp: function ($button, $window) {\r\n        $button.parent().parent().hide();\r\n\r\n        $(\"#auto-complete-nested-search > table\", $button.parent()).remove();\r\n        return false;\r\n    },\r\n    //:end\r\n\r\n    remove: function ($button, $window) {\r\n\r\n        var selected = JSON.parse($button.closest(\".data-row\").attr(\"data\"));\r\n\r\n        if ($window.find(\".autocomplete-table .data-row\").length > 1) {\r\n\r\n            $button.closest(\".data-row\").remove();\r\n        }\r\n        else {\r\n\r\n            $button.closest(\".data-row\").hide();\r\n            $button.closest(\".data-row\").attr(\"data\", \"\");\r\n            $(\".none-selected\", $window).show();\r\n        }\r\n\r\n        autocompleteGrid.trackChanges($window, \"remove\", selected);\r\n\r\n        var args = {};\r\n        args.data = selected;\r\n\r\n        $window.trigger(\"removed\", [args]);\r\n\r\n        return false;\r\n    },\r\n\r\n    removeAll: function ($window, trackChanges) {\r\n\r\n        var $table = $window.find(\".autocomplete-table\");\r\n        var $rows = $table.find(\".data-row\");\r\n\r\n        if ($rows.length > 1) {\r\n\r\n            var track = true;\r\n            if (trackChanges != undefined && trackChanges === false) {\r\n                track = false;\r\n            }\r\n\r\n            //loop all the rows and add the data to the changes collection.\r\n            for (var i = 0, ii = $rows.length; i < ii; i++) {\r\n                if (track) {\r\n                    autocompleteGrid.trackChanges($window, \"remove\", JSON.parse($rows.eq(i).attr(\"data\")));\r\n                }\r\n            }\r\n\r\n            $table.find(\".data-row:gt(0)\").remove();\r\n        }\r\n\r\n        $rows.hide();\r\n        $rows.attr(\"data\", \"\");\r\n\r\n        $(\".none-selected\", $window).show();\r\n    },\r\n\r\n    selectedValue: function ($window) {\r\n\r\n        var $search = $window.find(\".search\");\r\n        try {\r\n            return JSON.parse($search.attr(\"data-selected\"));\r\n        } catch (e) {\r\n            return null;\r\n        }\r\n    },\r\n\r\n    val: function ($window) {\r\n        var items = [];\r\n\r\n        // are we dealing with a list or single mode?\r\n        var singleMode = $window.attr(\"data-list-type\") === \"single\";\r\n        if (singleMode) {\r\n\r\n            //TFS Bug 5559\r\n            var singleValueBox = $window.find(\".search\");\r\n            var dataSelected = singleValueBox.attr(\"data-selected\");\r\n\r\n            if (dataSelected) {\r\n                var singleValue = JSON.parse(dataSelected);\r\n                items.push(singleValue.value);\r\n            }\r\n        }\r\n        else if ($window.find(\".autocomplete-table\").length > 0) {\r\n            var rows = $window.find(\".autocomplete-table .data-row:visible\");\r\n            if (rows.length === 0) {\r\n                //check for hidden rows\r\n                rows = $window.find(\".autocomplete-table .data-row:hidden\");\r\n            }\r\n\r\n            var $row = null;\r\n\r\n            for (var i = 0, li = rows.length; i < li; i++) {\r\n\r\n                $row = $(rows[i]);\r\n\r\n                var rowData = $(rows[i]).attr(\"data\");\r\n                if (rowData != null) {\r\n                    if (rowData !== \"\") {\r\n                        var data = JSON.parse(rowData);\r\n                        if ($(\".child-item\", $row).length > 0) {\r\n                            data.childValue = $(\".child-item select\", $row).val();\r\n                        }\r\n                        items.push(data);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        else {\r\n            var windowId = $window.gcop().getAttribute(\"id\");\r\n            items = autocompleteGrid.changes[windowId][\"load\"];\r\n        }\r\n        return items;\r\n\r\n    },\r\n\r\n    checkDuplicate: function ($window, input) {\r\n        var windowId = $window.attr(\"id\");\r\n        if (autocompleteGrid.changes[windowId] != undefined) {\r\n            for (var i = 0, li = autocompleteGrid.changes[windowId][\"load\"].length; i < li; i++) {\r\n                var item = autocompleteGrid.changes[windowId][\"load\"][i];\r\n                var val = input.value ? input.value : input.Value;\r\n                if (val) {\r\n                    if (item.value.toLowerCase() === val.toLowerCase()) {\r\n                        return true;\r\n                    }\r\n                }                \r\n            }\r\n        }\r\n\r\n        return false;\r\n    },\r\n\r\n    hideWindow: function ($window) {\r\n\r\n        $window.find(\".autocomplete-table .data-row\").addClass(\"hidden\");\r\n        $window.hide();\r\n    },\r\n\r\n    showWindow: function ($window) {\r\n\r\n        //add scolling to the content if value exceeds 200 items\r\n        if ($window.find(\".autocomplete-table .data-row\").length >= 30) {\r\n            $(\".autocomplete-content\", $window).css('height', '400px');\r\n            $(\".autocomplete-content\", $window).css('overflow-y', 'scroll');\r\n        }\r\n        $window.find(\".autocomplete-table .data-row\").removeClass(\"hidden\");\r\n        $window.show();\r\n    },\r\n\r\n    initialiseWindowWithHidden: function ($window) {\r\n        //        for (i = 0; i < $window.find(\".autocomplete-table .data-row\").length; i++) {\r\n        //            if ($window.find(\".autocomplete-table .data-row:eq(\" + i + \")\").css(\"display\") != \"none\") {\r\n        //                $window.find(\".autocomplete-table .data-row:eq(\" + i + \")\").addClass(\"hidden\");\r\n        //            }\r\n        //        }\r\n        $window.find(\".autocomplete-table .data-row\").addClass(\"hidden\");\r\n        var key = \"AutocompleteLabel_\" + $window.gcop().getAttribute(\"id\");\r\n        cpf.store.set(key, null);\r\n    },\r\n\r\n    hasValue: function ($window) {\r\n        // single from list\r\n        var selectedValue = $window.find(\".search\").attr(\"data-selected\");\r\n        var listType = $window.attr(\"data-list-type\");\r\n        var hasValue = false;\r\n\r\n        // if multiple list - check the rows have something\r\n        if (listType === \"multiple\") {\r\n            if ($window.find(\".none-selected\").is(':visible')) {\r\n                hasValue = false;\r\n            } else {\r\n                hasValue = true;\r\n            }\r\n        } else if (listType === \"single\") {\r\n            if (selectedValue !== undefined && selectedValue !== \"\") {\r\n                hasValue = true;\r\n            } else {\r\n                hasValue = false;\r\n            }\r\n        }\r\n\r\n        return hasValue;\r\n    },\r\n\r\n    bindAutocomplete: function ($window) {\r\n\r\n        if (!$window.hasClass(\"autocomplete-grid\")) {\r\n            $window = $window.find(\".autocomplete-grid\");\r\n        }\r\n\r\n        var allowEntries = isTrue($window.attr(\"data-allow-free-text\")),\r\n            singleMode = $window.attr(\"data-list-type\") === \"single\",\r\n            windowId = $window.attr(\"id\"),\r\n            searchVirtualFilePath = $window.attr(\"data-search-virtual-file-path\"),\r\n            parameters = $window.attr(\"data-parameters\"),\r\n            $autoCompleteLoader = $window.find(\".autoCompleteGrid-loader\");\r\n\r\n        var valueColumn = $window.attr(\"data-value-column\");\r\n        var labelColumn = $window.attr(\"data-label-column\");\r\n\r\n        $autoCompleteLoader.hide();\r\n\r\n        function split(val) {\r\n            return val.split(/,\\s*/);\r\n        }\r\n\r\n        function extractLast(term) {\r\n            return split(term).pop();\r\n        }\r\n\r\n        var cache = {};\r\n        if ($window != null) {\r\n            var $search = $window.find(\".search\");\r\n            $search.autocomplete({\r\n                minLength: this.searchMinLengh,\r\n                autoFocus: true,\r\n                delay: 200,\r\n                focus: function (event, ui) {\r\n                    return false;\r\n                },\r\n                appendTo: \"#\" + windowId + \"-results\",\r\n                response: function (event, ui) {\r\n                    if (allowEntries) {\r\n                        if (ui.content === undefined || ui.content.length === 0) {\r\n                            ui.content.push({\r\n                                label: $(this).val(),\r\n                                value: $(this).val(),\r\n                                id: 0\r\n                            });\r\n                        }\r\n                    } else {\r\n                        if (ui.content === undefined || ui.content.length === 0) {\r\n                            ui.content.push({\r\n                                label: \"No results found\",\r\n                                value: \"noresults\",\r\n                                id: 0\r\n                            });\r\n                        }\r\n                    }\r\n                },\r\n                source: function (request, response) {\r\n                    //show autocompletegrid spinner\r\n                    $autoCompleteLoader.show();\r\n\r\n                    var slicedResults = null;\r\n\r\n                    if (autocompleteGrid.cache[windowId + request.term] != undefined) {\r\n                        slicedResults = autocompleteGrid.cache[windowId + request.term].slice(0, 20);\r\n\r\n                        response($.map($.ui.autocomplete.filter(slicedResults, extractLast(request.term)), function (item) {\r\n                            return {\r\n                                label: item.label,\r\n                                value: item.value\r\n                            }\r\n                        }));\r\n\r\n                        $autoCompleteLoader.hide();\r\n                    } else {\r\n                        var success = function (result, status, xhr) {\r\n                            if (result.length > 0) {\r\n                                autocompleteGrid.cache[windowId + request.term] = result;\r\n\r\n                                slicedResults = result.slice(0, 20);\r\n\r\n                                response(\r\n                                    $.map(\r\n                                        $.ui.autocomplete.filter(slicedResults, extractLast(request.term)),\r\n                                        function (item) {\r\n                                            return {\r\n                                                label: item.label,\r\n                                                value: item.value\r\n                                            }\r\n                                        }\r\n                                    )\r\n                                );\r\n                            }\r\n                            else {\r\n                                autocompleteGrid.cache[windowId + request.term] = [];\r\n                                response([]);\r\n                            }\r\n\r\n                            $autoCompleteLoader.hide();\r\n\r\n                            return false;\r\n                        };\r\n\r\n                        var fail = function (result, status, xhr) {\r\n                            if (!result[\"message\"]) {\r\n                                $autoCompleteLoader.hide();\r\n                                cpf.alert(\"There was an error fetching the auto complete data\"); //. Error:+ status\r\n                            }\r\n                        };\r\n\r\n                        var data = {};\r\n                        data.searchVirtualFilePath = searchVirtualFilePath;\r\n                        data.parameterValues = null;\r\n                        data.filterTerm = request.term;\r\n                        data.valueFieldID = valueColumn;\r\n                        data.labelFieldID = labelColumn;\r\n\r\n                        try {\r\n                            data.parameterValues = parameters;\r\n                        } catch (e) {\r\n                        }\r\n\r\n                        cpf.ajax({ url: APPLICATIONPATH + \"cpf/controls/autocompletedata\", success: success, errorCallback: fail, data: data });\r\n                    }\r\n\r\n                    \r\n                },\r\n                select: function (event, ui) {\r\n\r\n                    if (ui.item.value == \"noresults\") {\r\n                        return false;\r\n                    }\r\n\r\n                    $(this).val(ui.item.label);\r\n                    $(this).attr(\"data-selected\", JSON.stringify(ui.item));\r\n\r\n                    if (!singleMode) {\r\n                        $(this).val(\"\");\r\n                        autocompleteGrid.add($window);\r\n                    }\r\n\r\n                    var args = {};\r\n                    args.data = ui.item;\r\n\r\n                    $window.trigger(\"selected\", [args]);\r\n\r\n                    return false;\r\n                }\r\n            });\r\n        }\r\n    },\r\n\r\n    getAutoChanges: function ($input) {\r\n        var changes = autocompleteGrid.getChanges($input);\r\n        if (changes !== undefined && changes !== null) {\r\n            changes.load = [];\r\n        }\r\n        return changes;\r\n    },\r\n\r\n    toggleZugoFeatures: function ($input) {\r\n        var search = SEARCHES[$input.find(\".search-results-outer\").gcop().getAttribute(\"id\")];\r\n        if (search != null) {\r\n            // reset sort button initialisation\r\n            search.sortButtonsInitialised = false;\r\n            search.sortButtonsOnLoad = true;\r\n            search.initialiseSortButtons();\r\n        }\r\n    },\r\n\r\n    toggleSortButtons: function (show) {\r\n\r\n        if (show) {\r\n            $(\"#sort-asc\").parent().show();\r\n            $(\"#sort-desc\").parent().show();\r\n        } else {\r\n            $(\"#sort-asc\").parent().hide();\r\n            $(\"#sort-desc\").parent().hide();\r\n        }\r\n    },\r\n\r\n    updateInputLabel: function ($control, $input) {\r\n        var $title = $control.find(\".search-title\");\r\n        var key = \"AutocompleteLabel_\" + $control.gcop().getAttribute(\"id\");\r\n        var titleStore = cpf.store.get(key, null);\r\n        if (titleStore != null) {\r\n            $title.text(titleStore);\r\n        }\r\n        else {\r\n            titleStore = $title.text().replace('PLACEHOLDER', $input.val());\r\n            cpf.store.set(key, titleStore);\r\n            $title.text(titleStore);\r\n        }\r\n    }\r\n};\r\n\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/compose-search.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\n/// <reference path=\"compose-search-values.js\" />\r\n;\r\nvar composeSearch = {\r\n    run: function (searchName, userObjectId) {\r\n        cpf.alert(\"Run has not been implemented\", \"e\");\r\n    },\r\n\r\n    $searchName: null,\r\n    $saveAs: null,\r\n    searchCacheName: \"Search_list\",\r\n    // this value record who raised the save, in case any actions are waiting for it to complete\r\n    saveSender: \"\",\r\n    isUnsavedSearch: false,\r\n\r\n    load: function () {\r\n\r\n        composeSearch.setupReferences();\r\n\r\n        composeSearch.bindEvents();\r\n\r\n        if (isNullOrEmpty(SEARCHREQUESTNAME) || SEARCHREQUESTNAME === \"unsavedsearch\" || (composeSearch.$searchName != undefined && (isNullOrEmpty(composeSearch.$searchName.val()) || composeSearch.$searchName.val() == \"unsavedsearch\"))) {\r\n            composeSearch.isUnsavedSearch = true;\r\n        }\r\n\r\n        composeSearch.setUpRibbon();\r\n\r\n        if (VIEW == \"details\") {\r\n            composeSearch.details.load();\r\n        } else if (VIEW == \"display\") {\r\n            composeSearch.display.load();\r\n        }\r\n\r\n        return false;\r\n    },\r\n\r\n    setupReferences: function () {\r\n        composeSearch.$searchName = $(\"#search-name\");\r\n    },\r\n\r\n    bindEvents: function () {\r\n        // side nav\r\n        $(\"#details-page\").on(\"click\", function () {\r\n            if (VIEW == \"details\") {\r\n                return false;\r\n            }\r\n\r\n            composeSearch.saveSender = \"details\";\r\n            //composeSearch[VIEW].save();\r\n            composeSearch[VIEW].silentSave();\r\n\r\n            return false;\r\n        });\r\n\r\n        $(\"#display-page\").on(\"click\", function () {\r\n            if (VIEW == \"display\") {\r\n                return false;\r\n            }\r\n\r\n            composeSearch.saveSender = \"display\";\r\n            composeSearch[VIEW].silentSave();\r\n\r\n            return false;\r\n        });\r\n\r\n        $(\"body\").on(\"saved\", function () {\r\n\r\n            var url = location.href;\r\n            var index = url.indexOf(\"?\");\r\n            if (index > -1) {\r\n                url = url.substring(0, index);\r\n            }\r\n\r\n            var index = url.indexOf(\"#\");\r\n            if (index > -1) {\r\n                url = url.substring(0, index);\r\n            }\r\n\r\n            // this feels a bit over complex\r\n            if (composeSearch.saveSender == \"details\") {\r\n                cpf.wait();\r\n                var nameLength = escape(SEARCHREQUESTNAME).length;\r\n                var ending = url.substring(url.length - nameLength);\r\n                if (ending == escape(SEARCHREQUESTNAME)) {\r\n                    location.href = url + \"?view=details\";\r\n                } else {\r\n                    location.href = url + \"?searchName=\" + ENCODEDSEARCHREQUESTNAME + \"&view=details\";\r\n                }\r\n            } else if (composeSearch.saveSender == \"display\") {\r\n                cpf.wait();\r\n                var nameLength = escape(SEARCHREQUESTNAME).length;\r\n                var ending = url.substring(url.length - nameLength);\r\n                if (ending == escape(SEARCHREQUESTNAME)) {\r\n                    location.href = url + \"?view=display\";\r\n                } else {\r\n                    location.href = url + \"?searchName=\" + ENCODEDSEARCHREQUESTNAME + \"&view=display\";\r\n                }\r\n            } else if (composeSearch.saveSender == \"run\") {\r\n                cpf.wait(true);\r\n                // we need to clear the existing search in session storage IF it is a different search.\r\n                // if this is an edit of a search that is already in the local storage cache, then we want to reset it.\r\n                //var existingData = cpf.store.get(USERID + \"_incident_list\");\r\n\r\n\r\n\r\n                //if (existingData != null && existingData.cacheName === SANITISEDSEARCHREQUESTNAME) {\r\n                //    existingData.pageIndex = 0;\r\n                //    cpf.store.set(USERID + \"_incident_list\", existingData);\r\n                //} else {\r\n                //    cpf.store.remove(USERID + \"_incident_list\");\r\n                //}\r\n\r\n                searchCache.remove(SANITISEDSEARCHREQUESTNAME);\r\n\r\n                composeSearch.run(SANITISEDSEARCHREQUESTNAME, USEROBJECTID); //$(\"#search-name\").val()\r\n\r\n\r\n            }\r\n        });\r\n\r\n        $(\"select.field-menu\").on(\"change\", function () {\r\n            var $option = $(this).find(\":selected\");\r\n            if ($option.gcop().getAttribute(\"disabled\") == \"disabled\") {\r\n                $(this).val(0);\r\n            }\r\n        });\r\n    },\r\n\r\n    ribbonContext: function () {\r\n        //        var allColumnChecks = $(\"input.column-check:checked\");\r\n        //        if (allColumnChecks.length > 0) {\r\n\r\n        //            composeSearch.$removeRowButton.gcop().removeClass(\"disabled\");\r\n\r\n        //            if (allColumnChecks.length == 1) {\r\n        //                // move up and down\r\n        //                composeSearch.$moveUpButton.gcop().removeClass(\"disabled\");\r\n        //                composeSearch.$moveDownButton.gcop().removeClass(\"disabled\");\r\n        //            } else {\r\n        //                composeSearch.$moveUpButton.gcop().addClass(\"disabled\");\r\n        //                composeSearch.$moveDownButton.gcop().addClass(\"disabled\");\r\n        //            }\r\n        //        } else {\r\n        //            composeSearch.$removeRowButton.gcop().addClass(\"disabled\");\r\n        //            composeSearch.$moveUpButton.gcop().addClass(\"disabled\");\r\n        //            composeSearch.$moveDownButton.gcop().addClass(\"disabled\");\r\n        //        }\r\n    },\r\n\r\n    // set up the context sensitive buttons on the ribbon\r\n    setUpRibbon: function () {\r\n\r\n        //        composeSearch.$removeRowButton = $(\"#remove\");\r\n        //        composeSearch.$moveUpButton = $(\"#move-up\");\r\n        //        composeSearch.$moveDownButton = $(\"#move-down\");\r\n\r\n        composeSearch.$saveAs = $(\"#save-as\");\r\n\r\n        if (composeSearch.isUnsavedSearch) {\r\n            composeSearch.$saveAs.addClass(\"disabled\");\r\n        }\r\n\r\n        // fire a run event on successful save if run is hit\r\n        $(\"#run\").on(\"click\", function () {\r\n            if (!$(this).gcop().hasClass(\"disabled\")) {\r\n                composeSearch.saveSender = \"run\";\r\n                composeSearch[VIEW].silentSave();\r\n            }\r\n            return false;\r\n        });\r\n\r\n        // save\r\n        $(\"#save\").on(\"click\", function () {\r\n            if (!$(this).gcop().hasClass(\"disabled\")) {\r\n                composeSearch.saveSender = VIEW;\r\n                composeSearch[VIEW].save(false);\r\n            }\r\n            return false;\r\n        });\r\n\r\n\r\n        // save\r\n        $(\"#save-display-run\").off(\"click\").on(\"click\", function () {\r\n            if (!$(this).gcop().hasClass(\"disabled\")) {\r\n                composeSearch.saveSender = VIEW;\r\n                composeSearch[VIEW].save(false);\r\n\r\n                // run existing search and then close display field light box\r\n                composeSearch.loadExistingSearch();\r\n                composeSearch.display.dialogShow(composeSearch.display.$composeDisplayLite, false);\r\n            }\r\n            return false;\r\n        });\r\n\r\n\r\n        $(\"#save-as\").on(\"click\", function () {\r\n            if (!$(this).gcop().hasClass(\"disabled\")) {\r\n                composeSearch.saveSender = VIEW;\r\n                composeSearch[VIEW].save(true);\r\n            }\r\n            return false;\r\n        });\r\n\r\n        // disable to option to add rows we already have\r\n        var $selectList = $(\"select.field-menu\");\r\n        var $columns = $(\"div.column-name\");\r\n        for (var i = 0, ii = $columns.length; i < ii; i++) {\r\n            var columnName = $columns.eq(i).gcop().getAttribute(\"data-column-id\");\r\n            $selectList.find(\"option[value='\" + columnName + \"']\").gcop().setAttribute(\"disabled\", \"disabled\");\r\n            $selectList.find(\"option[value='\" + columnName + \"']\").css(\"color\", \"gray\");\r\n        }\r\n\r\n        $selectList.val(\"0\");\r\n\r\n        if (VIEW == \"details\") {\r\n            $(\"#display-edit-group\").hide();\r\n            $(\".detail-edit-group\").show();\r\n        } else {\r\n            $(\"#detail-edit-group\").hide();\r\n            $(\".display-edit-group\").show();\r\n        }\r\n    },\r\n\r\n    uncheckAllColumns: function () {\r\n        $(\"input.column-check:checked\").gcop().setAttribute(\"checked\", false);\r\n        composeSearch.ribbonContext();\r\n    },\r\n\r\n    fail: function (failureMessage) {\r\n        cpf.alert(\"RESOURCE{{compose-search.js}:{FailedToSave}:{Failed to save: }}\" + failureMessage, \"w\");\r\n    },\r\n\r\n    loadExistingSearch: function () {\r\n\r\n        var settings = null;\r\n        var $searchItem = null;\r\n\r\n        //check if there is an existing searchName on the hash.\r\n        var existingSearchName = cpf.hash(\"searchName\");\r\n        if (existingSearchName !== null && existingSearchName !== undefined) {\r\n\r\n            //check store if we already have the hashed name in settings. Dont want to create the object again.\r\n            settings = searchCache.get(existingSearchName, null);\r\n\r\n            if (settings === null || settings.searchCacheName !== existingSearchName) {\r\n\r\n                $searchItem = $(\"#results\");\r\n                settings = composeSearch.populateSearchSettings($searchItem);\r\n            }\r\n            //else {\r\n            //    $searchItem = $(\"#results\");\r\n            //    settings = composeSearch.populateSearchSettings($searchItem);\r\n            //}\r\n        } else {\r\n            settings = searchCache.get(SEARCHNAME, null);\r\n            if (settings !== null) {\r\n                $searchItem = $(\"#results\");\r\n            }\r\n        }\r\n\r\n        // fresh. no search selected.\r\n        if (settings === null) {\r\n            // find the first search.\r\n            $searchItem = $(\"#results\");\r\n            if (!isNullOrEmpty($searchItem)) {\r\n                settings = composeSearch.populateSearchSettings($searchItem);\r\n            }\r\n        }\r\n\r\n        if (settings !== null) {\r\n            $searchItem = $(\"#results\");\r\n            SEARCHNAME = settings.searchName;\r\n            cpf.title.set(\"RESOURCE{{compose-search.js}:{SearchTitle}:{Search}}\" + \" > \" + $searchItem.attr(\"data-name\"));\r\n\r\n            //reset force run \r\n            settings.forceRun = false;\r\n\r\n            var deaggregate = Boolean(cpf.hash(\"deaggregate\"));\r\n            if (deaggregate !== undefined) {\r\n                settings.deaggregate = Boolean(deaggregate);\r\n                settings.deaggregateRowData = cpf.hash(\"deaggregateData\");\r\n            } else {\r\n                settings.deaggregate = false;\r\n                settings.deaggregateRowData = null;\r\n            }\r\n\r\n            composeSearch.runSearch(settings);\r\n        }\r\n    },\r\n\r\n    populateSearchSettings: function ($searchItem) {\r\n\r\n        if ($searchItem !== undefined && $searchItem.length > 0) {\r\n            // find seach with the same searchName.\r\n            //$searchItem.addClass(\"selected\");\r\n\r\n            var data = {};\r\n            data.resultPanel = \"#results\";\r\n            data.searchVirtualFilePath = $searchItem.attr(\"data-search-virtual-file-path\");\r\n            //data.containerName = $searchItem.attr(\"data-container\");\r\n            data.searchName = $searchItem.attr(\"data-encoded-name\");\r\n            data.searchNameEncoded = $searchItem.attr(\"data-javascript-encoded-name\");\r\n            data.cacheName = $searchItem.attr(\"data-cache-name\");\r\n            data.definitionName = $searchItem.attr(\"data-type\");           \r\n            data.searchCacheName = data.cacheName.toLowerCase();\r\n            data.showFullLoader = $searchItem.attr(\"data-show-full-loader\") === \"true\" ? true : false;\r\n            data.ssrPath = $searchItem.attr(\"data-ssr-path\");\r\n            //  data.searchBuilderDefID = cpf.hash(\"searchBuilderDefID\");\r\n            data.searchBuilderDefVirtualFilePath = $searchItem.attr(\"data-search-builder-virtual-file-path\");\r\n            data.pageIndex = 0;\r\n            data.sortColumn = '';\r\n            data.sortDirection = '';\r\n            data.filter = '';\r\n\r\n            return data;\r\n        }\r\n\r\n        return null;\r\n    },\r\n\r\n\r\n    generateCacheName: function (cacheName) {\r\n        //return USERID + \"_\" + SEARCHNAME + \"_\" + composeSearch.searchCacheName;\r\n        if (cacheName !== undefined) {\r\n            return USERID + \"_search_\" + cacheName;\r\n        }\r\n\r\n        return USERID + \"_search_\" + SEARCHNAME.toLowerCase();\r\n    },\r\n\r\n    runSearch: function (settings) {\r\n\r\n        cpf.hash(\"searchName\", settings.searchCacheName);\r\n        searchCache.set(settings.searchCacheName, settings);\r\n\r\n        if (!SEARCHES[\"ExplorerSearch\"]) {\r\n            SEARCHES[\"ExplorerSearch\"] = new searchContext(\"ExplorerSearch\", $(\"#results\"));\r\n        }\r\n\r\n        // search.run(settings);\r\n        SEARCHES[\"ExplorerSearch\"].run(settings);\r\n\r\n        return false;\r\n    }\r\n};\r\nvar INPUTSEARCHDATA = null;\r\ncomposeSearch.details = {\r\n\r\n    //$searchables: 0,\r\n    searchTimeout: 0,\r\n    composeTree: null,\r\n    $add: null,\r\n    $addAbove: null,\r\n    $remove: null,\r\n    $edit: null,\r\n    $searchName: null,\r\n    isUnsavedSearch: false,\r\n\r\n    goComposeObj: {},\r\n    goComposeSelectedInstance: null,\r\n\r\n    mandatoryVisible: true,\r\n\r\n    load: function () {\r\n\r\n        composeSearch.details.mandatoryVisible = $(\"#search-mandatory-container\").length > 0;\r\n\r\n        var filterData = null,\r\n            topicsData = null,\r\n            mandatoryData = null;\r\n\r\n        if (!isNullOrEmpty(JSONSEARCHDATA)) {\r\n\r\n            //mandatory\r\n            if (!isNullOrEmpty(JSONSEARCHDATA[\"data\"][\"mandatory\"]) && composeSearch.details.mandatoryVisible) {\r\n                mandatoryData = JSONSEARCHDATA[\"data\"][\"mandatory\"];\r\n            }\r\n\r\n            //topics\r\n            if (!isNullOrEmpty(JSONSEARCHDATA[\"data\"][\"topics\"])) {\r\n                topicsData = JSONSEARCHDATA[\"data\"][\"topics\"];\r\n            }\r\n\r\n            //filters\r\n            if (!isNullOrEmpty(JSONSEARCHDATA[\"data\"][\"conditions\"])) {\r\n                filterData = JSONSEARCHDATA[\"data\"][\"conditions\"];\r\n            }\r\n        }\r\n\r\n\r\n        if (composeSearch.details.mandatoryVisible) {\r\n            // mandatory\r\n            var mandatoryOptions = {\r\n                \"id\": \"mandatory\",\r\n                selectedCallback: composeSearch.details.itemSelected,\r\n                existingData: mandatoryData,\r\n                element: \"search-mandatory-container\",\r\n                parser: new conditionParser(),\r\n                //dataFormatter: new filterParser(), //function found in compose-search-parsers.js\r\n                //dataLoader: new filterParser(), //function found in compose-search-parsers.js\r\n                // startItem: { \"key\": -1, \"category\": \"start\", \"text\": \"RESOURCE{{compose-search.js}:{AddFilter}:{Add\\nMandatory}}\", \"fill\": \"#f0f0f0\" },\r\n                //showStartItem: false,\r\n                tileOptions: { \"fill\": \"#FFF7E8\", \"textColour\": \"#A0A0A0\", \"iconColour\": \"#FFBD26\", \"icon\": String.fromCharCode(\"0xf069\"), \"iconBackground\": \"#fff\" },\r\n                actions: [\"edit\"],\r\n                lightbox: {\r\n                    title: \"Mandatory Condition\",\r\n                    viewUrl: APPLICATIONPATH + 'cpf/search/ComposeSingle', searchBuilderDefVirtualFilePath: $SEARCHBUILDERDEFVIRTUALFILEPATH,\r\n                    defaultData: { \"searchBuilderDefVirtualFilePath\": SEARCHBUILDERDEFVIRTUALFILEPATH, \"container\": CONTAINER },\r\n                    loadedCallback: composeSearch.details.loaded\r\n                }\r\n            };\r\n\r\n            composeSearch.details.goComposeObj[mandatoryOptions.id] = new goCompose(mandatoryOptions);\r\n        }\r\n\r\n        //topics\r\n        var topicsOptions = {\r\n            id: \"topics\",\r\n            selectedCallback: composeSearch.details.itemSelected,\r\n            existingData: topicsData,\r\n            element: \"search-topics-container\",\r\n            parser: new topicParser(),\r\n            startItem: { \"key\": -1, \"category\": \"start\", \"loc\": \"175 0\", \"text\": \"RESOURCE{{compose-search.js}:{AddFilter}:{Add\\nTopic}}\", \"fill\": \"#f0f0f0\" },\r\n            tileOptions: { \"fill\": \"#FFF7E8\", \"textColour\": \"#A0A0A0\", \"iconColour\": \"#FFBD26\", \"icon\": String.fromCharCode(\"0xf0b0\"), \"iconBackground\": \"#fff\" },\r\n            lightbox: {\r\n                title: \"Topics\",\r\n                viewUrl: APPLICATIONPATH + 'cpf/search/topics?container=' + CONTAINER,\r\n                //defaultData: { \"searchBuilderDefinitionName\": SEARCHBUILDERDEFINITIONAME, \"searchBuilderDefinitionContainer\": SEARCHBUILDERDEFINITIONCONTAINER, \"container\": CONTAINER },\r\n                defaultData: { \"searchBuilderDefVirtualFilePath\": SEARCHBUILDERDEFVIRTUALFILEPATH, \"container\": CONTAINER },\r\n                loadedCallback: composeSearch.details.loaded\r\n            }\r\n        };\r\n\r\n        // filters\r\n        var filterOptions = {\r\n            \"id\": \"filters\",\r\n            selectedCallback: composeSearch.details.itemSelected,\r\n            existingData: filterData,\r\n            element: \"search-filters-container\",\r\n            parser: new conditionParser(),\r\n            startItem: { \"key\": -1, \"category\": \"start\", \"loc\": \"175 0\", \"text\": \"RESOURCE{{compose-search.js}:{AddFilter}:{Add\\nFilter}}\", \"fill\": \"#f0f0f0\" },\r\n            tileOptions: { \"fill\": \"#FFF7E8\", \"textColour\": \"#A0A0A0\", \"iconColour\": \"#FFBD26\", \"icon\": String.fromCharCode(\"0xf0b0\"), \"iconBackground\": \"#fff\" },\r\n            lightbox: {\r\n                title: \"Search Condition\",\r\n                viewUrl: APPLICATIONPATH + 'cpf/search/ComposeSingle',\r\n                //defaultData: { \"searchBuilderDefinitionName\": SEARCHBUILDERDEFINITIONAME, \"searchBuilderDefinitionContainer\": SEARCHBUILDERDEFINITIONCONTAINER, \"container\": CONTAINER },\r\n                defaultData: { \"searchBuilderDefVirtualFilePath\": SEARCHBUILDERDEFVIRTUALFILEPATH, \"container\": CONTAINER },\r\n                \r\n                loadedCallback: composeSearch.details.loaded\r\n            }\r\n        };\r\n\r\n        composeSearch.details.goComposeObj[topicsOptions.id] = new goCompose(topicsOptions);\r\n        composeSearch.details.goComposeObj[filterOptions.id] = new goCompose(filterOptions);\r\n\r\n        composeSearch.details.setupReferences();\r\n        composeSearch.details.bindEvents();\r\n\r\n        cpf.title.set(SEARCHREQUESTNAME);\r\n\r\n        return false;\r\n    },\r\n\r\n    bindEvents: function () {\r\n\r\n        composeSearch.details.$add.on(\"click\", function () {\r\n            if (!composeSearch.details.$add.gcop().hasClass(\"disabled\")) {\r\n                if (!isNullOrEmpty(composeSearch.details.goComposeSelectedInstance)) {\r\n                    composeSearch.details.goComposeObj[composeSearch.details.goComposeSelectedInstance].add();\r\n                }\r\n            }\r\n\r\n            return false;\r\n        });\r\n\r\n        composeSearch.details.$addAbove.on(\"click\", function () {\r\n            if (!composeSearch.details.$addAbove.gcop().hasClass(\"disabled\")) {\r\n\r\n                if (!isNullOrEmpty(composeSearch.details.goComposeSelectedInstance)) {\r\n                    composeSearch.details.goComposeObj[composeSearch.details.goComposeSelectedInstance].addAbove();\r\n                }\r\n            }\r\n\r\n            return false;\r\n        });\r\n\r\n        composeSearch.details.$remove.on(\"click\", function () {\r\n            if (!composeSearch.details.$remove.gcop().hasClass(\"disabled\")) {\r\n\r\n                if (!isNullOrEmpty(composeSearch.details.goComposeSelectedInstance)) {\r\n                    composeSearch.details.goComposeObj[composeSearch.details.goComposeSelectedInstance].remove();\r\n                }\r\n            }\r\n\r\n            return false;\r\n        });\r\n\r\n        composeSearch.details.$edit.on(\"click\", function () {\r\n            if (!composeSearch.details.$edit.gcop().hasClass(\"disabled\")) {\r\n\r\n                if (!isNullOrEmpty(composeSearch.details.goComposeSelectedInstance)) {\r\n                    composeSearch.details.goComposeObj[composeSearch.details.goComposeSelectedInstance].edit();\r\n                }\r\n            }\r\n\r\n            return false;\r\n        });\r\n    },\r\n\r\n    setupReferences: function () {\r\n        composeSearch.details.$add = $(\"#add-tile\"),\r\n        composeSearch.details.$addAbove = $(\"#add-above\"),\r\n        composeSearch.details.$remove = $(\"#remove-tile\"),\r\n        composeSearch.details.$edit = $(\"#edit-tile\");\r\n        composeSearch.details.$searchName = $(\"#search-name\");\r\n    },\r\n\r\n    // string goComposeInstanceId, \r\n    // bool isSelected, \r\n    // bool isEditable\r\n    itemSelected: function (goComposeInstanceId, isSelected, isEditable) {\r\n\r\n        if (isSelected) {\r\n\r\n            composeSearch.details.goComposeSelectedInstance = goComposeInstanceId;\r\n\r\n            var obj = composeSearch.details.goComposeObj[goComposeInstanceId];\r\n\r\n            if (isEditable) {\r\n                if (obj.canPerform(\"add\")) {\r\n                    composeSearch.details.$add.gcop().removeClass(\"disabled\");\r\n                    composeSearch.details.$addAbove.gcop().removeClass(\"disabled\");\r\n                }\r\n                else {\r\n                    composeSearch.details.$add.gcop().addClass(\"disabled\");\r\n                    composeSearch.details.$addAbove.gcop().addClass(\"disabled\");\r\n                }\r\n\r\n\r\n                if (obj.canPerform(\"remove\")) {\r\n                    composeSearch.details.$remove.gcop().removeClass(\"disabled\");\r\n                }\r\n                else {\r\n                    composeSearch.details.$remove.gcop().addClass(\"disabled\");\r\n                }\r\n\r\n                if (obj.canPerform(\"edit\")) {\r\n                    composeSearch.details.$edit.gcop().removeClass(\"disabled\");\r\n                }\r\n                else {\r\n                    composeSearch.details.$edit.gcop().addClass(\"disabled\");\r\n                }\r\n\r\n            } else {\r\n                composeSearch.details.$add.gcop().removeClass(\"disabled\");\r\n                composeSearch.details.$addAbove.gcop().addClass(\"disabled\");\r\n                composeSearch.details.$remove.gcop().addClass(\"disabled\");\r\n                composeSearch.details.$edit.gcop().addClass(\"disabled\");\r\n            }\r\n        }\r\n        else {\r\n            composeSearch.details.goComposeSelectedInstance = null;\r\n            $(\"#show-path\").gcop().addClass(\"disabled\");\r\n            composeSearch.details.$add.gcop().addClass(\"disabled\");\r\n            composeSearch.details.$addAbove.gcop().addClass(\"disabled\");\r\n            composeSearch.details.$remove.gcop().addClass(\"disabled\");\r\n            composeSearch.details.$edit.gcop().addClass(\"disabled\");\r\n        }\r\n\r\n        for (var i in composeSearch.details.goComposeObj) {\r\n            if (i !== goComposeInstanceId) {\r\n                composeSearch.details.goComposeObj[i].clickOff();\r\n            }\r\n        }\r\n\r\n        setTimeout(cpf.toolbar.initialiseDropDowns(), 5000);\r\n\r\n    },\r\n\r\n    lightboxLoaded: function () {\r\n        // first show all searchables without dependants\r\n\r\n        composeSearch.details.setUpConditions();\r\n        composeSearch.details.ribbonContext();\r\n\r\n        var searchables = $(\"div.searchable\");\r\n\r\n        for (var i = 0, li = searchables.length; i < li; i++) {\r\n\r\n            $(searchables[i]).show().find(\".window\").show();\r\n        }\r\n\r\n        // listen out for operator changes\r\n        $(\".searchable\").off(\"change\", \"select.condition-operator\").on(\"change\", \"select.condition-operator\", function () {\r\n            composeSearch.details.operatorChange($(this));\r\n        });\r\n\r\n        $(\".add-field\").on(\"click\", function () {\r\n            var $link = $(this);\r\n\r\n            var $selectList = $link.prev();\r\n            var columnName = $selectList.val();\r\n            if (!columnName || columnName == \"0\") {\r\n                return false;\r\n            }\r\n\r\n            // diable the button until we are done to avoid double clicks and adding a condition twice\r\n            $link.css(\"visibility\", \"hidden\");\r\n\r\n            var $selectedOption = $selectList.find(\"option:selected\");\r\n            var searchableID = $selectedOption.gcop().getAttribute(\"data-group-id\");\r\n            var searchableContainer = $selectedOption.gcop().getAttribute(\"data-container\");\r\n            var searchableName = $selectedOption.gcop().getAttribute(\"data-name\");\r\n\r\n            // build the request. CONTAINER and NAME are for the searchable\r\n            var data = {\r\n                container: searchableContainer,\r\n                name: searchableName,\r\n                searchableID: searchableID,\r\n                columnName: columnName,\r\n                columnId: columnName,\r\n                enableParameterized: typeof ENABLEPARAMETERIZED == 'undefined' ? true : ENABLEPARAMETERIZED\r\n            };\r\n\r\n            cpf.spin();\r\n\r\n            var arguments = { url: APPLICATIONPATH + \"conditions/default/condition\", dataType: \"html\", type: \"POST\", data: data, success: composeSearch.details.addConditionSuccess, errorCallback: composeSearch.details.addConditionError };\r\n            cpf.ajax(arguments);\r\n\r\n            return false;\r\n        });\r\n\r\n        // remove rows click\r\n        $(\"#remove-field\").on(\"click\", function () {\r\n            if ($(this).gcop().hasClass(\"disabled\")) {\r\n                return;\r\n            }\r\n\r\n            // get a list of checked rows\r\n            var allColumnChecks = $(\"input.column-check:checked\");\r\n\r\n            var mandatoryFieldsInRemoving = [];\r\n            // remove each tr\r\n            for (var i = 0, ii = allColumnChecks.length; i < ii; i++) {\r\n                var $row = allColumnChecks.eq(i).closest(\"tr.compose-search-row\");\r\n                // if view is DISPLAY and field is mandatory skip it with warning message\r\n                var isMandatoryField = $row.gcop().getAttribute(\"data-mandatory\") == \"true\" && VIEW == \"display\";\r\n                if (isMandatoryField) {\r\n                    mandatoryFieldsInRemoving.push($row.find(\"td input.user-display-name\").val());\r\n                    continue;\r\n                }\r\n\r\n                var $row = allColumnChecks.eq(i).closest(\"tr.compose-search-row\");\r\n                $row.remove();\r\n                var columnName = $row.find(\"div.column-name\").gcop().getAttribute(\"data-column-id\");\r\n                var $selectList = $(\"select.field-menu\");\r\n                $selectList.find(\"option[value='\" + columnName + \"']\").gcop().removeAttribute(\"disabled\");\r\n                $selectList.find(\"option[value='\" + columnName + \"']\").css(\"color\", \"\");\r\n\r\n                //composeSearch.details.hideDependentSearchables(columnName);\r\n            }\r\n\r\n            if (mandatoryFieldsInRemoving.length > 0) {\r\n                cpf.alert(\"RESOURCE{{compose-search.js}:{MandatoryFieldRemove}:{ \" + mandatoryFieldsInRemoving.join(\", \") + \" column(s) have not been removed as they are mandatory. }}\", \"w\");\r\n            }\r\n\r\n            // set the buttons back to disabled\r\n            $(this).gcop().addClass(\"disabled\");\r\n\r\n            // enable the drop down and show the add button again.\r\n            // enable the add button now we are done\r\n            $(\"a.add-field\").css(\"visibility\", \"visible\");\r\n            $(\".field-menu\").gcop().removeAttribute(\"disabled\");\r\n\r\n            if (VIEW == \"display\") {\r\n                composeSearch.display.refreshMappings();\r\n            }\r\n        });\r\n\r\n        composeSearch.details.initiateControls($(\"#cpf-lightbox-content\").find(\"td.condition-value div\").eq(0));\r\n    },\r\n\r\n    operatorChange: function ($operator) {\r\n\r\n        var ajax = new operatorAjax($operator);\r\n        ajax.fire();\r\n        return false;\r\n    },\r\n\r\n    addConditionSuccess: function (html, textStatus, jqXHR) {\r\n\r\n        // make an element out of the html and find out it's groupID\r\n        var $condition = $(html);\r\n        // var searchableID = $condition.gcop().getAttribute(\"data-group-id\");\r\n\r\n        // find the visible window\r\n        var $window = $(\"#compose-window\");\r\n        // Added in case there are unescaped characters within the ID\r\n        // var $window = $(\"#\" + composeSearch.details.escapeJQueryString(searchableID));\r\n\r\n        // find the conditions table with this group ID\r\n        var $conditonsTable = $(\"#condition-table\");\r\n\r\n        // add it at the end\r\n        $conditonsTable.append($condition);\r\n\r\n        var $valueArea = $condition.find(\"td.condition-value\");\r\n        var $control = $valueArea.find(\"div\").eq(0);\r\n\r\n\r\n        // initiate the dyno control\r\n        composeSearch.details.initiateControls($control);\r\n\r\n        var $p = $condition.find(\"td.parameterised input[type=checkbox]\");\r\n        $p.off(\"change\").on(\"change\", function () {\r\n            //            $(this).parents(\"td\").prev().find(\".validation-wrapper\").toggle();\r\n            $(this).parents(\"td\").next().find(\"input\").toggle();\r\n        });\r\n\r\n        // disable this field in the picker so they don't add it twice\r\n        var columnName = $condition.find(\"div.column-name\").gcop().getAttribute(\"data-column-id\");\r\n        var $selectList = $conditonsTable.find(\".field-menu\");\r\n        $selectList.find(\"option[value='\" + columnName + \"']\").gcop().setAttribute(\"disabled\", \"disabled\");\r\n        $selectList.find(\"option[value='\" + columnName + \"']\").css(\"color\", \"gray\");\r\n        //$selectList.val(\"0\");\r\n\r\n        // composeSearch.details.checkForDependentSearchables(columnName, $condition);\r\n\r\n        // show the title row\r\n        $conditonsTable.find(\".title-row\").gcop().visible();\r\n\r\n        cpf.spin(false);\r\n\r\n        // enable the add button now we are done\r\n        $conditonsTable.find(\"a.add-field\").css(\"visibility\", \"hidden\");\r\n\r\n        dynoform.bindHelpEvents();\r\n\r\n        // disable the field drop down as we can only add one condition\r\n\r\n        $conditonsTable.find(\".field-menu\").gcop().setAttribute(\"disabled\", \"disabled\");\r\n    },\r\n\r\n    initiateControls: function ($controls) {\r\n        var controls = $controls.find(\".condition-control-item\");\r\n        for (var i = 0, li = controls.length; i < li; i++) {\r\n            typeName = $(controls[i]).attr(\"data-control-type\");\r\n            type = controlTypes[typeName];\r\n            type.load($(controls[i]));\r\n        }\r\n\r\n        if ($controls.hasClass(\"panel-control\")) {\r\n            composeSearch.details.setUpConditionEvents($controls);\r\n        }\r\n    },\r\n\r\n    escapeJQueryString: function (str) {\r\n        if (str)\r\n            return str.replace(/([ #;?%&,.+*~\\':\"!^$[\\]()=>|\\/@])/g, '\\\\$1');\r\n\r\n        return str;\r\n    },\r\n\r\n    addNewError: function (xmlhttp, message, exception) {\r\n        cpf.spin(false);\r\n\r\n        // enable the add button now we are done\r\n        //$window.find(\"a.add-field\").css(\"visibility\", \"visible\");\r\n        $(\"div.window:visible\").find(\"a.add-field\").css(\"visibility\", \"visible\");\r\n    },\r\n\r\n    setUpConditions: function () {\r\n\r\n        // add an event to each check box for the ribbon context\r\n        $(\".searchable \").off(\"click\", \"input.column-check\").on(\"click\", \"input.column-check\", function () {\r\n            composeSearch.details.ribbonContext();\r\n        });\r\n\r\n        //// loop each dyno-control and load it.\r\n        //var typeName = null, type = null;\r\n\r\n        //var dynoControl = $(\"table.conditions .condition-value\").find(\".dyno-control\");\r\n        //for (var i = 0, li = dynoControl.length; i < li; i++) {\r\n        //    typeName = $(dynoControl[i]).attr(\"data-dyno-type\");\r\n        //    type = dynoform.getType(typeName);\r\n        //    type.load($(dynoControl[i]));\r\n        //}\r\n\r\n        //// PA20130311 T:#3523  \r\n        //var timeSpanControl = $(\"div.date-time-span\");\r\n        //for (var i = 0, li = timeSpanControl.length; i < li; i++) {\r\n        //    $(timeSpanControl[i]).parent().parent().find(\".condition-operator\").closest(\"td\").gcop().addClass(\"condition-operator-valign\");\r\n        //    dateTimeSpan.load($(timeSpanControl[i]));\r\n        //}\r\n    },\r\n\r\n    setUpConditionEvents: function ($control) {\r\n\r\n        $(\"a.close-panel\", $control).on(\"click\", function (event) {\r\n\r\n            var $panel = $(this).closest(\".panel\"),\r\n                $searchBox = $panel.find(\".panel-search-control .cpftxt\");\r\n\r\n            // Reset options display clear input box and re-populate the control\r\n            $searchBox.val(\"\");\r\n            composeSearch.details.filterOptionResults($control);\r\n\r\n            // enable watermark\r\n            $searchBox.val(\"Search...\").addClass('inputblank');\r\n\r\n            event.stopPropagation();\r\n\r\n            $panel.hide();\r\n\r\n            // if there is a custom display type for this control call the hide method on the type.\r\n            // mainly for autocomplete grid.\r\n            var displayType = $control.parent().gcop().getAttribute(\"data-display-type\");\r\n            if (displayType !== null && displayType !== undefined) {\r\n                var type = new displayTypes[displayType]($control);\r\n                type.hide();\r\n            }\r\n\r\n            var $tableRow = $panel.closest(\"tr\");\r\n            var columnName = $tableRow.find(\"div.column-name\").gcop().getAttribute(\"data-column-name\");\r\n            var columnId = $tableRow.find(\"div.column-name\").gcop().getAttribute(\"data-column-id\");\r\n            var $valueDiv = $panel.closest(\"td\").find(\"div\").eq(0);\r\n            var conditionValueType = $valueDiv.gcop().getAttribute(\"data-type\");\r\n            if (conditionValueType != \"readonly\") {\r\n                var type = new conditionControl($valueDiv, columnId);\r\n\r\n                $valueDiv.find(\"a.condition-edit\").text(type.previewText());\r\n            }\r\n\r\n            return false;\r\n        });\r\n\r\n        $(\"a.condition-edit\", $control).on(\"click\", function () {\r\n\r\n            $(\"div.searchable div.panel-view\").hide();\r\n\r\n            var $panel = $(this).nextAll(\".panel\").eq(0);\r\n\r\n            var $td = $(this).parents(\"td\");\r\n            var $tr = $(this).parents(\"tr\");\r\n            var offset = $tr.offset();\r\n            offset.top = offset.top - 1;\r\n            offset.left = (offset.left - $panel.show().outerWidth()) + $tr.outerWidth() + 1;\r\n\r\n            $panel.show();\r\n            $panel.offset(offset);\r\n            var $inner = $(\"div.panel-heading-inner\", $panel);\r\n            $inner.css(\"width\", $td.width() - 40);\r\n\r\n            var off = $td.offset();\r\n            off.top = off.top + 5;\r\n            off.left = off.left + 34;\r\n            $inner.offset(off);\r\n\r\n            // if there is a custom display type for this control call the hide method on the type.\r\n            // mainly for autocomplete grid.\r\n            var displayType = $control.parent().gcop().getAttribute(\"data-display-type\");\r\n            if (displayType !== null && displayType !== undefined) {\r\n                var type = new displayTypes[displayType]($control);\r\n                type.show();\r\n            }\r\n\r\n            // update options class height such for consistency\r\n            var optionHeight = 0;\r\n            var newHeight = 0;\r\n            var optionFlag = $panel.find(\".panel-content\").gcop().getAttribute(\"option-update-flag\");\r\n\r\n            var options = $panel.find(\".option\");\r\n            var optionCount = options.length;\r\n\r\n            if (optionFlag == \"true\") {\r\n\r\n                for (var i = 0; i < optionCount; i++) {\r\n                    newHeight = $(options[i]).height();\r\n                    if (newHeight > optionHeight) {\r\n                        optionHeight = newHeight;\r\n                    }\r\n                }\r\n\r\n                $panel.find(\".option\").height(optionHeight);\r\n                $panel.find(\".panel-content\").gcop().setAttribute(\"option-update-flag\", \"false\");\r\n            }\r\n\r\n            return false;\r\n        });\r\n\r\n        $(\".panel-search-control\", $control).on(\"keyup\", function (e) {\r\n\r\n            if (composeSearch.details.searchTimeout != undefined) {\r\n                clearTimeout(composeSearch.details.searchTimeout);\r\n                composeSearch.details.searchTimeout = setTimeout(function () { composeSearch.details.filterOptionResults($control) }, 100);\r\n            }\r\n        });\r\n\r\n        $(\".panel-search-control\", $control).find(\"input\").on(\"blur\", function (e) {\r\n\r\n            if ($(this).val() == '') {\r\n                $(this)\r\n                    .addClass('inputblank')\r\n                    .val('Search...');\r\n            }\r\n        });\r\n\r\n        $(\".panel-search-control\", $control).find(\"input\").on(\"focus\", function (e) {\r\n\r\n            if ($(this).val() == 'Search...') {\r\n                $(this)\r\n                    .removeClass('inputblank')\r\n                    .val('');\r\n            }\r\n        });\r\n\r\n        //bind close events\r\n        $(\"#compose-display-lite-close\").off(\"click\").on(\"click\", function () {\r\n            composeSearch.display.dialogShow(composeSearch.display.$composeDisplayLite, false);\r\n        });\r\n    },\r\n\r\n    ribbonContext: function () {\r\n        var allColumnChecks = $(\"input.column-check:checked\");\r\n        if (allColumnChecks.length > 0) {\r\n            $(\"#remove-field\").gcop().removeClass(\"disabled\");\r\n        } else {\r\n            $(\"#remove-field\").gcop().addClass(\"disabled\");\r\n        }\r\n    },\r\n\r\n    filterOptionResults: function ($control) {\r\n\r\n        var searchPanelName = $control.find(\".cpftxt\").gcop().getAttribute(\"id\");\r\n        var value = $('input[id=' + searchPanelName + ']').val();\r\n        var options = $control.find(\".options\").find(\"label\");\r\n\r\n        for (var j = 0, lj = options.length; j < lj; j++) {\r\n\r\n            //var option = $(options[j]).find(\"input\").gcop().getAttribute(\"data-column-id-name\");\r\n            var option = $.trim($(options[j]).text());\r\n            if (option.toLowerCase().indexOf(value.toLowerCase()) != -1) {\r\n                $(options[j]).gcop().show();\r\n            }\r\n            else {\r\n                $(options[j]).gcop().hide();\r\n            }\r\n        }\r\n\r\n        return false;\r\n    },\r\n\r\n    setUpNewRowLinks: function () {\r\n\r\n        $(\".add-field\").on(\"click\", function () {\r\n            var $link = $(this);\r\n\r\n            var $selectList = $link.prev();\r\n            var columnName = $selectList.val();\r\n            if (!columnName || columnName == \"0\") {\r\n                return false;\r\n            }\r\n\r\n            // diable the button until we are done to avoid double clicks and adding a condition twice\r\n            $link.css(\"visibility\", \"hidden\");\r\n\r\n            var searchableID = $selectList.gcop().getAttribute(\"data-group-id\");\r\n            //var searchableContainer = $selectList.gcop().getAttribute(\"data-container\");\r\n            var searchableName = $selectList.gcop().getAttribute(\"data-name\");\r\n\r\n            // build the request. CONTAINER and NAME are for the searchable\r\n            var data = {\r\n                //container: searchableContainer,\r\n                name: searchableName,\r\n                searchableID: searchableID,\r\n                columnName: columnName,\r\n                columnId: columnName,\r\n                enableParameterized: typeof ENABLEPARAMETERIZED == 'undefined' ? true : ENABLEPARAMETERIZED\r\n            };\r\n\r\n            cpf.spin();\r\n\r\n            var arguments = { url: APPLICATIONPATH + \"conditions/default/condition\", dataType: \"html\", type: \"POST\", data: data, success: composeSearch.details.addNewSuccess, errorCallback: composeSearch.details.addNewError };\r\n            cpf.ajax(arguments);\r\n\r\n            return false;\r\n        });\r\n    },\r\n\r\n    topicsLightboxSave: function () {\r\n\r\n        // simple data selection for now.\r\n        var $inclusion = $(\"#topic-inclusion\"),\r\n            $inclusionSelected = $(\"#topic-inclusion option:selected\"),\r\n            $topic = $(\"#topic-name\"),\r\n            $topicSelected = $(\"#topic-name option:selected\");\r\n        data = {};\r\n\r\n\r\n        // TODO : ADD VALIDATION\r\n\r\n        data.name = $topic.val();\r\n        //data.container = $topicSelected.gcop().getAttribute(\"data-container\");\r\n        data.type = $topicSelected.gcop().getAttribute(\"data-type\");\r\n        data.inclusionType = $inclusion.val();\r\n        data.displayName = $inclusionSelected.text() + \" \" + $topicSelected.text();\r\n        return data;\r\n    },\r\n\r\n    lightboxSave: function () {\r\n\r\n        var sections = $(\"div.searchable\"),\r\n            groupValid = true,\r\n            $conditionRow = $(\"#search-lightbox-content\").find(\"tr.compose-search-row\"),\r\n            sectionData = {},\r\n            hasConditions = false,\r\n            $sectionGroup = sections.find(\"div.window\"),\r\n            conditionResult = [];\r\n\r\n        validation.reset(sections);\r\n\r\n        sectionData.searchableId = $conditionRow.gcop().getAttribute(\"data-searchable-id\");\r\n        sectionData.searchableName = $conditionRow.gcop().getAttribute(\"data-searchable-name\");\r\n        //sectionData.searchBuilderDefinitionName = SEARCHBUILDERDEFINITIONAME;\r\n        //sectionData.searchBuilderDefinitionContainer = SEARCHBUILDERDEFINITIONCONTAINER;\r\n        sectionData.container = CONTAINER;\r\n        sectionData.condition = null;\r\n\r\n\r\n        groupValid = composeSearch.details.validateGroup($conditionRow, conditionResult);\r\n\r\n        if (groupValid) {\r\n            sectionData.condition = conditionResult[0].condition;\r\n\r\n            sectionData.displayName = conditionResult[0].displayName;\r\n\r\n            return sectionData;\r\n        }\r\n\r\n        return null;\r\n    },\r\n\r\n    getFriendlyName: function (conditionResult) {\r\n\r\n        var parts = [];\r\n        parts.push(conditionResult.columnName);\r\n        parts.push(conditionResult.operator);\r\n\r\n        //for (var i = 0; i < conditionResult.value.length; i++) {\r\n        parts.push(conditionResult.value);\r\n        //}\r\n\r\n        // var returnString = conditionResult.columnName + \" \" + conditionResult.operator + \" \" + conditionResult.value;\r\n\r\n        return parts.join(\" \");\r\n    },\r\n\r\n    validateGroup: function ($conditionRow, conditionResult) {\r\n\r\n        if ($conditionRow.length == 0) {\r\n            return false;\r\n        }\r\n\r\n        var valid = true;\r\n        //$conditionRow = $group.find(\"tr.compose-searh-row\");\r\n\r\n        var conditionValid = composeSearch.details.validateCondition($conditionRow, conditionResult);\r\n        if (!conditionValid) {\r\n            valid = false;\r\n        }\r\n\r\n        return valid;\r\n    },\r\n\r\n    validateCondition: function ($conditionRow, conditionResult) {\r\n        var valid = true;\r\n\r\n        var columnType = $conditionRow.gcop().getAttribute(\"data-column-type\");\r\n        var columnName = $conditionRow.find(\"div.column-name\").gcop().getAttribute(\"data-column-name\");\r\n        var columnDisplayName = $conditionRow.find(\"div.column-name\").gcop().getAttribute(\"data-column-label\");\r\n        var columnId = $conditionRow.find(\"div.column-name\").gcop().getAttribute(\"data-column-id\");\r\n        var inputID = columnId + \"-input\";\r\n\r\n        var $valueTr = $conditionRow.find(\"td.condition-value\");\r\n        var $valueDiv = $valueTr.find(\"div\").eq(0);\r\n\r\n        var conditionValueType = $valueDiv.gcop().getAttribute(\"data-type\");\r\n\r\n        var readOnly = $valueDiv.gcop().getAttribute(\"data-readonly\");\r\n\r\n        var type = new conditionControl($valueDiv, columnId);\r\n\r\n        if (readOnly !== undefined) {\r\n            conditionValueType = \"readonly\";\r\n        }\r\n\r\n        var $pTd = $conditionRow.find(\"td.parameterised\");\r\n        var parameterised = $pTd.find(\"input[type=checkbox]:checked\").length > 0;\r\n\r\n        var $requiredTd = $conditionRow.find(\"td.parameterised-required\");\r\n        var parameterisedRequired = $requiredTd.find(\"input[type=checkbox]:checked\").length > 0;\r\n\r\n        valid = type.validate(parameterised);\r\n\r\n        var $operator = $conditionRow.find(\".condition-operator\");\r\n        var operatorValue = conditionValueType == \"readonly\" || conditionValueType == \"allowselection\" ? $.trim($operator.find(\"option:selected\").text()) : $operator.val();\r\n        if ($operator.gcop().hasClass(\"default-operator\")) {\r\n            operatorValue = \"Equals\";\r\n        }\r\n\r\n        // add condition to conditionsArray\r\n        var condition = {\r\n            readonly: isNullOrEmpty(conditionValueType) ? false : true,\r\n            columnType: conditionValueType == \"readonly\" || conditionValueType == \"allowselection\" ? \"readonly\" : columnType,\r\n            dataType: conditionValueType,\r\n            id: columnId,\r\n            columnName: columnName,\r\n            operator: operatorValue,\r\n            operatorResolver: $operator.gcop().getAttribute(\"data-operator-resolver\"),\r\n            value: type.val(),\r\n            valueResolver: $conditionRow.gcop().getAttribute(\"data-value-resolver\"),\r\n            depth: $conditionRow.gcop().getAttribute(\"data-depth\"),\r\n            path: $conditionRow.gcop().getAttribute(\"data-path\"),\r\n            ns: $conditionRow.gcop().getAttribute(\"data-ns\"),\r\n            definitions: $conditionRow.gcop().getAttribute(\"data-definitions\"),\r\n            parameterised: parameterised,\r\n            parameterisedRequired: parameterisedRequired\r\n        };\r\n\r\n        conditionResult.push({ condition: condition, displayName: columnDisplayName + \" \" + $.trim($operator.find(\"option:selected\").text()) + \" \" + type.previewText(operatorValue, parameterised) });\r\n\r\n        // TODO : custom validation here\r\n        //}\r\n\r\n        return valid;\r\n    },\r\n\r\n    silentSave: function () {\r\n        composeSearch.details.save(null, true);\r\n    },\r\n\r\n    save: function (saveAs, silent) {\r\n\r\n        // clear any existing validation.\r\n        cpf.closeAlert();\r\n        dynoValidation.reset();\r\n\r\n        var save = function (parentFolderId, fileName, originUrl) {\r\n\r\n            composeSearch.details.data.searchName = fileName;\r\n            composeSearch.details.data.originUrl = originUrl;\r\n\r\n            if (!isNullOrEmpty(parentFolderId)) {\r\n                composeSearch.details.data.parentFolderId = parentFolderId;\r\n            }\r\n\r\n            composeSearch.details.data.isInitialSave = isNullOrEmpty(parentFolderId) ? false : true;\r\n\r\n            // no confirm function implemented or if it is edit without search name change\r\n            if (composeSearch.isUnsavedSearch) {\r\n                composeSearch.details.saveInternal();\r\n            }\r\n            else if (composeSearch.details.confirmOverwrite == null || composeSearch.details.$searchName.attr(\"data-initial-value\") == $.trim(fileName)) {\r\n                composeSearch.details.saveInternal();\r\n            } else if (composeSearch.details.searchNameExists(fileName) == false) {\r\n                //search name does not exists\r\n                composeSearch.details.saveInternal();\r\n            } else {\r\n                // search name exists and there is confirm overrite method is implemented\r\n                composeSearch.details.confirmOverwrite(fileName);\r\n            }\r\n        };\r\n\r\n\r\n        if (!composeSearch.details.initializeSaveData()) {\r\n            return false;\r\n        }\r\n\r\n        if (composeSearch.details.isSaveDataValid) {\r\n\r\n            if ((isNullOrEmpty($(\"#search-name\").val()) || saveAs || composeSearch.isUnsavedSearch) && !silent) {\r\n                var callback = function (parentFolderId, fileName, originUrl) {\r\n                    var split = \"/\" + path.slice(1).split(\"/\").slice(1).join(\"/\");\r\n                    composeSearch.isUnsavedSearch = false;\r\n                    save(split, fileName, originUrl);\r\n                };\r\n                files.show({\r\n                    mode: \"save\",\r\n                    title: \"Save Search\",\r\n                    extensions: [\"search\"],\r\n                    callback: callback\r\n                });\r\n\r\n            } else {\r\n                var fileName = isNullOrEmpty(composeSearch.details.$searchName.val()) ? \"unsavedsearch\" : composeSearch.details.$searchName.val();\r\n                save(null, fileName, null);\r\n            }\r\n\r\n        } else {\r\n            cpf.alert(\"RESOURCE{{compose-search.js}:{FieldsWithErrors}:{One or more fields on the form need changing. Please check the highlighted fields.}}\", \"w\");\r\n        }\r\n    },\r\n\r\n    confirmOverwrite: null,\r\n\r\n    searchNameExists: function (searchName) {\r\n        cpf.wait();\r\n        cpf.spin();\r\n        var hasExisted = true;\r\n        var data = { searchName: searchName, container: CONTAINER };\r\n        var success = function (result) {\r\n            hasExisted = result.data;\r\n        };\r\n        var fail = function (result) { };\r\n        var arguments = { url: APPLICATIONPATH + \"cpf/search/SearchExists\", dataType: \"json\", async: false, type: \"POST\", data: data, success: success, errorCallback: fail };\r\n        cpf.ajax(arguments);\r\n\r\n        return hasExisted;\r\n    },\r\n\r\n    initializeSaveData: function () {\r\n\r\n        composeSearch.details.isSaveDataValid = true;\r\n        composeSearch.details.data = {};\r\n        composeSearch.details.data.searchName = $(\"#search-name\").val();\r\n\r\n        composeSearch.details.data.mandatory = composeSearch.details.goComposeObj.hasOwnProperty(\"mandatory\") ? composeSearch.details.goComposeObj[\"mandatory\"].val() : null;\r\n        // mandatory conditons cannot have a group as the root. It has to be a list of conditions. Let's unwrap it.\r\n        if (composeSearch.details.data.mandatory && composeSearch.details.data.mandatory.length > 0) {\r\n            composeSearch.details.data.mandatory = composeSearch.details.data.mandatory[0].conditions;\r\n        }\r\n\r\n        composeSearch.details.data.conditions = composeSearch.details.goComposeObj[\"filters\"].val();\r\n        composeSearch.details.data.topics = composeSearch.details.goComposeObj[\"topics\"].val();\r\n\r\n\r\n        if ((composeSearch.details.data.mandatory == null && composeSearch.details.mandatoryVisible) || composeSearch.details.data.conditions == null || composeSearch.details.data.topics == null) {\r\n            cpf.alert(\"RESOURCE{{compose-search.js}:{FieldsWithErrors}:{One or more fields on the form need changing. Please check the highlighted fields.}}\", \"w\");\r\n            return false;\r\n        }\r\n\r\n        return true;\r\n\r\n        //        // add an array of groups. A group is a list of conditions\r\n        //        composeSearch.details.data.sections = new Array();\r\n        //        var sections = $(\"div.searchable\");\r\n\r\n        //        var sectionsWithConditions = 0;\r\n\r\n        //        for (var i = 0, ii = sections.length; i < ii; i++) {\r\n\r\n        //            var sectionData = {};\r\n        //            sectionData.searchableId = sections.eq(i).gcop().getAttribute(\"data-searchable-id\");\r\n        //            sectionData.searchableName = sections.eq(i).gcop().getAttribute(\"data-searchable-name\");\r\n        //            sectionData.groups = new Array();\r\n        //            composeSearch.details.data.sections.push(sectionData);\r\n        //            var hasConditions = false;\r\n\r\n        //            var sectionGroups = sections.eq(i).find(\"div.window\");\r\n        //            for (var j = 0, jj = sectionGroups.length; j < jj; j++) {\r\n        //                var $group = sectionGroups.eq(j);\r\n\r\n        //                var groupData = {};\r\n        //                //groupData.logical = i < 2 ? \"and\" : \"or\";\r\n        //                groupData.conditions = new Array();\r\n        //                sectionData.groups.push(groupData);\r\n\r\n        //                var groupValid = composeSearch.details.validateGroup($group, groupData.conditions);\r\n\r\n        //                // if this is the first or second section with conditions, it's OR, otherwise it's AND\r\n        //                groupData.logical = sectionsWithConditions < 2 ? \"and\" : \"or\";\r\n\r\n        //                if (groupData.conditions.length > 0) {\r\n        //                    sectionsWithConditions++;\r\n        //                }\r\n\r\n        //                if (!hasConditions) {\r\n        //                    hasConditions = groupData.conditions.length > 0;\r\n        //                }\r\n\r\n        //                if (!groupValid) {\r\n        //                    composeSearch.details.isSaveDataValid = false;\r\n        //                }\r\n        //            }\r\n        //        }\r\n\r\n    },\r\n\r\n    isSaveDataValid: true,\r\n\r\n    data: {},\r\n\r\n    saveInternal: function () {\r\n        cpf.spin();\r\n        $(\"#save\").gcop().addClass(\"disabled\");\r\n\r\n        if (!composeSearch.isUnsavedSearch) {\r\n            cpf.alert(\"RESOURCE{{dynoform.js}:{Saving}:{Saving}}...\", \"i\");\r\n        }\r\n\r\n        files.hide();\r\n\r\n        var savedata = {\r\n            userObjectID: USEROBJECTID,\r\n            container: CONTAINER,\r\n            ////searchBuilderDefinitionName: SEARCHBUILDERDEFINITIONAME,\r\n            ////searchBuilderDefinitionContainer: SEARCHBUILDERDEFINITIONCONTAINER,\r\n            searchBuilderDefVirtualFilePath: SEARCHBUILDERDEFVIRTUALFILEPATH,\r\n            //searchName: $(\"#search-name\").val(),\r\n            searchName: composeSearch.details.data.searchName,\r\n            parentFolderId: composeSearch.details.data.parentFolderId,\r\n            isInitialSave: composeSearch.details.data.isInitialSave,\r\n            originUrl: composeSearch.details.data.originUrl,\r\n            data: {},\r\n            section: \"details\"\r\n        };\r\n\r\n        savedata.data.conditions = composeSearch.details.data.conditions;\r\n        savedata.data.topics = composeSearch.details.data.topics;\r\n        savedata.data.mandatory = composeSearch.details.data.mandatory;\r\n\r\n        var arguments = { url: APPLICATIONPATH + \"cpf/search/save\", dataType: \"json\", type: \"POST\", data: savedata, success: composeSearch.details.saveSuccess, errorCallback: composeSearch.details.saveError };\r\n        cpf.ajax(arguments);\r\n    },\r\n\r\n    saveSuccess: function (result, textStatus, jqXHR) {\r\n\r\n        $(\"#save\").gcop().removeClass(\"disabled\");\r\n        cpf.spin(false);\r\n        USEROBJECTID = result[\"data\"].id;\r\n        SEARCHREQUESTNAME = result[\"data\"].name;\r\n        ENCODEDSEARCHREQUESTNAME = result[\"data\"].encodedName;\r\n        SANITISEDSEARCHREQUESTNAME = result[\"data\"].sanitisedName;\r\n        $(\"#search-name\").attr(\"data-initial-value\", $(\"#search-name\").val());\r\n\r\n        cpf.title.set(SEARCHREQUESTNAME);\r\n        $(\"#search-name\").val(SEARCHREQUESTNAME);\r\n        $(\"#search-name\").attr(\"data-initial-value\", result[\"data\"].name);\r\n\r\n        if (!composeSearch.isUnsavedSearch) {\r\n            if (composeSearch.$saveAs.hasClass(\"disabled\")) {\r\n                composeSearch.$saveAs.removeClass(\"disabled\");\r\n            }\r\n        }\r\n\r\n        //cpf.alert(\"RESOURCE{{compose-search.js}:{Saved}:{Saved successfully.}}\", \"s\");\r\n\r\n        if (composeSearch.saveSender == \"run\") {\r\n            cpf.alert(\"RESOURCE{{compose-search.js}:{RunningSearch}:{Running Search...}}\", \"s\");\r\n        }\r\n\r\n        // fire an event to say we saved ok, in case we are waiting to navigate away\r\n        $(\"body\").trigger(\"saved\");\r\n    },\r\n\r\n    saveError: function (result, textStatus, jqXHR) {\r\n        cpf.spin(false);\r\n        if (result[\"unhandled\"]) {\r\n            cpf.alert(\"RESOURCE{{compose-search.js}:{SaveFailed}:{There has been an error in the save search request.}}\", \"e\");\r\n        }\r\n        $(\"#save\").gcop().removeClass(\"disabled\");\r\n\r\n        //composeSearch.fail(message);\r\n    }\r\n};\r\n\r\n\r\nvar conditionControl = function ($input, columnName) {\r\n    this.$input = $input;\r\n    this.columnName = columnName + \"-input\";\r\n\r\n    this.load = function () {\r\n        var innerControls = this.getInnerControls();\r\n\r\n        for (var i = 0, ii = innerControls.length; i < ii; i++) {\r\n            var $inner = $(innerControls[i]);\r\n            typeName = $inner.gcop().getAttribute(\"data-control-type\");\r\n            type = controlTypes[typeName];\r\n            if (type != undefined) {\r\n                val = type.load($inner);\r\n            }\r\n        }\r\n    };\r\n\r\n    this.val = function () {\r\n        var typeName = null, type = null, val = null, parameters = [];\r\n        var innerControls = this.getInnerControls();\r\n\r\n        for (var i = 0, ii = innerControls.length; i < ii; i++) {\r\n\r\n            var $inner = $(innerControls[i]);\r\n            typeName = $inner.gcop().getAttribute(\"data-control-type\");\r\n\r\n            type = controlTypes[typeName];\r\n            var value = type.val($inner);\r\n            var constName = $inner.attr(\"data-name\");\r\n\r\n            if (!isNullOrEmpty(value)) {\r\n                //value = value.replace(/\\,/g, \"|\").replace(/;/g, \"|\");//.split(\"|\");\r\n                value = value.replace(/;/g, \"|\");\r\n\r\n                // HACK: To get date times working we have to check if its an empty date. if so then set the value to null;\r\n                if (typeName === \"date\" && value == \"00/00/0000\") {\r\n                    value = \"\";\r\n                }\r\n            }\r\n\r\n            parameters.push({ 'name': constName, 'value': value });\r\n        }\r\n\r\n        return parameters;\r\n    };\r\n\r\n    this.getInnerControls = function () {\r\n        var innerControls = this.$input.find(\".condition-control-item\");\r\n        return innerControls;\r\n    };\r\n\r\n    this.dependencyVal = function (operator) {\r\n\r\n        var typeName = this.$input.find(\".condition-control-item\").attr(\"data-control-type\");\r\n\r\n        switch (typeName) {\r\n\r\n            case \"checkboxlist\":\r\n                text = this.$input.find(\"input[type=checkbox]:checked\").map(function () {\r\n                    return $.trim($(this).parent().text());\r\n                }).get().join(\"|\");\r\n                break;\r\n            case \"dropdownlist\":\r\n                text = this.$input.find(\"select\").find('option:selected').text();\r\n                break;\r\n            case \"autocomplete\":\r\n                text = autocompleteGrid.val($input.find(\".autocomplete-grid\")).map(function (n, i) {\r\n                    return n.label;\r\n                }).join(\"|\");\r\n                break;\r\n            default:\r\n                text = this.val().map(function (i) {\r\n                    return $.trim(i[\"value\"]);\r\n                }).join(\"|\");\r\n                break;\r\n        }\r\n\r\n        return text;\r\n    };\r\n\r\n    this.validate = function (parameterised) {\r\n        if (!parameterised) {\r\n\r\n            var typeName = null,\r\n                type = null,\r\n                parameters = [],\r\n                valid = true;\r\n\r\n            var innerControls = $input.find(\".condition-control-item\");\r\n\r\n            for (var i = 0, ii = innerControls.length; i < ii; i++) {\r\n\r\n                $inner = $(innerControls[i]);\r\n                typeName = $inner.gcop().getAttribute(\"data-control-type\");\r\n\r\n                type = controlTypes[typeName];\r\n\r\n                if (type.validate) {\r\n                    var result = type.validate($inner, validation.messages, validation.validationArray);\r\n\r\n                    if (result == false) {\r\n                        validation.valid = false;\r\n                        valid = false;\r\n                    }\r\n                }\r\n            }\r\n\r\n            // manually add the invalid or valid classes here. \r\n            // prevent adding additional work to the validation script.\r\n            if ($input.gcop().hasClass(\"panel-validation\")) {\r\n                if (valid) {\r\n                    $input.gcop().removeClass(\"invalid\");\r\n                }\r\n                else {\r\n                    $input.gcop().addClass(\"invalid\");\r\n                }\r\n            }\r\n\r\n            return valid;\r\n        }\r\n        else {\r\n            return true;\r\n        }\r\n    };\r\n\r\n    this.previewText = function (operator, parameterised) {\r\n\r\n        var text = \"\";\r\n\r\n        text = this.dependencyVal().replace(/[|]/g, \",\");\r\n\r\n        if (text != undefined && text != \"\" && $.trim(text).length > 0) {\r\n\r\n            if (operator != undefined && operator == \"between\") {\r\n                var split = text.split(\",\");\r\n\r\n                if (isNullOrEmpty(split[0]) || split[0] == \"00/00/0000\") {\r\n                    split[0] = \"?\";\r\n                }\r\n\r\n                if (isNullOrEmpty(split[1]) || split[1] == \"00/00/0000\") {\r\n                    split[1] = \"?\";\r\n                }\r\n\r\n                text = split.join(\" \" + \"RESOURCE{{compose-search.js}:{OperatorBetweenJoin}:{and}}\" + \" \", split);\r\n            }\r\n            else if (text == \"00/00/0000\") {\r\n                text = \"?\";\r\n            }\r\n\r\n            if (text.length > 45) {\r\n                text = text.substring(0, 45);\r\n                text += \"...\";\r\n            }\r\n\r\n            return text;\r\n        }\r\n        else {\r\n            if (parameterised) {\r\n                return \"?\";\r\n            }\r\n\r\n            return \"RESOURCE{{compose-search.js}:{ClickHereToEdit}:{Click here to edit}}\"; //\"RESOURCE{{compose-search.js}:{ClickHereToEdit}:{Click here to edit}}\";\r\n        }\r\n    };\r\n\r\n    this.controlType = function () {\r\n        return this.$input.find(\".condition-control-item\").attr(\"data-control-type\");\r\n    }\r\n};\r\n\r\nvar controlTypes = {\r\n\r\n    bool: {\r\n\r\n        load: function () { },\r\n\r\n        val: function ($input) {\r\n            var $control = $input.find(\"input[type=radio]:checked\");\r\n\r\n            if ($control.length == 0) {\r\n                return \"\";\r\n            } else {\r\n                return $control.val();\r\n            }\r\n        },\r\n\r\n        validate: function ($input, messages, validationArray) {\r\n            //return $input.find(\"input[type='radio']:first\").validate({ validationArray: validationArray });\r\n            return $input.validate({ validationArray: validationArray });\r\n        }\r\n    },\r\n\r\n    date: {\r\n\r\n        load: function ($input) {\r\n            datePicker.load($input, null);\r\n        },\r\n\r\n        val: function ($input) {\r\n\r\n            // date part of the value.\r\n            var id = $input.gcop().getAttribute(\"id\");\r\n\r\n            if (id !== undefined) {\r\n                var year = $input.find(\"#\" + id + \"-year\").val();\r\n                var month = $input.find(\"#\" + id + \"-month\").val();\r\n                var day = $input.find(\"#\" + id + \"-day\").val();\r\n\r\n                var dateString = year + \"/\" + controlTypes.date.pad(month, 2, \"0\") + \"/\" + controlTypes.date.pad(day, 2, \"0\");\r\n                if (year == \"0\" || month == \"0\" || day == \"0\") {\r\n                    // invalid\r\n                    return \"00/00/0000\";\r\n                }\r\n\r\n                return dateString;\r\n            }\r\n        },\r\n\r\n        validate: function ($input, messages, validationArray) {\r\n\r\n            if (validationArray) {\r\n                var inputId = $input.gcop().getAttribute(\"id\");\r\n                var dayName = inputId + \"-day\";\r\n                $input.find(\"#\" + dayName).validate({ validationArray: validationArray });\r\n\r\n                var monthName = inputId + \"-month\";\r\n                $input.find(\"#\" + monthName).validate({ validationArray: validationArray });\r\n\r\n                var yearName = inputId + \"-year\";\r\n                $input.find(\"#\" + yearName).validate({ validationArray: validationArray });\r\n\r\n                return $.grep(validationArray, function (n) { return n.name == name }).length == 0;\r\n            } else {\r\n                return $input.validate();\r\n            }\r\n        },\r\n\r\n        pad: function (number, count, str) {\r\n            return Array(count - String(number).length + 1).join(str || '0') + number;\r\n        }\r\n    },\r\n\r\n    time: {\r\n        load: function ($input) {\r\n\r\n        },\r\n\r\n        val: function ($input) {\r\n\r\n            var id = $input.gcop().getAttribute(\"id\");\r\n\r\n            var hour = $input.find(\"#\" + id + \"-hour\").val();\r\n            var minute = $input.find(\"#\" + id + \"-minute\").val();\r\n\r\n            // determin if we are using a 12 hour picker be checking for a ampm-period select\r\n            if ($input.find(\"#\" + id + \"-period\").length == 1) {\r\n                var period = $input.find(\"#\" + id + \"-period\").val();\r\n                if (period == \"pm\" && hour != \"12\") {\r\n                    hour = Number(hour) + 12;\r\n                }\r\n                else if (period == \"am\" && hour == \"12\") {\r\n                    hour = \"00\";\r\n                }\r\n            }\r\n\r\n            if (hour == \"\" || minute == \"\") {\r\n                // invalid\r\n                return \"00:00:00\";\r\n            }\r\n\r\n            hour = dynoTime.pad(hour, 2);\r\n            minute = dynoTime.pad(minute, 2);\r\n\r\n            //CalculateExecutionTime(\"time\");\r\n            return hour + \":\" + minute + \":00\";\r\n        },\r\n\r\n        validate: function ($input, messages, validationArray) {\r\n            var timeName = $input.gcop().getAttribute(\"id\") + \"-time\";\r\n            var timePart = $input.gcop().getAttribute(\"id\") + \"-hour\";\r\n            $input.find(\"#\" + timePart).validate({ validationArray: validationArray });\r\n\r\n            var timeValid = $.grep(validationArray, function (n) { return n.name == timePart; }).length == 0;\r\n\r\n            return timeValid;\r\n        }\r\n    },\r\n\r\n    integer: {\r\n\r\n        load: function () { },\r\n\r\n        val: function ($input) {\r\n            var $control = $input.find(\"input[type=text]\");\r\n            return $control.val();\r\n        },\r\n\r\n        validate: function ($input, messages, validationArray) {\r\n            var $domInput = $input.find(\"#\" + $input.gcop().getAttribute(\"id\") + \"-input\");\r\n            return $domInput.validate({ validationArray: validationArray });\r\n        }\r\n    },\r\n\r\n    decimal: {\r\n\r\n        load: function () { },\r\n\r\n        val: function ($input) {\r\n            var $control = $input.find(\"input[type=text]\");\r\n            return $control.val();\r\n        },\r\n\r\n        validate: function ($input, messages, validationArray) {\r\n            var $domInput = $input.find(\"#\" + $input.gcop().getAttribute(\"id\") + \"-input\");\r\n            return $domInput.validate({ validationArray: validationArray });\r\n        }\r\n    },\r\n\r\n    text: {\r\n\r\n        load: function () { },\r\n\r\n        val: function ($input) {\r\n            var $control = $input.find(\"input[type=text]\");\r\n            return $control.val();\r\n        },\r\n\r\n        validate: function ($input, messages, validationArray) {\r\n            var $domInput = $input.find(\"#\" + $input.gcop().getAttribute(\"id\") + \"-input\");\r\n            return $domInput.validate({ validationArray: validationArray });\r\n        }\r\n    },\r\n\r\n    checkboxlist: {\r\n\r\n        load: function () { },\r\n\r\n        val: function ($input) {\r\n\r\n            var checked = $input.find(\"input[type=checkbox]:checked\"),\r\n                value = [];\r\n\r\n            for (var i = 0, ii = checked.length; i < ii; i++) {\r\n                value.push($(checked[i]).val());\r\n            }\r\n\r\n            if (value.length == 0) {\r\n                return \"\";\r\n            } else {\r\n                return value.join(\",\");\r\n            }\r\n        },\r\n\r\n        validate: function ($input, messages, validationArray) {\r\n            var $domInput = $input.find(\"input[name=\" + $input.gcop().getAttribute(\"id\") + \"-input\" + \"]\").eq(0);\r\n            return $input.validate({ validationArray: validationArray });\r\n        }\r\n    },\r\n\r\n    dropdownlist: {\r\n\r\n        load: function () { },\r\n\r\n        val: function ($input) {\r\n            var value = $input.find(\"select\").val();\r\n            if (value == \"-1\") {\r\n                return \"\";\r\n            } else {\r\n                return value;\r\n            }\r\n        },\r\n\r\n        validate: function ($input, messages, validationArray) {\r\n            var $domInput = $input.find(\"#\" + $input.gcop().getAttribute(\"id\") + \"-input\");\r\n            return $domInput.validate({ validationArray: validationArray });\r\n        }\r\n    },\r\n\r\n    autocomplete: {\r\n\r\n        load: function () { },\r\n\r\n        val: function ($input) {\r\n            var values = autocompleteGrid.val($input);\r\n            var returnValues = [];\r\n\r\n            if (values != null) {\r\n                for (var i = 0, ii = values.length; i < ii; i++) {\r\n                    returnValues.push(values[i].value);\r\n                }\r\n            }\r\n\r\n            return returnValues.join(\",\");\r\n        },\r\n\r\n        validate: function ($input, messages, validationArray) {\r\n\r\n            var values = autocompleteGrid.val($input);\r\n            return values.length > 0;\r\n        }\r\n    }\r\n};\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/compose-search-display.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\n/// <reference path=\"compose-search-values.js\" />\r\n;\r\n\r\ncomposeSearch.display = {\r\n\r\n    $columnMappings: 0,\r\n    $displayColumns: 0,\r\n    $displayFields: 0,\r\n    $moveUpButton: null,\r\n    $moveDownButton: null,\r\n    $removeRowButton: null,\r\n    searchTimeout: 0,\r\n    displayFieldsCacheObj: {},\r\n    load: function () {\r\n\r\n        // setup and store references to DOM objects\r\n        composeSearch.display.setupReferences();\r\n\r\n        // add events to DOM elements.\r\n        composeSearch.display.bindEvents();\r\n\r\n        composeSearch.display.setUpRibbon();\r\n\r\n\r\n        composeSearch.display.setUpNewRowLinks();\r\n\r\n\r\n        composeSearch.display.setUpDisplayFields();\r\n\r\n\r\n        cpf.title.set(SEARCHREQUESTNAME);\r\n\r\n        //composeSearch.display.refreshMappings();\r\n\r\n        // turn on the only window\r\n        $(\"div.window\").eq(0).show();\r\n\r\n        // get all display colums for cache storage\r\n        for (i = 0, ii = composeSearch.display.$displayFields.length; i < ii; i++) {\r\n            var columnId = composeSearch.display.$displayFields.eq(i).gcop().getAttribute(\"data-id\");\r\n            var searchableId = composeSearch.display.$displayFields.eq(i).gcop().getAttribute(\"data-group-id\");\r\n            composeSearch.display.displayFieldsCacheObj[searchableId + \"_\" + columnId] = { id: columnId, searchableId: searchableId };\r\n        }\r\n\r\n\r\n\r\n    },\r\n\r\n    setupReferences: function () {\r\n        composeSearch.display.$columnMappings = $(\"div.column-mappings\");\r\n        composeSearch.display.$displayFields = $(\".display-fields\").find(\".compose-searh-row\");\r\n\r\n        composeSearch.display.$removeRowButton = $(\"#remove\");\r\n        composeSearch.display.$moveUpButton = $(\"#move-up\");\r\n        composeSearch.display.$moveDownButton = $(\"#move-down\");\r\n    },\r\n\r\n    bindEvents: function () {\r\n\r\n        // bind lightbox close events\r\n        $(\"#compose-display-lite-close\").off(\"click\").on(\"click\", function () {\r\n            composeSearch.display.dialogShow(composeSearch.display.$composeDisplayLite, false);\r\n        });\r\n\r\n        // enable views\r\n        $(\"div.column-mappings input.enable-view\").on(\"change\", function () {\r\n            $columnMappingsGroup = $(this).closest(\"div.column-mappings\");\r\n\r\n            if ($(this).gcop().isChecked()) {\r\n                $columnMappingsGroup.find(\"select.mappable-columns\").gcop().removeAttribute(\"disabled\");\r\n            } else {\r\n                $columnMappingsGroup.find(\"select.mappable-columns\").gcop().setAttribute(\"disabled\", \"disabled\");\r\n            }\r\n        });\r\n\r\n        // searchable dropdown changed.\r\n        $(\"#searchable-select\").on(\"change\", function () {\r\n            composeSearch.display.searchableChanged($(this));\r\n        });\r\n\r\n        $(\"#condition-edit\").off(\"click\").on(\"click\", function () {\r\n\r\n            var searchableId = $(\"#searchable-select\").val();\r\n\r\n            if (searchableId !== '0') {\r\n                $(\"div.searchable div.panel\").hide();\r\n\r\n                var $panel = $(\"#\" + searchableId).find(\"div.panel\");\r\n                var $div = $(\"#display-option\");\r\n                var offset = $div.offset();\r\n                offset.top = offset.top - 5;\r\n                offset.left = offset.left - 10;\r\n\r\n                $panel.show();\r\n                $panel.offset(offset);\r\n            }\r\n\r\n            // update options class height such for consistency\r\n            var optionHeight = 0;\r\n            var newHeight = 0;\r\n            var optionFlag = $panel.find(\".panel-content\").gcop().getAttribute(\"option-update-flag\");\r\n\r\n            var options = $panel.find(\".option\");\r\n            var optionCount = options.length;\r\n\r\n            if (optionFlag == \"true\") {\r\n\r\n                for (var i = 0; i < optionCount; i++) {\r\n                    newHeight = $(options[i]).height();\r\n                    if (newHeight > optionHeight) {\r\n                        optionHeight = newHeight;\r\n                    }\r\n                }\r\n\r\n                $panel.find(\".option\").height(optionHeight);\r\n                $panel.find(\".panel-content\").gcop().setAttribute(\"option-update-flag\", \"false\");\r\n            }\r\n\r\n            return false;\r\n        });\r\n\r\n        //Allow radio buttons to be deselectable\r\n        $(\":radio\").on(\"click\", function (event) {\r\n            if ($(this).hasClass(\"checked\")) {\r\n                $(this).removeClass(\"checked\");\r\n                $(this).prop('checked', false);\r\n            } else {\r\n                $(\":radio\").each(function () {\r\n                    $(this).removeClass(\"checked\");\r\n                });\r\n\r\n                $(this).addClass(\"checked\");\r\n            }\r\n        });\r\n    },\r\n\r\n\r\n    ribbonContext: function () {\r\n        var allColumnChecks = $(\"input.column-check:checked\");\r\n        if (allColumnChecks.length > 0) {\r\n\r\n            composeSearch.display.$removeRowButton.gcop().removeClass(\"disabled\");\r\n\r\n            if (allColumnChecks.length == 1) {\r\n                // move up and down\r\n                composeSearch.display.$moveUpButton.gcop().removeClass(\"disabled\");\r\n                composeSearch.display.$moveDownButton.gcop().removeClass(\"disabled\");\r\n            } else {\r\n                composeSearch.display.$moveUpButton.gcop().addClass(\"disabled\");\r\n                composeSearch.display.$moveDownButton.gcop().addClass(\"disabled\");\r\n            }\r\n        } else {\r\n            composeSearch.display.$removeRowButton.gcop().addClass(\"disabled\");\r\n            composeSearch.display.$moveUpButton.gcop().addClass(\"disabled\");\r\n            composeSearch.display.$moveDownButton.gcop().addClass(\"disabled\");\r\n        }\r\n    },\r\n\r\n    setUpRibbon: function () {\r\n\r\n        // save\r\n        $(\"#save\").off(\"click\").on(\"click\", function () {\r\n            composeSearch.display.save();\r\n            composeSearch.saveSender = \"\";\r\n        });\r\n\r\n        $(\"#save-as\").off(\"click\").on(\"click\", function () {\r\n            if (!$(this).hasClass(\"disabled\")) {\r\n                composeSearch.display.save(true);\r\n                composeSearch.saveSender = \"\";\r\n            }\r\n        });\r\n\r\n        // remove rows click\r\n        composeSearch.display.$removeRowButton.on(\"click\", function () {\r\n            if ($(this).gcop().hasClass(\"disabled\")) {\r\n                return;\r\n            }\r\n\r\n            // get a list of checked rows\r\n            var allColumnChecks = $(\"input.column-check:checked\");\r\n\r\n            var mandatoryFieldsInRemoving = [];\r\n            // remove each tr\r\n            for (var i = 0, ii = allColumnChecks.length; i < ii; i++) {\r\n                var $row = allColumnChecks.eq(i).closest(\"tr.compose-searh-row\");\r\n                // if view is DISPLAY and field is mandatory skip it with warning message\r\n                var isMandatoryField = $row.gcop().getAttribute(\"data-mandatory\") == \"true\" && VIEW == \"display\";\r\n                if (isMandatoryField) {\r\n                    mandatoryFieldsInRemoving.push($row.find(\"td input.user-display-name\").val());\r\n                    continue;\r\n                }\r\n\r\n                var $row = allColumnChecks.eq(i).closest(\"tr.compose-searh-row\");\r\n                $row.remove();\r\n                var columnName = $row.find(\"div.column-name\").gcop().getAttribute(\"data-column-id\");\r\n                var $selectList = $(\"select.field-menu\");\r\n                $selectList.find(\"option[value='\" + columnName + \"']\").gcop().removeAttribute(\"disabled\");\r\n                $selectList.find(\"option[value='\" + columnName + \"']\").css(\"color\", \"\");\r\n\r\n                // not using the line below as we dont have concept of mandatory fields at the momemnt.\r\n                // composeSearch.details.hideDependentSearchables(columnName);\r\n            }\r\n\r\n            if (mandatoryFieldsInRemoving.length > 0) {\r\n                cpf.alert(\"RESOURCE{{compose-search.js}:{MandatoryFieldRemove}:{ \" + mandatoryFieldsInRemoving.join(\", \") + \" column(s) have not been removed as they are mandatory. }}\", \"w\");\r\n            }\r\n\r\n            // set the buttons back to disabled\r\n            composeSearch.display.$removeRowButton.gcop().addClass(\"disabled\");\r\n            composeSearch.display.$moveUpButton.gcop().addClass(\"disabled\");\r\n            composeSearch.display.$moveDownButton.gcop().addClass(\"disabled\");\r\n\r\n            if (VIEW == \"display\") {\r\n                composeSearch.display.refreshMappings();\r\n            }\r\n        });\r\n\r\n        // USED ON DISPLAY PAGE ONLY\r\n        composeSearch.display.$moveUpButton.on(\"click\", function () {\r\n            if (!composeSearch.display.$moveUpButton.hasClass(\"disabled\")) {\r\n                // get the row\r\n                $tr = $(\"input.column-check:checked\").eq(0).closest(\"tr.compose-searh-row\");\r\n                // move it up\r\n                $tr.insertBefore($tr.prev());\r\n            }\r\n        });\r\n\r\n        // USED ON DISPLAY PAGE ONLY\r\n        composeSearch.display.$moveDownButton.on(\"click\", function () {\r\n            if (!composeSearch.display.$moveDownButton.hasClass(\"disabled\")) {\r\n                // get the row\r\n                $tr = $(\"input.column-check:checked\").eq(0).closest(\"tr.compose-searh-row\");\r\n                // move it down\r\n                $tr.insertAfter($tr.next());\r\n            }\r\n        });\r\n\r\n    },\r\n\r\n    searchableChanged: function ($select) {\r\n\r\n        var selectedValue = $select.val(); // value of the select list\r\n\r\n        $select.parent().parent().find(\".display-fields-lookup\").hide();\r\n\r\n        if (selectedValue != \"0\") {\r\n\r\n            $(\"#condition-edit\").show();\r\n            var $valueWindow = $(\"#\" + selectedValue);\r\n\r\n            $valueWindow.gcop().show();\r\n\r\n            // bind change event for checkboxes to the parent container.\r\n            $valueWindow.off(\"change\", \"input[type=checkbox]\").on(\"change\", \"input[type=checkbox]\", function () {\r\n                var $checkbox = $(this).gcop();\r\n                var columnId = $checkbox.getAttribute(\"value\");\r\n                var searchableId = $checkbox.getAttribute(\"data-searchable-id\");\r\n                var $control = $(this).parents(\".display-fields-lookup\");\r\n                var identifier = searchableId + \"_\" + columnId;\r\n\r\n                if ($checkbox.isChecked()) {\r\n                    if (!composeSearch.display.displayFieldsCacheObj[identifier]) {\r\n                        composeSearch.display.addNewDisplayField(columnId, $control, identifier);\r\n                        //  composeSearch.display.displayFieldsCacheObj[identifier] = { id: columnId, searchableId: searchableId };\r\n                    }\r\n                }\r\n                else {\r\n                    // remove object from cache if it exists \r\n                    if (composeSearch.display.displayFieldsCacheObj[identifier]) {\r\n                        composeSearch.display.removeDisplayField(columnId, $control);\r\n                        delete composeSearch.display.displayFieldsCacheObj[identifier];\r\n                    }\r\n                }\r\n            });\r\n        }\r\n        else {\r\n            $(\"#default-select\").show();\r\n            $(\"#condition-edit\").hide();\r\n        }\r\n    },\r\n\r\n    setUpDisplayFieldsEvents: function ($control) {\r\n\r\n        $(\"a.close-panel\", $control).off(\"click\").on(\"click\", function (e) {\r\n\r\n            //clear input box and re-bind the control\r\n\r\n            var $panel = $(this).closest(\".panel\"),\r\n                $searchBox = $panel.find(\".panel-search-control .cpftxt\");\r\n\r\n            $searchBox.val(\"\");\r\n            composeSearch.display.filterOptionResults($control);\r\n\r\n            // enable watermark\r\n            $searchBox.val(\"Search...\").addClass('inputblank');\r\n\r\n            e.stopPropagation();\r\n            $panel.hide();\r\n\r\n            return false;\r\n        });\r\n\r\n        $(\".panel-search-control\", $control).off(\"keyup\").on(\"keyup\", function (e) {\r\n\r\n            //e.stopPropagation();\r\n            // trigger filter event after timeout expires added fo IE7\r\n            if (composeSearch.display.searchTimeout != undefined) {\r\n                clearTimeout(composeSearch.display.searchTimeout);\r\n                composeSearch.display.searchTimeout = setTimeout(function () { composeSearch.display.filterOptionResults($control) }, 100);\r\n            }\r\n        });\r\n\r\n        $(\".panel-search-control\", $control).find(\"input\").on(\"blur\", function (e) {\r\n\r\n            if ($(this).val() == '') {\r\n                $(this)\r\n                    .addClass('inputblank')\r\n                    .val('Search...');\r\n            }\r\n        });\r\n\r\n        $(\".panel-search-control\", $control).find(\"input\").on(\"focus\", function (e) {\r\n\r\n            if ($(this).val() == 'Search...') {\r\n                $(this)\r\n                    .removeClass('inputblank')\r\n                    .val('');\r\n            }\r\n        });\r\n    },\r\n\r\n    filterOptionResults: function ($control) {\r\n\r\n        var searchPanelName = $control.find(\".cpftxt\").gcop().getAttribute(\"id\");\r\n        var value = $('input[id=' + searchPanelName + ']').val();\r\n        var displayOptions = $control.find(\".option\");\r\n\r\n        for (var j = 0, lj = displayOptions.length; j < lj; j++) {\r\n\r\n            var option = $(displayOptions[j]).find(\"input\").gcop().getAttribute(\"data-column-id-name\");\r\n            if (option.toLowerCase().indexOf(value.toLowerCase()) != -1) {\r\n                $(displayOptions[j]).gcop().show();\r\n            }\r\n            else {\r\n                $(displayOptions[j]).gcop().hide();\r\n            }\r\n        }\r\n        return false;\r\n    },\r\n\r\n    removeDisplayField: function (columnId, $control) {\r\n\r\n        var $row = composeSearch.display.$displayFields.parent().find(\"[id =\" + columnId + \"]\");\r\n        $row.remove();\r\n        return false;\r\n    },\r\n\r\n    addNewDisplayField: function (columnId, $control, identifier) {\r\n\r\n        // what searchable is this column from?\r\n        var searchableName = $control.attr(\"id-name\");\r\n        var searchableID = $control.attr(\"id\");\r\n        var selectedItem = $control.find(\"$control:checkbox[name=\" + identifier + \"-input]\").parent();\r\n        var id = selectedItem.find(\"input\").attr(\"data-id\");\r\n\r\n        // get the parent for the selected field is any.\r\n        var selectedParent = selectedItem.find(\"input\").attr(\"data-parent\");\r\n\r\n        // we can only have 1 deep multiple display result, so make sure we do not already have one\r\n        var level = selectedItem.find(\"input\").attr(\"data-level\");\r\n        if (level == \"DeepMultiple\") {\r\n\r\n            // get all the rows and check for an existing deep multiple\r\n            var $window = $(\"div.searchable div.window:visible\");\r\n            var $row = $window.find(\"tr.compose-searh-row[data-depth=DeepMultiple][data-group-id=\" + searchableName + \"]\").eq(0);\r\n            if ($row.length > 0) {\r\n\r\n                // get parent of the existing deepMultiple and see if the new selected item has the same type.\r\n                var parent = $row.gcop().getAttribute(\"data-parent\");\r\n\r\n                if (selectedParent !== parent) {\r\n                    cpf.alert(\"RESOURCE{{compose-search.js}:{SelectRowToDelete}:{Cannot add column. Remove existing deep multiple display column first.}}\", \"w\");\r\n\r\n                    // uncheck control\r\n                    $control.find(\"input[data-id=\" + columnId + \"]\").prop(\"checked\", false);\r\n                    return false;\r\n                }\r\n            }\r\n        }\r\n        var columnId = columnId;\r\n        if (!columnId || columnId == \"0\") {\r\n            return false;\r\n        }\r\n\r\n        // store display cache\r\n        composeSearch.display.displayFieldsCacheObj[identifier] = { id: columnId, searchableId: searchableID };\r\n\r\n        // build the request. CONTAINER and NAME are written out in the ComposeSearch view\r\n        var data = {\r\n            container: CONTAINER,\r\n            name: searchableName,\r\n            searchableName: searchableName,\r\n            searchableID: searchableID,\r\n            columnName: columnId,\r\n            columnId: columnId,\r\n            id: id\r\n        };\r\n\r\n        cpf.spin();\r\n\r\n        var arguments = { url: APPLICATIONPATH + \"cpf/search/displayfield\", dataType: \"html\", type: \"POST\", data: data, success: composeSearch.display.addNewSuccess, errorCallback: composeSearch.display.addNewError };\r\n        cpf.ajax(arguments);\r\n\r\n        return false;\r\n    },\r\n\r\n    silentSave: function () {\r\n        composeSearch.display.save(null, true);\r\n    },\r\n\r\n    save: function (saveAs, silent) {\r\n        if ($(this).gcop().hasClass(\"disabled\")) {\r\n            return false;\r\n        }\r\n\r\n        var rows = $(\"tr.compose-searh-row\");\r\n\r\n        var data = {\r\n            displayFields: [],\r\n            views: [],\r\n            indexer: $(\"table.display-fields\").find(\"input[name=indexer]:checked\").val()\r\n        };\r\n\r\n        // get all display fields\r\n        for (var i = 0, ii = rows.length; i < ii; i++) {\r\n\r\n            var $displayRow = rows.eq(i);\r\n\r\n            var columnType = $displayRow.gcop().getAttribute(\"data-column-type\");\r\n            var id = $displayRow.gcop().getAttribute(\"data-id\");\r\n            var columnName = $displayRow.find(\"div.column-name\").gcop().getAttribute(\"data-column-name\");\r\n            var userDisplayName = $displayRow.find(\".user-display-name\").val();\r\n            var sort = $displayRow.find(\".sort-operator\").val();\r\n            var depth = $displayRow.gcop().getAttribute(\"data-depth\");\r\n            var path = $displayRow.gcop().getAttribute(\"data-path\");\r\n            var ns = $displayRow.gcop().getAttribute(\"data-ns\");\r\n            var definitions = $displayRow.gcop().getAttribute(\"data-definitions\");\r\n            var xmlColumn = $displayRow.gcop().getAttribute(\"data-xml-column\");\r\n            var relatedField = $displayRow.gcop().getAttribute(\"data-related-field\");\r\n            var searchableID = $displayRow.gcop().getAttribute(\"data-group-id\");\r\n            var parent = $displayRow.gcop().getAttribute(\"data-parent\");\r\n            var mandatory = $displayRow.gcop().getAttribute(\"data-mandatory\") == \"true\";\r\n\r\n            var field = {\r\n                id: id,\r\n                columnType: columnType,\r\n                columnName: columnName,\r\n                userDisplayName: userDisplayName,\r\n                sort: sort,\r\n                depth: depth,\r\n                path: path,\r\n                ns: ns,\r\n                xmlColumn: xmlColumn,\r\n                relatedField: relatedField,\r\n                searchableID: searchableID,\r\n                parent: parent,\r\n                mandatory: mandatory,\r\n                definitions: definitions\r\n            };\r\n\r\n            data.displayFields.push(field);\r\n        }\r\n\r\n        // now get the mappings\r\n        var allViews = $(\"div.column-mappings\");\r\n        for (var v = 0, vv = allViews.length; v < vv; v++) {\r\n\r\n            var view = {\r\n                enabled: allViews.eq(v).find(\"input.enable-view\").gcop().isChecked(),\r\n                name: allViews.eq(v).gcop().getAttribute(\"data-view\"),\r\n                mappings: []\r\n            };\r\n\r\n            var allMappingRowsInView = allViews.eq(v).find(\"tr.mapping\");\r\n            for (var i = 0, ii = allMappingRowsInView.length; i < ii; i++) {\r\n                var $mapping = allMappingRowsInView.eq(i);\r\n\r\n                view.mappings.push({\r\n                    property: $mapping.find(\"div.property-name\").gcop().getAttribute(\"data-value\"),\r\n                    column: $mapping.find(\"select.mappable-columns\").val()\r\n                });\r\n            }\r\n\r\n            data.views.push(view);\r\n        }\r\n\r\n        //$(\"#debug\").text(JSON.stringify(data));\r\n        //return false;\r\n\r\n        var save = function (saveAs, parentFolderId, searchName) {\r\n            cpf.spin();\r\n            $(\"#save\").gcop().addClass(\"disabled\");\r\n\r\n            if (!silent) {\r\n                cpf.alert(\"RESOURCE{{dynoform.js}:{Saving}:{Saving}}...\", \"i\");\r\n            }\r\n\r\n            //            var savedata = {\r\n            //                userObjectID: USEROBJECTID,\r\n            //                container: CONTAINER,\r\n            //                searchBuilderDefinitionName: SEARCHBUILDERDEFINITIONAME,\r\n            //                searchBuilderDefinitionContainer: SEARCHBUILDERDEFINITIONCONTAINER,\r\n            //                displayFields: data\r\n            //            };\r\n\r\n            var savedata = {\r\n                userObjectID: USEROBJECTID,\r\n                container: CONTAINER,\r\n                //searchBuilderDefinitionName: SEARCHBUILDERDEFINITIONAME,\r\n                //searchBuilderDefinitionContainer: SEARCHBUILDERDEFINITIONCONTAINER,\r\n                searchBuilderDefVirtualFilePath: SEARCHBUILDERDEFVIRTUALFILEPATH,\r\n                searchName: searchName,\r\n                isInitialSave: saveAs ? true : false,\r\n                data: {\r\n                    displayFields: data\r\n                },\r\n                section: \"display\"\r\n            };\r\n\r\n            if (saveAs) {\r\n                savedata.parentFolderId = parentFolderId;\r\n            }\r\n\r\n            var arguments = { url: APPLICATIONPATH + \"cpf/search/save\", dataType: \"json\", type: \"POST\", data: savedata, success: composeSearch.display.saveSuccess, errorCallback: composeSearch.display.saveError };\r\n            cpf.ajax(arguments);\r\n        };\r\n\r\n        if ((saveAs || composeSearch.isUnsavedSearch) && !silent) {\r\n\r\n            var callback = function(parentFolderId, fileName) {\r\n                //composeSearch.saveSender = \"\";\r\n                save(true, parentFolderId, fileName);\r\n                if (saveAs || composeSearch.isUnsavedSearch) {\r\n                    composeSearch.saveSender = \"display\";\r\n                }\r\n            };\r\n            files.show({\r\n                mode: \"save\",\r\n                title: \"Save Search\",\r\n                extensions: [\"search\"],\r\n                callback: callback\r\n            });\r\n        } else {\r\n            save(false, null, null);\r\n        }\r\n\r\n    },\r\n\r\n    saveSuccess: function (result, textStatus, jqXHR) {\r\n\r\n        $(\"#save\").gcop().removeClass(\"disabled\");\r\n        cpf.spin(false);\r\n        USEROBJECTID = result[\"data\"].id;\r\n        SEARCHREQUESTNAME = result[\"data\"].name;\r\n        ENCODEDSEARCHREQUESTNAME = encodeURIComponent(result[\"data\"].name);\r\n        //cpf.alert(\"RESOURCE{{compose-search.js}:{Saved}:{Saved successfully.}}\", \"s\");\r\n\r\n        cpf.title.set(SEARCHREQUESTNAME);\r\n\r\n        // fire an event to say we saved ok, in case we are waiting to navigate away\r\n        $(\"body\").trigger(\"saved\");\r\n    },\r\n\r\n    saveError: function (result, textStatus, jqXHR) {\r\n        cpf.spin(false);\r\n        if (result[\"unhandled\"]) {\r\n            cpf.alert(\"RESOURCE{{compose-search.js}:{SaveFailed}:{There has been an error saving the search.}}\", \"e\");\r\n        }\r\n\r\n        $(\"#save\").gcop().removeClass(\"disabled\");\r\n    },\r\n\r\n    setUpDisplayFields: function () {\r\n\r\n        // add an event to each check box for the ribbon context\r\n        $(\"input.column-check\").off(\"click\").on(\"click\", function () {\r\n            composeSearch.display.ribbonContext();\r\n        });\r\n    },\r\n\r\n    setUpNewRowLinks: function () {\r\n\r\n        $(\"a.add-field\").on(\"click\", function () {\r\n\r\n            var $link = $(this);\r\n            var $selectList = $link.prevAll(\"select.field-options:visible\");\r\n\r\n            // what searchable is this column from?\r\n            var searchableName = $selectList.find(\"option:selected\").gcop().getAttribute(\"data-searchable-name\");\r\n            var id = $selectList.find(\"option:selected\").gcop().getAttribute(\"data-id\");\r\n\r\n            // get the parent for the selected field is any.\r\n            var selectedParent = $selectList.find(\"option:selected\").attr(\"data-parent\");\r\n\r\n            // we can only have 1 deep multiple display result, so make sure we do not already have one\r\n            var level = $selectList.find(\"option:selected\").gcop().getAttribute(\"data-level\");\r\n            if (level == \"DeepMultiple\") {\r\n\r\n                // get all the rows and check for an existing deep multiple\r\n                var $window = $(\"div.searchable div.window:visible\");\r\n                var $row = $window.find(\"tr.compose-searh-row[data-depth=DeepMultiple][data-group-id=\" + searchableName + \"]\").eq(0);\r\n                if ($row.length > 0) {\r\n\r\n                    // get parent of the existing deepMultiple and see if the new selected item has the same type.\r\n                    var parent = $row.gcop().getAttribute(\"data-parent\");\r\n\r\n                    if (selectedParent !== parent) {\r\n                        cpf.alert(\"Cannot add column. Remove existing deep multiple display column first\", \"w\");\r\n                        return false;\r\n                    }\r\n                }\r\n            }\r\n\r\n            var columnName = $selectList.val();\r\n            if (!columnName || columnName == \"0\") {\r\n                return false;\r\n            }\r\n\r\n            // diable the button until we are done to avoid double clicks and adding a condition twice\r\n            $link.css(\"visibility\", \"hidden\");\r\n\r\n            // build the request. CONTAINER and NAME are written out in the ComposeSearch view\r\n            var data = {\r\n                container: CONTAINER,\r\n                name: searchableName,\r\n                searchableName: searchableName,\r\n                columnName: columnName,\r\n                id: id\r\n            };\r\n\r\n            cpf.spin();\r\n\r\n            var arguments = { url: APPLICATIONPATH + \"cpf/search/displayfield\", dataType: \"html\", type: \"POST\", data: data, success: composeSearch.display.addNewSuccess, errorCallback: composeSearch.display.addNewError };\r\n            cpf.ajax(arguments);\r\n\r\n            return false;\r\n        });\r\n    },\r\n\r\n    addNewSuccess: function (newRow) {\r\n        // make an element out of the html and find out it's groupID\r\n        var $displayField = $(newRow);\r\n        var columnName = $displayField.find(\"div.column-name\").gcop().getAttribute(\"data-column-name\");\r\n\r\n        // if the column name is already present prepend the table name to it\r\n        if ($('[data-column-name]').text().indexOf(columnName) > -1) {\r\n            var tableColumnName = $(\"#searchable-select option:selected\").text() + \"-\" + columnName;\r\n\r\n            // replace user display name\r\n            $displayField.find('.user-display-name').each(function () {\r\n                $(this).val(tableColumnName);\r\n            });\r\n        }\r\n\r\n        // find the visible window\r\n        var $window = $(\"div.searchable div.window:visible\");\r\n\r\n        // find the conditions table with this group ID\r\n        var $fieldsTable = $window.find(\"table.display-fields\");\r\n\r\n        // add it at the end\r\n        $fieldsTable.append($displayField);\r\n        composeSearch.display.setUpDisplayFields();\r\n        cpf.spin(false);\r\n    },\r\n\r\n    addNewError: function (xmlhttp, message, exception) {\r\n        cpf.spin(false);\r\n\r\n        // enable the add button now we are done\r\n        var $window = $(\"div.searchable div.window:visible\");\r\n        $window.find(\"a.add-field\").css(\"visibility\", \"visible\");\r\n    },\r\n\r\n\r\n\r\n    refreshMappings: function () {\r\n\r\n        composeSearch.display.displayFieldsCacheObj = {};\r\n\r\n        var allColumns = $(\"tr.compose-searh-row\");\r\n        for (var i = 0, ii = allColumns.length; i < ii; i++) {\r\n            var columnId = allColumns.eq(i).gcop().getAttribute(\"data-id\");\r\n            var searchableId = allColumns.eq(i).gcop().getAttribute(\"data-group-id\");\r\n            var identifier = searchableId + \"_\" + columnId;\r\n            composeSearch.display.displayFieldsCacheObj[identifier] = { id: columnId, searchableId: searchableId };\r\n        }\r\n\r\n        // reset all checked items if item is removed \r\n        var cols = $(\"div.panel-content\").find(\"input:checked\");\r\n        for (var j = 0; j < cols.length; j++) {\r\n            var identifier = $(cols[j]).gcop().getAttribute(\"data-group-id\") + \"_\" + $(cols[j]).gcop().getAttribute(\"data-id\");\r\n            if (!composeSearch.display.displayFieldsCacheObj[identifier]) {\r\n                $(cols[j]).attr({ checked: false });\r\n            }\r\n        }\r\n    },\r\n\r\n    addRemoveDisplayFields: function ($input) {\r\n\r\n        var data = {};\r\n        data.searchBuilderDefID = $input.gcop().getAttribute(\"search-builder-definition-id\");\r\n        data.searchName = encodeURIComponent($input.gcop().getAttribute(\"search-name\"));\r\n\r\n        composeSearch.display.$composeDisplayLite = $(\"#compose-display-lite\");\r\n\r\n        var success = function (result) {\r\n\r\n            if (result.success) {\r\n\r\n                composeSearch.display.$composeDisplayLite.find(\"#compose-display-details-container\").html(result.data);\r\n                composeSearch.display.load();\r\n                composeSearch.display.dialogShow(composeSearch.display.$composeDisplayLite, true);\r\n                return false;\r\n            }\r\n        };\r\n\r\n        var error = function (result) {\r\n            if (result[\"unhandled\"]) {\r\n                cpf.alert(\"RESOURCE{{email.js}:{ErrorEmailingDashoard}:{There was an error fetching display fields. Please contact support.}}\", \"e\");\r\n            }\r\n            return false;\r\n        };\r\n\r\n        cpf.ajax({ url: APPLICATIONPATH + \"cpf/composedisplay\", success: success, errorCallback: error, data: data });\r\n\r\n        return false;\r\n    },\r\n\r\n    dialogShow: function ($box, show) {\r\n\r\n        if (show) {\r\n            // centre the msgbox\r\n            //$box.css(\"top\", (($(window).height() - $box.outerHeight()) / 2) + \"px\");\r\n            $box.css(\"top\", \"0px\");\r\n            $box.css(\"left\", (($(window).width() - $box.outerWidth()) / 2) + \"px\");\r\n\r\n            cpf.overlay.show($box.attr(\"id\"));\r\n            lightbox.positionAndShow($box); //  $box.show();\r\n        } else {\r\n            $box.hide();\r\n            cpf.overlay.hide($box.attr(\"id\"));\r\n        }\r\n    }\r\n};\r\n\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/compose-search-parsers.js\n * ======================================== */\n\n﻿function conditionParser() {\r\n\r\n    conditionParser.prototype.toJson = function (goObj) {\r\n        var linksArray = goObj.diagram.model.linkDataArray;\r\n        var tileArray = goObj.diagram.model.nodeDataArray;\r\n\r\n        if (linksArray.length === 0) {\r\n            return [];\r\n        } else {\r\n\r\n            if (this.validateConditions(tileArray, goObj)) {\r\n\r\n                var root = new conditionGroup();\r\n                root.logicalOperator = \"And\";\r\n\r\n                //return JSON.stringify(filterParser.prototype.parseFilterData(tileArray[0], root, linksArray, goObj, \"And\"));\r\n\r\n                var filters = [];\r\n                filters.push(this.parseFilterData(tileArray[0], root, linksArray, goObj, \"And\"));\r\n                return filters;\r\n            }\r\n\r\n            return null;\r\n        }\r\n    };\r\n\r\n    conditionParser.prototype.validateConditions = function (conditions, goObj) {\r\n\r\n        var valid = true;\r\n        for (var i = 0; i < conditions.length; i++) {\r\n            if (conditions[i].key === -1) {\r\n                continue;\r\n            }\r\n\r\n            if (conditions[i].data.condition.value !== null && !conditions[i].data.condition.parameterised) {\r\n\r\n                if (conditions[i].data.condition.value.length === 0) {\r\n                    valid = false;\r\n                    goObj.diagram.startTransaction(\"Update click\");\r\n                    goObj.diagram.model.setDataProperty(conditions[i], \"invalid\", \"red\");\r\n                    goObj.diagram.commitTransaction(\"Update click\");\r\n                }\r\n                else {\r\n                    for (var j = 0; j < conditions[i].data.condition.value.length; j++) {\r\n\r\n                        if (isNullOrEmpty(conditions[i].data.condition.value[j])) {\r\n                            valid = false;\r\n                            goObj.diagram.startTransaction(\"Update click\");\r\n                            goObj.diagram.model.setDataProperty(conditions[i], \"invalid\", \"red\");\r\n                            goObj.diagram.commitTransaction(\"Update click\");\r\n                            break;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n        return valid;\r\n    };\r\n\r\n    conditionParser.prototype.parseFilterData = function (node, group, linksArray, goObj, operator) {\r\n        //var nodeType = node.category;\r\n\r\n        var childrenNodes = goObj.getChildren(node.key);\r\n\r\n        if (node.key === -1 && childrenNodes.length === 0) {\r\n\r\n        } else if (node.key === -1 && childrenNodes.length > 1) {\r\n\r\n            //            var c = new condition();\r\n            //            c.id = node.key;\r\n            //            c.logicalOperator = operator;\r\n            //            group.conditions.push(c);\r\n\r\n            for (var i = 0; i < childrenNodes.length; i++) {\r\n                if (goObj.getChildren(childrenNodes[i].key).length >= 1) {\r\n                    // TILEGROUP\r\n                    var subGroup = new conditionGroup();\r\n                    subGroup.logicalOperator = \"Or\";\r\n                    group.conditions.push(subGroup);\r\n\r\n                    this.parseFilterData(childrenNodes[i], subGroup, linksArray, goObj, \"And\");\r\n                } else {\r\n                    this.parseFilterData(childrenNodes[i], group, linksArray, goObj, \"Or\");\r\n                }\r\n            }\r\n        } else if (node.key === -1 && childrenNodes.length === 1) {\r\n            for (var i = 0; i < childrenNodes.length; i++) {\r\n                this.parseFilterData(childrenNodes[i], group, linksArray, goObj, \"And\");\r\n            }\r\n        } else if (childrenNodes.length > 1) {\r\n\r\n\r\n            for (var i = 0; i < childrenNodes.length; i++) {\r\n                if (goObj.getChildren(childrenNodes[i].key).length >= 1) {\r\n                    // TILEGROUP\r\n                    var subGroup = new conditionGroup();\r\n                    subGroup.logicalOperator = operator;\r\n                    group.conditions.push(subGroup);\r\n\r\n                    var c = new condition();\r\n                    c.id = node.key;\r\n                    c.logicalOperator = operator;\r\n                    subGroup.conditions.push(c);\r\n                    this.injectConditionDataProperties(c, node);\r\n\r\n                    this.parseFilterData(childrenNodes[i], subGroup, linksArray, goObj, \"And\");\r\n                } else {\r\n\r\n                    var c = new condition();\r\n                    c.id = node.key;\r\n                    c.logicalOperator = operator;\r\n                    group.conditions.push(c);\r\n                    this.injectConditionDataProperties(c, node);\r\n\r\n                    this.parseFilterData(childrenNodes[i], group, linksArray, goObj, \"Or\");\r\n                }\r\n\r\n            }\r\n\r\n        } else if (childrenNodes.length === 1) {\r\n\r\n            // normal condition\r\n            var c = new condition();\r\n            c.id = node.key;\r\n            c.logicalOperator = operator;\r\n            group.conditions.push(c);\r\n            this.injectConditionDataProperties(c, node);\r\n\r\n            for (var i = 0; i < childrenNodes.length; i++) {\r\n                this.parseFilterData(childrenNodes[i], group, linksArray, goObj, \"And\");\r\n            }\r\n        } else {\r\n            // normal condition\r\n            var c = new condition();\r\n            c.id = node.key;\r\n            c.logicalOperator = operator;\r\n            group.conditions.push(c);\r\n            this.injectConditionDataProperties(c, node);\r\n        }\r\n\r\n        return group;\r\n    };\r\n\r\n    conditionParser.prototype.injectConditionDataProperties = function (condition, node) {\r\n        try {\r\n            condition.type = \"condition\";\r\n            condition.searchableId = node.data.searchableId;\r\n            condition.searchableName = node.data.searchableName;\r\n            condition.searchBuilderDefinitionName = node.data.searchBuilderDefinitionName;\r\n            condition.searchBuilderDefinitionContainer = node.data.searchBuilderDefinitionContainer;\r\n            condition.container = node.data.container;\r\n\r\n            for (var p in node.data.condition) {\r\n                condition[p] = node.data.condition[p];\r\n            }\r\n        } catch (e) {\r\n            exceptions.push({ \"message\": \"Error injecting search condition data properties\", \"exception\": e });\r\n        }\r\n    };\r\n\r\n    conditionParser.prototype.parseJson = function (goObj) {\r\n        var existingData = goObj.options.existingData;\r\n\r\n        if (existingData != null) {\r\n            this.loadExistingFilters(existingData, \"And\", null, null, goObj);\r\n        }\r\n    };\r\n\r\n    conditionParser.prototype.loadExistingFilters = function (inputData, logicalOperator, nodeKey, previousNodeKey, goObj) {\r\n        for (var i = 0; i < inputData.length; i++) {\r\n            var currentNode = inputData[i];\r\n\r\n            if (currentNode.type === \"condition\") {\r\n                if (currentNode.logicalOperator === \"And\") {\r\n                    this.parseExistingFilter(currentNode, logicalOperator, goObj.diagram.model.maxKey, previousNodeKey, goObj);\r\n                    previousNodeKey = goObj.diagram.model.maxKey;\r\n                    goObj.diagram.model.maxKey = goObj.diagram.model.maxKey + 1;\r\n                    logicalOperator = currentNode.logicalOperator;\r\n                }\r\n                else if (currentNode.logicalOperator === \"Or\") {\r\n                    this.parseExistingFilter(currentNode, logicalOperator, goObj.diagram.model.maxKey, previousNodeKey, goObj);\r\n                    goObj.diagram.model.maxKey = goObj.diagram.model.maxKey + 1;\r\n                    logicalOperator = currentNode.logicalOperator;\r\n                }\r\n            }\r\n            else if (currentNode.type === \"group\") {\r\n                this.loadExistingFilters(currentNode.conditions, logicalOperator, nodeKey, previousNodeKey, goObj);\r\n                logicalOperator = currentNode.logicalOperator;\r\n            }\r\n        }\r\n    };\r\n\r\n    conditionParser.prototype.parseExistingFilter = function (inputNodeData, logicalOperator, nodeKey, previousNodeKey, goObj) {\r\n        //create new node and add to the node array\r\n        var conditionObj = {};\r\n        conditionObj.columnName = inputNodeData.columnName;\r\n        conditionObj.columnType = inputNodeData.columnType;\r\n        //conditionObj.definitions = inputNodeData.definitions;\r\n        //conditionObj.depth = inputNodeData.depth;\r\n        conditionObj.id = inputNodeData.id;\r\n        //conditionObj.ns = inputNodeData.ns;\r\n        conditionObj.operator = inputNodeData.operator;\r\n        conditionObj.operatorResolver = inputNodeData.operatorResolver;\r\n        conditionObj.parameterised = inputNodeData.parameterised;\r\n        conditionObj.parameterisedRequired = inputNodeData.parameterisedRequired;\r\n        //conditionObj.path = inputNodeData.path;\r\n        conditionObj.readOnly = inputNodeData.readOnly;\r\n        conditionObj.valueResolver = inputNodeData.valueResolver;\r\n        conditionObj.value = inputNodeData.value;\r\n\r\n        var dataObj = {};\r\n        dataObj.container = inputNodeData.container;\r\n        dataObj.displayName = inputNodeData.displayName;\r\n        dataObj.searchableId = inputNodeData.searchableId;\r\n        dataObj.searchableName = inputNodeData.searchableName;\r\n        dataObj.condition = conditionObj;\r\n\r\n        goObj.diagram.startTransaction(\"make new link\");\r\n        goObj.diagram.model.addNodeData({ key: nodeKey, data: dataObj, text: dataObj.displayName });\r\n\r\n        //create link from node to parent\r\n        if (logicalOperator === \"And\" && previousNodeKey === null) {\r\n            goObj.diagram.model.addLinkData({ from: -1, to: nodeKey });\r\n        } else if (logicalOperator === \"Or\" && previousNodeKey === null) {\r\n            goObj.diagram.model.addLinkData({ from: -1, to: nodeKey });\r\n        } else {\r\n            //todo find key and add link\r\n            goObj.diagram.model.addLinkData({ from: previousNodeKey, to: nodeKey });\r\n        }\r\n\r\n        if (!goObj.canPerform(\"add\")) {\r\n            if (goObj.diagram.model.nodeDataArray.length > 1) {\r\n                var currentHeight = $(goObj.diagram.div).height();\r\n\r\n                goObj.diagram.div.style.height = (currentHeight + 105) + \"px\";\r\n                goObj.diagram.requestUpdate();\r\n            }\r\n        }\r\n        else {\r\n\r\n            var numberOfChildrenCount = goObj.numberOfChildren(nodeKey);\r\n\r\n            if (numberOfChildrenCount === 0) {\r\n                var currentHeight = $(goObj.diagram.div).height();\r\n\r\n                goObj.diagram.div.style.height = (currentHeight + 105) + \"px\";\r\n                goObj.diagram.requestUpdate();\r\n            }\r\n        }\r\n\r\n        goObj.diagram.commitTransaction(\"make new link\");\r\n        goObj.diagram.rebuildParts();\r\n    };\r\n}\r\nfunction topicParser() {\r\n\r\n    topicParser.prototype.toJson = function (goObj) {\r\n        var linksArray = goObj.diagram.model.linkDataArray;\r\n        var tileArray = goObj.diagram.model.nodeDataArray;\r\n\r\n        if (linksArray.length === 0) {\r\n            return [];\r\n        } else {\r\n            var root = new topicGroup();\r\n            root.logicalOperator = \"And\";\r\n\r\n            //return JSON.stringify(topicParser.prototype.parseTopicData(tileArray[0], root, linksArray, goObj, \"And\"));\r\n\r\n            var topics = [];\r\n            topics.push(this.parseTopicData(tileArray[0], root, linksArray, goObj, \"And\"));\r\n            return topics;\r\n        }\r\n    };\r\n\r\n    topicParser.prototype.parseTopicData = function (node, group, linksArray, goObj, operator) {\r\n        var childrenNodes = goObj.getChildren(node.key);\r\n\r\n        if (node.key === -1 && childrenNodes.length === 0) {\r\n            //There are no nodes\r\n        } else if (node.key === -1 && childrenNodes.length > 1) {\r\n\r\n            for (var i = 0; i < childrenNodes.length; i++) {\r\n                if (goObj.getChildren(childrenNodes[i].key).length >= 1) {\r\n                    // TILEGROUP\r\n                    var subGroup = new topicGroup();\r\n                    subGroup.logicalOperator = operator;\r\n                    group.topics.push(subGroup);\r\n\r\n                    this.parseTopicData(childrenNodes[i], subGroup, linksArray, goObj, \"And\");\r\n                } else {\r\n                    this.parseTopicData(childrenNodes[i], group, linksArray, goObj, \"Or\");\r\n                }\r\n            }\r\n        } else if (node.key === -1 && childrenNodes.length === 1) {\r\n            for (var i = 0; i < childrenNodes.length; i++) {\r\n                this.parseTopicData(childrenNodes[i], group, linksArray, goObj, \"And\");\r\n            }\r\n        } else if (childrenNodes.length > 1) {\r\n\r\n            for (var i = 0; i < childrenNodes.length; i++) {\r\n                if (goObj.getChildren(childrenNodes[i].key).length >= 1) {\r\n                    // TILEGROUP\r\n                    var subGroup = new topicGroup();\r\n                    subGroup.logicalOperator = operator;\r\n                    group.topics.push(subGroup);\r\n\r\n                    var c = new topic();\r\n                    c.id = node.key;\r\n                    c.logicalOperator = operator;\r\n                    group.topics.push(c);\r\n                    this.injectTopicDataProperties(c, node);\r\n\r\n                    this.parseTopicData(childrenNodes[i], subGroup, linksArray, goObj, \"And\");\r\n                } else {\r\n\r\n                    var c = new topic();\r\n                    c.id = node.key;\r\n                    c.logicalOperator = operator;\r\n                    group.topics.push(c);\r\n                    this.injectTopicDataProperties(c, node);\r\n\r\n                    this.parseTopicData(childrenNodes[i], group, linksArray, goObj, \"Or\");\r\n                }\r\n\r\n            }\r\n\r\n        } else if (childrenNodes.length === 1) {\r\n\r\n            // normal condition\r\n            var c = new topic();\r\n            c.id = node.key;\r\n            c.logicalOperator = operator;\r\n            group.topics.push(c);\r\n            this.injectTopicDataProperties(c, node);\r\n\r\n            for (var i = 0; i < childrenNodes.length; i++) {\r\n                this.parseTopicData(childrenNodes[i], group, linksArray, goObj, \"And\");\r\n            }\r\n        } else {\r\n            // normal condition\r\n            var c = new topic();\r\n            c.id = node.key;\r\n            c.logicalOperator = operator;\r\n            group.topics.push(c);\r\n            this.injectTopicDataProperties(c, node);\r\n        }\r\n\r\n        return group;\r\n    };\r\n\r\n    topicParser.prototype.injectTopicDataProperties = function (topic, node) {\r\n        try {\r\n            topic.searchContainer = node.data.container;\r\n            topic.displayName = node.data.displayName;\r\n            topic.inclusionType = node.data.inclusionType;\r\n            topic.searchName = node.data.name;\r\n            topic.searchType = node.data.type;\r\n        } catch (e) {\r\n            exceptions.push({ \"message\": \"Error injecting search topic data properties\", \"exception\": e });\r\n        }\r\n    };\r\n\r\n    topicParser.prototype.parseJson = function (goObj) {\r\n        var existingData = goObj.options.existingData;\r\n\r\n        if (existingData != null) {\r\n            this.loadExistingTopics(existingData, \"And\", null, null, goObj);\r\n        }\r\n    };\r\n\r\n    topicParser.prototype.loadExistingTopics = function (inputData, logicalOperator, nodeKey, previousNodeKey, goObj) {\r\n        for (var i = 0; i < inputData.length; i++) {\r\n            var currentNode = inputData[i];\r\n\r\n            if (currentNode.type === \"topic\") {\r\n                if (currentNode.logicalOperator === \"And\") {\r\n                    this.parseExistingTopic(currentNode, logicalOperator, goObj.diagram.model.maxKey, previousNodeKey, goObj);\r\n                    previousNodeKey = goObj.diagram.model.maxKey;\r\n                    goObj.diagram.model.maxKey = goObj.diagram.model.maxKey + 1;\r\n                    logicalOperator = currentNode.logicalOperator;\r\n                }\r\n                else if (currentNode.logicalOperator === \"Or\") {\r\n                    this.parseExistingTopic(currentNode, logicalOperator, goObj.diagram.model.maxKey, previousNodeKey, goObj);\r\n                    //previousNodeKey = this.diagram.model.maxKey;\r\n                    goObj.diagram.model.maxKey = goObj.diagram.model.maxKey + 1;\r\n                    logicalOperator = currentNode.logicalOperator;\r\n                }\r\n            }\r\n            else if (currentNode.type === \"group\") {\r\n                this.loadExistingTopics(currentNode.topics, logicalOperator, nodeKey, previousNodeKey, goObj);\r\n                logicalOperator = currentNode.logicalOperator;\r\n            }\r\n        }\r\n    };\r\n\r\n    topicParser.prototype.parseExistingTopic = function (inputNodeData, logicalOperator, nodeKey, previousNodeKey, goObj) {\r\n        //create new node and add to the node array\r\n        var dataObj = {};\r\n        dataObj.container = inputNodeData.searchContainer;\r\n        dataObj.displayName = inputNodeData.inclusionType + \" \" + inputNodeData.searchName;\r\n        dataObj.inclusionType = inputNodeData.inclusionType;\r\n        dataObj.name = inputNodeData.searchName;\r\n        dataObj.type = inputNodeData.searchType;\r\n\r\n        goObj.diagram.startTransaction(\"make new link\");\r\n        goObj.diagram.model.addNodeData({ key: goObj.diagram.model.maxKey, data: dataObj, text: dataObj.displayName });\r\n\r\n        //create link from node to parent\r\n        if (logicalOperator === \"And\" && previousNodeKey === null) {\r\n            goObj.diagram.model.addLinkData({ from: -1, to: nodeKey });\r\n        } else if (logicalOperator === \"Or\" && previousNodeKey === null) {\r\n            goObj.diagram.model.addLinkData({ from: -1, to: nodeKey });\r\n        } else {\r\n            goObj.diagram.model.addLinkData({ from: previousNodeKey, to: nodeKey });\r\n        }\r\n\r\n        var numberOfChildrenCount = goObj.numberOfChildren(goObj.diagram.model.maxKey);\r\n\r\n        if (numberOfChildrenCount === 0) {\r\n            var currentHeight = $(goObj.diagram.div).height();\r\n\r\n            goObj.diagram.div.style.height = (currentHeight + 105) + \"px\";\r\n            goObj.diagram.requestUpdate();\r\n        }\r\n\r\n        goObj.diagram.commitTransaction(\"make new link\");\r\n        goObj.diagram.rebuildParts();\r\n    };\r\n\r\n}\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/compose-search-values.js\n * ======================================== */\n\n﻿/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\n/// <reference path=\"cpfmvc.js\" />\r\nfunction operatorAjax($operator) {\r\n    this.$operator = $operator;\r\n    this.$row = 0;\r\n    this.$row = this.$operator.closest(\"tr.compose-search-row\");\r\n    this.$valueArea = this.$row.find(\"td.condition-value\");\r\n    this.$searchableName = this.$row.attr(\"data-searchable-name\");\r\n\r\n    this.fire = function () {\r\n\r\n        // build the request. CONTAINER and NAME are for the searchable\r\n        var existingValue = \"\";\r\n        var columnName = this.$row.find(\"div.column-name\").gcop().getAttribute(\"data-column-name\");\r\n        var columnId = this.$row.find(\"div.column-name\").gcop().getAttribute(\"data-column-id\");\r\n        var $valueDiv = this.$row.find(\"td.condition-value\").find(\"div\").eq(0);\r\n        var conditionValueType = $valueDiv.gcop().getAttribute(\"data-type\");\r\n\r\n        if (conditionValueType != \"readonly\") {\r\n            var conditionType = new conditionControl($valueDiv, columnId);\r\n            existingValue = conditionType.val();\r\n        }\r\n\r\n        var data = {\r\n            container: CONTAINER,\r\n            name: this.$searchableName,\r\n            columnName: columnName,\r\n            columnId: columnId,\r\n            operator: this.$operator.val(),\r\n            searchableName: this.$row.attr(\"data-searchable-name\"),\r\n            existingValue: JSON.stringify(existingValue)\r\n        };\r\n\r\n        cpf.spin();\r\n\r\n        // set a spinner in the value area\r\n        this.$valueArea.html(\"loading...\");\r\n\r\n        var arguments = { context: this, url: APPLICATIONPATH + \"conditions/default/conditionvalue\", dataType: \"html\", type: \"POST\", data: data, success: this.success, errorCallback: this.error };\r\n        cpf.ajax(arguments);\r\n    };\r\n\r\n    this.success = function (html, textStatus, jqXHR) {\r\n\r\n        this.context.$valueArea.html(html);\r\n        var $control = this.context.$valueArea.find(\"div\").eq(0);\r\n        cpf.spin(false);\r\n\r\n        // initiate the dyno control\r\n        composeSearch.details.initiateControls($control);\r\n\r\n        // PA20130311 T:#3523  \r\n        // load dateTimeSpan events\r\n        if ($control.attr(\"data-type\") == \"datetimespan\") {\r\n            $control.parent().parent().find(\".condition-operator\").closest(\"td\").gcop().addClass(\"condition-operator-valign\");\r\n            dateTimeSpan.load($control);\r\n        }\r\n        else {\r\n            $control.parent().parent().find(\".condition-operator\").closest(\"td\").gcop().removeClass(\"condition-operator-valign\");\r\n        }\r\n\r\n        dynoform.bindHelpEvents();\r\n    },\r\n\r\n    this.error = function (xmlhttp, message, exception) {\r\n        cpf.alert(\"Failed to update condition value control\", \"w\");\r\n        cpf.spin(false);\r\n    }\r\n}\n\n/* ========================================\n * Source: Components/src/scripts/Cpf/Content/Scripts/cpfmvc.js\n * ======================================== */\n\n/// <reference path=\"jquery-1.5-vsdoc.js\" />\r\nvar cpfErrorTimeout;\r\n\r\n// array to track which lightbox windows are open.\r\n// sometimes we have more than on, and when it one is closed the background fade is hidden when it should still show.\r\nvar openWindows = [];\r\n\r\nvar cpf = {};\r\ncpf = {\r\n\tisIE: true,\r\n\tisIE7: false,\r\n\tisIE8: false,\r\n\tisIE9: false,\r\n\tisIE10: false,\r\n\tsignInEnabled: \"$CONFIG('Feature.EnableSignInApp','False')\".toLowerCase() === 'true',\r\n\tload: function () {\r\n\t\tcpf.isIE = cpf.browser.isIE();\r\n\t\tcpf.isIE7 = cpf.browser.isIE(7);\r\n\t\tcpf.isIE8 = cpf.browser.isIE(8);\r\n\t\tcpf.isIE9 = cpf.browser.isIE(9);\r\n\t\tcpf.isIE10 = cpf.browser.isIE(10);\r\n\r\n\t\tif (cpf.browser.isIE()) {\r\n\t\t\tvar iecheck = window.localStorage.getItem(\"ie-not-supported\");\r\n\t\t\tif (\r\n\t\t\t\ttypeof iecheck === \"undefined\" ||\r\n\t\t\t\tNumber(iecheck) < Date.now()\r\n\t\t\t) {\r\n\t\t\t\tvar $ieNotSuported = $(\"#ie-not-supported\");\r\n\t\t\t\t$ieNotSuported.show();\r\n\t\t\t\t$ieNotSuported.find(\"#ie-dismiss\").click(function () {\r\n\t\t\t\t\t$ieNotSuported.hide();\r\n\t\t\t\t\tvar fortnightAway = Number(new Date(Date.now() + 12096e5));\r\n\t\t\t\t\twindow.localStorage.setItem(\r\n\t\t\t\t\t\t\"ie-not-supported\",\r\n\t\t\t\t\t\tfortnightAway\r\n\t\t\t\t\t);\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t// check for a ribbon\r\n\t\ttry {\r\n\t\t\t$(\".ribbon\").ribbon();\r\n\t\t} catch (err) {}\r\n\r\n\t\t$(\"#current-client\").on(\"change\", function () {\r\n\t\t\tvar abbr = $(\"#current-client\").val();\r\n\t\t\tcpf.teleport(true);\r\n\t\t\tcpf.wait(true);\r\n\r\n\t\t\tvar url;\r\n\t\t\tif (HTTP.clientSlug !== \"\")\r\n\t\t\t{\r\n\t\t\t\turl = `${window.location.origin}/${abbr}/signin/sso/saml2/appriss`;\r\n\t\t\t} else {\r\n\