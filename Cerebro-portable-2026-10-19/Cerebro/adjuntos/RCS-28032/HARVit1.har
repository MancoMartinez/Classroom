   width: 100%;\\n    color: var(--secure-primary-text);\\n    font-weight: bold;\\n    font-size: 1.125rem;\\n    line-height: 1.125rem;\\n    border-radius: 1.5rem 1.5rem 0 0;\\n    word-break: break-word;\\n    -ms-flex: 0 0 auto;\\n    flex: 0 0 auto;\\n}\\n\\n.lightbox-nav-tabs {\\n    position: absolute;\\n    right: 3rem;\\n    top: 0;\\n    border-bottom: 0;\\n    background: 0;\\n}\\n\\n.lightbox-close, .cpf-lightbox-close {\\n    position: absolute;\\n    top: 0.875rem;\\n    right: 0.875rem;\\n    font-size: 1.25rem;\\n    cursor: pointer;\\n    z-index: 101;\\n    color: var(--secure-primary-text);\\n    padding: 0 0.5rem;\\n    border-radius: 0.75rem;\\n    background: rgba(var(--primary-rgb), 0.25);\\n}\\n\\n.lightbox-close:hover, .cpf-lightbox-close:hover {\\n    background: rgba(var(--primary-rgb), 0.45);\\n}\\n\\n.lightbox-close:focus, .cpf-lightbox-close:focus {\\n    background: rgba(var(--primary-rgb), 0.45);\\n    -webkit-box-shadow: 0 0 0 3px rgba(var(--primary-rgb), 0.5);\\n    box-shadow: 0 0 0 3px rgba(var(--primary-rgb), 0.5);\\n}\\n\\n.lightbox .toolbar {\\n    min-width: initial;\\n    padding-left: 0;\\n}\\n\\n.lightbox-content .lightbox-content-heading {\\n    min-width: 20rem;\\n    padding: 1rem;\\n    border-bottom: 1px solid var(--muted);\\n    height: 6.5rem;\\n}\\n\\n.lightbox-inner > .lightbox-content:last-child {\\n    border-radius: 0 0 2rem 2rem;\\n}\\n\\n.lightbox-content {\\n    min-width: 20rem;\\n    overflow-y: auto;\\n    position: relative;\\n}\\n\\n.lightbox-content .content {\\n    min-width: 20rem;\\n}\\n\\n.lightbox-content h3 + .content {\\n    padding-top: 0;\\n}\\n\\n.lightbox-content .content.container-fluid {\\n    padding-left: 0;\\n    padding-right: 0;\\n}\\n\\n.lightbox-content .content.inner-content .content {\\n    padding: 0;\\n}\\n\\n.lightbox-content > .section-content {\\n    width: 100%;\\n}\\n\\n.lightbox-title + .lightbox-content > .content,\\n.lightbox-content + .lightbox-buttons {\\n    padding-t