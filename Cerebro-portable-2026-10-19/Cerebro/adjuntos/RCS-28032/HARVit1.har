\\r\\n\\r\\n.panel.results-panel.apps-panel {\\r\\n    display: flex;\\r\\n    flex: 0 1 auto;\\r\\n    flex-wrap: wrap;\\r\\n}\\r\\n\\r\\n.panel.results-panel.apps-panel > * {\\r\\n    justify-content: left;\\r\\n    align-items: flex-start;\\r\\n    padding: 10px;\\r\\n}\\r\\n\\r\\n.panel.results-panel.apps-panel.section {\\r\\n    margin-bottom: 0;\\r\\n}\\r\\n\\r\\n.flex-container > .panel.results-panel.apps-panel {\\r\\n    height: auto;\\r\\n}\\r\\n\\r\\n.tab-ribbon {\\r\\n    background: 0;\\r\\n}\\r\\n\\r\\n#allAppsToggleCurveNew:before {\\r\\n    background: var(--toolbar-background);\\r\\n}\\r\\n\\r\\n.apps-panel > div {\\r\\n    height: 13rem;\\r\\n    display: flex;\\r\\n    align-content: center;\\r\\n    justify-content: center;\\r\\n    min-width: 0;\\r\\n}\\r\\n\\r\\n.apps-panel-item {\\r\\n    overflow: hidden;\\r\\n    position: relative;\\r\\n}\\r\\n\\r\\n.apps-panel-item:hover {\\r\\n    overflow: visible;\\r\\n}\\r\\n\\r\\n.apps-panel-box {\\r\\n    position: absolute;\\r\\n    padding: 0.75rem;\\r\\n    text-align: center;\\r\\n    text-decoration: none;\\r\\n    width: 13rem;\\r\\n    border-radius: 2rem;\\r\\n    cursor: pointer;\\r\\n    position: relative;\\r\\n    word-break: normal;\\r\\n    display: block;\\r\\n    background: 0;\\r\\n    box-shadow: none;\\r\\n    transition: background 0.2s ease, box-shadow 0.2s ease;\\r\\n    z-index: 1;\\r\\n    display: flex;\\r\\n    flex-direction: column;\\r\\n    align-items: center;\\r\\n}\\r\\n\\r\\n.apps-panel-box.box {\\r\\n    border: 0;\\r\\n    background: 0;\\r\\n}\\r\\n\\r\\n.apps-panel-box.disabled {\\r\\n    cursor: default;\\r\\n}\\r\\n\\r\\na.apps-panel-box {\\r\\n    text-decoration: none;\\r\\n}\\r\\n\\r\\n.apps-panel-box:hover {\\r\\n    background: var(--app-panel-hover);\\r\\n    box-shadow: 0 4px 12px rgba(10, 20, 50, 0.15);\\r\\n    z-index: 5;\\r\\n}\\r\\n\\r\\n.apps-panel-box:after {\\r\\n    border-radius: 2rem;\\r\\n}\\r\\n\\r\\n.apps-panel-box.disabled:hover {\\r\\n    background: 0;\\r\\n    box-shadow: none;\\r\\n}\\r\\n\\r\\n.apps-panel-box.disabled .app-name {\\r\\n    color: #7d92ad;\\r\\n}\\r\\n\\r\\n.apps-panel-box.disabled .app-description {\\r\\n    display: none;\\r\\n}\\r\\n\\r\\na.apps-panel-box:focus {\\r\\n    box-shadow: none;\\r\\n}\\r\\n\\r\\na.apps-panel-box:focus:after {\\r\\n    width: 100%;\\r\\n    height: 11rem;\\r\\n    border-radius: 2rem;\\r\\n    position: absolute;\\r\\n    top: 0;\\r\\n    left: 0;\\r\\n    border: solid 0.125rem rgba(var(--primary-rgb), 0.2);\\r\\n    transition: border 0.2s ease;\\r\\n    content: \"\";\\r\\n}\\r\\n\\r\\na.apps-panel-box:focus:hover:after {\\r\\n    height: 100%;\\r\\n}\\r\\n\\r\\n.app-icon {\\r\\n    padding: 0.875rem 0.75rem 0.75rem;\\r\\n    position: relative;\\r\\n    height: 6.5rem;\\r\\n    width: 8rem;\\r\\n    background: var(--app-icon);\\r\\n    color: var(--secure-primary-text);\\r\\n    border-radius: 2rem;\\r\\n    margin: 0 1.25rem 0.5rem;\\r\\n    box-shadow: 2px 4px 10px rgba(29, 62, 111, 0.1);\\r\\n}\\r\\n\\r\\n.app-icon.app-icon-platform {\\r\\n    background: var(--app-icon-platform);\\r\\n    color: white;\\r\\n}\\r\\n\\r\\n.app-icon.app-icon-platform.disabled {\\r\\n    background: 0;\\r\\n    border: 1px solid #dee3e8;\\r\\n}\\r\\n\\r\\n.app-icon-platform .disabled {\\r\\n    cursor: not-allowed;\\r\\n}\\r\\n\\r\\n.app-icon .fa,\\r\\n.app-icon .fo {\\r\\n    font-size: 3.875rem;\\r\\n}\\r\\n\\r\\n.app-icon .sub-icon {\\r\\n    font-size: 1.5rem;\\r\\n    position: absolute;\\r\\n    bottom: 1rem;\\r\\n    right: 1.25rem;\\r\\n    background: var(--secure-primary-text);\\r\\n    padding: 0.25rem 0.125rem;\\r\\n    border-radius: 0.75rem;\\r\\n    color: var(--app-icon-sub-icon);\\r\\n    box-sizing: content-box;\\r\\n    width: 1.28571429em;\\r\\n}\\r\\n\\r\\n.app-icon.app-folder-icon {\\r\\n    width: 10rem;\\r\\n    margin-top: 0.25rem;\\r\\n    height: 6.25rem;\\r\\n    padding-top: 0.75rem;\\r\\n}\\r\\n\\r\\n.app-icon.app-folder-icon,\\r\\n.a